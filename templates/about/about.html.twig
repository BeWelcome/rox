{% extends 'about/layout.html.twig' %}

{% block title %}{{ 'aboutuspage' | trans }}{% endblock %}

{% block page_title %}{{ 'sowhat' | trans }}{% endblock %}
{% block page_lead %}{{ 'about.lead' | trans }}{% endblock %}

{% block content %}
    {% set _blocks = [
        {icon: 'fa-lightbulb', title: 'aboutus_theidea', text: 'aboutus_theideatext', url: path('about_people'), link: 'about.more.people'},
        {icon: 'fa-sitemap', title: 'aboutus_howorganized', text: 'aboutus_howorganizedtext', url: path('about_bod'), link: 'about.more.board'},
        {icon: 'fa-hand-holding-hand', title: 'aboutus_getactive', text: 'aboutus_getactivetext', url: path('getactive'), link: 'about.more.getactive'},
        {icon: 'fa-comment', title: 'aboutus_givefeedback', text: 'aboutus_givefeedbacktext', url: path('contactus'), link: 'about.more.contact'},
    ] %}
    <div class="p-about-blocks">
        {% for item in _blocks %}
            <section class="p-about-block">
                <span class="p-about__icon" aria-hidden="true"><i class="fas {{ item.icon }}"></i></span>
                <h2>{{ item.title | trans }}</h2>
                <div>{{ item.text | trans | purify }}</div>
                <a class="p-about__more" href="{{ item.url }}">{{ item.link | trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </section>
        {% endfor %}
    </div>
    <div class="p-about__footnote">{{ 'aboutus_greetings' | trans | purify }}</div>
{% endblock content %}
