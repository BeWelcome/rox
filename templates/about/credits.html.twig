{% set slim_nav = true %}
{% extends 'base.html.twig' %}

{% block title %}
{{ 'credits.title' | trans }}
{% endblock %}

{% block content %}
<h1>{{ 'credits.headline' | trans }}</h1>
<p>{{ 'credits.abstract' | trans }}</p>
<dl>
    <dt><a id="geonames" href="https://geonames.org">Geonames</a></dt>
    <dd>{{ 'credits.geonames'|trans }}</dd>
    <dt><a id="OSM"></a><a href="https://openstreetmap.org">Open Street Map</a></dt>
    <dd>{{ 'credits.osm'|trans }}</dd>
    <dt><a id="Jetbrains"></a><a href="https://www.jetbrains.com/?from=bewelcome"><img
                src="{{ asset('images/phpstorm-text.svg') }}" height="24" alt="PHPStorm logo" title="PHPStorm"></a></dt>
    <dd>{{ 'credits.jetbrains'|trans|purify }}</dd>
    <dt><a id="Browserstack"></a><a href="https://browserstack.com"><img
                src="{{ asset('images/Browserstack-logo.svg') }}" height="24" alt="Browserstack logo"
                title="Browserstack"></a></dt>
    <dd>{{ 'credits.browserstack'|trans }}</dd>
    <dt><a id="Symfony"></a><a href="https://symfony.com"><img src="{{ asset('images/symfony_black_02.png') }}"
                height="24" alt="symfony logo" title="symfony"></a></dt>
    <dd>{{ 'credits.symfony'|trans }}</dd>
    <dt><a id="ckeditor"></a><a href="https://ckeditor.com/ckeditor-5/">CKEditor 5</a></dt>
    <dd>{{ 'credits.ckeditor'|trans }}</dd>
    <dt><a id="znuny"></a><a href="https://www.znuny.org/">Znuny</a></dt>
    <dd>{{ 'credits.znuny'|trans }}</dd>
    <dt><a href="https://htmlpurifier.org/"><img src="/images/html_purifier_powered.png"
                alt="Powered by HTML Purifier"></a></dt>
    <dd>{{ 'credits.htmlpurifier'|trans }}</dd>
    <dt><a href="https://meet.jitsi.org"><img src="https://jitsi.org/wp-content/themes/jitsi/images/logo-web-2020.png"
                height="24"></a></dt>
    <dd>{{ 'credits.jitsi.meet'|trans }}</dd>
    <dt><a href="https://framasoft.org">Framasoft</a></dt>
    <dd>{{ 'credits.framasoft'|trans }}</dd>
</dl>
{% endblock content %}