{% extends 'about/layout.html.twig' %}

{% block title %}{{ 'credits.title' | trans }}{% endblock %}

{% block page_title %}{{ 'credits.headline' | trans }}{% endblock %}
{% block page_lead %}{{ 'credits.abstract' | trans }}{% endblock %}

{% block matomo %}
    <script type="application/javascript">
    var _paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be calledbefore "trackPageView" */
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
    var u="//matomo.bewelcome.org/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '1']);
    var d=document, g=d.createElement('script'),s=d.getElementsByTagName('script')[0];
    g.type='text/javascript'; g.async=true; g.defer=true;g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
    </script>
{% endblock matomo %}

{% block about_body %}
    {# a row per project; the ids are linked to (map.js links to #OSM) #}
    {% set _credits = [
        {id: 'geonames', name: 'Geonames', url: 'https://geonames.org', text: 'credits.geonames'},
        {id: 'OSM', name: 'OpenStreetMap', url: 'https://openstreetmap.org', text: 'credits.osm'},
        {id: 'Jetbrains', name: 'PhpStorm', url: 'https://www.jetbrains.com/?from=bewelcome', text: 'credits.jetbrains'},
        {id: 'Browserstack', name: 'BrowserStack', url: 'https://browserstack.com', text: 'credits.browserstack'},
        {id: 'Symfony', name: 'Symfony', url: 'https://symfony.com', text: 'credits.symfony'},
        {id: 'ckeditor', name: 'CKEditor 5', url: 'https://ckeditor.com/ckeditor-5/', text: 'credits.ckeditor'},
        {id: 'htmlpurifier', name: 'HTML Purifier', url: 'https://htmlpurifier.org/', text: 'credits.htmlpurifier'},
        {id: 'jitsi', name: 'Jitsi Meet', url: 'https://meet.jitsi.org', text: 'credits.jitsi.meet'},
        {id: 'framasoft', name: 'Framasoft', url: 'https://framasoft.org', text: 'credits.framasoft'},
        {id: 'znuny', name: 'Znuny', url: 'https://www.znuny.org/', text: 'credits.znuny'},
    ] %}
    <div class="p-about__card p-about__text p-credits">
        {% for credit in _credits %}
            <div class="p-credits__row" id="{{ credit.id }}">
                <a class="p-credits__name" href="{{ credit.url }}">{{ credit.name }}</a>
                <div class="p-credits__text">{{ credit.text | trans | purify }}</div>
            </div>
        {% endfor %}
    </div>
{% endblock about_body %}
