{% extends 'about/layout.html.twig' %}

{% block title %}
	{{ 'contactus' | trans }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
{% endblock stylesheets %}

{% block javascripts %}
    {# opens the report hint below when it is there (data-micromodal-open) #}
    {{ encore_entry_script_tags('micromodal') }}
{% endblock javascripts %}

{% block content %}
    {# The hint for a safety report, opened on load by assets/js/micromodal.js (data-micromodal-open). Coming from a
       message (messageId), it offers to report that message instead. #}
    {% if form.vars.valid and form.IdCategory.vars.value == 2 and no_modal == false %}
        <div class="micromodal-slide p-about-hint" id="report-modal" aria-hidden="true" data-micromodal-open>
            <div class="modal__overlay p-about-hint__overlay" tabindex="-1" data-micromodal-close>
                <div class="modal__container p-about-hint__box" role="dialog" aria-modal="true" aria-labelledby="report-modal-title">
                    <div class="p-about-hint__head">
                        <span class="p-about-hint__icon" aria-hidden="true"><i class="fas fa-shield-alt"></i></span>
                        <h2 class="p-about-hint__title" id="report-modal-title">{{ 'feedback.profile.title'|trans }}</h2>
                    </div>
                    <div class="p-about-hint__text">
                        {{ (messageId != null ? 'feedback.profile.report.message' : 'feedback.profile.report.addinfo')|trans|purify|nl2br }}
                    </div>
                    <div class="p-about-hint__actions">
                        {% if messageId != null %}
                            <button type="button" class="p-about-hint__btn p-about-hint__btn--secondary" data-micromodal-close>{{ 'modal.continue'|trans }}</button>
                            <a href="{{ url('conversation_report_spam', {'id': messageId}) }}" class="p-about-hint__btn p-about-hint__btn--primary">{{ 'conversation.report.message'|trans }}</a>
                        {% else %}
                            <button type="button" class="p-about-hint__btn p-about-hint__btn--primary" data-micromodal-close>{{ 'feedback.understood'|trans }}</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <div class="o-text">
        <h1>{{ 'contactus' | trans }}</h1>
        <div class="row">
            <div class="col-12 col-md-6">
                <p>{{ 'feedbackdisclaimer' | trans | purify | nl2br }}</p>
                {# Special notice for profile reports #}
            </div>
            <div class="col-12 col-md-6">
                {{ form_start(form) }}
                {{ form_row(form.IdCategory) }}
                {{ form_row(form.FeedbackQuestion) }}
                {{ form_errors(form.FeedbackQuestion) }}
                {{ form_rest(form) }}
                <div class="mb-3">
                    <button type="submit" id="submit" name="submit" class="o-button">{{ 'submit'|trans }}</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock content %}
