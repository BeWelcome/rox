{% extends 'about/layout.html.twig' %}

{% block title %}{{ 'contactus' | trans }}{% endblock %}

{% block page_title %}{{ 'contactus' | trans }}{% endblock %}
{% block page_lead %}{{ 'contactus.lead' | trans }}{% endblock %}

{% block content %}
    <div class="p-contact__sent">
        <span class="p-about__icon" aria-hidden="true"><i class="fas fa-paper-plane"></i></span>
        <h2>{{ 'contactus.sent.title' | trans }}</h2>
        <p>{{ 'contactus.sent.text' | trans }}</p>
        <a class="o-button o-button--outline" href="{{ path('feedback') }}"><i class="fas fa-comment-dots" aria-hidden="true"></i>{{ 'feedback.send.more' | trans }}</a>
    </div>
{% endblock content %}
