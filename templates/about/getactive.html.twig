{% extends 'about/layout.html.twig' %}
{#
  Get active: a tile per team (App\Model\About\VolunteerTeams) with its tags (links), its text and the member to
  contact (a TeamCoordinator, set in the volunteer tools). The pills filter the tiles by group (about/getactive.js);
  without JavaScript all tiles show.
#}

{% block title %}{{ 'getactive' | trans }}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('about/getactive') }}
{% endblock javascripts %}

{% block page_title %}{{ 'getactive' | trans }}{% endblock %}
{% block page_lead %}{{ 'getactiveintro' | trans | purify }}{% endblock %}

{% block about_body %}
    <div class="p-getactive js-getactive">
        <div class="p-about__pills" role="group" aria-label="{{ 'getactive.filter' | trans }}">
            <button type="button" class="c-pill is-active" data-group="" aria-pressed="true">{{ 'getactive.filter.all' | trans }}</button>
            {% for group in groups %}
                <button type="button" class="c-pill" data-group="{{ group }}" aria-pressed="false">{{ ('getactive.filter.' ~ group) | trans }}</button>
            {% endfor %}
        </div>

        <div class="p-getactive__tiles">
            {% for team, definition in volunteer_teams %}
                {% set _coordinator = coordinators[team] ?? null %}
                {% set _tags = (definition.tags | trans | purify | striptags('<a>') | replace({'&#124;': '|'})) | split('|') | map(tag => tag | trim) | filter(tag => tag != '') %}
                <section class="p-getactive__tile" data-group="{{ definition.group }}" aria-labelledby="getactive-{{ team }}">
                    <div class="p-getactive__tile-head">
                        <span class="p-about__icon" aria-hidden="true"><i class="{{ definition.icon }}"></i></span>
                        <h2 id="getactive-{{ team }}">{{ ('getactive' ~ team ~ 'title') | trans }}</h2>
                    </div>
                    {% if _tags is not empty %}
                        <div class="p-getactive__tags">
                            {% for tag in _tags %}<span class="c-tag">{{ tag | raw }}</span>{% endfor %}
                        </div>
                    {% endif %}
                    <div class="p-getactive__text">{{ ('getactive' ~ team ~ 'text') | trans | purify }}</div>
                    {% if _coordinator %}
                        {% set _member = _coordinator.member %}
                        <div class="p-getactive__contact">
                            <img class="p-getactive__avatar" src="{{ path('avatar', {username: _member.username, size: 48}) }}" alt="" width="32" height="32" loading="lazy">
                            <div class="p-getactive__who">
                                <a class="p-getactive__name" href="{{ path('members_profile', {username: _member.username}) }}">{{ _member.username }}</a>
                                <span class="p-getactive__role">{{ 'getactive.coordinator' | trans }}</span>
                            </div>
                            <a class="c-pill" href="{{ path('message_new', {username: _member.username}) }}"><i class="fas fa-envelope" aria-hidden="true"></i>{{ 'getactive.message' | trans }}</a>
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock about_body %}
