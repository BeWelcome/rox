{% extends 'about/layout.html.twig' %}
{#
  The statistics (StatisticsController): a card per figure with its latest value and an area chart, by week or by day
  (the switch above them, both loaded at once); then how long ago members logged in, where they live and their
  languages as bar lists. about/statistics.js loads the data from the stats_* routes and draws them.
#}
{% set metrics = {
    members: {headline: 'members', route: 'stats_members', unit: 'statistics.unit.active'},
    sent_messages: {headline: 'sent_messages', route: 'stats_messages_sent'},
    read_messages: {headline: 'read_messages', route: 'stats_messages_read'},
    sent_requests: {headline: 'sent_requests', route: 'stats_requests_sent'},
    accepted_requests: {headline: 'accepted_requests', route: 'stats_requests_accepted'},
    created_legs: {headline: 'statistics.legs.created', route: 'stats_legs_created'},
    sent_invitations: {headline: 'statistics.invitations.sent', route: 'stats_invitations_sent'},
    accepted_invitations: {headline: 'statistics.invitations.accepted', route: 'stats_invitations_accepted'},
} %}
{% set lists = {
    logins: {headline: 'statslastlogin', url: '/stats/members/logins'},
    countries: {headline: 'statsmembercountry', url: '/stats/members/countries'},
    languages: {headline: 'statslanguages', url: '/stats/languages/spoken'},
    preferred: {headline: 'statspreferredlanguages', url: '/stats/languages/preferred'},
} %}

{% block title %}{{ 'statistics.title' | trans }}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('about/statistics') }}
{% endblock javascripts %}

{% block page_title %}{{ 'bw statistics' | trans }}{% endblock %}
{% block page_lead %}{{ 'statshead' | trans }}{% endblock %}

{% block about_body %}
    <div class="p-stats js-stats" data-locale="{{ app.request.locale }}">
        <div class="p-stats__bar">
            <div class="c-home-radius__options" role="group" aria-label="{{ 'statistics.period' | trans }}">
                <button type="button" class="c-home-radius__option is-active" data-period="weekly" aria-pressed="true">{{ 'statistics.period.weekly' | trans }}</button>
                <button type="button" class="c-home-radius__option" data-period="daily" aria-pressed="false">{{ 'statistics.period.daily' | trans }}</button>
            </div>
            <span class="p-stats__updated">{{ 'statistics.updated' | trans }}</span>
        </div>

        <div class="p-stats__cards">
            {% for key, metric in metrics %}
                <section class="p-stats__card js-stats-metric"
                         data-weekly="{{ path(metric.route, {period: 'weekly'}) }}" data-daily="{{ path(metric.route, {period: 'daily'}) }}">
                    <h2>{{ metric.headline | trans }}</h2>
                    <p class="p-stats__value"><span class="js-stats-value">–</span> <span class="p-stats__unit">{{ (metric.unit ?? 'statistics.unit.day') | trans }}</span></p>
                    <div class="p-stats__chart"><canvas class="js-stats-chart" aria-label="{{ metric.headline | trans }}" role="img"></canvas></div>
                    <div class="p-stats__range"><span class="js-stats-from"></span><span class="js-stats-to"></span></div>
                    {% if key == 'members' %}
                        <p class="p-stats__note">{{ 'statistics.members.info' | trans }}</p>
                    {% endif %}
                </section>
            {% endfor %}

            {% for key, list in lists %}
                <section class="p-stats__card js-stats-list" data-url="{{ list.url }}">
                    <h2>{{ list.headline | trans }}</h2>
                    <ul class="p-stats__list js-stats-rows"><li class="p-stats__loading">{{ 'statistics.loading' | trans }}</li></ul>
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock about_body %}
