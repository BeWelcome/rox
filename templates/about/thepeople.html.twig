{% extends 'about/layout.html.twig' %}

{% block title %}{{ 'aboutuspage' | trans }} - {{ 'about_thepeople' | trans }}{% endblock %}

{% block page_title %}{{ 'thepeople' | trans }}{% endblock %}
{% block page_lead %}{{ 'thepeople.lead' | trans }}{% endblock %}

{% block content %}
    <div class="p-people">
        <div class="p-people__intro">
            <section>
                <h2>{{ 'thepeople_title1' | trans }}</h2>
                <p>{{ 'thepeople_text1' | trans | purify | nl2br }}</p>
            </section>
            <section>
                <h2>{{ 'thepeople_titleinterviews' | trans }}</h2>
                <p><a href="{{ url('wiki_page', {'pageTitle': 'Interviews'}) }}">{{ 'thepeople_textinterviews' | trans | purify | nl2br }}</a></p>
            </section>
        </div>

        {# photos of a meeting of the volunteers, from BeVolunteer's Flickr album #}
        <figure class="u:m-0">
            <div class="p-people__mosaic">
                {% for photo in [
                    'https://farm3.static.flickr.com/2200/2204242456_f2a726c103.jpg',
                    'https://farm3.static.flickr.com/2275/2204241012_756d5234e6.jpg',
                    'https://farm3.static.flickr.com/2157/2204319026_8764a0573a.jpg',
                    'https://farm3.static.flickr.com/2161/2206203954_9a511d50d2.jpg',
                    'https://farm3.static.flickr.com/2179/2204240888_d90054b31a.jpg',
                ] %}
                    <img src="{{ photo }}" alt="" loading="lazy">
                {% endfor %}
            </div>
            <figcaption class="p-people__caption">
                {{ 'thepeople_picturetext1' | trans | purify }} {{ 'thepeople_picturetext2' | trans | purify }}
                <a href="https://www.flickr.com/photos/22828233@N05/">Flickr</a>
            </figcaption>
        </figure>

        <section class="p-people__outro">
            <h2>{{ 'thepeople_title3' | trans }}</h2>
            <p>{{ 'thepeople_text3' | trans | purify | nl2br }}</p>
        </section>
    </div>
{% endblock content %}
