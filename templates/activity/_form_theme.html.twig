{# Activity forms: errors once, under the field (the site theme also puts them into the label). #}

{% block form_label_errors %}{% endblock form_label_errors %}

{% block form_errors %}
  {%- if errors|length > 0 -%}
    <ul class="p-activities-errors">
      {%- for error in errors -%}
        <li class="form-error-message">{{ error.message }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{% endblock form_errors %}
