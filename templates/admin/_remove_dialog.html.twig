{#
  The dialog that asks before removing a right or a flag (assets/js/admin/assignments.js): a button with
  data-remove="{{ id }}", data-action (the URL it posts to) and data-text (the question) opens it.
  id, title, token (the CSRF token id), confirm (the label of the button).
#}
<div class="micromodal-slide p-pe-confirm" id="{{ id }}" aria-hidden="true">
  <div class="modal__overlay p-pe-confirm__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container p-pe-confirm__box" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
      <span class="p-pe-confirm__icon" aria-hidden="true"><i class="fas fa-xmark"></i></span>
      <h2 class="p-pe-confirm__title" id="{{ id }}-title">{{ title }}</h2>
      <p class="p-pe-confirm__text" data-remove-text></p>
      <form method="post" class="p-pe-confirm__actions" data-remove-form>
        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
        <input type="hidden" name="return" value="{{ app.request.requestUri }}">
        <button type="button" class="p-pe-confirm__cancel" data-micromodal-close>{{ 'cancel'|trans }}</button>
        <button type="submit" class="p-pe-confirm__delete">{{ confirm }}</button>
      </form>
    </div>
  </div>
</div>
