{#
  The checker's pages, with what is open in them (Admin\CheckerController::counts). Expects counts and active.
#}
{% set _items = {
  messages: {key: 'reported.messages', icon: 'envelope', route: 'admin_spam_messages'},
  processed_messages: {key: 'reported.messages.processed', icon: 'envelope-circle-check', route: 'admin_spam_messages_processed'},
  blocked_words: {key: 'block.words.messages', icon: 'ban', route: 'admin_spam_messages_block_words'},
  processed_blocked_words: {key: 'block.words.processed', icon: 'circle-check', route: 'admin_spam_messages_block_words_processed'},
  activities: {key: 'activities', icon: 'calendar-days', route: 'admin_spam_activities'},
  community_news: {key: 'community_news', icon: 'newspaper', route: 'admin_spam_community_news'},
} %}
<nav class="c-cnews-card c-cnews-menu" aria-label="{{ 'admin.checker.eyebrow'|trans }}">
  <p class="c-cnews-eyebrow">{{ 'admin.checker.eyebrow'|trans }}</p>
  <ul>
    {% for key, item in _items %}
      <li>
        <a class="c-cnews-menu__item{{ key == active ? ' is-active' }}" href="{{ path(item.route) }}"{% if key == active %} aria-current="page"{% endif %}>
          <i class="fas fa-{{ item.icon }} fa-fw" aria-hidden="true"></i><span>{{ item.key|trans }}</span>
          {% if (counts[key] ?? 0) > 0 %}<span class="c-cnews-menu__count">{{ counts[key] }}</span>{% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
