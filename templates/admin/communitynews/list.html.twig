{% extends 'base.html.twig' %}
{#
  The news admin's list (Admin\CommunityNewsController::showOverviewAction): the news as cards, filtered by All,
  Published and Hidden, with Edit and Hide or Publish. Reported comments are the checkers' (CheckerController).
#}
{% set inline_notices = true %}
{% set _filters = {all: 'admin.communitynews.filter.all', published: 'admin.communitynews.filter.published', hidden: 'admin.communitynews.filter.hidden'} %}

{% block title %}{{ 'admin.communitynews.title'|trans }}{% endblock %}

{% block main %}
  <main role="main" class="c-cnews">
    <div class="container-lg c-cnews__admin">
      <header class="c-cnews-head">
        <p class="c-page-head__eyebrow">{{ 'admin.communitynews.eyebrow'|trans }}</p>
        <h1 class="c-page-head__title">{{ 'admin.communitynews.title'|trans }}</h1>
      </header>
      {% include 'admin/massmail/_flash.html.twig' %}

      <div class="c-cnews-toolbar">
        <nav class="c-cnews-segments" aria-label="{{ 'admin.communitynews.title'|trans }}">
          {% for key, label in _filters %}
            <a class="c-cnews-segments__item{{ filter == key ? ' is-active' }}" href="{{ path('admin_communitynews_overview', key == 'all' ? {} : {show: key}) }}"{% if filter == key %} aria-current="page"{% endif %}>{{ label|trans({count: counts[key]}) }}</a>
          {% endfor %}
        </nav>
        <a class="c-cadmin-btn c-cadmin-btn--primary" href="{{ path('admin_communitynews_create') }}"><i class="fas fa-plus" aria-hidden="true"></i>{{ 'admin.communitynews.create'|trans }}</a>
      </div>

      {% if communityNews.nbResults == 0 %}
        <p class="c-cnews-card c-cadmin__empty"><i class="fas fa-newspaper" aria-hidden="true"></i>{{ 'admin.communitynews.none'|trans }}</p>
      {% else %}
        <ul class="c-cnews-posts">
          {% for news in communityNews %}
            <li class="c-cnews-card c-cnews-post{{ news.public ? '' : ' is-hidden' }}">
              <div class="c-cnews-post__main">
                {% if news.public %}
                  <span class="c-tag c-tag--green"><i class="fas fa-eye" aria-hidden="true"></i>{{ 'admin.communitynews.published.tag'|trans }}</span>
                {% else %}
                  <span class="c-tag"><i class="fas fa-eye-slash" aria-hidden="true"></i>{{ 'admin.communitynews.hidden.tag'|trans }}</span>
                {% endif %}
                <h2 class="c-cnews-post__title"><a href="{{ path('communitynews_show', {id: news.id}) }}">{{ news.title }}</a></h2>
                <p class="c-cnews-post__excerpt">{{ news.text|striptags|replace({'&nbsp;': ' '})|slice(0, 400) }}</p>
                <p class="c-cnews-post__meta">
                  {% if news.createdBy %}
                    <img src="{{ path('avatar', {username: news.createdBy.username, size: 48}) }}" alt="" width="24" height="24" loading="lazy">
                    <a href="{{ path('members_profile', {username: news.createdBy.username}) }}">{{ news.createdBy.username }}</a> ·
                  {% endif %}
                  {% if news.createdAt %}{{ news.createdAt.diffForHumans }} · {% endif %}
                  <span><i class="far fa-comment" aria-hidden="true"></i> {{ 'communitynews.comments.count'|trans({count: comments[news.id] ?? 0}) }}</span>
                </p>
              </div>
              <div class="c-cnews-post__actions">
                <a class="c-cadmin-btn c-cnews-btn-small" href="{{ path('admin_communitynews_edit', {id: news.id}) }}"><i class="fas fa-pen" aria-hidden="true"></i>{{ 'admin.communitynews.edit'|trans }}</a>
                <form method="post" action="{{ path(news.public ? 'admin_communitynews_hide' : 'admin_communitynews_unhide', {id: news.id}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\Admin\\CommunityNewsController::TOKEN')) }}">
                  <input type="hidden" name="return" value="{{ app.request.requestUri }}">
                  <button type="submit" class="c-cadmin-btn c-cadmin-btn--quiet c-cnews-btn-small">
                    <i class="fas fa-{{ news.public ? 'eye-slash' : 'eye' }}" aria-hidden="true"></i>{{ (news.public ? 'admin.communitynews.hide' : 'admin.communitynews.publish')|trans }}
                  </button>
                </form>
              </div>
            </li>
          {% endfor %}
        </ul>
        {% if communityNews.haveToPaginate %}
          <div class="c-cadmin__pager">{{ pagerfanta(communityNews, 'rox_default') }}</div>
        {% endif %}
      {% endif %}
    </div>
  </main>
{% endblock main %}
