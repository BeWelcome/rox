{% extends 'admin/faqs/_layout.html.twig' %}
{#
  A new FAQ category, or an edit of its English name: the translation id (fixed once the category exists) and the
  name. Expects form, edit and, when editing, faqCategory.
#}

{% block faq_admin %}
    <section class="p-faq__card p-faq__main p-faq__form">
        <div class="p-faq__title-row">
            <h2 class="p-faq__title">{{ (edit ? 'admin.faq.edit.category' : 'admin.faq.create.category')|trans }}</h2>
            {% if edit %}<a class="p-faq__back" href="{{ path('admin_faqs_overview', {categoryId: faqCategory.id}) }}"><i class="fas fa-chevron-left" aria-hidden="true"></i> {{ faqCategory.description|lower|trans({}, 'messages', 'en') }}</a>{% endif %}
        </div>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.wordCode) }}
            {{ form_row(form.description) }}
            <div class="p-faq__actions">
                {% if form.FaqCategoryCreate is defined %}{{ form_widget(form.FaqCategoryCreate, {attr: {class: 'c-cadmin-btn c-cadmin-btn--primary c-cnews-btn-small'}}) }}{% endif %}
                {% if form.FaqCategoryUpdate is defined %}{{ form_widget(form.FaqCategoryUpdate, {attr: {class: 'c-cadmin-btn c-cadmin-btn--primary c-cnews-btn-small'}}) }}{% endif %}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </section>
{% endblock %}
