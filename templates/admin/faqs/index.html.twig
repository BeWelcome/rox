{% extends 'admin/faqs/_layout.html.twig' %}
{#
  The FAQs of a category, the inactive ones too: drag them by the handle to change their order, then save it. Each
  shows its translation id, its question and the start of its answer (in English), and opens its edit form.
  Expects faqCategory, faqs and form (the order).
#}
{% set inline_notices = true %}

{% block faq_admin %}
    <section class="p-faq__card p-faq__main">
        <div class="p-faq__title-row">
            <h2 class="p-faq__title">{{ faqCategory.description|lower|trans({}, 'messages', 'en') }}</h2>
            <a class="c-cadmin-btn c-cadmin-btn--quiet c-cnews-btn-small" href="{{ path('admin_faqs_category_edit', {id: faqCategory.id}) }}"><i class="fas fa-pen" aria-hidden="true"></i>{{ 'admin.faq.edit.category'|trans }}</a>
            <a class="c-cadmin-btn c-cadmin-btn--primary c-cnews-btn-small" href="{{ path('admin_faqs_faq_create', {categoryId: faqCategory.id}) }}"><i class="fas fa-plus" aria-hidden="true"></i>{{ 'faqs.button.create'|trans }}</a>
        </div>

        {% if faqs is empty %}
            <div class="c-cnews-empty">
                <span class="c-cnews-empty__icon" aria-hidden="true"><i class="fas fa-circle-question"></i></span>
                <p class="c-cnews-empty__title">{{ 'faqs.none'|trans }}</p>
                <p class="c-cnews-empty__text">{{ 'faqs.none.create'|trans }}</p>
            </div>
        {% else %}
            {{ form_start(form, {attr: {class: 'p-faq__sort js-faq-sort'}}) }}
                <p class="p-faq__hint">{{ 'admin.faqs.drag'|trans }}</p>
                <ol class="p-faq__rows js-faq-sortable">
                    {% for faq in faqs %}
                        {% set _active = faq.Active == 'Active' %}
                        <li class="p-faq__row{{ _active ? '' : ' is-inactive' }}" data-id="{{ faq.id }}">
                            <span class="p-faq__handle js-faq-handle" title="{{ 'admin.faqs.move'|trans }}" aria-hidden="true"><i class="fas fa-grip-vertical"></i></span>
                            <div class="p-faq__row-text">
                                <p class="p-faq__code">{{ faq.QandA }}{% if not _active %} <span class="c-tag">{{ 'admin.faqs.inactive'|trans }}</span>{% endif %}</p>
                                <p class="p-faq__question">{{ ('faqq_' ~ faq.QandA)|lower|trans({}, 'messages', 'en')|striptags|trim }}</p>
                                <p class="p-faq__preview">{{ ('faqa_' ~ faq.QandA)|lower|trans({}, 'messages', 'en')|striptags|truncate(140) }}</p>
                            </div>
                            <a class="c-cadmin-btn c-cadmin-btn--quiet c-cnews-btn-small" href="{{ path('admin_faqs_faq_edit', {id: faq.id}) }}"><i class="fas fa-pen" aria-hidden="true"></i>{{ 'admin.faqs.edit'|trans }}</a>
                        </li>
                    {% endfor %}
                </ol>
                {{ form_widget(form.sortOrder, {attr: {class: 'js-faq-order'}}) }}
                <div class="p-faq__actions">
                    <button type="submit" class="c-cadmin-btn c-cadmin-btn--primary c-cnews-btn-small js-faq-save" disabled><i class="fas fa-floppy-disk" aria-hidden="true"></i>{{ 'label.admin.faq.update.order'|trans }}</button>
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        {% endif %}
    </section>
{% endblock %}
