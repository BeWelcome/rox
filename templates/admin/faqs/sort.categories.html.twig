{% extends 'admin/faqs/_layout.html.twig' %}
{#
  The order of the FAQ categories: drag them by the handle, then save. Each shows its name in English and, for a
  volunteer using another language, in that language. Expects faqCategories and form (the order).
#}
{% set inline_notices = true %}

{% block faq_admin %}
    <section class="p-faq__card p-faq__main">
        <h2 class="p-faq__title">{{ 'admin.faqs.sort_categories'|trans }}</h2>
        {{ form_start(form, {attr: {class: 'p-faq__sort js-faq-sort'}}) }}
            <p class="p-faq__hint">{{ 'admin.faq.abstract'|trans }}</p>
            <ol class="p-faq__rows js-faq-sortable">
                {% for faqCategory in faqCategories %}
                    <li class="p-faq__row" data-id="{{ faqCategory.id }}">
                        <span class="p-faq__handle js-faq-handle" title="{{ 'admin.faqs.move'|trans }}" aria-hidden="true"><i class="fas fa-grip-vertical"></i></span>
                        <div class="p-faq__row-text">
                            <p class="p-faq__code">{{ faqCategory.description }}</p>
                            <p class="p-faq__question">{{ faqCategory.description|lower|trans({}, 'messages', 'en') }}</p>
                            {% if app.request.locale != 'en' %}<p class="p-faq__preview">{{ faqCategory.description|lower|trans }}</p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
            {{ form_widget(form.sortOrder, {attr: {class: 'js-faq-order'}}) }}
            <div class="p-faq__actions">
                <button type="submit" class="c-cadmin-btn c-cadmin-btn--primary c-cnews-btn-small js-faq-save" disabled><i class="fas fa-floppy-disk" aria-hidden="true"></i>{{ 'admin.faq.category.update.order'|trans }}</button>
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </section>
{% endblock %}
