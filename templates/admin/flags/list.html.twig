{% extends 'base.html.twig' %}
{#
  Every NotAllowedToPostInForum flag ever set (Admin\FlagsController::index): the current ones first, then the removed
  ones, newest first. Flags are set and removed in the Admin box of the member's profile; a current one also here.
#}
{% import 'admin/rights/_macros.html.twig' as rm %}
{% set inline_notices = true %}

{% block title %}{{ 'admin.flags.title'|trans }}{% endblock %}

{% block javascripts %}
  {{ encore_entry_script_tags('admin/assignments') }}
{% endblock javascripts %}

{% block main %}
  <main role="main" class="c-cadmin">
    <div class="p-pro__tabs-wrap c-cadmin__band">
      <div class="container-lg c-cadmin__band-inner">
        <h1 class="c-cadmin__title">{{ 'admin.flags.title'|trans }}</h1>
        <p class="c-radmin-band-note">{{ 'admin.flags.note'|trans({flag: flag.name}) }}</p>
      </div>
    </div>

    <div class="container-lg c-cadmin__body">
      {% include 'admin/massmail/_flash.html.twig' %}
      <section class="c-home-card c-radmin-table-card" aria-label="{{ 'admin.flags.title'|trans }}">
        <form method="get" action="{{ path('admin_flags') }}" class="c-radmin-bar">
          <input type="search" name="member" class="o-input c-radmin-bar__search c-radmin-bar__search--narrow" value="{{ search }}" placeholder="{{ 'admin.rights.find.member'|trans }}" aria-label="{{ 'admin.rights.find.member'|trans }}">
          <span class="c-radmin-bar__count">{{ 'admin.flags.count'|trans({count: assignments|length, current: current}) }}</span>
          <button type="submit" class="u:sr-only">{{ 'admin.assignments.filter'|trans }}</button>
        </form>

        {% if assignments is empty %}
          <p class="c-cadmin__empty c-radmin-empty"><i class="fas fa-magnifying-glass" aria-hidden="true"></i>{{ 'admin.assignments.none'|trans }}</p>
        {% else %}
          {% set _xmark %}<i class="fas fa-xmark" aria-hidden="true"></i>{% endset %}
          <div class="c-radmin-table">
            <div class="c-radmin-table__inner c-radmin-table__inner--flags">
              <div class="c-radmin-table__row c-radmin-table__row--head" role="row">
                <span>{{ 'admin.rights.member'|trans }}</span>
                <span>{{ 'admin.rights.comment'|trans }}</span>
                <span>{{ 'admin.flags.set'|trans }}</span>
                <span>{{ 'admin.flags.removed.on'|trans }}</span>
                <span><span class="u:sr-only">{{ 'admin.assignments.actions'|trans }}</span></span>
              </div>
              {% for assignment in assignments %}
                {% set is_current = assignment.current == 1 %}
                <div class="c-radmin-table__row" role="row">
                  <a class="c-radmin-member" href="{{ path('members_profile', {username: assignment.username}) }}">
                    <img class="c-radmin-member__avatar" src="{{ path('avatar', {username: assignment.username, size: 48}) }}" alt="" width="36" height="36" loading="lazy">
                    <span class="c-radmin-member__text">
                      <span class="c-radmin-member__name{{ is_current ? '' : ' is-removed' }}">{{ assignment.username }}</span>
                      {% if not is_current %}{{ rm.removed_tag() }}{% endif %}
                      <span class="c-radmin-member__place">{{ rm.place(assignment) }}</span>
                    </span>
                  </a>
                  <span class="c-radmin-table__comment">{{ assignment.comment ?: '—' }}</span>
                  <span class="c-radmin-muted">{{ assignment.created_at|format_date('medium') }}</span>
                  <span class="c-radmin-muted">{{ is_current ? '—' : (assignment.updated_at ?? assignment.created_at)|format_date('medium') }}</span>
                  <span class="c-radmin-table__actions">
                    {% if is_current %}
                      {{ rm.remove_button('c-radmin-flag-remove', path('admin_flags_unblock', {username: assignment.username}),
                        'admin.flags.remove.question'|trans({flag: flag.name, username: assignment.username}),
                        'c-radmin-icon c-radmin-icon--danger', _xmark, 'admin.assignments.remove'|trans) }}
                    {% endif %}
                  </span>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </section>
    </div>

    {{ include('admin/_remove_dialog.html.twig', {id: 'c-radmin-flag-remove', title: 'admin.flags.remove.title'|trans, token: constant('App\\Controller\\Admin\\FlagsController::TOKEN'), confirm: 'admin.flags.remove.button'|trans}) }}
  </main>
{% endblock main %}
