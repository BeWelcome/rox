{% extends 'base.html.twig' %}

{% block content %}
  <h1 class="u:text-24">{{ 'admin.flags.remove'|trans }}</h1>
  <p>{{ 'admin.flags.remove.confirm'|trans({
    '%flag%': assignment.flag.name,
    '%username%': assignment.member.username
  }) }}</p>
  <dl>
    <dt>{{ 'admin.flags.level'|trans }}</dt>
    <dd>{{ assignment.level }}</dd>
    <dt>{{ 'admin.flags.scope'|trans }}</dt>
    <dd>{{ assignment.scope }}</dd>
    <dt>{{ 'admin.flags.comment'|trans }}</dt>
    <dd>{{ assignment.comment|nl2br }}</dd>
  </dl>
  {{ form(form) }}
{% endblock content %}
