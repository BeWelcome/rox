{% extends 'base.html.twig' %}
{% import '_partials/member_suggest.html.twig' as member_suggest %}
{#
  The logs (Admin\LogController): what members and volunteers did on the site, newest first, filtered by type
  (chips, no chip = all) and member. The group logs (filters false) show the group entries only.
  Expects logs; with filters log_types, selected and username.
#}

{% block javascripts %}
    {{ encore_entry_script_tags('member/suggest-fields') }}
{% endblock %}

{% block main %}
<main role="main" class="c-vtools c-logs">
    <div class="container-lg">
        <header class="c-vtools__head">
            <div class="c-vtools__head-main">
                <p class="c-page-head__eyebrow">{{ 'admin.logs.eyebrow'|trans }}</p>
                <h1 class="c-page-head__title">{{ (filters ? 'admin.logs.title' : 'admin.groups.logs')|trans }}</h1>
                <p class="c-vtools__description">{{ 'admin.logs.description'|trans }}</p>
            </div>
        </header>

        <section class="c-logs__card">
            {% if filters %}
                <form class="c-logs__filters" method="get" action="{{ path('admin_logs_overview') }}">
                    {% if log_types|length > 1 %}
                        <div class="c-logs__filter c-logs__filter--types" role="group" aria-labelledby="c-logs-types">
                            <span class="c-logs__label" id="c-logs-types">{{ 'admin.logs.type'|trans }}</span>
                            {# several types can be on; Show logs sends them (the chips show their state themselves, CSS) #}
                            <div class="c-logs__chips">
                                {% for type in log_types %}
                                    <label class="c-logs__chip">
                                        <input type="checkbox" name="log[types][]" value="{{ type }}"{{ type in selected ? ' checked' }}>
                                        <i class="fas fa-check c-logs__chip-check" aria-hidden="true"></i>{{ type }}
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    <div class="c-logs__filter">
                        <label class="c-logs__label" for="c-logs-member">{{ 'admin.logs.member'|trans }}</label>
                        {# picking a suggested member filters by them; part of a name and Enter filters too #}
                        {{ member_suggest.input('log[username]', username, 'c-logs-member', {placeholder: 'admin.logs.member.placeholder'|trans, submit: true, icon: true, class: 'c-logs__member'}) }}
                        <button type="submit" class="c-cadmin-btn c-cadmin-btn--primary c-logs__show"><i class="fas fa-filter" aria-hidden="true"></i>{{ 'admin.logs.show'|trans }}</button>
                        {% if selected is not empty or username != '' %}
                            <a class="c-cadmin__clear" href="{{ path('admin_logs_overview') }}"><i class="fas fa-xmark" aria-hidden="true"></i>{{ 'admin.logs.clear'|trans }}</a>
                        {% endif %}
                        <span class="c-logs__count">{{ 'admin.logs.count'|trans({count: logs.nbResults}) }}</span>
                    </div>
                </form>
            {% endif %}

            {% if logs.nbResults == 0 %}
                <div class="c-cnews-empty">
                    <span class="c-cnews-empty__icon" aria-hidden="true"><i class="fas fa-scroll"></i></span>
                    <p class="c-cnews-empty__title">{{ 'admin.logs.empty.title'|trans }}</p>
                    <p class="c-cnews-empty__text">{{ 'admin.logs.empty.text'|trans }}</p>
                </div>
            {% else %}
                <div class="c-vtools-table c-logs__table">
                    <div class="c-vtools-table__row c-vtools-table__row--head c-logs__row" role="row">
                        <span>{{ 'admin.logs.logged'|trans }}</span>
                        <span>{{ 'admin.logs.type'|trans }}</span>
                        <span>{{ 'admin.logs.message'|trans }}</span>
                        <span>{{ 'admin.logs.member'|trans }}</span>
                    </div>
                    {% for log in logs.currentPageResults %}
                        {% set _type = log.type|lower %}
                        {% set _tone = 'signup' in _type ? ' c-tag--green' : ('group' in _type ? ' c-tag--type' : ('message' in _type or 'right' in _type or 'admin' in _type ? ' c-tag--orange' : '')) %}
                        <div class="c-vtools-table__row c-logs__row">
                            <span class="c-logs__when"><strong>{{ log.created|date('Y-m-d') }}</strong><small>{{ log.created|date('H:i:s') }}</small></span>
                            <span><span class="c-tag{{ _tone }}">{{ log.type }}</span></span>
                            <span class="c-logs__message">{{ log.logMessage|raw }}</span>
                            <span>
                                {% if log.member %}
                                    <a class="c-logs__person" href="{{ path('members_profile', {username: log.member.username}) }}">
                                        <img src="{{ path('avatar', {username: log.member.username, size: 48}) }}" alt="" width="28" height="28" loading="lazy">{{ log.member.username }}
                                    </a>
                                {% else %}
                                    <span class="c-logs__system">{{ 'admin.logs.system'|trans }}</span>
                                {% endif %}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {% if logs.haveToPaginate %}
            <nav class="c-cadmin__pager">{{ pagerfanta(logs, 'rox_default') }}</nav>
        {% endif %}
    </div>
</main>
{% endblock main %}
