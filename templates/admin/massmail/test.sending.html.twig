{% extends 'base.html.twig' %}
{% set inline_notices = true %}

{% block content %}
  {% import 'admin/massmail/_macros.html.twig' as mm %}
  {% form_theme form 'admin/massmail/_form_theme.html.twig' %}
  <div class="c-massmail">
    {% include 'admin/massmail/_flash.html.twig' %}
    <a class="c-page-head__back" href="{{ path('admin_massmail_details', {id: newsletter.id}) }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> {{ newsletter.name }}</a>
    <div class="c-page-head">
      <div class="c-page-head__main">
        <p class="c-page-head__eyebrow">{{ newsletter.name }}</p>
        <h1 class="c-page-head__title">{{ 'admin.massmail.test.title'|trans }}</h1>
      </div>
    </div>

    <div class="c-hint c-hint--inline">
      <span class="c-hint__icon"><i class="fas fa-bolt" aria-hidden="true"></i></span>
      <p class="c-hint__text">{{ 'admin.massmail.test.hint'|trans }}</p>
    </div>

    <section class="c-home-card c-massmail-block">
      {{ form_start(form, {attr: {class: 'c-massmail-test'}}) }}
        {# the input and the button in one row, centred on each other; help and errors below #}
        <div class="o-form-group">
          {{ form_label(form.members) }}
          <div class="c-massmail-test__row">
            {{ form_widget(form.members, {attr: {'aria-describedby': form.members.vars.id ~ '_help'}}) }}
            <button type="submit" class="o-button"><i class="far fa-paper-plane" aria-hidden="true"></i>{{ 'admin.massmail.test.send'|trans }}</button>
          </div>
          {{ form_help(form.members) }}
          {{ form_errors(form.members) }}
        </div>
      {{ form_end(form) }}
    </section>

    <section class="c-home-card">
      <div class="c-card-head">
        <h2 class="c-card-head__title">{{ mm.type_label(newsletter.type) }}</h2>
        <span class="c-card-head__note">{{ 'admin.massmail.test.preview.note'|trans }}</span>
      </div>
      {% include 'admin/massmail/_preview.html.twig' %}
    </section>
  </div>
{% endblock content %}
