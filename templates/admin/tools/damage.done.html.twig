{% extends 'admin/tools/_layout.html.twig' %}
{% import 'admin/tools/_macros.html.twig' as vt %}

{% block tool %}
  {% if damageDone is empty %}
    <p class="c-cadmin__empty c-vtools__empty"><i class="fas fa-circle-check" aria-hidden="true"></i>{{ 'admin.tools.nobody'|trans }}</p>
  {% else %}
    <div class="c-vtools-table">
      <div class="c-vtools-table__row c-vtools-table__row--head c-vtools-damage">
        <span>{{ 'admin.tools.damage_done.spammer'|trans }}</span><span></span><span>{{ 'admin.tools.damage_done.wrote.to'|trans }}</span>
      </div>
      {% for row in damageDone %}
        <div class="c-vtools-table__row c-vtools-damage">
          <span class="c-vtools-damage__side">{{ vt.member(row.Sender) }}{{ vt.status(row.SenderStatus) }}</span>
          <i class="fas fa-arrow-right c-vtools-damage__arrow" aria-hidden="true"></i>
          <span class="c-vtools-damage__side">{{ vt.member(row.Receiver, row.LastUpdated ? 'admin.tools.damage_done.updated'|trans({date: row.LastUpdated|format_datetime('medium', 'short')})) }}{{ vt.status(row.ReceiverStatus) }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock tool %}
