{% extends 'admin/tools/_layout.html.twig' %}
{% import '_partials/member_suggest.html.twig' as member_suggest %}
{#
  Turning all forum notifications of a member on or off (right ManageSubscriptions): the member is searched by
  username (suggestions from member/suggest), then one of the two buttons.
#}

{% block javascripts %}
  {{ encore_entry_script_tags('member/suggest-fields') }}
{% endblock javascripts %}

{% block tool %}
  {{ form_start(form, {attr: {class: 'c-vtools-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}
    {# the buttons beside the field, so the suggestions open over nothing to click #}
    <div class="c-vtools-notifications">
      <div class="o-form-group c-vtools-notifications__field">
        <label class="form-label" for="{{ form.username.vars.id }}">{{ 'label.username'|trans }}</label>
        {{ member_suggest.field(form.username, {placeholder: 'admin.subscriptions.member.placeholder'|trans, icon: true}) }}
        {% if form.username.vars.errors|length > 0 %}
          <ul class="c-massmail-form__errors">
            {% for error in form.username.vars.errors %}<li>{{ error.message|trans }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
      <div class="c-vtools-notifications__actions">
        {{ form_widget(form.enable, {attr: {class: 'c-cadmin-btn c-cadmin-btn--primary'}}) }}
        {{ form_widget(form.disable, {attr: {class: 'c-cadmin-btn c-cadmin-btn--quiet'}}) }}
      </div>
    </div>
  {{ form_end(form) }}
{% endblock tool %}
