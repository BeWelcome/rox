{% extends 'admin/tools/_layout.html.twig' %}
{% import 'admin/tools/_macros.html.twig' as vt %}

{% block javascripts %}
  {{ encore_entry_script_tags('admin/tools/login_message') }}
{% endblock javascripts %}

{% block stylesheets %}
  {{ encore_entry_link_tags('admin/tools/login_message') }}
{% endblock stylesheets %}

{% block tool %}
  <a class="c-vtools-back" href="{{ path('admin_tools_login_messages_show') }}"><i class="fas fa-chevron-left" aria-hidden="true"></i>{{ 'admin.tools.login_messages.all'|trans }}</a>
  {{ form_start(form, {attr: {class: 'c-massmail-form c-vtools-form', novalidate: 'novalidate'}}) }}
    {{ vt.field(form.message) }}
    <div class="c-vtools-form__date">{{ vt.field(form.expires) }}</div>
    <div class="c-massmail-form__actions">
      <button type="submit" class="o-button">{{ 'admin.tools.login_message.publish'|trans }}</button>
      <a class="o-button o-button--outline-gray" href="{{ path('admin_tools_login_messages_show') }}">{{ 'cancel'|trans }}</a>
    </div>
  {{ form_end(form) }}
{% endblock tool %}
