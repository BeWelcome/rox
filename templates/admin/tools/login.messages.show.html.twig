{% extends 'admin/tools/_layout.html.twig' %}

{% block tool %}
  <div class="c-vtools-bar-head">
    <span class="c-vtools__summary">{{ 'admin.tools.login_messages.count'|trans({active: active, expired: login_messages|length - active}) }}</span>
    <a class="c-cadmin-btn c-cadmin-btn--primary c-radmin-assign" href="{{ path('admin_tools_login_message_add') }}"><i class="fas fa-plus" aria-hidden="true"></i>{{ 'admin.tools.login_message_add.title'|trans }}</a>
  </div>
  {% if login_messages is empty %}
    <p class="c-cadmin__empty c-vtools__empty"><i class="fas fa-bullhorn" aria-hidden="true"></i>{{ 'admin.tools.login_messages.none'|trans }}</p>
  {% else %}
    <ul class="c-vtools-list">
      {% for message in login_messages %}
        {% set _active = message.expires > now %}
        <li class="c-vtools-list__row c-vtools-login{{ _active ? '' : ' is-expired' }}">
          <div class="c-vtools-login__main">
            <p class="c-vtools-login__meta">
              <span class="c-tag{{ _active ? ' c-tag--green' }}">{{ (_active ? 'admin.tools.login_messages.active' : 'admin.tools.login_messages.expired')|trans }}</span>
              {{ (_active ? 'admin.tools.login_messages.until' : 'admin.tools.login_messages.ended')|trans({date: message.expires|format_date('medium')}) }}
            </p>
            <div class="c-vtools-login__text">{{ message.message|purify }}</div>
          </div>
          {% if _active %}
            <form method="post" action="{{ path('admin_tools_login_message_expire', {id: message.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\Admin\\VolunteerToolController::LOGIN_MESSAGE_TOKEN')) }}">
              <button type="submit" class="c-cadmin-btn c-cadmin-btn--quiet c-vtools-login__expire"><i class="fas fa-xmark" aria-hidden="true"></i>{{ 'admin.tools.login_messages.expire'|trans }}</button>
            </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endblock tool %}
