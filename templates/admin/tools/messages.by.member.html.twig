{% extends 'admin/tools/_layout.html.twig' %}
{% import 'admin/tools/_macros.html.twig' as vt %}
{#
  results: per correspondent the kinds (type: 1 message, 2 invitation, 4 stay request) and the direction (1 received,
  2 sent) with the last of each (Admin\VolunteerToolController::correspondents).
#}
{% set _kinds = {1: ['envelope', 'admin.tools.messages_by_member.message'], 4: ['house-user', 'admin.tools.messages_by_member.request'], 2: ['route', 'admin.tools.messages_by_member.invitation']} %}

{% block javascripts %}
  {{ encore_entry_script_tags('member/autocomplete') }}
{% endblock javascripts %}

{% block stylesheets %}
  {{ encore_entry_link_tags('member/autocomplete') }}
{% endblock stylesheets %}

{% block tool %}
  {{ form_start(form, {attr: {class: 'c-vtools-search', novalidate: 'novalidate'}}) }}
    {{ form_widget(form.username, {attr: form.username.vars.attr|merge({class: 'o-input member-autocomplete', 'aria-label': 'admin.tools.username'|trans, placeholder: 'admin.tools.username'|trans})}) }}
    <button type="submit" class="c-cadmin-btn c-cadmin-btn--primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i>{{ 'admin.tools.messages_by_member.look.up'|trans }}</button>
  {{ form_end(form) }}
  {% for error in form.username.vars.errors %}<p class="c-massmail-form__errors">{{ error.message|trans }}</p>{% endfor %}

  {% if member %}
    <div class="c-vtools-mbm__head">
      {{ vt.member(member.username, 'admin.tools.messages_by_member.count'|trans({count: results|length})) }}
      <span class="c-vtools-mbm__legend">
        {% for kind in _kinds %}<span><i class="fas fa-{{ kind[0] }}" aria-hidden="true"></i>{{ kind[1]|trans }}</span>{% endfor %}
      </span>
    </div>
    {% if results is empty %}
      <p class="c-cadmin__empty c-vtools__empty"><i class="fas fa-inbox" aria-hidden="true"></i>{{ 'admin.tools.messages_by_member.none'|trans }}</p>
    {% else %}
      <ul class="c-vtools-list">
        {% for result in results %}
          {% set _dates = [
            result.direction b-and 1 and result.last_received ? 'admin.tools.messages_by_member.received'|trans({date: result.last_received|format_datetime('medium', 'short')}),
            result.direction b-and 2 and result.last_sent ? 'admin.tools.messages_by_member.sent'|trans({date: result.last_sent|format_datetime('medium', 'short')}),
          ]|filter(v => v)|join(' · ') %}
          <li class="c-vtools-list__row c-vtools-mbm">
            <span class="c-vtools-mbm__kinds">
              {% for bit, kind in _kinds %}{% if result.type b-and bit %}<i class="fas fa-{{ kind[0] }}" title="{{ kind[1]|trans }}" aria-label="{{ kind[1]|trans }}"></i>{% endif %}{% endfor %}
            </span>
            <span class="c-vtools-mbm__direction" aria-hidden="true">
              <i class="fas fa-arrow-left{{ result.direction b-and 1 ? '' : ' is-off' }}"></i>
              <i class="fas fa-arrow-right{{ result.direction b-and 2 ? '' : ' is-off' }}"></i>
            </span>
            {{ vt.member(result.username, _dates) }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endif %}
{% endblock tool %}
