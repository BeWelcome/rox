{% extends 'admin/tools/_layout.html.twig' %}
{% import 'admin/tools/_macros.html.twig' as vt %}

{% block tool %}
  {% if messagesSent is empty %}
    <p class="c-cadmin__empty c-vtools__empty"><i class="fas fa-circle-check" aria-hidden="true"></i>{{ 'admin.tools.nobody'|trans }}</p>
  {% else %}
    <div class="c-vtools-table">
      <div class="c-vtools-table__row c-vtools-table__row--head c-vtools-spammers">
        <span>{{ 'admin.tools.member'|trans }}</span><span>{{ 'admin.tools.status'|trans }}</span><span>{{ 'admin.tools.updated'|trans }}</span><span class="u:text-right">{{ 'admin.tools.messages_sent.unit'|trans }}</span>
      </div>
      {% for spammer in messagesSent %}
        <div class="c-vtools-table__row c-vtools-spammers">
          {{ vt.member(spammer.Username) }}
          <span>{{ vt.status(spammer.Status) }}</span>
          <span class="c-radmin-muted">{{ spammer.Updated ? spammer.Updated|format_datetime('medium', 'short') }}</span>
          <span class="c-vtools-ranked__count">{{ spammer.MessagesSent|format_number }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock tool %}
