{% extends 'admin/tools/_layout.html.twig' %}

{% block tool %}
  {% if results.nbResults == 0 %}
    <p class="c-cadmin__empty c-vtools__empty"><i class="fas fa-images" aria-hidden="true"></i>{{ 'admin.tools.uploaded_images.none'|trans }}</p>
  {% else %}
    <ul class="c-vtools-images">
      {% for image in results %}
        {% set _src = path('gallery_uploaded_ckeditor', {id: image.id, fileInfo: image.fileInfo}) %}
        <li class="c-vtools-image">
          <a href="{{ _src }}" target="_blank" rel="noopener"><img class="c-vtools-image__img" src="{{ _src }}" alt="{{ image.filename }}" loading="lazy"></a>
          <span class="c-vtools-image__name">{{ image.filename }}</span>
          <span class="c-vtools-image__meta">{{ image.created|format_datetime('medium', 'short') }} · {{ image.width }} × {{ image.height }}</span>
        </li>
      {% endfor %}
    </ul>
    {% if results.haveToPaginate %}
      <div class="c-cadmin__pager">{{ pagerfanta(results, 'rox_default', {routeName: 'admin_tools_uploaded_images'}) }}</div>
    {% endif %}
  {% endif %}
{% endblock tool %}
