{% extends 'admin/translations/tool/_layout.html.twig' %}
{#
  Mails and pages of each feature, to preview with test data in the site's language: the features on the left, the
  chosen one's previews as cards. Previews with variants (parameters) have a link per variant.
  locale, languageMenu, features ({name, count}), feature (the open one), provider (its MockupProvider).
#}
{% set tab = 'mockups' %}

{% block tool %}
    <p class="p-tr-intro">{{ 'translation.tool.mockups.intro'|trans({language: language_name_translated(app.request.locale, app.request.locale)}) }}</p>
    <div class="p-tr-mockups">
        <nav class="p-tr-features" aria-label="{{ 'translation.tool.tab.mockups'|trans }}">
            {% for item in features %}
                <a class="p-tr-features__item{{ item.name == feature ? ' is-active' }}" href="{{ path('translations_mockups_feature', {feature: item.name}) }}"{{ item.name == feature ? ' aria-current="page"' }}>
                    <span>{{ item.name|humanize }}</span>
                    <span class="p-tr-features__count">{{ 'translation.tool.mockups.count'|trans({count: item.count}) }}</span>
                </a>
            {% endfor %}
        </nav>

        <section class="p-tr-feature">
            <h2 class="p-tr-feature__title">{{ feature|humanize }}</h2>
            <div class="p-tr-previews">
                {% for name, mockup in provider.mockups %}
                    {% set _type = mockup.type == 'email' ? 'mail' : (mockup.type == 'template' ? 'template' : 'page') %}
                    <article class="p-tr-preview">
                        <div class="p-tr-preview__icon" aria-hidden="true">
                            <i class="{{ {mail: 'far fa-envelope', template: 'far fa-file', page: 'fas fa-globe'}[_type] }}"></i>
                        </div>
                        <div class="p-tr-preview__body">
                            <span class="p-tr-format">{{ ('translation.tool.mockups.type.' ~ _type)|trans }}</span>
                            <h3 class="p-tr-preview__title">{{ name|capitalize }}</h3>
                            <div class="p-tr-preview__actions">
                                {% if mockup.with_parameters is defined and mockup.with_parameters == true %}
                                    {% for parameter_name, parameter in provider.mockupParameter(app.request.locale, name) %}
                                        {% for key, value in parameter %}
                                            <a class="p-tr-button" href="{{ path('translation_mockup', {feature: feature, name: name, (parameter_name): value}) }}">{{ parameter_name|capitalize }}: {{ key }}</a>
                                        {% endfor %}
                                    {% endfor %}
                                {% else %}
                                    <a class="p-tr-button" href="{{ path('translation_mockup', {feature: feature, name: name}) }}">{{ 'translation.tool.mockups.preview'|trans }}</a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock tool %}
