{% extends 'base.html.twig' %}
{% import 'donation/_macros.html.twig' as money %}
{% import 'macros/post_button.html.twig' as post %}
{% set inline_notices = true %}

{% block title %}{{ 'admin.treasurer.overview'|trans }}{% endblock %}

{% block content %}
  {% set running = params and params.toggledonatebar %}
  {% set yearPercent = money.percent(stats.YearDonation, stats.YearNeededAmount)|trim %}
  {# The current quarter: its first and last month #}
  {% set quarterStart = (('now'|date('n') - 1) // 3) * 3 + 1 %}
  {% set quarterMonths = (('now'|date('Y') ~ '-' ~ quarterStart ~ '-01')|format_date(pattern: 'MMM'))
      ~ ' – ' ~ (('now'|date('Y') ~ '-' ~ (quarterStart + 2) ~ '-01')|format_date(pattern: 'MMM')) %}
  <div class="c-donate c-treasurer">
    {% include 'admin/massmail/_flash.html.twig' %}
    <div class="c-page-head">
      <div class="c-page-head__main">
        <p class="c-page-head__eyebrow">{{ 'admin.treasurer.eyebrow'|trans }}</p>
        <h1 class="c-page-head__title">{{ 'admin.treasurer.overview'|trans }}</h1>
      </div>
      <div class="c-page-head__actions">
        <a class="o-button o-button--outline" href="{{ path('donations_list') }}"><i class="fas fa-list" aria-hidden="true"></i>{{ 'admin.treasurer.public.list'|trans }}</a>
        <a class="o-button" href="{{ path('admin_treasurer_donation_add') }}"><i class="fas fa-plus" aria-hidden="true"></i>{{ 'admin.treasurer.donation.add'|trans }}</a>
      </div>
    </div>

    <section class="c-donate-status">
      <div class="c-donate-steps">
        <div class="c-donate-step">
          <span class="c-donate-step__label">{{ 'admin.treasurer.campaign'|trans }}</span>
          {% if running %}
            <span class="c-treasurer-state c-treasurer-state--running">{{ 'admin.treasurer.campaign.running'|trans }}</span>
            <span class="c-donate-step__note">{{ 'admin.treasurer.campaign.running.note'|trans({date: params.campaignstartdate|format_date('medium')}) }}</span>
          {% else %}
            <span class="c-treasurer-state">{{ 'admin.treasurer.campaign.stopped.state'|trans }}</span>
            <span class="c-donate-step__note">{{ 'admin.treasurer.campaign.stopped.note'|trans }}</span>
          {% endif %}
        </div>
        <div class="c-donate-step">
          <span class="c-donate-step__label">{{ 'admin.treasurer.this.year'|trans }}</span>
          <span><span class="c-donate-step__value">{{ money.euros(stats.YearDonation) }}</span>
            <span class="c-donate-step__note">{{ 'admin.treasurer.of'|trans({amount: money.euros(stats.YearNeededAmount)|trim}) }}</span></span>
          <div class="c-donate-bar c-donate-bar--small"><div class="c-donate-bar__fill" style="width: {{ yearPercent }}%"></div></div>
          <span class="c-donate-step__note">{{ 'admin.treasurer.year.percent'|trans({percent: yearPercent}) }}</span>
        </div>
        <div class="c-donate-step">
          {% set quarterPercent = money.percent(stats.QuarterDonation ?? 0, stats.QuarterNeededAmount ?? 0)|trim %}
          <span class="c-donate-step__label">{{ 'admin.treasurer.this.quarter'|trans }}</span>
          <span><span class="c-donate-step__value">{{ money.euros(stats.QuarterDonation ?? 0) }}</span>
            <span class="c-donate-step__note">{{ 'admin.treasurer.of'|trans({amount: money.euros(stats.QuarterNeededAmount ?? 0)|trim}) }}</span></span>
          <div class="c-donate-bar c-donate-bar--small"><div class="c-donate-bar__fill" style="width: {{ quarterPercent }}%"></div></div>
          <span class="c-donate-step__note">{{ 'admin.treasurer.quarter.percent'|trans({percent: quarterPercent, months: quarterMonths}) }}</span>
        </div>
      </div>
      <div class="c-donate-next">
        {% if running %}
          <span class="c-donate-next__icon"><i class="fas fa-bullhorn" aria-hidden="true"></i></span>
          <p class="c-donate-next__text">{{ 'admin.treasurer.campaign.running.hint'|trans({amount: money.euros(stats.YearNeededAmount)|trim}) }}</p>
          <div class="c-donate-next__actions">
            {% set stopLabel %}<i class="fas fa-hand" aria-hidden="true"></i>{{ 'admin.treasurer.campaign.stop'|trans }}{% endset %}
            {{ post.post_link(path('admin_treasurer_campaign_stop'), 'treasurer_campaign_stop', 'c-btn-danger', stopLabel) }}
          </div>
        {% else %}
          <span class="c-donate-next__icon"><i class="fas fa-bullhorn" aria-hidden="true"></i></span>
          <p class="c-donate-next__text">{{ 'admin.treasurer.campaign.stopped.hint'|trans }}</p>
          <div class="c-donate-next__actions">
            <a class="o-button" href="{{ path('admin_treasurer_campaign_start') }}"><i class="fas fa-play" aria-hidden="true"></i>{{ 'admin.treasurer.campaign.start'|trans }}</a>
          </div>
        {% endif %}
      </div>
    </section>

    <section class="c-home-card">
      <div class="c-card-head">
        <h2 class="c-card-head__title">{{ 'admin.treasurer.donations'|trans }}</h2>
        <span class="c-card-head__note">{{ 'admin.treasurer.donations.note'|trans({count: donations.maxPerPage}) }}</span>
      </div>
      {% if donations.nbResults == 0 %}
        <p class="c-donate-table__empty">{{ 'admin.treasurer.no.donations'|trans }}</p>
      {% else %}
        <div class="c-donate-table">
          <div class="c-donate-table__rows c-donate-table__rows--admin">
            <div class="c-donate-table__row c-donate-table__row--head">
              <span>{{ 'admin.treasurer.donation.date'|trans }}</span>
              <span>{{ 'admin.treasurer.donation.donor'|trans }}</span>
              <span class="c-donate-table__amount">{{ 'admin.treasurer.donation.amount'|trans }}</span>
              <span>{{ 'admin.treasurer.donation.country'|trans }}</span>
              <span>{{ 'admin.treasurer.donation.comment'|trans }}</span>
              <span class="visually-hidden">{{ 'edit'|trans }}</span>
            </div>
            {% for donation in donations.currentPageResults %}
              <div class="c-donate-table__row c-donate-table__row--hover">
                <span class="c-donate-table__date">{{ donation.created|format_date('medium') }}</span>
                <span class="c-donate-table__text">
                  {% if donation.donor %}
                    <a class="c-treasurer__member" href="{{ path('members_profile', {username: donation.donor.username}) }}">{{ donation.donor.username }}</a>
                  {% elseif donation.nameGiven %}
                    <span class="c-donate-table__name">{{ donation.nameGiven }}</span>
                    <span class="c-treasurer-pill">{{ 'admin.treasurer.donor.type.other'|trans }}</span>
                  {% else %}
                    <span class="c-treasurer__unknown">{{ 'admin.treasurer.donor.type.unknown'|trans }}</span>
                  {% endif %}
                </span>
                <span class="c-donate-table__amount">{{ money.amount(donation) }}</span>
                <span class="c-donate-table__text">{{ money.country(donation) }}</span>
                <span class="c-donate-table__text">{{ donation.systemComment ?: '—' }}</span>
                <a class="c-radmin-icon" href="{{ path('admin_treasurer_donation_edit', {id: donation.id}) }}"
                   title="{{ 'admin.treasurer.donation.edit'|trans }}" aria-label="{{ 'admin.treasurer.donation.edit'|trans }}"><i class="fas fa-pen" aria-hidden="true"></i></a>
              </div>
            {% endfor %}
          </div>
        </div>
        {% if donations.haveToPaginate %}
          <div class="c-donate-table__footer c-donate-table__footer--end">
            {{ pagerfanta(donations, 'rox_default') }}
          </div>
        {% endif %}
      {% endif %}
    </section>
  </div>
{% endblock content %}
