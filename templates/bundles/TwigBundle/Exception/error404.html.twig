{# templates/bundles/TwigBundle/Exception/error404.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
    <h1>{{ 'error.page.not.found'|trans }}</h1>

    {% if app.user %}
        <p>{{ 'error.greeting'|trans({username: app.user.Username}) }}<p>
        <p>{{ 'error.404'|trans({'url': app.request.pathInfo }) }}</p>
    {% else %}
        <p>{{ 'error.404'|trans({'url': app.request.pathInfo }) }}</p>
    {% endif %}
    <p>
        <br><a href="{{ url('homepage') }}">{{ 'error.return.home'|trans }}</a>
    </p>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Plausible 404 goal (#540): which paths are broken. #}
    <script>window.plausible && plausible('404', {props: {path: document.location.pathname}})</script>
{% endblock javascripts %}
