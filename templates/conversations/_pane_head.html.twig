{#
  Top of the conversation pane: avatar, subject, correspondent and, on the view page,
  the report and delete actions. Expects current, correspondent, subject, linked,
  is_spam, show_deleted, back_url and show_actions. meta (optional) is shown after the
  username, e.g. where the member lives.
#}
{% import 'macros/post_button.html.twig' as post %}
{% set token = constant('App\\Controller\\ConversationController::TOKEN') %}
<header class="c-inbox-head">
    <a class="c-inbox-head__back{{ show_actions ? '' : ' is-always' }}" href="{{ back_url }}">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
        <span class="visually-hidden">{{ 'back'|trans }}</span>
    </a>
    {# The person first: face with the hosting ring (as on the home page), name, positive comments, where they live and the subject #}
    {% set hosting = correspondent.accommodation == constant('App\\Doctrine\\AccommodationType::YES') %}
    <img class="c-inbox-avatar c-inbox-avatar--l c-inbox-head__avatar{{ hosting ? ' is-hosting' : '' }}" src="{{ path('avatar', { username: correspondent.username, size: 72 }) }}" alt="" loading="lazy">
    <div class="c-inbox-head__who">
        <div class="c-inbox-head__line">
            {% if linked %}
                <a class="c-inbox-head__name" href="{{ path('members_profile', { username: correspondent.username }) }}">{{ correspondent.username }}</a>
            {% else %}
                <span class="c-inbox-head__name">{{ correspondent.username }}</span>
            {% endif %}
            {% set positive = member_positive_comments(correspondent) %}
            {% if positive > 0 %}
                <span class="c-inbox-head__refs"><i class="fas fa-thumbs-up" aria-hidden="true"></i> {{ positive }}<span class="visually-hidden"> {{ 'comment.quality.positive'|trans }}</span></span>
            {% endif %}
        </div>
        {% if meta is not defined %}
            {% set _address = correspondent.activeAddress %}
            {% set meta = (_address and _address.location) ? _address.location.name ~ (_address.location.country ? ', ' ~ _address.location.country.name : '') : '' %}
        {% endif %}
        <h1 class="c-inbox-head__subject">
            {%- if meta -%}<span class="c-inbox-head__meta">{{ meta }} · </span>{%- endif -%}
            {{ subject|striptags }}
        </h1>
    </div>

    {% if show_actions %}
    <div class="c-inbox-head__actions">
        {% if is_spam %}
            {% set content %}<i class="far fa-flag" aria-hidden="true"></i><span>{{ 'marknospam'|trans }}</span>{% endset %}
            {{ post.post_link(path('conversation_mark_nospam', { id: current.id }), token, 'c-inbox-head__report', content) }}
        {% else %}
            <button type="button" class="c-inbox-head__report js-modal-trigger" data-micromodal-trigger="report-modal" aria-label="{{ 'markspam'|trans }}">
                <i class="far fa-flag" aria-hidden="true"></i><span>{{ 'conversation.report.short'|trans }}</span>
            </button>
        {% endif %}
        {% if show_deleted %}
            {% set content %}<i class="fas fa-inbox" aria-hidden="true"></i><span class="visually-hidden">{{ 'recover'|trans }}</span>{% endset %}
            {{ post.post_link(path('conversation_recover', { id: current.id }), token, 'c-inbox-head__icon', content) }}
        {% else %}
            {% set content %}<i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden">{{ 'delete'|trans }}</span>{% endset %}
            {{ post.post_link(path('conversation_delete', { id: current.id }), token, 'c-inbox-head__icon', content) }}
        {% endif %}
    </div>

    <details class="c-inbox-head__menu">
        <summary class="c-inbox-head__icon" aria-label="{{ 'edit'|trans }}">
            <i class="fas fa-ellipsis-h" aria-hidden="true"></i>
        </summary>
        <div class="c-inbox-head__menu-list">
            {% if is_spam %}
                {% set content %}<i class="far fa-flag fa-fw" aria-hidden="true"></i> {{ 'marknospam'|trans }}{% endset %}
                {{ post.post_link(path('conversation_mark_nospam', { id: current.id }), token, '', content) }}
            {% else %}
                <button type="button" class="js-modal-trigger" data-micromodal-trigger="report-modal"><i class="far fa-flag fa-fw" aria-hidden="true"></i> {{ 'markspam'|trans }}</button>
            {% endif %}
            {% if show_deleted %}
                {% set content %}<i class="fas fa-inbox fa-fw" aria-hidden="true"></i> {{ 'recover'|trans }}{% endset %}
                {{ post.post_link(path('conversation_recover', { id: current.id }), token, '', content) }}
            {% else %}
                {% set content %}<i class="fas fa-trash-alt fa-fw" aria-hidden="true"></i> {{ 'delete'|trans }}{% endset %}
                {{ post.post_link(path('conversation_delete', { id: current.id }), token, 'is-danger', content) }}
            {% endif %}
        </div>
    </details>
    {% endif %}
</header>
