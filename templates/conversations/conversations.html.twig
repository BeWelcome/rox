{% extends 'base.html.twig' %}
{% set inbox_page = true %}
{% import 'conversations/_inbox.macros.twig' as inbox %}

{% set hide_sidebar = true %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('conversations') }}
{% endblock %}

{% block title %}
    {{ 'conversations' | trans }}
{% endblock title %}

{% block content %}
    <div class="c-inbox c-inbox--list">
        {{ inbox.nav(submenu.active, 'column') }}

        <section class="c-inbox__list">
            {{ form_start(form, { attr: { class: 'c-inbox-list js-inbox-form' } }) }}
                {{ inbox.list(conversations, submenu.active, {
                    form: form,
                    initiator: initiator,
                    unreadOnly: showUnreadOnly,
                }) }}
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </section>

        <section class="c-inbox__pane c-inbox__pane--empty" aria-hidden="true">
            <i class="fas fa-comments" aria-hidden="true"></i>
            <p>{{ 'conversations.pick'|trans }}</p>
        </section>
    </div>
{% endblock %}
