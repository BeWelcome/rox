{# A message as a chat bubble. html: the message, purified by the caller; time: when it was written (optional). #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 20px;"><tr><td style="padding:14px 18px 10px;background:#f1f5f9;border-radius:18px 18px 18px 6px;font-family:Helvetica, Arial, sans-serif;font-size:16px;line-height:24px;color:#0f172a;mso-line-height-rule:exactly;">{{ html|raw }}{% if time is defined and time %}<div style="margin-top:4px;font-size:12px;line-height:16px;color:#94a3b8;text-align:right;">{{ time }}</div>{% endif %}</td></tr></table>
