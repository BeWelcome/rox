{# A code to copy (the confirmation key). Long codes wrap within the card. code #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 6px;border-collapse:separate;"><tr><td style="padding:12px 20px;background:#fff4ea;border:1px dashed #fdba74;border-radius:12px;font-family:'Courier New', monospace;font-size:{{ code|length > 16 ? '16px' : '22px' }};line-height:26px;font-weight:bold;letter-spacing:{{ code|length > 16 ? '1px' : '3px' }};color:#c2410c;word-break:break-all;">{{ code }}</td></tr></table>
