{# Links as rows. items: [{ label, url, sub (a line under the label, optional) }] #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 18px;">
{% for item in items %}
<tr><td style="padding:0 0 8px;"><a href="{{ item.url }}" style="display:block;padding:12px 16px;background:#f8fafc;border-radius:12px;font-family:Helvetica, Arial, sans-serif;font-size:15px;line-height:20px;font-weight:bold;color:#0f172a;text-decoration:none;">{{ item.label }}{% if item.sub is defined and item.sub %}<span style="display:block;font-weight:normal;font-size:13px;color:#64748b;">{{ item.sub }}</span>{% endif %}</a></td></tr>
{% endfor %}
</table>
