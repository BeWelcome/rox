{% extends 'emails/base.html.twig' %}
{#
  members:remind:login: a member who hasn't logged in for a year. The links carry the campaign, so the analytics
  count the visits it brings. receiver.
#}
{% set utm_campaign = 'login_reminder' %}
{% set utm_source = 'reminder' %}

{% block preheader %}{{ 'email.login.reminder.subject'|trans }}{% endblock %}

{% block content %}
    {% include 'emails/_partials/eyebrow.html.twig' with { text: 'email.account'|trans } %}
    {% include 'emails/_partials/title.html.twig' with { text: 'email.login.reminder.subject'|trans } %}
    {% include 'emails/_partials/text.html.twig' with { html: 'email.login.reminder.body'|trans({ username: receiver.username, gender: receiver.gender })|purify, div: true } %}
    {% include 'emails/_partials/buttons.html.twig' with {
        primary: { label: 'indexpageloginsubmit'|trans, url: url('login') },
    } %}
{% endblock content %}
