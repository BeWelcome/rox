{% extends 'emails/base.html.twig' %}
{#
  To the volunteers who approve groups (English only): a member created a group. group, member.
#}
{% block preheader %}A new group "{{ group.name }}" needs approval{% endblock %}

{% block content %}
    {% include 'emails/_partials/eyebrow.html.twig' with { text: 'For volunteers', tone: 'volunteer' } %}
    {% include 'emails/_partials/title.html.twig' with { text: 'A new group needs approval' } %}
    {% include 'emails/_partials/sender.html.twig' with { of_group: group, meta: 'Created by ' ~ member.username } %}
    {% for locale, description in group.descriptions %}
        {% include 'emails/_partials/box.html.twig' with { html: '<span style="font-size:13px;color:#64748b;">' ~ description.Language.WordCode|trans|e ~ ' (' ~ locale|e ~ ')</span><br>' ~ description.Sentence|purify } %}
    {% endfor %}
    {% include 'emails/_partials/buttons.html.twig' with {
        primary: { label: 'Open group approval', url: url('admin_groups_approval') },
    } %}
{% endblock content %}
