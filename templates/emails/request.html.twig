{% extends 'emails/base.html.twig' %}
{#
  A hosting request, to the host: who would like to stay, the stay, the guest's message; reply, the guest's profile,
  report the request.
  sender (the guest), message (the request's first message), request (its HostingRequest), receiverLocale.
#}
{% set _locale = receiverLocale ?? 'en' %}
{% set _nights = date(request.departure|date('Y-m-d')).diff(date(request.arrival|date('Y-m-d'))).days %}
{% set _address = sender.activeAddress %}
{% set _place = _address and _address.location ? _address.location.name ~ (_address.location.country ? ', ' ~ _address.location.country.name) : '' %}
{% set _since = 'profile.member.for'|trans({ duration: sender.created.copy().locale(_locale|replace({'-': '_'})).diffForHumans({ syntax: 1 }) }) %}

{% block preheader -%}
    {{ 'request.card.title'|trans }}: {{ request.arrival|format_date(pattern='d MMM', locale=_locale) }} – {{ request.departure|format_date(pattern='d MMM', locale=_locale) }} · {{ 'contact.trip.nights'|trans({ count: _nights }) }} · {{ 'request.card.persons'|trans({ count: request.numberOfTravellers }) }}
{%- endblock %}

{% block content %}
    {% include 'emails/_partials/eyebrow.html.twig' with { text: 'request.card.title'|trans } %}
    {% include 'emails/_partials/title.html.twig' with {
        text: 'email.request.stay'|trans({ '%username%': sender.username, 'gender': sender.gender })|trim('.', 'right'),
    } %}
    {% include 'emails/_partials/sender.html.twig' with {
        member: sender,
        meta: [_place, _since]|filter(part => part)|join(' · '),
        references: member_comments_by_quality(sender)[constant('App\\Doctrine\\CommentQualityType::POSITIVE')] ?? 0,
    } %}
    {% include 'emails/_partials/stay.html.twig' with { request: request } %}
    {% include 'emails/_partials/bubble.html.twig' with {
        html: message.message|purify('custom'),
        time: message.created ? message.created|format_datetime(pattern='d MMM, HH:mm', locale=_locale) : null,
    } %}
    {% include 'emails/_partials/buttons.html.twig' with {
        primary: { label: 'reply'|trans, url: url('conversation_reply', { id: message.id }) },
        secondary: { label: 'message.profile'|trans({ username: sender.username }), url: url('members_profile', { username: sender.username }) },
    } %}
    {% include 'emails/_partials/small_links.html.twig' with {
        links: [{ label: 'message.report'|trans, url: url('conversation_report_spam', { id: message.id }) }],
    } %}
{% endblock content %}
