{% extends 'emails/base.html.twig' %}
{#
  Someone asked to reset the member's password: the button to choose a new one, and what to do otherwise.
  receiver, token.
#}
{% block preheader %}{{ 'email.password.request'|trans }}{% endblock %}

{% block content %}
    {% include 'emails/_partials/eyebrow.html.twig' with { text: 'email.account'|trans } %}
    {% include 'emails/_partials/title.html.twig' with { text: 'reset.password.subject'|trans } %}
    {% include 'emails/_partials/text.html.twig' with { html: 'email.password.request'|trans|e } %}
    {% include 'emails/_partials/buttons.html.twig' with {
        primary: { label: 'email.password.reset'|trans, url: url('member_reset_password', { username: receiver.username, token: token }) },
    } %}
    {% include 'emails/_partials/text.html.twig' with {
        html: 'email.password.request.ignore'|trans({ '%link_start%': '<a href="' ~ url('feedback') ~ '" style="color:#c2410c;font-weight:bold;text-decoration:none;">', '%link_end%': '</a>' }),
        muted: true,
    } %}
{% endblock content %}
