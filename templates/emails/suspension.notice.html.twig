{% extends 'emails/email_no_greeting.html.twig' %}

{#
  members:suspend:notification: a member who didn't come back despite the reminders. The links carry the
  campaign, so the analytics count the visits it brings.
#}
{% block content %}
    {% apply utm_links('suspension_notice', 'reminder') %}
        {{ 'email.suspension.notice.body'|trans({username: receiver.username, gender: receiver.gender, deletion_date: deletion_date})|purify }}
    {% endapply %}
{% endblock %}
