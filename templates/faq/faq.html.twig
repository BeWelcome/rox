{% extends 'about/layout.html.twig' %}
{#
  The FAQ (FaqController) in the About pages' frame, the categories as pills above the card: the questions of one
  category, each opening its answer (a <details>, so it works without JavaScript); a link to #question12 opens that
  one. The questions and answers are translations (faqq_… and faqa_…) with their own paragraphs. A box at the end
  leads to the contact form. Expects submenu, faqCategories, faqCategory and faqs.
#}

{% block title %}{{ 'aboutfaq'|trans }}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('faq') }}
{% endblock javascripts %}

{% block page_title %}{{ 'aboutfaq'|trans }}{% endblock %}
{% block page_lead %}{{ 'faq.lead'|trans }}{% endblock %}

{% block page_head %}
    <nav class="p-about__pills" aria-label="{{ 'faq.categories'|trans }}">
        {% for category in faqCategories %}
            {% set _active = category.id == faqCategory.id %}
            <a class="c-pill{{ _active ? ' is-active' }}" href="{{ path('faqs_overview', {category: category.id}) }}"{% if _active %} aria-current="page"{% endif %}>{{ category.description|lower|trans }}</a>
        {% endfor %}
    </nav>
{% endblock page_head %}

{% block about_body %}
    <article class="p-about__card p-faq">
        <h2 class="p-faq__title">{{ faqCategory.description|lower|trans }}</h2>
        {% for faq in faqs %}
            <details class="p-faq__item" id="question{{ faq.id }}">
                <summary>
                    <span>{{ ('faqq_' ~ faq.QandA)|lower|trans|striptags|trim }}</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="p-faq__answer">{{ ('faqa_' ~ faq.QandA)|lower|trans|purify }}</div>
            </details>
        {% else %}
            <p class="p-faq__empty">{{ 'faqs.none'|trans }}</p>
        {% endfor %}

        <section class="p-faq__help">
            <div>
                <h2>{{ 'faq.more.title'|trans }}</h2>
                <p>{{ 'faq.more.text'|trans }}</p>
            </div>
            <a class="o-button o-button--outline" href="{{ path('contactus') }}"><i class="fas fa-envelope" aria-hidden="true"></i>{{ 'contactus'|trans }}</a>
        </section>
    </article>
{% endblock about_body %}
