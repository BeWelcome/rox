{% extends 'about/layout.html.twig' %}
{#
  The FAQ (FaqController) in the About pages' frame, the categories in the About menu: the questions of one category,
  each opening its answer (a <details>, so it works without JavaScript); a link to #question12 opens that one. The
  questions and answers are translations (faqq_… and faqa_…) with their own paragraphs. A box at the end leads to the
  contact form. Expects submenu, faqCategory and faqs.
#}

{% block title %}{{ 'aboutfaq'|trans }}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('faq') }}
{% endblock javascripts %}

{% block content %}
    <div class="p-faq">
        <h1>{{ 'aboutfaq'|trans }}</h1>
        <h2 class="p-faq__title">{{ faqCategory.description|lower|trans }}</h2>
        {% for faq in faqs %}
            <details class="p-faq__item" id="question{{ faq.id }}">
                <summary>
                    <span>{{ ('faqq_' ~ faq.QandA)|lower|trans|striptags|trim }}</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="p-faq__answer">{{ ('faqa_' ~ faq.QandA)|lower|trans|purify }}</div>
            </details>
        {% else %}
            <p class="p-faq__empty">{{ 'faqs.none'|trans }}</p>
        {% endfor %}

        <section class="p-faq__help">
            <div>
                <h2>{{ 'faq.more.title'|trans }}</h2>
                <p>{{ 'faq.more.text'|trans }}</p>
            </div>
            <a class="c-cadmin-btn c-cadmin-btn--quiet c-cnews-btn-small" href="{{ path('contactus') }}"><i class="fas fa-envelope" aria-hidden="true"></i>{{ 'contactus'|trans }}</a>
        </section>
    </div>
{% endblock content %}
