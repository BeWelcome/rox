{#
  The head of the forum pages: the title, a button to start a topic, and the forum's tabs (recent posts of all
  groups, the agora, the member's subscriptions, the rules and, for the moderators, the reports).
  active: the tab of the page, if any.
  newTopicUrl: where the button starts a topic, if the member may.
  tabsOnly: just the tabs, on a page with its own title (an agora thread).
#}
{% set moderator = is_granted('ROLE_ADMIN_FORUMMODERATOR') or is_granted('ROLE_ADMIN_ADMIN') %}
<header class="p-forum__head">
    {% if not tabsOnly|default(false) %}
    <div class="p-forum__top">
        <h1 class="p-forum__title">{{ 'forum'|trans }}</h1>
        {% if newTopicUrl|default(null) %}
            <a class="p-forum__new" href="{{ newTopicUrl }}"><i class="fa fa-plus" aria-hidden="true"></i> {{ 'forumnewtopic'|trans }}</a>
        {% endif %}
    </div>
    {% endif %}
    <nav class="p-forum__tabs" aria-label="{{ 'forum'|trans }}">
        {% set tabs = {
            forums: {url: path('forums'), label: 'forumrecentposts'},
            agora: {url: path('group_forum', {group_id: constant('App\\Entity\\Group::BEWELCOME')}), label: 'agoraforum'},
            subscriptions: {url: path('subscriptions'), label: 'forumsubscriptions'},
            rules: {url: path('forum_rules'), label: 'forumrulesshort'},
        } %}
        {% if moderator %}
            {% set tabs = tabs|merge({reports: {url: path('forum_reports', {list: 'AllActiveReports'}), label: 'forum.reports.title', count: forum_open_reports()}}) %}
        {% endif %}
        {% for name, tab in tabs %}
            <a class="p-forum__tab{% if active|default(null) == name %} is-active{% endif %}" href="{{ tab.url }}"{% if active|default(null) == name %} aria-current="page"{% endif %}>
                {{- tab.label|trans -}}
                {% if tab.count|default(0) > 0 %}<span class="p-forum__tab-count">{{ tab.count }}</span>{% endif %}
            </a>
        {% endfor %}
    </nav>
</header>
