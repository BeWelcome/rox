{#
  One post of a thread. The first post is a big white card (photo with a ring, "Started the topic", its day and
  time, Reply and the number of replies under it); the others hang on the thread's line: the photo on the line,
  a white card with the name, tags (Author, You), the time and who can see it if not everyone. On the right
  Reply and a menu of what the viewer can do with it (link, edit their own, translate, report, moderate).
  The viewer's own posts are cream.
  replyUrl, replyTitle: Reply in the side panel, when the viewer may reply. replies: the number of replies.
  starter: the thread's oldest post (id, author id), or null.
  Posts of members who aren't on BeWelcome any more have no author: a former member with the empty avatar.
#}
{% set _deleted = post.deleted == constant('App\\Doctrine\\ForumDeleteStatusType::DELETED') %}
{% set _starter = starter and starter.id == post.id %}
{% set _isStarter = starter and post.author and starter.author == post.author.id %}
{% set _isMe = app.user and post.author == app.user %}
{% set _vis = post.postvisibility %}
{% set _day = post.created|format_date(pattern: post.created|date('Y') == 'now'|date('Y') ? 'MMM d' : 'MMM d, y') %}
<article class="p-thread-post{{ _starter ? ' p-thread-post--starter' }}{{ _isMe ? ' is-mine' }}{{ _deleted ? ' is-deleted' }}" id="post{{ post.id }}">
    {% if post.author %}
        <a class="p-thread-post__photo" href="{{ path('members_profile', {username: post.author.username}) }}">
            <img width="56" height="56" alt="" loading="lazy" src="{{ path('avatar', {username: post.author.username, size: 72}) }}">
        </a>
    {% else %}
        <span class="p-thread-post__photo">
            <img width="56" height="56" alt="" loading="lazy" src="{{ asset('images/empty_avatar_72_72.png') }}">
        </span>
    {% endif %}
    <div class="p-thread-post__main">
        <div class="p-thread-post__head">
            <div class="p-thread-post__who">
                {% if post.author %}
                    <a class="p-thread-post__name" href="{{ path('members_profile', {username: post.author.username}) }}">{{ post.author.username }}</a>
                {% else %}
                    <span class="p-thread-post__name">{{ 'forum.former.member'|trans }}</span>
                {% endif %}
                {% if _starter %}
                    <span class="p-thread-post__tag p-thread-post__tag--author"><i class="fas fa-flag" aria-hidden="true"></i> {{ 'forum.post.started'|trans }}</span>
                {% elseif _isStarter %}
                    <span class="p-thread-post__tag p-thread-post__tag--author">{{ 'forum.post.author'|trans }}</span>
                {% endif %}
                {% if _isMe %}<span class="p-thread-post__tag">{{ 'forum.post.you'|trans }}</span>{% endif %}
                {# The first post shows its day and time under the name; the others their time, the day is above them #}
                <a class="p-thread-post__when" href="#post{{ post.id }}" title="{{ post.created|format_datetime('medium', 'short') }}">{{ _starter ? _day ~ ', ' ~ post.created|format_time('short') : post.created|format_time('short') }}</a>
                {% if _vis == constant('App\\Doctrine\\ForumVisibilityType::GROUP_ONLY') %}
                    <span class="p-thread-post__vis"><i class="fas fa-lock" aria-hidden="true"></i> {{ 'forum.post.group.only'|trans }}</span>
                {% elseif _vis == constant('App\\Doctrine\\ForumVisibilityType::MODERATOR_ONLY') %}
                    <span class="p-thread-post__vis"><i class="fas fa-lock" aria-hidden="true"></i> {{ ('forum_edit_vis_' ~ _vis)|lower|trans }}</span>
                {% endif %}
            </div>
            <div class="p-thread-post__tools">
                {% if replyUrl|default(null) and not _starter %}
                    <a class="p-thread-post__tool js-contact-open" href="{{ replyUrl }}" data-title="{{ replyTitle }}" aria-label="{{ 'forumreply'|trans }}">
                        <i class="fas fa-reply" aria-hidden="true"></i>
                    </a>
                {% endif %}
                <details class="p-thread-post__more">
                    <summary class="p-thread-post__tool" aria-label="…"><i class="fas fa-ellipsis-h" aria-hidden="true"></i></summary>
                    <div class="p-thread-post__menu">
                        <a href="{{ app.request.baseUrl ~ app.request.pathInfo }}#post{{ post.id }}"><i class="fas fa-link" aria-hidden="true"></i> {{ 'forumpermalink'|trans }}</a>
                        {% if is_granted('FORUM_POST_EDIT', post) %}
                            <a href="{{ path('forum_edit', {postId: post.id}) }}"><i class="fas fa-edit" aria-hidden="true"></i> {{ 'forum_edituser'|trans }}</a>
                            <a href="{{ path('forum_translate', {postId: post.id}) }}"><i class="fas fa-language" aria-hidden="true"></i> {{ 'forum_label_lang'|trans }}</a>
                        {% endif %}
                        {% if not _isMe %}
                            <a href="{{ path('forum_report', {postId: post.id}) }}"><i class="fas fa-flag" aria-hidden="true"></i> {{ 'forummyreporttomod'|trans }}</a>
                        {% endif %}
                        {% if moderator %}
                            <a href="{{ path('forum_admin', {postId: post.id}) }}"><i class="fas fa-edit" aria-hidden="true"></i> {{ 'forum.moderator.edit'|trans }}</a>
                        {% endif %}
                    </div>
                </details>
            </div>
        </div>
        <div class="p-thread-post__text js-highlight">
            {% set shown = post.messageIn(app.request.locale) %}
            {% if _deleted %}<s>{% endif %}
            {{ shown.message|purify|forum_text|forum_lightbox }}
            {% if _deleted %}</s>{% endif %}
        </div>
        {% set translations = post.messageTranslations %}
        {% if translations|length > 1 %}
            <p class="p-thread-post__langs">
                {%- for locale, translation in translations -%}
                    {{ translation.language.name }}{% if not loop.last %}, {% endif %}
                {%- endfor -%}
            </p>
        {% endif %}
        {% if reports|default([])|length %}
            <p class="p-thread-post__reports">
                {% for report in reports %}
                    <a href="{{ path('forum_report_member', {postId: post.id, memberId: report.reporter.id}) }}">{{ 'forum.reports.view'|trans }}: {{ report.reporter.username }}</a>
                    ({{ ('forum.report.status.' ~ (report.status == 'OnDiscussion' ? 'discussion' : report.status|lower))|trans }}){% if not loop.last %} · {% endif %}
                {% endfor %}
            </p>
        {% endif %}
        {% if _starter %}
            <div class="p-thread-post__foot">
                {% if replyUrl|default(null) %}
                    <a class="p-thread-post__reply js-contact-open" href="{{ replyUrl }}" data-title="{{ replyTitle }}"><i class="fas fa-reply" aria-hidden="true"></i> {{ 'forumreply'|trans }}</a>
                {% endif %}
                <span class="p-thread-post__replies">{{ 'forum.thread.replies'|trans({count: replies|default(0)}) }}</span>
            </div>
        {% endif %}
    </div>
</article>
