{% extends 'group/layout.html.twig' %}

{#
  New topic in a group's forum (or the agora): a head with the group's picture, a link back to it and New topic;
  then the form card (the title, the editor, who can see it, the notifications, Cancel and Post topic, greyed until
  a title and a text are there) next to the forum rules in short. On phones the rules are a panel above the form
  that the member can fold (remembered in the browser) and Post topic sits at the bottom of the screen.
#}
{% set group_head_hidden = true %}

{% block group_content %}
    {% set _picture = group.beWelcome ? asset('images/logo_icon_2025.svg') : (group.picture ? path('group_thumbimg', {group_id: group.id}) : asset('images/icons/group.png')) %}
    <div class="p-forum-new">
        <header class="p-forum-new__page-head">
            <span class="p-forum-new__picture{{ group.beWelcome ? ' is-agora' }}"><img width="64" height="64" alt="" src="{{ _picture }}"></span>
            <div>
                <a class="p-forum-new__back" href="{{ path('group_forum', {group_id: group.id}) }}"><i class="fas fa-chevron-left" aria-hidden="true"></i> {{ group.name }}</a>
                <h1 class="p-forum-new__title">{{ 'forumnewtopic'|trans }}</h1>
            </div>
        </header>

        <div class="p-forum-new__layout">
        <details class="p-forum-rules-aside js-forum-rules" open>
            <summary class="p-forum-rules-aside__head">
                <span class="p-forum-rules-aside__icon"><i class="fas fa-scale-balanced" aria-hidden="true"></i></span>
                <h2>{{ 'forum.rules.in.short'|trans }}</h2>
                <i class="fas fa-chevron-up p-forum-rules-aside__caret" aria-hidden="true"></i>
            </summary>
            {% include 'group/_rules_short.html.twig' %}
            <a class="p-forum-rules-aside__more" href="{{ path('group_rules', {group_id: group.id}) }}">{{ 'forum.rules.read.all'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </details>

        {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'p-forum-new__card js-forum-new-form'}}) }}
            {% for _error in form.vars.errors %}<p class="p-forum-new__error p-forum-new__error--box">{{ _error.message }}</p>{% endfor %}

            <div class="p-forum-new__field">
                <label class="p-forum-new__label" for="{{ form.title.vars.id }}">{{ form.title.vars.label|trans }}</label>
                {{ form_widget(form.title, {attr: {class: 'p-forum-new__input', autocomplete: 'off'}}) }}
                {% for _error in form.title.vars.errors %}<p class="p-forum-new__error">{{ _error.message }}</p>{% endfor %}
            </div>

            <div class="p-forum-new__field p-forum-reply__editor">
                <label class="p-forum-new__label" for="{{ form.text.vars.id }}">{{ form.text.vars.label|trans }}</label>
                {{ form_widget(form.text) }}
                {% for _error in form.text.vars.errors %}<p class="p-forum-new__error">{{ _error.message }}</p>{% endfor %}
            </div>

            {% if form.visibility is defined %}
                <div class="p-forum-new__field">
                    <span class="p-forum-new__label">{{ 'forum.reply.who.can.see'|trans }}</span>
                    <div class="p-forum-seg">
                        {% for choice in form.visibility %}
                            <input type="radio" class="p-forum-seg__input" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}"{% if choice.vars.checked %} checked{% endif %}>
                            <label class="p-forum-seg__option" for="{{ choice.vars.id }}">
                                <i class="fas {{ choice.vars.value == constant('App\\Doctrine\\ForumVisibilityType::NO_RESTRICTION') or choice.vars.value == constant('App\\Doctrine\\ForumVisibilityType::MEMBERS_ONLY') ? 'fa-globe' : 'fa-lock' }}" aria-hidden="true"></i>
                                {{ choice.vars.label|trans }}
                            </label>
                            {% do choice.setRendered %}
                        {% endfor %}
                    </div>
                    {% for _error in form.visibility.vars.errors %}<p class="p-forum-new__error">{{ _error.message }}</p>{% endfor %}
                </div>
                {% do form.visibility.setRendered %}
            {% endif %}

            {% if form.subscribe is defined %}
                <label class="p-forum-notify" for="{{ form.subscribe.vars.id }}">
                    <i class="fas fa-bell" aria-hidden="true"></i>
                    <span class="p-forum-notify__text">{{ form.subscribe.vars.label|trans }}</span>
                    <input type="checkbox" class="p-preference-toggle__input" id="{{ form.subscribe.vars.id }}" name="{{ form.subscribe.vars.full_name }}" value="{{ form.subscribe.vars.value }}"{% if form.subscribe.vars.checked %} checked{% endif %}>
                    <span class="p-preference-toggle__track" aria-hidden="true"><span class="p-preference-toggle__thumb"></span></span>
                </label>
                {% do form.subscribe.setRendered %}
            {% endif %}

            {% do form.submit.setRendered %}
            {{ form_rest(form) }}

            <div class="p-forum-new__foot">
                <a class="p-group-btn" href="{{ path('group_forum', {group_id: group.id}) }}">{{ 'cancel'|trans }}</a>
                <button type="submit" name="{{ form.submit.vars.full_name }}" class="p-group-btn p-group-btn--primary js-forum-new-send">
                    <i class="fas fa-paper-plane" aria-hidden="true"></i> {{ 'forum.post.topic'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
        </div>
    </div>
    <script>
        (function () {
            // Create topic stays greyed until there is a title and a text (or a picture)
            var form = document.querySelector('.js-forum-new-form');
            var send = form.querySelector('.js-forum-new-send');
            var title = document.getElementById('{{ form.title.vars.id }}');
            var refresh = function () {
                var editable = form.querySelector('.ck-editor__editable');
                var filled = editable
                    ? editable.textContent.trim() !== '' || editable.querySelector('img') !== null
                    : form.querySelector('textarea').value.trim() !== '';
                send.disabled = !filled || title.value.trim() === '';
            };
            new MutationObserver(refresh).observe(form, { childList: true, characterData: true, subtree: true });
            form.addEventListener('input', refresh);
            refresh();

            // The rules: open unless the member folded them (phones; on larger screens they are always open)
            var rules = document.querySelector('.js-forum-rules');
            var key = 'bw.forum.rules.folded';
            var phone = window.matchMedia('(max-width: 540px)');
            try {
                if (phone.matches && localStorage.getItem(key) === '1') {
                    rules.open = false;
                }
            } catch (e) {}
            rules.addEventListener('toggle', function () {
                if (!phone.matches) {
                    rules.open = true;
                    return;
                }
                try { localStorage.setItem(key, rules.open ? '0' : '1'); } catch (e) {}
            });
        })();
    </script>
{% endblock %}
