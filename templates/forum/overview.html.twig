{% extends 'base.html.twig' %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
        <h1 class="h3 mb-0">{{ 'ForumRecentPostsLong'|trans }}</h1>
        <div>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('group_forum', {group_id: constant('App\\Entity\\Group::BEWELCOME')}) }}">{{ 'AgoraForum'|trans }}</a>
            {% if onlyMyGroups %}
                <a class="btn btn-outline-primary btn-sm" href="{{ path('forums_groups_all') }}">{{ 'SwitchShowAllGroupsTopics'|trans }}</a>
            {% else %}
                <a class="btn btn-outline-primary btn-sm" href="{{ path('forums_groups_only_mine') }}">{{ 'SwitchShowOnlyMyGroupsTopics'|trans }}</a>
            {% endif %}
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('forums_less_group_posts') }}">{{ 'ShowLess'|trans }}</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('forums_more_group_posts') }}">{{ 'ShowMore'|trans }}</a>
        </div>
    </div>

    {% include 'forum/_threads.html.twig' with {threads: threads, showGroup: true} %}

    {% if threads.haveToPaginate %}
        <div class="u:flex u:justify-end u:my-8">
            {{ pagerfanta(threads, 'rounded_pagination', {routeName: 'forums', pageParameter: '[page]'}) }}
        </div>
    {% endif %}
{% endblock %}
