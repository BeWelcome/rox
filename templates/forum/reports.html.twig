{% extends 'group/layout.html.twig' %}
{% import 'forum/_macros.html.twig' as forum %}
{% import 'forum/_report_macros.html.twig' as reportParts %}

{#
  The Reports tab of a group, for the forum moderators: the reports about posts of the group (or of all groups,
  ?scope=all), the oldest change first. Open (all open reports), Mine, open and All mine (the ones the moderator
  answered). Each row opens the report.
  reports, posts (the reported posts by id), list, counts (by list), all.
#}
{% block title %}{{ 'forum.reports.title'|trans }}{% endblock %}

{% block group_content %}
    {% set _scope = all ? {scope: 'all'} : {} %}
    <div class="p-mod-bar">
        <nav class="p-forum-seg p-mod-seg" aria-label="{{ 'forum.reports.title'|trans }}">
            {% for _name, _label in {AllActiveReports: 'forum.reports.list.open', MyReportActive: 'forum.reports.list.mine.open', AllMyReport: 'forum.reports.list.mine'} %}
                <a class="p-forum-seg__option{{ list == _name ? ' is-active' }}" href="{{ path('group_reports', {group_id: group.id, list: _name}|merge(_scope)) }}"{% if list == _name %} aria-current="page"{% endif %}>
                    {{ _label|trans }} <span class="p-mod-seg__count">{{ counts[_name] }}</span>
                </a>
            {% endfor %}
        </nav>
        <nav class="p-forum-seg p-mod-seg" aria-label="{{ 'forum.reports.scope'|trans }}">
            <a class="p-forum-seg__option{{ not all ? ' is-active' }}" href="{{ path('group_reports', {group_id: group.id, list: list}) }}"{% if not all %} aria-current="page"{% endif %}>{{ 'forum.reports.scope.group'|trans }}</a>
            <a class="p-forum-seg__option{{ all ? ' is-active' }}" href="{{ path('group_reports', {group_id: group.id, list: list, scope: 'all'}) }}"{% if all %} aria-current="page"{% endif %}>{{ 'forum.reports.scope.all'|trans }}</a>
        </nav>
    </div>

    <div class="p-mod-list" id="reports">
        {% for report in reports %}
            {% set _post = posts[report.postId] ?? null %}
            {% set _messages = forum_report_messages(report) %}
            {% set _first = _messages|first %}
            <div class="p-mod-row">
                <img class="p-mod-row__photo" width="44" height="44" alt="" loading="lazy" src="{{ path('avatar', {username: report.reporter.username, size: 48}) }}">
                <div class="p-mod-row__body">
                    <p class="p-mod-row__line">
                        <a class="p-mod-row__link" href="{{ path('forum_report_member', {postId: report.postId, memberId: report.reporter.id}) }}">
                            <strong>{{ report.reporter.username }}</strong> <span>{{ 'forum.reports.reported.post.by'|trans }}</span> <strong>{{ _post and _post.author ? _post.author.username : 'forum.former.member'|trans }}</strong>
                        </a>
                        <span class="p-mod-row__when">{{ (report.updated ?? report.created)|format_datetime('medium', 'short') }}</span>
                    </p>
                    {% if _post and _post.thread %}
                        <p class="p-mod-row__topic">
                            <span><i class="fas fa-comments" aria-hidden="true"></i> {{ forum.thread_title(_post.thread, app.request.locale) }}</span>
                            {% if all and _post.thread.group %}<span class="p-mod-row__group">{{ _post.thread.group.name }}</span>{% endif %}
                        </p>
                    {% endif %}
                    {% if _first %}
                        <p class="p-mod-row__excerpt">“{{ _first.text|purify|striptags|trim|truncate(240) }}”</p>
                    {% endif %}
                    <p class="p-mod-row__state">
                        {{ reportParts.status(report) }}
                        <span class="p-mod-row__wait">{% if reportParts.is_waiting(report)|trim %}<span class="p-mod-dot"></span>{% endif %}{{ reportParts.waiting(report) }}</span>
                    </p>
                </div>
            </div>
        {% else %}
            <p class="p-mod-list__empty"><i class="fas fa-circle-check" aria-hidden="true"></i> {{ 'forum.reports.none'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
