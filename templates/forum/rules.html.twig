{% extends 'base.html.twig' %}

{% block content %}
    {% include 'forum/_head.html.twig' with {active: 'rules'} %}
    <h2 class="h4">{{ 'forumrulesgeneral'|trans|raw }}</h2>
    <h2 class="h4">{{ 'forumrulescharterheadline1'|trans|raw }}</h2>
    <h3 class="h5">{{ 'forumrulescharterheadline2'|trans|raw }}</h3>
    <ol>
        {% for i in 1..6 %}<li>{{ ('forumruleschartertext' ~ i)|trans|raw }}</li>{% endfor %}
    </ol>
    <h2 class="h4">{{ 'forumrulesheadline1'|trans|raw }}</h2>
    <h3 class="h5">{{ 'forumrulesheadline2'|trans|raw }}</h3>
    <p>{{ 'forumrulestext1'|trans|raw }}</p>
    <ol>
        {% for i in 2..6 %}<li>{{ ('forumrulestext' ~ i)|trans|raw }}</li>{% endfor %}
    </ol>
    <p>{{ 'forumrulestext7'|trans|raw }}</p>
    <ol>
        {% for i in 8..11 %}<li>{{ ('forumrulestext' ~ i)|trans|raw }}</li>{% endfor %}
    </ol>
    {% for i in 12..15 %}<p>{{ ('forumrulestext' ~ i)|trans|raw }}</p>{% endfor %}
    <h3 class="h5" id="groups">{{ 'forumrulesdiscussiongroups'|trans|raw }}</h3>
    <p>{{ 'forumrulesdiscussiongroupstext'|trans|raw }}</p>
{% endblock %}
