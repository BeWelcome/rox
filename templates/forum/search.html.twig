{% extends 'base.html.twig' %}
{% import 'forum/_macros.html.twig' as forum %}

{% block content %}
    <h1 class="h3">{{ 'search'|trans }}{% if group %}: <a href="{{ path('group_forum', {group_id: group.id}) }}">{{ group.beWelcome ? 'agoraforum'|trans : group.name }}</a>{% endif %}</h1>
    {% include 'forum/_search_form.html.twig' %}

    {% if posts is not null %}
        {% if posts.nbResults == 0 %}
            <p>{{ 'forumsearchnoresults'|trans }}</p>
        {% else %}
            <div id="search-results">
                {% for post in posts %}
                    <div class="border-bottom py-2">
                        <a href="{{ forum.thread_url(post.thread) }}#post{{ post.id }}" class="fw-bold">{{ forum.thread_title(post.thread, app.request.locale) }}</a>
                        {% if not post.thread.agora %}<small class="text-muted"> · {{ post.thread.group.name }}</small>{% endif %}
                        <div class="small text-muted">{{ post.author.username }}, {{ post.created|format_datetime('short', 'short') }}</div>
                        <div class="js-highlight">{% set text = post.messageIn(app.request.locale).message|striptags|trim %}{{ text|length > 400 ? text|slice(0, 400) ~ '…' : text }}</div>
                    </div>
                {% endfor %}
            </div>
            {% if posts.haveToPaginate %}
                <div class="u:flex u:justify-end u:my-8">
                    {% if group %}
                        {{ pagerfanta(posts, 'rounded_pagination', {routeName: 'group_search_discussions', routeParams: {group_id: group.id, q: keyword}, pageParameter: '[page]'}) }}
                    {% else %}
                        {{ pagerfanta(posts, 'rounded_pagination', {routeName: 'forums_search_pages', routeParams: {keyword: keyword}, pageParameter: '[page]'}) }}
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
