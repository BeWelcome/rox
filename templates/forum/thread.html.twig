{% extends 'group/layout.html.twig' %}
{% import 'forum/_macros.html.twig' as forum %}

{#
  A forum thread: a white top (the group's small head, back to the discussions, the title, Reply, Subscribe and
  the order), then the posts in one white card and "Write a reply" under it. Reply opens in a side panel
  (assets/js/contact/drawer.js, loaded by bewelcome.js): forum/reply.html.twig ?embed=1.
#}
{# The group's small head is in the thread's white top (group/layout.html.twig leaves it out) #}
{% set group_head_compact = true %}

{% block title %}{{ forum.thread_title(thread, locale) }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('highlight') }}
    {{ encore_entry_script_tags('lightbox') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('highlight') }}
{% endblock %}

{% block group_content %}
    {% set moderator = is_granted('ROLE_ADMIN_FORUMMODERATOR') or is_granted('ROLE_ADMIN_ADMIN') %}
    {% set canReply = is_granted('FORUM_THREAD_REPLY', thread) %}
    {% set _replyUrl = thread.agora ? path('forum_reply', {threadId: thread.id}) : path('group_forum_reply', {group_id: group.id, thread: thread.id}) %}
    {% set _replyTitle = forum.thread_title(thread, locale)|striptags %}
    {% set _lastPost = thread.lastPost %}

    <div class="p-thread">
    <div class="p-thread__top">
        {% if thread.agora %}
            {% include 'forum/_head.html.twig' with {active: 'agora', tabsOnly: true} %}
        {% elseif submenu is defined %}
            {% include 'group/_head_compact.html.twig' %}
        {% endif %}

        <a class="p-thread__back" href="{{ path('group_forum', {group_id: group.id}) }}">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> {{ 'forum.thread.all.discussions'|trans }}
        </a>
        <h1 class="p-thread__title">{{ forum.thread_title(thread, locale) }}</h1>
        {% if thread.deleted == constant('App\\Doctrine\\ForumDeleteStatusType::DELETED') %}
            <p class="alert alert-warning">{{ 'threadclosed'|trans }}</p>
        {% endif %}

        <div class="p-thread__actions">
            {% if canReply %}
                <a class="p-thread-btn p-thread-btn--primary js-contact-open" href="{{ _replyUrl }}" data-title="{{ _replyTitle }}">
                    <i class="fas fa-reply" aria-hidden="true"></i> {{ 'forumreply'|trans }}
                </a>
            {% endif %}
            <form method="post" action="{{ subscribed ? path('forum_thread_unsubscribe', {threadId: thread.id}) : path('forum_thread_subscription', {threadId: thread.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\ForumSubscriptionController::TOKEN')) }}">
                {# Subscribed: orange; a click unsubscribes (said on hover) #}
                <button type="submit" class="p-thread-btn{{ subscribed ? ' is-on' }}"{% if subscribed %} title="{{ 'forumunsubscribe'|trans }}"{% endif %}>
                    <i class="fas fa-bell" aria-hidden="true"></i> {{ (subscribed ? 'forum.thread.subscribed' : 'forumsubscribe')|trans }}
                </button>
            </form>
            <a class="p-thread__order" href="{{ thread.agora ? path('forum_reverse', {threadId: thread.id}) : path('group_forum_thread_reverse', {group_id: group.id, thread: thread.id}) }}">
                <i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i> {{ (ascending ? 'forums.sort.latest.first' : 'forums.sort.oldest.first')|trans }}
            </a>
        </div>

        <p class="p-thread__meta">
            {{ 'forum.thread.posts'|trans({count: posts.nbResults}) }}
            {% if _lastPost and posts.nbResults > 1 %}
                · {{ 'forum.thread.last.reply'|trans({date: _lastPost.created|format_date(pattern: _lastPost.created|date('Y') == 'now'|date('Y') ? 'MMM d' : 'MMM d, y')}) }}
            {% endif %}
        </p>
    </div>

    {% if posts.haveToPaginate %}
        <div class="p-thread__pages">
            {{ pagerfanta(posts, 'rounded_pagination', thread.agora
                ? {routeName: 'forum_thread_pages', routeParams: {threadId: thread.id}, pageParameter: '[pageId]'}
                : {routeName: 'group_forum_thread_pages', routeParams: {group_id: group.id, thread: thread.id}, pageParameter: '[page_id]'}) }}
        </div>
    {% endif %}

    <div class="p-thread__posts">
        {% for post in posts %}
            {% include 'forum/_post.html.twig' with {post: post, moderator: moderator, reports: reports[post.id] ?? [], replyUrl: canReply ? _replyUrl : null, replyTitle: _replyTitle} %}
        {% endfor %}
    </div>

    {% if posts.haveToPaginate %}
        <div class="p-thread__pages">
            {{ pagerfanta(posts, 'rounded_pagination', thread.agora
                ? {routeName: 'forum_thread_pages', routeParams: {threadId: thread.id}, pageParameter: '[pageId]'}
                : {routeName: 'group_forum_thread_pages', routeParams: {group_id: group.id, thread: thread.id}, pageParameter: '[page_id]'}) }}
        </div>
    {% endif %}

    {% if canReply %}
        <div class="p-thread__write">
            <a class="p-thread-btn p-thread-btn--soft js-contact-open" href="{{ _replyUrl }}" data-title="{{ _replyTitle }}">
                <i class="fas fa-reply" aria-hidden="true"></i> {{ 'forum.thread.write.reply'|trans }}
            </a>
        </div>
        {% include 'conversations/_contact_drawer.html.twig' with { from: 'forum' } %}
    {% endif %}
    </div>
{% endblock %}
