{% extends 'profile/profile.html.twig' %}
{% import 'macros.twig' as macros %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('micromodal') }}
  {{ encore_entry_script_tags('readmore') }}
{% endblock javascripts %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('readmore') }}
{% endblock stylesheets %}

{% block page_content %}
  <input type="hidden" id="read.more" value="{{ 'comment.read.more'|trans }}">
  <input type="hidden" id="show.less" value="{{ 'comment.show.less'|trans }}">
  <div class="p-friends-page p-profile-main">
    <div class="card">
      <div class="card-header u:flex u:flex-row u:justify-between">
        <span>
          {{ 'profile.friends'|trans }}
          {% if friends.nbResults > 0 %}
            <span class="p-gallery-footer__count">{{ friends.nbResults }}</span>
          {% endif %}
        </span>
        {% if member == app.user %}
          <a class="p-friends-page__manage" href="{{ url('friendships', {username: member.username}) }}">
            <i class="fas fa-edit" aria-hidden="true"></i> {{ 'friendships.manage'|trans }}
          </a>
        {% endif %}
      </div>
      <div class="card-body">
        {% if friends.nbResults == 0 %}
          <div class="p-no-comments">
            <i class="fas fa-user-friends" aria-hidden="true"></i>
            <p>{{ 'profile.no.friends'|trans }}</p>
          </div>
        {% else %}
          <ul class="p-friends-page__grid">
            {% for friend in friends %}
              {% set other = friend.other(member) %}
              <li>
                <a class="p-friends-page__item" href="{{ url('members_profile', {username: other.username}) }}">
                  <span class="o-avatar o-avatar--m">
                    <span class="o-avatar__img-wrapper o-avatar--shadow-s">
                      <img class="o-avatar__img" src="{{ path('avatar', {username: other.username, size: 72}) }}" alt="" loading="lazy">
                    </span>
                  </span>
                  <span class="p-friends-page__name">{{ other.username }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
          {% if friends.haveToPaginate %}
            <div class="p-friends-page__pager">
              {{ pagerfanta(friends, 'rounded_pagination_end') }}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock page_content %}
