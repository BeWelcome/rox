{#
  One group in a list (my groups, all groups): picture, name and when its last post was, its place and categories as
  chips, the number of members in a pill on the right; a small Joined next to the name when the member is in it.
  row is a result row of GroupRepository: the group (key 0), memberCount, newMemberCount and lastActivity.
  myGroupIds: the groups the member is in.
#}
{% import 'group/_macros.html.twig' as groups %}
{% set group = row[0] %}
{# Archived groups are named "[Archived] ..." for now: the name without it, and a grey Archived tag #}
{% set _archived = group.name|lower starts with '[archived]' %}
<a class="p-group-card" href="{{ path('group_start', {group_id: group.id}) }}">
    <img class="p-group-card__picture" width="68" height="68" alt="" loading="lazy"
         src="{{ group.picture ? path('group_thumbimg', {group_id: group.id}) : asset('images/icons/group.png') }}" onerror="this.onerror=null;this.src='{{ asset('images/icons/group.png') }}'">
    <span class="p-group-card__main">
        <span class="p-group-card__title">
            <span class="p-group-card__name">{{ _archived ? group.name|slice(10)|trim : group.name }}</span>
            {% if group.id in myGroupIds|default([]) %}
                <span class="p-group-card__joined"><i class="fa fa-check" aria-hidden="true"></i> {{ 'group.list.joined'|trans }}</span>
            {% endif %}
        </span>
        <span class="p-group-card__meta">
            {% if _archived %}
                <span class="p-group-card__archived"><i class="fas fa-box-archive" aria-hidden="true"></i> {{ 'group.list.archived.tag'|trans }}</span>
            {% endif %}
            {{ groups.activity(row.lastActivity) }}
        </span>
        {% if group.location or group.categories is not empty %}
            <span class="p-group-card__chips">{{ groups.place(group) }}{{ groups.categories(group) }}</span>
        {% endif %}
    </span>
    {# The members as a number in a pill on the right, like the replies of a thread #}
    <span class="p-group-card__members" data-member-count="{{ row.memberCount }}" title="{{ 'group.list.members'|trans({count: row.memberCount}) }}">
        <i class="fas fa-user-group" aria-hidden="true"></i> {{ row.memberCount }}
        <span class="visually-hidden">{{ 'group.list.members'|trans({count: row.memberCount}) }}</span>
    </span>
</a>
