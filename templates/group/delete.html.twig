{% extends 'group/layout.html.twig' %}

{% block group_content %}
    {% import 'macros/post_button.html.twig' as button %}
    <h2 class="h4">{{ 'groupsdeletegroup'|trans }}</h2>
    <p>{{ 'groupsdeleteconsiderations'|trans }}</p>
    {{ button.post_button(path('group_delete_confirmed', {id: group.id}), 'group-delete-' ~ group.id, 'groupsreallydelete', 'btn btn-danger') }}
    <a class="btn btn-outline-primary" href="{{ path('group_start', {group_id: group.id}) }}">{{ 'groupsdontdelete'|trans }}</a>
{% endblock %}
