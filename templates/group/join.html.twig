{% extends 'group/layout.html.twig' %}

{#
  Joining a group: one white card with why the member joins, whether they want the group's mails
  (Yes / No as a grey pill) and Cancel / Join.
#}

{% block group_content %}
    <div class="p-group-form">
        {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'p-group-form__card'}}) }}
        <div class="p-group-form__head">
            <span class="p-group-form__icon"><i class="fas fa-user-plus" aria-hidden="true"></i></span>
            <div>
                <h2 class="p-group-form__title">{{ 'group.join.abstract'|trans }}</h2>
                <p class="p-group-form__sub">{{ group.name }}</p>
            </div>
        </div>
        {% for _error in form.vars.errors %}<p class="p-group-form__error p-group-form__error--box">{{ _error.message }}</p>{% endfor %}

        <div class="p-group-form__field">
            <label class="p-group-form__label" for="{{ form.reason.vars.id }}">{{ form.reason.vars.label|trans }}</label>
            <textarea class="p-group-form__input" id="{{ form.reason.vars.id }}" name="{{ form.reason.vars.full_name }}" rows="4" required>{{ form.reason.vars.value }}</textarea>
            {% do form.reason.setRendered %}
            {% for _error in form.reason.vars.errors %}<p class="p-group-form__error">{{ _error.message }}</p>{% endfor %}
        </div>

        <div class="p-group-form__field">
            <span class="p-group-form__label">{{ form.notifications.vars.label|trans }}</span>
            <div class="p-forum-seg" role="radiogroup" aria-label="{{ form.notifications.vars.label|trans }}">
                {% for item in form.notifications %}
                    <input type="radio" class="p-forum-seg__input" value="{{ item.vars.value }}" id="{{ item.vars.id }}"
                           name="{{ item.vars.full_name }}"{{ item.vars.checked ? ' checked' }}>
                    <label class="p-forum-seg__option" for="{{ item.vars.id }}">
                        <i class="fas {{ item.vars.value == 'yes' ? 'fa-envelope' : 'fa-eye-slash' }}" aria-hidden="true"></i>
                        {{ item.vars.label|trans }}
                    </label>
                    {% do item.setRendered %}
                {% endfor %}
            </div>
        </div>

        <div class="p-group-form__foot">
            <a class="p-group-btn" href="{{ path('group_start', {group_id: group.id}) }}">{{ 'cancel'|trans }}</a>
            <button type="submit" class="p-group-btn p-group-btn--primary" id="{{ form.join.vars.id }}" name="{{ form.join.vars.full_name }}">{{ form.join.vars.label|trans }}</button>
            {% do form.join.setRendered %}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock group_content %}
