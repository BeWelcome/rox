{% extends 'base.html.twig' %}

{#
  The pages of a group: the group's head with its menu as tabs above the page, in place of the sidebar.
  Pages fill group_content. Pages shared with the agora (the forum's) get the head only when they have the
  group's menu (submenu).
#}

{% if submenu is defined %}{% set hide_sidebar = true %}{% endif %}

{% block content %}
    {# Not in a side panel (?embed=1): only the page itself there #}
    {# group_head_compact: the page shows the group's small head itself (a forum thread) #}
    {% if submenu is defined and not app.request.query.getBoolean('embed') and not (group_head_compact ?? false) %}{% include 'group/_head.html.twig' %}{% endif %}
    {% block group_content %}{% endblock %}
{% endblock %}
