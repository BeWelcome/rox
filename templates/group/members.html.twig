{% extends 'group/layout.html.twig' %}

{# A group's members: one white list, a row per member (avatar, name, why they joined), the row opens the profile #}

{% block group_content %}
    <section class="p-group-panel p-group-people">
        <div class="p-group-panel__head">
            <h2 class="p-group-panel__title">{{ 'groupsmembers'|trans }} <span class="p-group-panel__count">{{ memberships.nbResults }}</span></h2>
        </div>
        <div class="p-group-people__list">
            {% for membership in memberships %}
                {% set member = membership.member %}
                <div class="p-group-people__row">
                    <img class="p-group-people__avatar" width="48" height="48" loading="lazy" alt="" src="{{ path('avatar', {username: member.username, size: 50}) }}">
                    <div class="p-group-people__text">
                        <a class="p-group-people__name username" href="{{ path('members_profile', {username: member.username}) }}">{{ member.username }}</a>
                        {% if membership.comment|striptags|trim %}
                            <p class="p-group-people__comment">{{ membership.comment|purify|nl2br }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
        {% if memberships.haveToPaginate %}
            <div class="p-group-people__pages">
                {{ pagerfanta(memberships, 'rounded_pagination', {routeName: 'group_members_paged', routeParams: {group_id: group.id}, pageParameter: '[page_number]'}) }}
            </div>
        {% endif %}
    </section>
{% endblock %}
