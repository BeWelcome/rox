{% extends 'base.html.twig' %}

{% block content %}
    <div class="row">
        <div class="col">
            <h1 class="h3">{{ 'groupsmembers'|trans }}: <a href="{{ path('group_start', {group_id: group.id}) }}">{{ group.name }}</a></h1>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th colspan="2" class="col-3">{{ 'groupmembers'|trans }}</th>
                    <th class="col-9">{{ 'groupsmembercomment'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for membership in memberships %}
                    {% set member = membership.member %}
                    <tr>
                        <td><img class="rounded" width="50" height="50" loading="lazy" alt="" src="{{ path('avatar', {username: member.username, size: 50}) }}"></td>
                        <td><a href="{{ path('members_profile', {username: member.username}) }}" class="username">{{ member.username }}</a></td>
                        <td><em>{{ membership.comment|purify|nl2br }}</em></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if memberships.haveToPaginate %}
        <div class="u:flex u:justify-end u:my-8">
            {{ pagerfanta(memberships, 'rounded_pagination', {routeName: 'group_members_paged', routeParams: {group_id: group.id}, pageParameter: '[page_number]'}) }}
        </div>
    {% endif %}
{% endblock %}
