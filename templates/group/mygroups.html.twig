{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('groups/location') }}
{% endblock %}

{% block content %}
    {% include 'group/_list.html.twig' with {tab: 'mine'} %}

    {# The groups the profile shows #}
    {% if profileForm.groups.children|length > 0 %}
        <details class="p-groups__profile" id="profile-groups">
            <summary>{{ 'group.profile.groups'|trans }}</summary>
            {{ form(profileForm) }}
        </details>
    {% endif %}
{% endblock %}
