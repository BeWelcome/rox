{% extends 'group/layout.html.twig' %}

{% block group_content %}
    <h2 class="h4">{{ 'administraterelatedgroupstitle'|trans }}</h2>
    {% if isMember %}
        <p>
            <a class="btn btn-outline-primary" href="{{ path('relatedgroup_select', {group_id: group.id}) }}">{{ 'addrelatedgroupbutton'|trans }}</a>
            <a class="btn btn-outline-danger" href="{{ path('relatedgroup_selectdelete', {group_id: group.id}) }}">{{ 'removerelatedgroupbutton'|trans }}</a>
        </p>
    {% endif %}
    <ul class="list-unstyled" id="related-group-log">
        {% for link in links %}
            <li>
                <span class="text-muted small">{{ link.updated|format_datetime('short', 'short') }}</span>
                {% set by = link.removed ? link.deletedBy : link.addedBy %}
                {% if by %}<a href="{{ path('members_profile', {username: by.username}) }}">{{ by.username }}</a>{% endif %}
                {{ (link.removed ? 'removerelatedgrouptitle' : 'addrelatedgrouptitle')|trans }}:
                <a href="{{ path('group_start', {group_id: link.relatedGroup.id}) }}">{{ link.relatedGroup.name }}</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
