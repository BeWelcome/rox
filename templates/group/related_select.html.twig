{% extends 'group/layout.html.twig' %}

{% block group_content %}
    <h2 class="h4">{{ 'titleaddrelatedgrouptogroup'|trans }}</h2>
    <ul class="list-unstyled">
        {% for candidate in candidates %}
            <li class="mb-2">
                <form method="post" action="{{ path('relatedgroup_add', {group_id: group.id, related_id: candidate.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('relatedgroup-add-' ~ group.id ~ '-' ~ candidate.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">{{ 'addasrelatedgroup'|trans }}</button>
                </form>
                <a href="{{ path('group_start', {group_id: candidate.id}) }}">{{ candidate.name }}</a>
            </li>
        {% endfor %}
    </ul>
    <a href="{{ path('relatedgroup_selectdelete', {group_id: group.id}) }}">{{ 'removerelatedgroupbutton'|trans }}</a>
{% endblock %}
