{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('groups/search') }}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12 col-lg-8 mb-3">
            <h1 class="h3">{{ 'GroupsSearchHeading'|trans }}</h1>
            <form action="{{ path('groups_search') }}" method="get" class="js-group-search">
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="group_search_name">{{ 'name'|trans }}</label>
                        <input type="text" class="o-input" id="group_search_name" name="name" value="{{ search.name }}">
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="group_search_category">{{ 'group.search.category'|trans }}</label>
                        <select class="o-input" id="group_search_category" name="category">
                            <option value="">{{ 'group.search.category.all'|trans }}</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}"{% if category.id == search.category %} selected{% endif %}>{{ category.name(app.request.locale) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="group_search_location_name">{{ 'location'|trans }}</label>
                        <div class="auto-search-wrapper max-height">
                            <input type="text" class="o-input js-location-picker" id="group_search_location_name" name="locationName"
                                   value="{{ search.locationName }}" autocomplete="off">
                        </div>
                        <input type="hidden" id="group_search_location" name="location" value="{{ search.location }}">
                    </div>
                    <input type="hidden" name="order" value="{{ search.order }}">
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">{{ 'GroupsSearchSubmit'|trans }}</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-12 col-lg-4 mb-3">
            <h2 class="h3">{{ 'GroupsCreateHeading'|trans }}</h2>
            <a class="btn btn-primary" role="button" href="{{ path('new_group') }}">{{ 'GroupsCreateNew'|trans }}</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6">
            <h2 class="h3">{{ 'GroupsSearchResult'|trans }}</h2>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <span class="fw-bold">{{ 'GroupsSearchOrdered'|trans }}:</span>
            {% for orders in [['actdesc', 'actasc'], ['nameasc', 'namedesc'], ['membersdesc', 'membersasc'], ['createddesc', 'createdasc']] %}
                {% set next = search.order == orders[0] ? orders[1] : orders[0] %}
                {% set key = next starts with 'created' ? 'GroupsOrderDate' ~ next : 'GroupsOrderBy' ~ next %}
                <a class="btn btn-sm {{ search.order in orders ? 'btn-primary' : 'btn-outline-primary' }}"
                   href="{{ path('groups_search', search.toQuery(next, 1)) }}">{{ key|trans }}</a>
            {% endfor %}
        </div>
    </div>

    {% if groups.nbResults > 0 %}
        <div class="row">
            {% for row in groups %}
                {% include 'group/_card.html.twig' %}
            {% endfor %}
        </div>
        {% if groups.haveToPaginate %}
            <div class="u:flex u:justify-end u:my-8">
                {{ pagerfanta(groups, 'rounded_pagination', {routeName: 'groups_search', routeParams: search.toQuery(null, 1)|filter((value, key) => key != 'page'), pageParameter: '[page]'}) }}
            </div>
        {% endif %}
    {% else %}
        <p>{{ 'group.search.no.results'|trans }}</p>
    {% endif %}
{% endblock %}
