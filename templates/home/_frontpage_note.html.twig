{# One card of the front page hero corners: a round icon, a bold line and a grey line #}
<div class="fp-float fp-note">
    <span class="fp-note__icon fp-note__icon--{{ colour }}"><i class="fas {{ icon }}"></i></span>
    <div><p class="fp-note__title">{{ title }}</p><p class="fp-note__sub">{{ sub }}</p></div>
</div>
