<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('/images/favicon-96x96.png') }}" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('/images/favicon.svg') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/images/apple-touch-icon.png') }}" />
    <meta name="apple-mobile-web-app-title" content="beWelcome" />

    <title>BeWelcome - {{ 'home.headline.bewelcome.cultural' | trans }}</title>
    <meta name="description" content="{{ 'default_meta_description' | trans }}"/>
    <meta name="keywords" content="{{ 'default_meta_keyword' | trans }}"/>

    {% include 'webpreview.html.twig' %}

    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('leaflet') }}
    <link rel='manifest' href='{{ asset('manifest.webmanifest') }}'>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js').then(registration => {
                    console.log('SW registered: ', registration);
                }).catch(registrationError => {
                    console.log('SW registration failed: ', registrationError);
                });
            });
        }
    </script>
  {% include '_analytics.html.twig' %}
</head>
<body>
{% block content %}
{#
  The front page for visitors: the top bar (language, Log in, Join free), the hero with a photo and two cards
  of the site, the dark band on why it's free, how it works in five cards, the community with a photo, then a
  last call to join. Avatars are letters for now.
#}
<header class="fp-top">
    <div class="fp-wrap fp-top__in">
        <a class="fp-top__logo" href="{{ url('homepage') }}">{% include 'logo.html.twig' %}</a>
        <nav class="fp-top__nav">
            <div class="dropdown">
                <button type="button" class="fp-top__link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'menu.language.toggle'|trans }}">
                    <i class="fas fa-globe" aria-hidden="true"></i> {{ language_name(app.request.locale) }}
                </button>
                <div class="dropdown-menu dropdown-menu-end fp-top__langs">
                    {% for lang in locales %}
                        <a class="dropdown-item{{ lang == app.request.locale ? ' active' }}" href="{{ path('language', {locale: lang}) }}">{{ language_name(lang) }}</a>
                    {% endfor %}
                </div>
            </div>
            <a class="fp-top__link js-home-login-open" href="{{ url('security_login') }}" role="button" aria-controls="home-login" aria-expanded="false">{{ 'login'|trans }}</a>
            <a class="fp-top__join" href="{{ url('signup') }}"><i class="fas fa-user-plus" aria-hidden="true"></i> {{ 'frontpage.join.free'|trans }}</a>
        </nav>
    </div>
</header>

{# Log in: a card under the top bar on desktop, a sheet from the bottom on phones (home.js opens it) #}
<div class="fp-login js-home-login-aside">
    <aside id="home-login" class="fp-login__panel" role="dialog" aria-modal="true" aria-labelledby="home-login-title">
        <span class="fp-login__grip" aria-hidden="true"></span>
        <button type="button" class="fp-login__close js-home-login-close" aria-label="{{ 'close'|trans }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <h2 class="fp-login__title" id="home-login-title">{{ 'login'|trans }}</h2>
        {% include 'partials/home_login_form.html.twig' %}
        <p class="fp-login__signup">{{ 'menu.not.a.member.yet'|trans }}
            <a href="{{ url('signup') }}">{{ 'navbar.button.signup'|trans }}</a>
        </p>
    </aside>
</div>
<div class="fp-login__backdrop js-home-login-backdrop" aria-hidden="true"></div>

<main class="fp">
    <section class="fp-hero">
        <div class="fp-wrap fp-hero__in">
            <div class="fp-hero__copy">
                <p class="fp-badge"><i class="fas fa-heart" aria-hidden="true"></i> {{ 'frontpage.badge'|trans }}</p>
                <h1 class="fp-hero__title">
                    <span>{{ 'frontpage.title.stay'|trans }}</span>
                    <span>{{ 'frontpage.title.host'|trans }}</span>
                    <span class="fp-orange">{{ 'frontpage.title.free'|trans }}</span>
                </h1>
                <p class="fp-hero__lead">{{ 'frontpage.lead'|trans }}</p>
                <div class="fp-hero__actions">
                    <a class="fp-btn fp-btn--primary" href="{{ url('signup') }}">{{ 'frontpage.join.button'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    <a class="fp-btn fp-btn--light" href="#how">{{ 'frontpage.how'|trans }}</a>
                </div>
                <dl class="fp-hero__facts">
                    <div><dt class="js-fp-count" data-count="{{ stats.members }}">{{ stats.members|format_number }}</dt><dd>{{ 'frontpage.fact.members'|trans }}</dd></div>
                    <div><dt>0 €</dt><dd>{{ 'frontpage.fact.forever'|trans }}</dd></div>
                    <div><dt>{{ 'frontpage.fact.since'|trans }}</dt><dd>{{ 'frontpage.fact.nonprofit'|trans }}</dd></div>
                </dl>
            </div>
            <div class="fp-hero__media">
                <img class="fp-hero__photo" src="{{ asset(images[1].high) }}" srcset="{{ asset(images[1].high) }} 1200w, {{ asset(images[1].low) }} 576w" sizes="(max-width: 900px) 100vw, 50vw" alt="">
                {# Two corners of the photo show what happens on the site: each one turns through a few cards (home.js) #}
                <div class="fp-slot fp-slot--a js-fp-slot" aria-hidden="true">
                    <div class="fp-float fp-float--request is-active">
                        <span class="fp-av fp-av--big"><img src="{{ asset('images/avatars/1.webp') }}" alt=""></span>
                        <div class="fp-req__text">
                            <p class="fp-note__title">Danny</p>
                            <p class="fp-note__sub">{{ 'frontpage.card.request'|trans }} · Oct 24 – 31</p>
                        </div>
                        <span class="fp-req__btn" title="{{ 'frontpage.card.decline'|trans }}"><i class="fas fa-xmark"></i></span>
                        <span class="fp-req__btn fp-req__btn--yes" title="{{ 'frontpage.card.accept'|trans }}"><i class="fas fa-check"></i></span>
                    </div>
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-house-circle-check', colour: 'green', title: 'frontpage.note.invitation'|trans({name: 'Lena'}), sub: 'Berlin · Nov 2 – 5'}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-envelope', colour: 'slate', title: 'Kenji: ' ~ 'frontpage.note.message'|trans, sub: 'frontpage.note.message.when'|trans}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-route', colour: 'peach', title: 'frontpage.note.trip'|trans({name: 'Amara', place: 'Lisbon'}), sub: 'Nov 12 – 15 · ' ~ 'frontpage.note.trip.host'|trans}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-calendar-day', colour: 'orange', title: 'frontpage.note.activity'|trans, sub: 'frontpage.note.activity.when'|trans ~ ' · ' ~ 'frontpage.how.meet.going'|trans({count: 12})}) }}
                </div>
                <div class="fp-slot fp-slot--b js-fp-slot" aria-hidden="true">
                    <div class="fp-float fp-float--host is-active">
                        <span class="fp-av fp-av--green fp-av--big"><img src="{{ asset('images/avatars/2.webp') }}" alt=""><i class="fp-av__dot"></i></span>
                        <div>
                            <p class="fp-float__name"><strong>Lena</strong> {{ 'frontpage.card.host.in'|trans }} Berlin</p>
                            <p class="fp-float__refs"><span class="fp-tag fp-tag--green"><i class="fas fa-thumbs-up"></i> 13</span> <span class="fp-tag">− 1</span> {{ 'frontpage.card.references'|trans({count: 14}) }}</p>
                            <p class="fp-float__quote">“{{ 'frontpage.card.quote'|trans }}”</p>
                        </div>
                    </div>
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-thumbs-up', colour: 'green', title: 'frontpage.note.reference'|trans, sub: 'frontpage.note.reference.from'|trans({name: 'Tomás'}) ~ ' · “' ~ 'frontpage.note.reference.quote'|trans ~ '”'}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-bolt', colour: 'yellow', title: 'frontpage.note.replies'|trans, sub: 'frontpage.note.replies.rate'|trans({rate: 96})}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-language', colour: 'blue', title: 'frontpage.note.languages'|trans({languages: 'English, French, Italian'}), sub: 'frontpage.note.languages.mother'|trans({language: 'French'})}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-location-dot', colour: 'peach', title: 'frontpage.note.nearby'|trans({count: 38}), sub: 'frontpage.note.nearby.within'|trans({km: 20, place: 'Paris'})}) }}
                    {{ include('home/_frontpage_note.html.twig', {icon: 'fa-person-hiking', colour: 'sage', title: 'Hiking Enthusiasts', sub: 'frontpage.note.group'|trans({count: 6})}) }}
                </div>
            </div>
        </div>
    </section>

    <section class="fp-free">
        <div class="fp-wrap fp-free__in">
            <div class="fp-free__head">
                <h2 class="fp-free__title">{{ 'frontpage.free.title'|trans }} <span class="fp-orange">{{ 'frontpage.free.really'|trans }}</span></h2>
                <p>{{ 'frontpage.free.sub'|trans }}</p>
            </div>
            {% for _item in [
                {icon: 'fa-hand-holding-heart', key: 'fees'},
                {icon: 'fa-users', key: 'volunteers'},
                {icon: 'fa-code', key: 'opensource'},
            ] %}
                <div class="fp-free__item">
                    <span class="fp-free__icon"><i class="fas {{ _item.icon }}" aria-hidden="true"></i></span>
                    <div>
                        <h3>{{ ('frontpage.free.' ~ _item.key)|trans }}</h3>
                        <p>{{ ('frontpage.free.' ~ _item.key ~ '.text')|trans }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="fp-how" id="how">
        <div class="fp-wrap">
            <p class="fp-eyebrow">{{ 'frontpage.how.eyebrow'|trans }}</p>
            <h2 class="fp-h2">{{ 'frontpage.how.title'|trans }}</h2>

            <div class="fp-how__grid">
                <article class="fp-step fp-step--wide">
                    <div class="fp-step__art fp-map" aria-hidden="true">
                        <div class="fp-map__tiles js-fp-map"></div>
                        <div class="fp-map__search"><i class="fas fa-search"></i> <strong>Berlin</strong> · Nov 2–5 <span class="fp-map__chip"><i class="fas fa-home"></i> {{ 'frontpage.how.hosting'|trans }}</span></div>
                        <span class="fp-pin fp-av fp-av--green" style="left: 18%; top: 38%;"><img src="{{ asset('images/avatars/2.webp') }}" alt=""></span>
                        <span class="fp-pin fp-av fp-av--brown" style="left: 45%; top: 26%;"><img src="{{ asset('images/avatars/3.webp') }}" alt=""></span>
                        <span class="fp-pin fp-av fp-av--purple" style="left: 34%; top: 53%;"><img src="{{ asset('images/avatars/8.webp') }}" alt=""></span>
                        <span class="fp-pin fp-av fp-av--orange" style="left: 59%; top: 59%;"><img src="{{ asset('images/avatars/10.webp') }}" alt=""></span>
                        <span class="fp-pin fp-av fp-av--slate" style="left: 82%; top: 64%;"><img src="{{ asset('images/avatars/7.webp') }}" alt=""></span>
                        <span class="fp-pin fp-av fp-av--green" style="left: 72%; top: 40%;"><img src="{{ asset('images/avatars/11.webp') }}" alt=""></span>
                        <div class="fp-map__card"><span class="fp-av fp-av--green fp-av--big"><img src="{{ asset('images/avatars/2.webp') }}" alt=""></span><div><strong>Lena</strong><small>Kreuzberg · German, English</small></div><span class="fp-tag fp-tag--green"><i class="fas fa-thumbs-up"></i> 13</span></div>
                    </div>
                    <div class="fp-step__text">
                        <h3><span class="fp-num">1</span> {{ 'frontpage.how.search'|trans }}</h3>
                        <p>{{ 'frontpage.how.search.text'|trans }}</p>
                    </div>
                </article>

                <article class="fp-step">
                    <div class="fp-step__art" aria-hidden="true">
                        <div class="fp-mini">
                            <div class="fp-mini__head"><span class="fp-av fp-av--purple fp-av--sm"><img src="{{ asset('images/avatars/5.webp') }}" alt=""></span><strong>{{ 'frontpage.how.trip.name'|trans }}</strong><span class="fp-tag fp-tag--orange"><i class="fas fa-globe"></i> {{ 'frontpage.how.trip.public'|trans }}</span></div>
                            {% for _leg in [['Berlin', 'Nov 2 – 5'], ['Prague', 'Nov 5 – 8'], ['Vienna', 'Nov 8 – 11']] %}
                                <div class="fp-mini__leg"><span class="fp-num fp-num--{{ loop.first ? 'on' : 'off' }}">{{ loop.index }}</span><strong>{{ _leg[0] }}</strong><small>{{ _leg[1] }}</small></div>
                            {% endfor %}
                        </div>
                        <p class="fp-stackline"><span class="fp-stack"><span class="fp-av fp-av--green fp-av--sm"><img src="{{ asset('images/avatars/2.webp') }}" alt=""></span><span class="fp-av fp-av--brown fp-av--sm"><img src="{{ asset('images/avatars/9.webp') }}" alt=""></span><span class="fp-av fp-av--slate fp-av--sm"><img src="{{ asset('images/avatars/11.webp') }}" alt=""></span></span> {{ 'frontpage.how.trip.invited'|trans }}</p>
                    </div>
                    <div class="fp-step__text">
                        <h3><span class="fp-num">2</span> {{ 'frontpage.how.trip'|trans }}</h3>
                        <p>{{ 'frontpage.how.trip.text'|trans }}</p>
                    </div>
                </article>

                <article class="fp-step">
                    <div class="fp-step__art" aria-hidden="true">
                        <div class="fp-mini">
                            <div class="fp-mini__head"><span class="fp-av fp-av--brown fp-av--sm"><img src="{{ asset('images/avatars/3.webp') }}" alt=""></span><strong>Tomás</strong><span class="fp-tag fp-tag--orange"><i class="fas fa-bed"></i> Nov 2 – 5 · 3 nights</span></div>
                            <p class="fp-mini__msg">{{ 'frontpage.how.request.message'|trans }}</p>
                        </div>
                        <p class="fp-accepted"><span class="fp-pill-green"><i class="fas fa-check"></i> {{ 'frontpage.how.request.accepted'|trans }}</span><span class="fp-av fp-av--green fp-av--sm"><img src="{{ asset('images/avatars/2.webp') }}" alt=""></span></p>
                    </div>
                    <div class="fp-step__text">
                        <h3><span class="fp-num">3</span> {{ 'frontpage.how.request'|trans }}</h3>
                        <p>{{ 'frontpage.how.request.text'|trans }}</p>
                    </div>
                </article>

                <article class="fp-step">
                    <div class="fp-step__art" aria-hidden="true">
                        {% for _event in [['2', 'frontpage.how.meet.picnic', 12], ['9', 'frontpage.how.meet.cafe', 7]] %}
                            <div class="fp-mini fp-event">
                                <span class="fp-event__date"><small>NOV</small>{{ _event[0] }}</span>
                                <div><strong>{{ _event[1]|trans }}</strong><p class="fp-stackline"><span class="fp-stack"><span class="fp-av fp-av--green fp-av--xs"><img src="{{ asset('images/avatars/9.webp') }}" alt=""></span><span class="fp-av fp-av--brown fp-av--xs"><img src="{{ asset('images/avatars/10.webp') }}" alt=""></span><span class="fp-av fp-av--slate fp-av--xs"><img src="{{ asset('images/avatars/8.webp') }}" alt=""></span></span> {{ 'frontpage.how.meet.going'|trans({count: _event[2]}) }}</p></div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="fp-step__text">
                        <h3><span class="fp-num">4</span> {{ 'frontpage.how.meet'|trans }}</h3>
                        <p>{{ 'frontpage.how.meet.text'|trans }}</p>
                    </div>
                </article>

                <article class="fp-step">
                    <div class="fp-step__art" aria-hidden="true">
                        <div class="fp-mini">
                            <div class="fp-mini__head"><span class="fp-av fp-av--brown fp-av--sm"><img src="{{ asset('images/avatars/3.webp') }}" alt=""></span><strong>Tomás</strong><span class="fp-tag fp-tag--green"><i class="fas fa-thumbs-up"></i> {{ 'frontpage.how.trust.positive'|trans }}</span></div>
                            <p class="fp-mini__msg">“{{ 'frontpage.how.trust.quote'|trans }}”</p>
                        </div>
                        <p class="fp-center"><span class="fp-tag fp-tag--green"><i class="fas fa-thumbs-up"></i> 13</span> <span class="fp-tag">− 1</span></p>
                    </div>
                    <div class="fp-step__text">
                        <h3><span class="fp-num">5</span> {{ 'frontpage.how.trust'|trans }}</h3>
                        <p>{{ 'frontpage.how.trust.text'|trans }}</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="fp-community">
        <div class="fp-wrap fp-community__in">
            <img class="fp-community__photo" src="{{ asset(images[2].high) }}" srcset="{{ asset(images[2].high) }} 1200w, {{ asset(images[2].low) }} 576w" sizes="(max-width: 900px) 100vw, 50vw" alt="" loading="lazy">
            <div>
                <p class="fp-eyebrow">{{ 'frontpage.community.eyebrow'|trans }}</p>
                <h2 class="fp-h2">{{ 'frontpage.community.title'|trans }}</h2>
                <p class="fp-community__lead">{{ 'frontpage.community.lead'|trans }}</p>
                <ul class="fp-community__list">
                    <li><span class="fp-community__icon"><i class="fas fa-language" aria-hidden="true"></i></span><span>{{ 'frontpage.community.translated'|trans|raw }}</span></li>
                    <li><span class="fp-community__icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></span><span>{{ 'frontpage.community.moderated'|trans|raw }}</span></li>
                    <li><span class="fp-community__icon"><i class="far fa-calendar-alt" aria-hidden="true"></i></span><span>{{ 'frontpage.community.activities'|trans|raw }}</span></li>
                </ul>
                <a class="fp-link" href="{{ path('getactive') }}">{{ 'frontpage.community.volunteer'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </section>

    <section class="fp-last">
        <div class="fp-wrap">
            <div class="fp-last__card">
                <div class="fp-last__text">
                    <span class="fp-stack fp-stack--big" aria-hidden="true"><span class="fp-av fp-av--brown"><img src="{{ asset('images/avatars/2.webp') }}" alt=""></span><span class="fp-av fp-av--purple"><img src="{{ asset('images/avatars/10.webp') }}" alt=""></span><span class="fp-av fp-av--slate"><img src="{{ asset('images/avatars/8.webp') }}" alt=""></span><span class="fp-av"><img src="{{ asset('images/avatars/1.webp') }}" alt=""></span><span class="fp-av"><img src="{{ asset('images/avatars/7.webp') }}" alt=""></span></span>
                    <h2 class="fp-h2">{{ 'frontpage.last.title'|trans }} <span class="fp-orange">{{ 'frontpage.last.world'|trans }}</span></h2>
                    <p>{{ 'frontpage.last.text'|trans }}</p>
                    <a class="fp-btn fp-btn--primary" href="{{ url('signup') }}">{{ 'frontpage.last.join'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <img class="fp-last__photo" src="{{ asset(images[3].high) }}" srcset="{{ asset(images[3].high) }} 1200w, {{ asset(images[3].low) }} 576w" sizes="(max-width: 900px) 100vw, 50vw" alt="" loading="lazy">
            </div>
        </div>
    </section>
</main>

{% include 'footer.html.twig' %}

{{ encore_entry_script_tags('home') }}
{{ encore_entry_script_tags('password/showhide') }}
<script>
    window.addEventListener("load", function () {
        let locale = document.getElementsByTagName('html')[0].getAttribute('lang');
        let privacyUrl = "/privacy";
        if ('fr' === locale) {
            privacyUrl += "/fr";
        }
        window.cookieconsent.initialise({
            "palette": {
                "popup": {
                    "background": "#ffffff",
                    "text": "#334155"
                },
                "button": {
                    "background": "#f37000",
                    "text": "#ffffff"
                }
            },
            "theme": "edgeless",
            "position": "bottom",
            "content": {
                "href": privacyUrl,
                message: "{{ 'cookie.consent.message'|trans }}",
                dismiss: "{{ 'cookie.consent.dismiss'|trans }}",
                link: "{{ 'cookie.consent.learnmore'|trans }}"
            }
        })
    });
</script>
{% endblock content %}
</body>
</html>
