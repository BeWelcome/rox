{#
  What the invitation is about, above the messages, as a card (like the hosting request
  one, request/header.html.twig): "Invitation" and where it stands, arrival and
  departure with the nights between, then the people and the year; a warning when the
  dates differ from the trip's. The host (who invited) and the guest read a
  different status text. Expects invitation, leg, original and myself.
#}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set side = original.Initiator == myself ? 'host' : 'guest' %}
{% set statuses = {
    (constant(S ~ 'REQUEST_OPEN')): { key: 'open', tone: 'pending', icon: 'fas fa-clock' },
    (constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED')): { key: 'tentatively', tone: 'maybe', icon: 'fa fa-question' },
    (constant(S ~ 'REQUEST_ACCEPTED')): { key: 'accepted', tone: 'success', icon: 'far fa-handshake' },
    (constant(S ~ 'REQUEST_DECLINED')): { key: 'declined', tone: 'danger', icon: 'fa fa-times' },
    (constant(S ~ 'REQUEST_CANCELLED')): { key: 'cancelled', tone: 'danger', icon: 'fa fa-times' },
} %}
{% set status = statuses[invitation.status] ?? { key: null, tone: 'pending', icon: '' } %}
{% set nights = date(invitation.departure|date('Y-m-d')).diff(date(invitation.arrival|date('Y-m-d'))).days %}
{% set sameYear = invitation.arrival|date('Y') == invitation.departure|date('Y') %}

<section class="c-stay-card c-stay-card--{{ status.tone }}">
    <div class="c-stay-card__top">
        <p class="c-stay-card__kind"><i class="fas fa-house-user" aria-hidden="true"></i> {{ 'invitation.card.title'|trans }}</p>
        {% if status.key %}
            <span class="c-stay-card__status"><i class="{{ status.icon }}" aria-hidden="true"></i> {{ ('request.status.' ~ status.key)|trans }}</span>
        {% endif %}
    </div>
    <div class="c-stay-card__dates">
        <p class="c-stay-card__date">
            <span class="c-stay-card__label">{{ 'request.card.arrival'|trans }} · {{ invitation.arrival|format_date(pattern='EEE') }}</span>
            <strong>{{ invitation.arrival|format_date(pattern=sameYear ? 'd MMM' : 'd MMM y') }}{% if sameYear %}<span class="c-stay-card__y"> {{ invitation.arrival|date('Y') }}</span>{% endif %}</strong>
        </p>
        <span class="c-stay-card__nights"><i class="fas fa-moon c-stay-card__moon" aria-hidden="true"></i><i class="fas fa-arrow-right c-stay-card__arrow" aria-hidden="true"></i> {{ 'contact.trip.nights'|trans({ count: nights }) }}</span>
        <p class="c-stay-card__date c-stay-card__date--end">
            <span class="c-stay-card__label">{{ 'request.card.departure'|trans }} · {{ invitation.departure|format_date(pattern='EEE') }}</span>
            <strong>{{ invitation.departure|format_date(pattern=sameYear ? 'd MMM' : 'd MMM y') }}{% if sameYear %}<span class="c-stay-card__y"> {{ invitation.departure|date('Y') }}</span>{% endif %}</strong>
        </p>
    </div>
    <ul class="c-stay-card__facts">
        <li><i class="fa fa-users" aria-hidden="true"></i> {{ 'request.card.persons'|trans({ count: invitation.numberOfTravellers }) }}</li>
        {% include 'request/_card_cancel.html.twig' with { stay: invitation, place: 'facts', confirm: 'invitation.confirm.cancel' } %}
    </ul>
    {% include 'request/_card_cancel.html.twig' with { stay: invitation, place: 'side', confirm: 'invitation.confirm.cancel' } %}
    {% if invitation.status != constant(S ~ 'REQUEST_ACCEPTED') and (invitation.arrival|date('Y-m-d') != leg.arrival|date('Y-m-d') or invitation.departure|date('Y-m-d') != leg.departure|date('Y-m-d')) %}
        <p class="c-stay-card__warning"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> {{ 'trip.leg.not.matched'|trans }}</p>
    {% endif %}
</section>
