{#
  What the invitation is about, above the messages: the dates and where the invitation
  stands, then the nights and the people. The host (who invited) and the guest read a
  different status text. Expects invitation, leg, original and myself.
#}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set side = original.Initiator == myself ? 'host' : 'guest' %}
{% set statuses = {
    (constant(S ~ 'REQUEST_OPEN')): { key: 'open', tone: 'pending', icon: 'fa fa-question' },
    (constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED')): { key: 'tentatively', tone: 'pending', icon: 'fa fa-question' },
    (constant(S ~ 'REQUEST_ACCEPTED')): { key: 'accepted', tone: 'success', icon: 'far fa-handshake' },
    (constant(S ~ 'REQUEST_DECLINED')): { key: 'declined', tone: 'danger', icon: 'fa fa-times' },
    (constant(S ~ 'REQUEST_CANCELLED')): { key: 'cancelled', tone: 'danger', icon: 'fa fa-times' },
} %}
{% set status = statuses[invitation.status] ?? { key: null, tone: 'pending', icon: '' } %}
{% set nights = date(invitation.departure).diff(date(invitation.arrival)).days %}
{% set sameYear = invitation.arrival|date('Y') == invitation.departure|date('Y') %}

<section class="c-inbox-trip c-inbox-trip--{{ status.tone }}">
    <span class="c-inbox-trip__icon" aria-hidden="true"><i class="fas fa-bed"></i></span>
    <div class="c-inbox-trip__body">
        <div class="c-inbox-trip__top">
            <p class="c-inbox-trip__dates">
                <span class="c-inbox-trip__day">{{ invitation.arrival|format_date(pattern='EEE') }}</span>
                {{ invitation.arrival|format_date(pattern=sameYear ? 'd MMM' : 'd MMM y') }}
                <span class="c-inbox-trip__sep" aria-hidden="true">→</span>
                <span class="c-inbox-trip__day">{{ invitation.departure|format_date(pattern='EEE') }}</span>
                {{ invitation.departure|format_date(pattern='d MMM y') }}
            </p>
        </div>
        <ul class="c-inbox-trip__facts">
            <li><i class="fa fa-moon" aria-hidden="true"></i> {{ 'request.night.stay'|trans({ numbernights: nights }) }}</li>
            <li><i class="fa fa-users" aria-hidden="true"></i> {{ 'request.number.persons'|trans({ numberpersons: invitation.numberOfTravellers }) }}</li>
        </ul>
        {% if invitation.status != constant(S ~ 'REQUEST_ACCEPTED') and (invitation.arrival|date('Y-m-d') != leg.arrival|date('Y-m-d') or invitation.departure|date('Y-m-d') != leg.departure|date('Y-m-d')) %}
            <p class="c-inbox-trip__warning">{{ 'trip.leg.not.matched'|trans }}</p>
        {% endif %}
    </div>
    {% if status.key %}
        {# Short status on the right. #}
        <span class="c-inbox-trip__status">
            <i class="{{ status.icon }}" aria-hidden="true"></i>
            {{ ('request.status.' ~ status.key)|trans }}
        </span>
    {% endif %}
</section>
