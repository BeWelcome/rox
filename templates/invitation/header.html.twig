{#
  What the invitation is about, above the messages, as a card (like the hosting request
  one, request/header.html.twig): "Invitation" and where it stands, arrival and
  departure with the nights between, then the people and the year; a warning when the
  dates differ from the trip's. The host (who invited) and the guest read a
  different status text. Expects invitation, leg, original and myself.
#}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set side = original.Initiator == myself ? 'host' : 'guest' %}
{% set statuses = {
    (constant(S ~ 'REQUEST_OPEN')): { key: 'open', tone: 'pending', icon: 'fas fa-clock' },
    (constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED')): { key: 'tentatively', tone: 'maybe', icon: 'fa fa-question' },
    (constant(S ~ 'REQUEST_ACCEPTED')): { key: 'accepted', tone: 'success', icon: 'far fa-handshake' },
    (constant(S ~ 'REQUEST_DECLINED')): { key: 'declined', tone: 'danger', icon: 'fa fa-times' },
    (constant(S ~ 'REQUEST_CANCELLED')): { key: 'cancelled', tone: 'danger', icon: 'fa fa-times' },
} %}
{% set status = statuses[invitation.status] ?? { key: null, tone: 'pending', icon: '' } %}
{# Still waiting (or maybe) when the arrival has passed: nobody can answer any more (BaseRequestModel::hasExpired) #}
{% if invitation.status in [constant(S ~ 'REQUEST_OPEN'), constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED')] and invitation.arrival|date('Y-m-d') < 'now'|date('Y-m-d') %}
    {% set status = { key: 'expired', tone: 'expired', icon: 'fas fa-calendar-xmark' } %}
{% endif %}
{% set nights = date(invitation.departure|date('Y-m-d')).diff(date(invitation.arrival|date('Y-m-d'))).days %}

{% set _menu %}{% include 'request/_card_menu.html.twig' with { stay: invitation, confirm: 'invitation.confirm.cancel', dates: false } %}{% endset %}
{% set _warning %}
    {% if invitation.status != constant(S ~ 'REQUEST_ACCEPTED') and (invitation.arrival|date('Y-m-d') != leg.arrival|date('Y-m-d') or invitation.departure|date('Y-m-d') != leg.departure|date('Y-m-d')) %}
        <p class="c-stay2__warning"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> {{ 'trip.leg.not.matched'|trans }}</p>
    {% endif %}
{% endset %}
{% include 'request/_stay_card.html.twig' with {
    stay: invitation, status: status, nights: nights, kind: 'invitation', decider: side == 'guest',
    other: original.Initiator == myself ? original.Receiver : original.Initiator,
    subject: original.subject.subject ?? '', menu: _menu, warning: _warning
} %}
