{% extends 'conversations/reply_layout.html.twig' %}

{% set compose_class = ' c-inbox-compose--large' %}

{% block javascripts %}
    {{ encore_entry_script_tags('requests') }}
{% endblock javascripts %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind')  }}
    {{ encore_entry_link_tags('requests')  }}
{% endblock stylesheets %}

{% block reply_extra %}
    {% set original = thread | last %}
    {% set current = thread | first %}
    {% set request = current.request %}
    {% set invitation = current.request %}
    {% set receiver = original.receiver %}
    {% set myself = app.user %}
    {% include 'invitation/trip.summary.html.twig' with {'open': false} %}
    {% include 'invitation/header.html.twig' %}
{% endblock reply_extra %}

{% block reply_form %}
    {% set current = thread | first %}
    {% set request = current.request %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'autocomplete': 'off'}}) }}
        {{ form_errors(form) }}
        {% if form.message.vars.errors|length > 0 %}
            <div class="c-inbox-compose__error">{{ form_errors(form.message) }}</div>
        {% endif %}
        <div class="c-inbox-compose__editor">
            {{ form_widget(form.message) }}
        </div>
        {% do form.message.setRendered %}

        <div class="c-inbox-compose__fields">
            {{ form_row(form.request.arrival) }}
            {{ form_row(form.request.departure) }}
            {{ form_row(form.request.numberOfTravellers) }}
            {{ form_row(form.request.inviteForLeg) }}
        </div>

        <div class="c-inbox-compose__actions">
            {% if request.status != constant('App\\Entity\\HostingRequest::REQUEST_DECLINED') %}
                <div class="btn-group c-inbox-compose__decline">
                    <button type="submit" id="{{ form.decline.vars.id }}" name="{{ form.decline.vars.full_name }}" class="c-inbox-actions__btn c-inbox-actions__btn--outline c-inbox-compose__split">
                        {{ form.decline.vars.label|trans }}
                    </button>
                    <button type="button" class="c-inbox-actions__btn c-inbox-actions__btn--outline c-inbox-compose__split-toggle dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="visually-hidden">{{ 'toggle.dropdown'|trans }}</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end c-inbox-compose__menu">
                        <button type="submit" form="conversation-decline-{{ current.id }}" class="dropdown-item">{{ 'label.decline.no.message'|trans }}</button>
                    </div>
                </div>
            {% endif %}
            {% do form.decline.setRendered %}
            {{ form_widget(form.update, {'attr': {'class': 'c-inbox-actions__btn c-inbox-actions__btn--outline'}}) }}
            {% if form.tentatively is defined %}
                {{ form_widget(form.tentatively, {'attr': {'class': 'c-inbox-actions__btn c-inbox-actions__btn--outline'}}) }}
            {% endif %}
            {% if form.accept is defined %}
                {{ form_widget(form.accept, {'attr': {'class': 'c-inbox-reply__btn c-inbox-compose__send'}}) }}
            {% endif %}
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
    {# declining without a message posts its own form (the button above is in the reply form) #}
    <form id="conversation-decline-{{ current.id }}" method="post" action="{{ url('conversation_decline', {id: current.id}) }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\ConversationController::TOKEN')) }}">
    </form>
{% endblock reply_form %}
