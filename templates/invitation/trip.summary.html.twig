<div class="u:flex u:justify-between u:items-center bg-white p-1 mb-1 u:rounded-4">
    <div><strong>{{ 'invitation.trip.summary'|trans }}</strong></div>
    <div>
        <button class="o-button" type="button" data-bs-toggle="collapse" data-bs-target="#tripSummary" aria-expanded="false" aria-controls="#tripSummary">
            {{ 'invitation.trip.summary.show.hide'|trans }}
        </button>
    </div>
</div>
<div class="row g-0 mb-1 bg-white {% if open %}show{% else %}collapse{% endif %} p-1" id="tripSummary">
    <div class="col-12 col-md-4 pe-1">
        <p><strong><a href="{{ url('trip_show', { id: leg.trip.id }) }}">{{ 'trip.summary'|trans }}</a></strong></p>
        <p>{{ leg.trip.summary }}</p>
        <p><strong>{{ 'trip.description'|trans }}</strong></p>
        <p>{{ leg.trip.description|purify }}</p>
        <p><strong>{{ 'request.number_of_travellers'|trans }}</strong></p>
        <p>{{ leg.trip.countOfTravellers }}</p>
        <p><strong>{{ 'location'|trans }}</strong></p>
        <p>{{ leg.location.name }}</p>
    </div>
    <div class="col-12 col-md-6">
        {% if app.user != guest %}
            {# Show profile summary only to potential hosts #}
            <p><strong>{{ 'profile.summary'|trans }}</strong></p>
            {# Member texts by language (Member::getTranslations); the summary is "AboutMe" (formerly "ProfileSummary") #}
            {% set fields = guest.translations %}
            {% set localeFields = fields[app.request.locale] ?? fields['en'] ?? {} %}
            {% set summary = localeFields['AboutMe'] ?? localeFields['ProfileSummary'] ?? ((fields|filter(f => f['AboutMe'] ?? false)|first)['AboutMe'] ?? null) %}
            <p>
                {% if summary %}
                    {{ summary|purify }}
                {% else %}
                    {{ 'profile.summary.none'|trans }}
                {% endif %}
            </p>
        {% endif %}
    </div>
</div>
