{% import 'macros.twig' as macros %}
{% extends 'conversations/view.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('requests') }}
{% endblock stylesheets %}

{# The answer under the thread (Accept, Maybe, Decline, the message) needs requests.js #}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('requests') }}
{% endblock javascripts %}

{% block additional %}
    {% set original = thread | last %}{% set invitation = (thread | first).request %}
    {% set myself = app.user %}
    {% set otherUser = (myself == original.Sender) ? original.Receiver : original.Sender %}
    {% if (thread | first).Sender.Username == myself.Username %}
        {% set label = 'update' %}
    {% else %}
        {% set label = 'reply' %}
    {% endif %}
    {% set leg = invitation.inviteForLeg %}

    {% include 'invitation/header.html.twig' %}
{% endblock additional %}
