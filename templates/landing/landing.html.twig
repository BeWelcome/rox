{% extends 'base.html.twig' %}
{% import 'macros.twig' as macros %}

{% block stylesheets %}
  {{ encore_entry_link_tags('jquery_ui') }}
  {{ encore_entry_link_tags('leaflet') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ encore_entry_script_tags('landing') }}
  {{ encore_entry_script_tags('jquery_ui') }}
{% endblock javascripts %}

{% block content %}

{#
  Welcome banner: the member (avatar, name, city, hosting status) on the left, a
  search on the right that switches between a place and a member, and three
  counters at the bottom.
#}
{% set homeCity = searchLocation.vars.value.location ?? '' %}
<div class="l-hello u:my-32">
	<div class="l-hello__top">
		<div class="l-hello__me">
			{% include 'landing/widget/profilepicturewithaccommodation.html.twig' with { member: app.user } only %}

			<div class="l-hello__info">
				<p class="l-hello__label">{{ 'landing.welcomeback'|trans }}</p>
				<p class="l-hello__name">{{ macros.profilelink(app.user.Username) }}</p>
				{% if not app.user.Accommodation is null %}
					<div class="l-hello__where">
						{{ form_start(searchLocation, { action: path('search_locations'), attr: { class: 'l-hello__city-form' } }) }}
						<button type="submit" id="home_updateMap" name="home[updateMap]" class="searchsubmit l-hello__city">
							<i class="fas fa-location-dot" aria-hidden="true"></i> {{ homeCity }}
						</button>
						{% do searchLocation.updateMap.setRendered %}
						<div class="d-none invisible">{{ form_rest(searchLocation) }}</div>
						{{ form_end(searchLocation) }}
						<a class="l-hello__profile" href="{{ path('members_profile', { username: app.user.Username }) }}"><span class="l-hello__long">{{ 'landing.viewprofile'|trans }}</span><span class="l-hello__short">{{ 'landing.viewprofile.short'|trans }}</span></a>
					</div>
					{% include 'landing/widget/accommodation.html.twig' with { member: app.user } only %}
				{% else %}
					<p class="l-hello__not-setup">{{ 'profile.created'|trans }}</p>
				{% endif %}
			</div>
			<a class="l-hello__edit" href="{{ path('profile_edit', { username: app.user.Username }) }}" title="{{ 'editmyprofile'|trans }}" aria-label="{{ 'editmyprofile'|trans }}"><i class="fas fa-user-pen" aria-hidden="true"></i></a>
		</div>

		<div class="l-hello__search js-hello-search" data-mode="place">
			<div class="l-hello__search-head">
				<p class="l-hello__search-title">
					<span class="js-hello-mode-place">{{ 'landing.whereyougo'|trans }}</span>
					<span class="js-hello-mode-member" hidden>{{ 'landing.search.findmember'|trans }}</span>
				</p>
				<div class="l-hello__modes" role="radiogroup" aria-label="{{ 'landing.search.submit'|trans }}">
					<button type="button" class="l-hello__mode active js-hello-mode" data-mode="place" role="radio" aria-checked="true"><i class="fas fa-location-dot" aria-hidden="true"></i> {{ 'landing.search.mode.place'|trans }}</button>
					<button type="button" class="l-hello__mode js-hello-mode" data-mode="member" role="radio" aria-checked="false"><i class="fas fa-user" aria-hidden="true"></i> {{ 'landing.search.mode.member'|trans }}</button>
				</div>
			</div>

			<div class="js-hello-mode-place">
				{{ form_start(tinySearch, { action: path('search_locations'), attr: { class: 'u:w-full' } }) }}
				<label for="{{ tinySearch.location.vars.id }}" class="visually-hidden">{{ 'landing.whereyougo'|trans }}</label>
				<div class="l-hello__bar">
					<i class="fas fa-location-dot l-hello__bar-icon" aria-hidden="true"></i>
					<div class="auto-search-wrapper max-height l-hello__field">
						<input type="text"
							id="{{ tinySearch.location.vars.id }}"
							name="{{ tinySearch.location.vars.full_name }}"
							class="l-hello__input js-location-picker"
							autocomplete="off"
							placeholder="{{ 'landing.search.placeholder'|trans }}"
							{% if tinySearch.location.vars.value %}value="{{ tinySearch.location.vars.value }}"{% endif %}
						>
					</div>
					<button type="submit" id="tiny_updateMap" name="{{ tinySearch.updateMap.vars.name }}" class="l-hello__submit">
						<span class="l-hello__submit-text">{{ 'landing.search.submit'|trans }}</span> <i class="fas fa-arrow-right l-hello__submit-arrow" aria-hidden="true"></i><i class="fas fa-magnifying-glass l-hello__submit-loupe" aria-hidden="true"></i>
					</button>
				</div>
				<div class="u:block">{{ form_errors(tinySearch.location) }}</div>
				{% do tinySearch.location.setRendered %}
				{% do tinySearch.updateMap.setRendered %}
				<div class="d-none" aria-hidden="true">{{ form_rest(tinySearch) }}</div>
				{{ form_end(tinySearch) }}
				<p class="l-hello__hint">{{ 'landing.search.place.hint'|trans }}</p>
			</div>

			<div class="js-hello-mode-member" hidden>
				<form action="{{ path('search_members') }}" method="get" class="l-hello__member-form u:w-full">
					<label for="hello_username" class="visually-hidden">{{ 'landing.search.findmember'|trans }}</label>
					<div class="l-hello__bar">
						<i class="fas fa-at l-hello__bar-icon" aria-hidden="true"></i>
						<div class="l-hello__field">
							<input type="text" id="hello_username" name="username" class="l-hello__input js-hello-username" autocomplete="off" placeholder="{{ 'landing.search.member.placeholder'|trans }}"
								role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="hello_username_list">
						</div>
						<button type="submit" class="l-hello__submit">
							<span class="l-hello__submit-text">{{ 'landing.search.submit'|trans }}</span> <i class="fas fa-arrow-right l-hello__submit-arrow" aria-hidden="true"></i><i class="fas fa-magnifying-glass l-hello__submit-loupe" aria-hidden="true"></i>
						</button>
					</div>
					<ul class="l-hello__suggest js-hello-suggest" id="hello_username_list" role="listbox" hidden
						data-loading="{{ 'landing.search.member.searching'|trans }}"
						data-empty="{{ 'select.no.results'|trans }}"></ul>
				</form>
				<p class="l-hello__hint">{{ 'landing.search.member.hint'|trans }}</p>
			</div>
		</div>
	</div>

	<div class="l-hello__stats">
		<a class="l-hello__stat{% if requestsToAnswerCount %} l-hello__stat--alert{% endif %}" href="{{ url('conversations', { conversationsType: 'requests' }) }}">
			<span class="l-hello__stat-icon"><i class="fas fa-bed" aria-hidden="true"></i></span>
			<span class="l-hello__stat-text"><strong>{{ requestsToAnswerCount }}</strong> <span class="l-hello__long">{{ 'landing.stats.requests'|trans }}</span><span class="l-hello__short">{{ 'landing.stats.requests.short'|trans }}</span></span>
			<i class="fas fa-chevron-right l-hello__stat-go" aria-hidden="true"></i>
		</a>
		<a class="l-hello__stat" href="{{ url('visitors') }}">
			<span class="l-hello__stat-icon"><i class="fas fa-suitcase" aria-hidden="true"></i></span>
			<span class="l-hello__stat-text"><strong>{{ visitorsCount }}</strong> <span class="l-hello__long">{% if homeCity %}{{ 'landing.stats.travelers'|trans({ city: homeCity }) }}{% else %}{{ 'landing.stats.travelers.area'|trans }}{% endif %}</span><span class="l-hello__short">{{ 'landing.stats.travelers.short'|trans }}</span></span>
			<i class="fas fa-chevron-right l-hello__stat-go" aria-hidden="true"></i>
		</a>
		<a class="l-hello__stat l-hello__stat--activities" href="/activities">
			<span class="l-hello__stat-icon"><i class="fas fa-calendar-days" aria-hidden="true"></i></span>
			<span class="l-hello__stat-text"><strong>{{ activityCount }}</strong> <span class="l-hello__long">{{ 'landing.stats.activities'|trans }}</span><span class="l-hello__short">{{ 'landing.stats.activities.short'|trans }}</span></span>
			<i class="fas fa-chevron-right l-hello__stat-go" aria-hidden="true"></i>
		</a>
	</div>
</div>

{#
  The two main blocks: messages and visitors, then forum, activities and notifications.
  Each is a card with its tabs on top; the lists are loaded by landing.js.
  The filter pills keep the "active" class landing.js reads when it reloads a list.
#}
{% set loading %}
    <p class="c-home-list__loading"><i class="fa fa-spinner fa-pulse" aria-hidden="true"></i></p>
{% endset %}
<div class="c-home-blocks">

    {# messages and visitors #}
    <section class="c-home-card">
        <ul class="nav c-home-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link active" aria-controls="conversations" href="#conversations" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.messagesreceived'|trans }}
                    {% if conversationCount %}<span class="c-home-tabs__count">{{ conversationCount }}</span>{% endif %}
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="visitors" href="#visitors" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.visitors'|trans }}
                    {% if visitorsCount %}<span class="c-home-tabs__count">{{ visitorsCount }}</span>{% endif %}
                </a>
            </li>
        </ul>

        <div class="tab-content c-home-card__content">
            <div role="tabpanel" class="tab-pane c-home-pane active" id="conversations">
                <div class="c-home-pane__filters" role="radiogroup" aria-label="{{ 'landing.tab.messagesreceived'|trans }}">
                    <button type="button" class="c-home-pill js-home-filter{% if messageFilter != 'Unread' %} active{% endif %}" id="all" role="radio" aria-checked="{{ messageFilter != 'Unread' ? 'true' : 'false' }}" data-group="messages">{{ 'landing.button.all'|trans }}</button>
                    <button type="button" class="c-home-pill js-home-filter{% if messageFilter == 'Unread' %} active{% endif %}" id="unread" role="radio" aria-checked="{{ messageFilter == 'Unread' ? 'true' : 'false' }}" data-group="messages">{{ 'landing.button.unread'|trans }}</button>
                </div>
                <div id="conversationsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="{{ url('conversations', { conversationsType: 'conversations' }) }}">{{ 'landing.conversations'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="visitors">
                {{ form_start(radiusForm, { attr: { class: 'c-home-pane__radius' } }) }}
                    <i class="fa fa-bullseye" aria-hidden="true"></i>
                    {{ form_label(radiusForm.radius, null, { label_attr: { class: 'c-home-pane__radius-label' } }) }}
                    {{ form_widget(radiusForm.radius, { attr: { class: 'c-home-pane__radius-select' } }) }}
                    {{ form_rest(radiusForm) }}
                {{ form_end(radiusForm) }}
                <div id="legsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="{{ url('visitors') }}"><i class="far fa-map" aria-hidden="true"></i> {{ 'landing.bevisited.alltrips'|trans }}</a>
                </div>
            </div>
        </div>
    </section>

    {# forum, activities and notifications #}
    <section class="c-home-card">
        <ul class="nav c-home-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link active" aria-controls="threads" href="#threads" role="tab" data-bs-toggle="tab">{{ 'landing.tab.forum'|trans }}</a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="activities" href="#activities" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.activities'|trans }}
                    {% if activityCount %}<span class="c-home-tabs__count">{{ activityCount }}</span>{% endif %}
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="notifications" href="#notifications" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.notifications'|trans }}
                    {% if notificationCount %}<span class="c-home-tabs__count">{{ notificationCount }}</span>{% endif %}
                </a>
            </li>
        </ul>

        <div class="tab-content c-home-card__content">
            <div role="tabpanel" class="tab-pane c-home-pane active" id="threads">
                {% set showGroups = forumFilter == 'GroupsAndForums' or forumFilter == 'Groups' %}
                {% set showForums = forumFilter == 'GroupsAndForums' or forumFilter == 'Forums' %}
                <div class="c-home-pane__filters" role="group" aria-label="{{ 'landing.tab.forum'|trans }}">
                    <button type="button" class="c-home-pill js-home-filter{% if showGroups %} active{% endif %}" id="groupsButton" aria-pressed="{{ showGroups ? 'true' : 'false' }}">{{ 'landing.button.groups'|trans|capitalize }}</button>
                    <button type="button" class="c-home-pill js-home-filter{% if showForums %} active{% endif %}" id="forumButton" aria-pressed="{{ showForums ? 'true' : 'false' }}">{{ 'landing.button.forum'|trans|capitalize }}</button>
                </div>
                <div id="threadsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="/forums"><i class="fas fa-comments" aria-hidden="true"></i> {{ 'landing.button.discussions'|trans }}</a>
                    <a class="c-home-link" href="/groups/mygroups"><i class="fas fa-users" aria-hidden="true"></i> {{ 'landing.button.mygroups'|trans }}</a>
                    <a class="c-home-link" href="/forums/subscriptions"><i class="fas fa-check-square" aria-hidden="true"></i> {{ 'landing.button.subscriptions'|trans }}</a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="activities">
                <div class="c-home-pane__filters">
                    <label class="c-home-switch">
                        <input type="checkbox" id="show_online" name="show_online"{% if onlineActivities %} checked{% endif %}>
                        <span class="c-home-switch__track" aria-hidden="true"></span>
                        {{ 'landing.activities.show.online'|trans }}
                    </label>
                    <a class="c-home-pill c-home-pill--action" href="/activities/create"><i class="fa fa-calendar-plus" aria-hidden="true"></i> {{ 'landing.activities.create'|trans }}</a>
                </div>
                <div id="activitiesdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="/activities"><i class="fa fa-map" aria-hidden="true"></i> {{ 'landing.activities.allactivities'|trans }}</a>
                    <a class="c-home-link" href="/activities/myactivities"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'landing.activities.myactivities'|trans }}</a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="notifications">
                <div id="notificationsdisplay" class="c-home-list">{{ loading }}</div>
            </div>
        </div>
    </section>
</div>

{# Be involved: donate, volunteer, and the transparency links #}
{% set goalReached = campaign.yearDonated >= campaign.yearNeeded %}
<section class="c-home-section">
    <h2 class="c-home-section__title">{{ 'landing.beinvolved.title'|trans }}</h2>
    <div class="c-home-involved">
        <div class="c-home-box">
            <div class="c-home-box__head">
                <h3 class="c-home-box__title">{{ 'landing.beinvolved.donate'|trans }}</h3>
                <p class="c-home-box__aside">{{ 'landing.beinvolved.goalfor'|trans }} {{ campaign.year }} - {{ campaign.year + 1 }}: <strong>€{{ campaign.yearNeeded }}</strong></p>
            </div>
            {% if goalReached %}
                {% set goalShare = campaign.yearDonated > 0 ? (campaign.yearNeeded / campaign.yearDonated) * 100 : 100 %}
                <div class="c-home-progress" role="progressbar" aria-valuenow="{{ campaign.yearDonated }}" aria-valuemin="0" aria-valuemax="{{ campaign.yearNeeded }}">
                    <span class="c-home-progress__bar" style="width: {{ goalShare }}%;" title="{{ 'donation.needed'|trans }}"></span>
                    <span class="c-home-progress__bar c-home-progress__bar--extra" style="width: {{ 100 - goalShare }}%;" title="{{ 'donation.additional'|trans }}"></span>
                </div>
            {% else %}
                <div class="c-home-progress" role="progressbar" aria-valuenow="{{ campaign.yearDonated }}" aria-valuemin="0" aria-valuemax="{{ campaign.yearNeeded }}">
                    <span class="c-home-progress__bar" style="width: {{ campaign.yearNeeded > 0 ? (campaign.yearDonated / campaign.yearNeeded) * 100 : 0 }}%;"></span>
                </div>
            {% endif %}
            <p class="c-home-box__amount{% if goalReached %} is-reached{% endif %}"><strong>€ {{ campaign.yearDonated }}</strong> {{ 'dashboard.donation.received'|trans }}</p>
            {% if goalReached %}
                <div class="c-home-box__text">{{ 'donation.thank.you'|trans({ amount: '€' ~ campaign.yearNeeded })|raw }}</div>
            {% endif %}
            <a class="c-home-button{% if goalReached %} c-home-button--outline{% endif %}" href="{{ url('donations') }}"><i class="fa fa-euro-sign" aria-hidden="true"></i> {{ 'landing.beinvolved.pleasedonate'|trans }}</a>
        </div>

        <div class="c-home-box">
            <div class="c-home-box__head">
                <h3 class="c-home-box__title">{{ 'landing.beinvolved.volunteer'|trans }}</h3>
            </div>
            <p class="c-home-box__text">{{ 'landing.beinvolved.intro'|trans }}</p>
            <a class="c-home-button c-home-button--outline" href="{{ url('getactive') }}"><i class="fa fa-wrench" aria-hidden="true"></i> {{ 'landing.beinvolved.helpbewelcome'|trans }}</a>
        </div>

        <div class="c-home-box">
            <div class="c-home-box__head">
                <h3 class="c-home-box__title">{{ 'landing.beinformed.title'|trans }} · {{ 'landing.beinformed.subtitle'|trans }}</h3>
            </div>
            {% set infoLinks = [
                { url: url('about'), icon: 'fa fa-question-circle', label: 'landing.beinformed.about'|trans },
                { url: url('about_faq'), icon: 'fas fa-comments', label: 'landing.beinformed.faq'|trans },
                { url: url('safety'), icon: 'fa fa-user-shield', label: 'landing.beinformed.safety'|trans },
                { url: url('newsletters'), icon: 'far fa-newspaper', label: 'newsletters'|trans },
            ] %}
            {% set moreLinks = [
                { url: 'https://www.bevolunteer.org/', icon: 'fa fa-bullseye', label: 'landing.beinformed.bevolunteer'|trans, external: true },
                { url: 'https://www.bevolunteer.org/reports/annual-reports/', icon: 'fa fa-book', label: 'landing.beinformed.annualreport'|trans, external: true },
                { url: 'https://www.bevolunteer.org/reports/financial-reports/', icon: 'fa fa-money-bill-wave-alt', label: 'landing.beinformed.finances'|trans, external: true },
                { url: url('terms_of_use'), icon: 'fa fa-book', label: 'landing.beinformed.termsofuse'|trans },
                { url: url('privacy_policy'), icon: 'fa fa-book', label: 'landing.beinformed.privacypolicy'|trans },
                { url: url('data_rights'), icon: 'fa fa-book', label: 'landing.beinformed.datarights'|trans },
                { url: url('about_credits'), icon: 'fa fa-book', label: 'credits.title'|trans },
            ] %}
            <ul class="c-home-links">
                {% for link in infoLinks %}
                    <li><a class="c-home-links__item" href="{{ link.url }}"><i class="{{ link.icon }}" aria-hidden="true"></i><span>{{ link.label }}</span><i class="fa fa-chevron-right c-home-links__chevron" aria-hidden="true"></i></a></li>
                {% endfor %}
            </ul>
            {# The other links stay one click away so the three boxes keep the same height. #}
            <details class="c-home-links__more">
                <summary>{{ 'more'|trans|capitalize }}</summary>
                <ul class="c-home-links">
                    {% for link in moreLinks %}
                        <li><a class="c-home-links__item" href="{{ link.url }}"{% if link.external ?? false %} target="_blank" rel="noopener"{% endif %}><i class="{{ link.icon }}" aria-hidden="true"></i><span>{{ link.label }}</span><i class="fa fa-chevron-right c-home-links__chevron" aria-hidden="true"></i></a></li>
                    {% endfor %}
                </ul>
            </details>
        </div>
    </div>
</section>

{# Community news #}
<section class="c-home-section">
    <div class="c-home-section__head">
        <h2 class="c-home-section__title">{{ 'landing.bwnews.title'|trans }} <span class="c-home-section__subtitle">{{ 'landing.bwnews.subtitle'|trans }}</span></h2>
        <a class="c-home-link" href="{{ url('communitynews') }}"><i class="far fa-newspaper" aria-hidden="true"></i> {{ 'landing.bwnews.allnews'|trans }}</a>
    </div>
    <div class="c-home-news">
        {% for news in communityNews %}
            <article class="c-home-box c-home-news__item">
                <h3 class="c-home-news__title"><a href="{{ url('communitynews_show', { id: news.id }) }}">{{ news.title }}</a></h3>
                <p class="c-home-news__text">{{ news.text|striptags|truncate(110) }}</p>
                <div class="c-home-news__meta">
                    <span>{{ news.createdAt.diffForHumans }}</span>
                    <span><i class="far fa-comment" aria-hidden="true"></i> {{ 'bewelcome_news.nrcomments'|trans({ '%commentsCount%': news.comments|length }) }}</span>
                </div>
                <a class="c-home-link" href="{{ url('communitynews_show', { id: news.id }) }}">{{ 'label.read.more'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </article>
        {% endfor %}
    </div>
</section>
{% endblock content %}
