{% extends 'base.html.twig' %}
{# the members' home keeps the footer on phones too #}
{% set footer_on_mobile = true %}
{% import 'macros.twig' as macros %}

{% block stylesheets %}
  {{ encore_entry_link_tags('leaflet') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ encore_entry_script_tags('landing') }}
{% endblock javascripts %}

{% block content %}

{#
  Welcome banner: the member (avatar, name, city, hosting status) on the left, a
  place search with "Plan a trip" next to it on the right. A request to answer shows in a
  thin line under it.
#}
{% set homeCity = searchLocation.vars.value.location ?? '' %}
<div class="l-hello">
	{# On phones the banner folds down to the member line; the choice is kept in the browser. #}
	<script>try { if (localStorage.getItem('bw.hello.collapsed') === '1') { document.currentScript.parentNode.classList.add('is-collapsed'); } } catch (e) {}</script>
	<div class="l-hello__top">
		<div class="l-hello__me js-hello-me">
			{% include 'landing/widget/profilepicturewithaccommodation.html.twig' with { member: app.user } only %}

			<div class="l-hello__info">
				<p class="l-hello__label">{{ 'landing.welcomeback'|trans }}</p>
				<p class="l-hello__name">{{ macros.profilelink(app.user.Username) }}</p>
				{% if not app.user.Accommodation is null %}
					<div class="l-hello__where">
						{{ form_start(searchLocation, { action: path('search_locations'), attr: { class: 'l-hello__city-form' } }) }}
						<button type="submit" id="home_updateMap" name="home[updateMap]" class="searchsubmit l-hello__city">
							{% set _homeAddress = app.user.activeAddress %}
							{% set _homeCountry = _homeAddress and _homeAddress.location ? _homeAddress.location.countryId : null %}
							{% if _homeCountry %}
								<span class="c-tip" data-tip="{{ _homeAddress.location.country ? _homeAddress.location.country.name : _homeCountry }}"><span class="o-flag o-flag--{{ _homeCountry|upper }} l-hello__flag" aria-hidden="true"></span></span>
							{% else %}
								<i class="fas fa-location-dot" aria-hidden="true"></i>
							{% endif %}
							<span>{{ homeCity }}{% if _homeCountry and _homeAddress.location.country %}<span class="l-hello__country">, {{ _homeAddress.location.country.name }}</span>{% endif %}</span>
						</button>
						{% do searchLocation.updateMap.setRendered %}
						<div class="d-none invisible">{{ form_rest(searchLocation) }}</div>
						{{ form_end(searchLocation) }}
						{% set isHosting = app.user.Accommodation == constant('App\\Doctrine\\AccommodationType::YES') %}
						<span class="l-hello__status js-hello-status{% if isHosting %} is-on{% endif %}" data-on="{{ 'hosting'|trans|capitalize }}" data-off="{{ 'not hosting'|trans|capitalize }}">{{ isHosting ? 'hosting'|trans|capitalize : 'not hosting'|trans|capitalize }}</span>
					</div>
					{% include 'landing/widget/accommodation.html.twig' with { member: app.user } only %}
				{% else %}
					<p class="l-hello__not-setup">{{ 'profile.created'|trans }}</p>
				{% endif %}
			</div>
			<button type="button" class="l-hello__toggle js-hello-toggle" aria-expanded="true" aria-controls="hello_search"
				data-expand="{{ 'landing.banner.expand'|trans }}" data-collapse="{{ 'landing.banner.collapse'|trans }}"
				aria-label="{{ 'landing.banner.collapse'|trans }}">
				<i class="fas fa-chevron-up" aria-hidden="true"></i>
			</button>
		</div>

		<div class="l-hello__search js-hello-search" id="hello_search" data-mode="place">
			<div class="l-hello__box">
				<div class="l-hello__modes" role="radiogroup" aria-label="{{ 'landing.search.submit'|trans }}">
					<button type="button" class="l-hello__mode active js-hello-mode" data-mode="place" role="radio" aria-checked="true"><i class="fas fa-location-dot" aria-hidden="true"></i> {{ 'landing.search.mode.place'|trans }}</button>
					<button type="button" class="l-hello__mode js-hello-mode" data-mode="member" role="radio" aria-checked="false"><i class="fas fa-user" aria-hidden="true"></i> {{ 'landing.search.mode.member'|trans }}</button>
				</div>
			<div class="l-hello__go-search js-hello-mode-place">
				{{ form_start(tinySearch, { action: path('search_locations'), attr: { class: 'u:w-full' } }) }}
				<label for="{{ tinySearch.location.vars.id }}" class="visually-hidden">{{ 'landing.whereyougo'|trans }}</label>
				<div class="l-hello__bar">
					<i class="fas fa-location-dot l-hello__bar-icon" aria-hidden="true"></i>
					<div class="auto-search-wrapper max-height l-hello__field">
						<input type="text"
							id="{{ tinySearch.location.vars.id }}"
							name="{{ tinySearch.location.vars.full_name }}"
							class="l-hello__input js-location-picker"
							autocomplete="off"
							placeholder="{{ 'landing.search.where'|trans }}"
							{% if tinySearch.location.vars.value %}value="{{ tinySearch.location.vars.value }}"{% endif %}
						>
					</div>
					{# Picking a place starts the search too (landing.js) #}
					<button type="submit" id="tiny_updateMap" name="{{ tinySearch.updateMap.vars.name }}" class="l-hello__submit">
						<span class="l-hello__submit-text">{{ 'landing.search.submit'|trans }}</span> <i class="fas fa-arrow-right l-hello__submit-arrow" aria-hidden="true"></i><i class="fas fa-magnifying-glass l-hello__submit-loupe" aria-hidden="true"></i>
					</button>
				</div>
				<div class="u:block">{{ form_errors(tinySearch.location) }}</div>
				{% do tinySearch.location.setRendered %}
				{% do tinySearch.updateMap.setRendered %}
				<div class="d-none" aria-hidden="true">{{ form_rest(tinySearch) }}</div>
				{{ form_end(tinySearch) }}
			</div>
			<div class="l-hello__go-search js-hello-mode-member" hidden>
				<form method="get" class="l-hello__member-form u:w-full" data-profile-url="{{ path('members_profile', { username: '__username__' }) }}">
					<label for="hello_username" class="visually-hidden">{{ 'landing.search.findmember'|trans }}</label>
					<div class="l-hello__bar">
						<i class="fas fa-at l-hello__bar-icon" aria-hidden="true"></i>
						<div class="l-hello__field">
							<input type="text" id="hello_username" name="username" class="l-hello__input js-hello-username" autocomplete="off" placeholder="{{ 'landing.search.member.placeholder'|trans }}"
								role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="hello_username_list">
						</div>
						<button type="submit" class="l-hello__submit">
							<span class="l-hello__submit-text">{{ 'landing.search.submit'|trans }}</span> <i class="fas fa-arrow-right l-hello__submit-arrow" aria-hidden="true"></i><i class="fas fa-magnifying-glass l-hello__submit-loupe" aria-hidden="true"></i>
						</button>
					</div>
					<ul class="c-member-suggest js-hello-suggest" id="hello_username_list" role="listbox" hidden
						data-loading="{{ 'landing.search.member.searching'|trans }}"
						data-empty="{{ 'select.no.results'|trans }}"></ul>
				</form>
			</div>
			</div>
			{# Under the box: plan a trip (place), or how to search a member #}
			<p class="l-hello__under js-hello-mode-place">
				<i class="fas fa-route l-hello__under-icon" aria-hidden="true"></i>
				<span class="l-hello__under-text">{{ 'landing.search.dates.known'|trans }}</span>
				<a class="l-hello__under-plan js-contact-open" href="{{ path('new_trip') }}" data-title="{{ 'landing.stats.trip'|trans }}"><i class="fa fa-plus" aria-hidden="true"></i> {{ 'landing.plan.public.trip'|trans }}</a>
				<span class="l-hello__under-hint">· {{ 'landing.plan.public.trip.hint'|trans }}</span>
			</p>
			<p class="l-hello__under js-hello-mode-member" hidden>
				<i class="fas fa-circle-info l-hello__under-icon" aria-hidden="true"></i>
				<span class="l-hello__under-text">{{ 'landing.search.by.username'|trans }}</span>
			</p>
		</div>
	</div>
</div>

{# Requests to answer: reloaded by landing.js when the side panel closes #}
<div class="l-hello-alert-wrap js-home-alert">{% include 'landing/widget/request_alert.html.twig' %}</div>

{#
  The four cards of the dashboard: messages, members coming to the member's area (one trip at a
  time, previous and next), upcoming activities and the discussions of the member's groups.
  Each card has its title, a count and a link to the full list; the lists are loaded by landing.js.
#}
{% set loading %}
    <p class="c-home-list__loading"><i class="fa fa-spinner fa-pulse" aria-hidden="true"></i></p>
{% endset %}
<div class="c-home-blocks c-home-dash">

    {# Messages: the unread count in orange #}
    <section class="c-home-card c-home-dash__card c-home-dash__card--messages" aria-labelledby="home_messages_title">
        <header class="c-home-dash__head">
            <span class="c-home-dash__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
            <h2 class="c-home-dash__title" id="home_messages_title">{{ 'landing.dash.messages'|trans }}</h2>
            {% if conversationCount %}<span class="c-home-dash__count c-home-dash__count--hot">{{ conversationCount }}</span>{% endif %}
        </header>
        <div class="c-home-pane c-home-dash__body">
            <div id="conversationsdisplay" class="c-home-list">{{ loading }}</div>
            {% set _allConversations = inbox_total_count() %}
            <div class="c-home-pane__footer c-home-pane__footer--more">
                <a class="c-home-more" href="{{ url('conversations', { conversationsType: 'conversations' }) }}">
                    {{ 'landing.conversations.all'|trans }}
                    <i class="fas fa-chevron-right c-home-more__chevron" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    {# Trips to the member's area: one at a time, the distance in a pill (landing.js reloads the list) #}
    {% set _radius = radiusForm.radius.vars.value|default('') %}
    {# Hidden when nobody comes (landing.js checks again once the list is loaded) #}
    <section class="c-home-card c-home-dash__card c-home-dash__card--trips js-home-trips" aria-labelledby="home_trips_title"{% if not visitorsCount %} hidden{% endif %}>
        <header class="c-home-dash__head">
            <span class="c-home-dash__icon" aria-hidden="true"><i class="fas fa-suitcase"></i></span>
            <h2 class="c-home-dash__title" id="home_trips_title">
                <a href="{{ url('visitors') }}">{{ homeCity ? 'landing.dash.coming.to'|trans({ city: homeCity }) : 'landing.tab.visitors'|trans }}</a>
            </h2>
            <span class="c-home-dash__count js-home-trips-position" hidden></span>
            <label class="c-home-dash__radius">
                <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                <span class="visually-hidden">{{ 'trips.radius'|trans }}</span>
                <select class="js-home-trips-radius">
                    {% for choice in radiusForm.radius.vars.choices %}
                        {% if choice.value in ['20', '50', '100', '200'] or choice.value == _radius ~ '' %}
                            <option value="{{ choice.value }}"{% if choice.value == _radius ~ '' %} selected{% endif %}>{{ choice.label|trans }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </label>
            <input type="hidden" id="trips_radius" value="{{ _radius }}">
        </header>
        <div class="c-home-pane c-home-dash__body">
            <div id="legsdisplay" class="c-home-list">{{ loading }}</div>
        </div>
    </section>

    {# Upcoming activities, and a button to create one; none: a thin strip at the bottom #}
    <section class="c-home-card c-home-dash__card c-home-dash__card--activities js-home-activities{% if not activityCount %} is-empty{% endif %}" aria-labelledby="home_activities_title" data-online="{{ onlineActivities ? 1 : 0 }}">
        <header class="c-home-dash__head">
            <span class="c-home-dash__icon" aria-hidden="true"><i class="far fa-calendar"></i></span>
            <h2 class="c-home-dash__title" id="home_activities_title">{{ 'landing.dash.activities'|trans }}</h2>
            {% if activityCount %}<span class="c-home-dash__count">{{ activityCount }}</span>{% endif %}
            <a class="c-home-dash__add" href="{{ path('activities_create') }}" aria-label="{{ 'landing.activities.create'|trans }}"><i class="fas fa-plus" aria-hidden="true"></i></a>
        </header>
        <div class="c-home-pane c-home-dash__body">
            <div id="activitiesdisplay" class="c-home-list">{{ loading }}</div>
            <div class="c-home-pane__footer c-home-pane__footer--more">
                <a class="c-home-more" href="{{ path('activities') }}">
                    {{ 'landing.dash.activities.all'|trans }}
                    <i class="fas fa-chevron-right c-home-more__chevron" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    {# The discussions of the member's groups, the BeWelcome group's agora included #}
    <section class="c-home-card c-home-dash__card c-home-dash__card--groups" aria-labelledby="home_groups_title">
        <header class="c-home-dash__head">
            <span class="c-home-dash__icon" aria-hidden="true"><i class="fas fa-comments"></i></span>
            <h2 class="c-home-dash__title" id="home_groups_title">{{ 'landing.dash.groups'|trans }}</h2>
        </header>
        <div class="c-home-pane c-home-dash__body">
            <div id="groupsdisplay" class="c-home-list">{{ loading }}</div>
            <div class="c-home-pane__footer c-home-pane__footer--more">
                <a class="c-home-more" href="{{ path('groups_mygroups') }}">
                    {{ 'landing.dash.groups.all'|trans }}
                    <i class="fas fa-chevron-right c-home-more__chevron" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
</div>

{% if countries is not empty %}
    {% include 'landing/_countries.html.twig' %}
{% endif %}

{# Be involved: donate, volunteer, and the transparency links #}
{% set goalReached = campaign.yearDonated >= campaign.yearNeeded %}
<section class="c-home-section c-home-section--divided">
    <h2 class="c-home-section__title">{{ 'landing.beinvolved.title'|trans }}</h2>
    <div class="c-home-involved">
        <div class="c-home-box">
            <div class="c-home-box__head">
                <h3 class="c-home-box__title">{{ 'landing.beinvolved.donate'|trans }}</h3>
                <p class="c-home-box__aside">{{ 'landing.beinvolved.goalfor'|trans }} {{ campaign.year }} - {{ campaign.year + 1 }}: <strong>€{{ campaign.yearNeeded }}</strong></p>
            </div>
            {% if goalReached %}
                {% set goalShare = campaign.yearDonated > 0 ? (campaign.yearNeeded / campaign.yearDonated) * 100 : 100 %}
                <div class="c-home-progress" role="progressbar" aria-valuenow="{{ campaign.yearDonated }}" aria-valuemin="0" aria-valuemax="{{ campaign.yearNeeded }}">
                    <span class="c-home-progress__bar" style="width: {{ goalShare }}%;" title="{{ 'donation.needed'|trans }}"></span>
                    <span class="c-home-progress__bar c-home-progress__bar--extra" style="width: {{ 100 - goalShare }}%;" title="{{ 'donation.additional'|trans }}"></span>
                </div>
            {% else %}
                <div class="c-home-progress" role="progressbar" aria-valuenow="{{ campaign.yearDonated }}" aria-valuemin="0" aria-valuemax="{{ campaign.yearNeeded }}">
                    <span class="c-home-progress__bar" style="width: {{ campaign.yearNeeded > 0 ? (campaign.yearDonated / campaign.yearNeeded) * 100 : 0 }}%;"></span>
                </div>
            {% endif %}
            <p class="c-home-box__amount{% if goalReached %} is-reached{% endif %}"><strong>€ {{ campaign.yearDonated }}</strong> {{ 'dashboard.donation.received'|trans }}</p>
            {% if goalReached %}
                <div class="c-home-box__text">{{ 'donation.thank.you'|trans({ amount: '€' ~ campaign.yearNeeded })|raw }}</div>
            {% endif %}
            <a class="c-home-button{% if goalReached %} c-home-button--outline{% endif %}" href="{{ url('donations') }}"><i class="fa fa-euro-sign" aria-hidden="true"></i> {{ 'landing.beinvolved.pleasedonate'|trans }}</a>
        </div>

        <div class="c-home-box">
            <div class="c-home-box__head">
                <h3 class="c-home-box__title">{{ 'landing.beinvolved.volunteer'|trans }}</h3>
            </div>
            <p class="c-home-box__text">{{ 'landing.beinvolved.intro'|trans }}</p>
            <a class="c-home-button c-home-button--outline" href="{{ url('getactive') }}"><i class="fa fa-wrench" aria-hidden="true"></i> {{ 'landing.beinvolved.helpbewelcome'|trans }}</a>
        </div>

        {#
          The information links as a slider of pages of four links, with previous and
          next buttons in the head, so the three boxes keep the same height.
        #}
        <div class="c-home-box c-home-slider js-home-slider">
            <div class="c-home-box__head c-home-slider__head">
                <h3 class="c-home-box__title">{{ 'landing.beinformed.title'|trans }} · {{ 'landing.beinformed.subtitle'|trans }}</h3>
                <div class="c-home-slider__nav">
                    <button type="button" class="c-home-slider__btn js-home-slider-prev" aria-controls="home_info_links" aria-label="{{ 'landing.beinformed.previous'|trans }}" disabled><i class="fa fa-chevron-left" aria-hidden="true"></i></button>
                    <button type="button" class="c-home-slider__btn js-home-slider-next" aria-controls="home_info_links" aria-label="{{ 'landing.beinformed.next'|trans }}"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>
            {% set infoLinks = [
                { url: url('about'), icon: 'fa fa-question-circle', label: 'landing.beinformed.about'|trans },
                { url: url('faqs_overview'), icon: 'fas fa-comments', label: 'landing.beinformed.faq'|trans },
                { url: url('safety'), icon: 'fa fa-user-shield', label: 'landing.beinformed.safety'|trans },
                { url: url('newsletters'), icon: 'far fa-newspaper', label: 'newsletters'|trans },
                { url: 'https://www.bevolunteer.org/', icon: 'fa fa-bullseye', label: 'landing.beinformed.bevolunteer'|trans, external: true },
                { url: 'https://www.bevolunteer.org/reports/annual-reports/', icon: 'fa fa-book', label: 'landing.beinformed.annualreport'|trans, external: true },
                { url: 'https://www.bevolunteer.org/reports/financial-reports/', icon: 'fa fa-money-bill-wave-alt', label: 'landing.beinformed.finances'|trans, external: true },
                { url: url('terms_of_use'), icon: 'fa fa-book', label: 'landing.beinformed.termsofuse'|trans },
                { url: url('privacy_policy'), icon: 'fa fa-book', label: 'landing.beinformed.privacypolicy'|trans },
                { url: url('data_rights'), icon: 'fa fa-book', label: 'landing.beinformed.datarights'|trans },
                { url: url('about_credits'), icon: 'fa fa-book', label: 'credits.title'|trans },
            ] %}
            <div class="c-home-slider__track js-home-slider-track" id="home_info_links" tabindex="-1">
                {% for page in infoLinks|batch(4) %}
                    <ul class="c-home-links c-home-slider__page">
                        {% for link in page %}
                            <li><a class="c-home-links__item" href="{{ link.url }}"{% if link.external ?? false %} target="_blank" rel="noopener"{% endif %}><i class="{{ link.icon }}" aria-hidden="true"></i><span>{{ link.label }}</span><i class="fa fa-chevron-right c-home-links__chevron" aria-hidden="true"></i></a></li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </div>
            <div class="c-home-slider__dots" aria-hidden="true">
                {% for page in infoLinks|batch(4) %}<span class="c-home-slider__dot{% if loop.first %} is-active{% endif %}"></span>{% endfor %}
            </div>
        </div>
    </div>
</section>

{# Community news #}
<section class="c-home-section c-home-section--divided">
    <div class="c-home-section__head">
        <h2 class="c-home-section__title">{{ 'landing.bwnews.title'|trans }} <span class="c-home-section__subtitle">{{ 'landing.bwnews.subtitle'|trans }}</span></h2>
        <a class="c-home-link" href="{{ url('communitynews') }}"><i class="far fa-newspaper" aria-hidden="true"></i> {{ 'landing.bwnews.allnews'|trans }}</a>
    </div>
    <div class="c-home-news">
        {% for news in communityNews %}
            <article class="c-home-box c-home-news__item">
                <h3 class="c-home-news__title"><a href="{{ url('communitynews_show', { id: news.id }) }}">{{ news.title }}</a></h3>
                <p class="c-home-news__text">{{ news.text|striptags|truncate(110) }}</p>
                <div class="c-home-news__meta">
                    <span>{{ news.createdAt.diffForHumans }}</span>
                    <span><i class="far fa-comment" aria-hidden="true"></i> {{ 'bewelcome_news.nrcomments'|trans({ '%commentsCount%': news.comments|length }) }}</span>
                </div>
                <a class="c-home-link" href="{{ url('communitynews_show', { id: news.id }) }}">{{ 'label.read.more'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </article>
        {% endfor %}
    </div>
</section>

{# Visitors: writing to a traveller or inviting them opens in a side panel #}
{% include 'conversations/_contact_drawer.html.twig' %}
{% endblock content %}
