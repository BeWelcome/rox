{#
  One trip coming to the member's area, as a row of the trips card on the home page: the traveller's
  face, their name and what they look for (Needs a host, Invited, Meet locals), how soon (orange within
  a week), the dates, the nights and the travellers when more than one, then the trip's title and the
  start of its text on one line. The whole row opens the trip in the side panel; the chevron shows it.
#}
{% set traveller = leg.trip.creator %}
{% set invited = leg.invitationBy(app.user) %}
{% set _lookingForHost = constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
{% set _arrival = leg.arrival|date('Y-m-d') %}
{% set _nights = date(leg.departure|date('Y-m-d')).diff(date(_arrival)).days %}
{% set _travellers = leg.trip.countOfTravellers %}
{#- How soon, in words: Today, Tomorrow, In 11 days (up to a month), then In 2 months -#}
{% set _days = ((_arrival|date('U')) - ('today'|date('U'))) // 86400 %}
{% if _days <= 0 %}{% set _soon = 'landing.dash.when.today'|trans %}
{% elseif _days == 1 %}{% set _soon = 'landing.dash.when.tomorrow'|trans %}
{% elseif _days < 31 %}{% set _soon = 'landing.dash.when.days'|trans({ count: _days }) %}
{% else %}{% set _soon = 'landing.dash.when.months'|trans({ count: _days // 30 }) %}
{% endif %}
{% set _title = leg.trip.summary ?: leg.location.name %}
{% set _excerpt = leg.trip.description|striptags|trim %}
<article class="c-home-visit js-contact-row">
    <a class="c-home-visit__cover js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ _title }}">
        <span class="visually-hidden">{{ _title }}</span>
    </a>
    <img class="c-home-visit__avatar" src="{{ path('avatar', { username: traveller.username, size: 96 }) }}" alt="" loading="lazy">
    <div class="c-home-visit__body">
        <p class="c-home-visit__top">
            <span class="c-home-visit__name">{{ traveller.shortNameOrUsername }}</span>
            {% if invited %}
                <span class="c-home-visit__tag c-home-visit__tag--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
            {% elseif _lookingForHost %}
                <span class="c-home-visit__tag"><i class="fas fa-house" aria-hidden="true"></i> {{ 'landing.dash.needs.host'|trans }}</span>
            {% elseif constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
                <span class="c-home-visit__tag c-home-visit__tag--plain"><i class="fas fa-users" aria-hidden="true"></i> {{ 'trip.option.meet.locals'|trans }}</span>
            {% endif %}
        </p>
        <p class="c-home-visit__when">
            <span class="c-home-visit__soon{{ _days < 7 ? ' is-soon' }}">{{ _soon }}</span>
            <span>
                {{- leg.arrival|format_date(pattern='MMM d') -}}
                {%- if leg.departure|date('Y-m-d') != _arrival %} → {{ leg.departure|date('Y-m') == leg.arrival|date('Y-m') ? leg.departure|format_date(pattern='d') : leg.departure|format_date(pattern='MMM d') }}{% endif -%}
            </span>
            {% if _nights > 0 %}<span>{{ 'contact.trip.nights'|trans({ count: _nights }) }}</span>{% endif %}
            {% if _travellers > 1 %}<span>{{ 'trip.count.of.travellers'|trans({ countOfTravellers: _travellers }) }}</span>{% endif %}
        </p>
        <p class="c-home-visit__text"><strong class="c-home-visit__title">{{ _title }}</strong>{% if _excerpt %} {{ _excerpt }}{% endif %}</p>
    </div>
</article>
