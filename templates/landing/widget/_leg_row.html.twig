{#
  One trip coming to the member's area, as a row of the trips card on the home page: the traveller's
  face, their name and Invited or Meet locals (Needs a host is the usual case, not shown), the dates in orange and the
  nights, then the trip's title and the start of its text on one line. The whole row opens the trip
  in the side panel.
#}
{% set traveller = leg.trip.creator %}
{% set invited = leg.invitationBy(app.user) %}
{% set _arrival = leg.arrival|date('Y-m-d') %}
{% set _nights = date(leg.departure|date('Y-m-d')).diff(date(_arrival)).days %}
{% set _title = leg.trip.summary ?: leg.location.name %}
{% set _excerpt = leg.trip.description|striptags|trim %}
<article class="c-home-visit js-contact-row">
    <a class="c-home-visit__cover js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ _title }}">
        <span class="visually-hidden">{{ _title }}</span>
    </a>
    <img class="c-home-visit__avatar" src="{{ path('avatar', { username: traveller.username, size: 96 }) }}" alt="" loading="lazy">
    <div class="c-home-visit__body">
        <p class="c-home-visit__top">
            <span class="c-home-visit__name">{{ member_display_name(traveller) }}</span>
            {% if invited %}
                <span class="c-home-visit__tag c-home-visit__tag--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
            {% elseif constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
                <span class="c-home-visit__tag c-home-visit__tag--plain">{{ 'trip.option.meet.locals'|trans }}</span>
            {% endif %}
        </p>
        {#- The dates in orange (Thu 19 – Sun 22 Nov), or only Today / Tomorrow in an orange pill; the nights in a small grey pill with a moon -#}
        {% set _days = date(_arrival).diff(date('today')).days %}
        <p class="c-home-visit__when">
            {% if _arrival >= 'now'|date('Y-m-d') and _days <= 1 %}
            <span class="c-home-visit__soon">{{ (_days == 0 ? 'landing.visitors.today' : 'landing.visitors.tomorrow')|trans }}</span>
            {% else %}
            <span class="c-home-visit__dates">
                {%- if leg.departure|date('Y-m-d') == _arrival -%}
                    {{ leg.arrival|format_date(pattern='EEE d MMM') }}
                {%- elseif leg.departure|date('Y-m') == leg.arrival|date('Y-m') -%}
                    {{ leg.arrival|format_date(pattern='EEE d') }} – {{ leg.departure|format_date(pattern='EEE d MMM') }}
                {%- else -%}
                    {{ leg.arrival|format_date(pattern='EEE d MMM') }} – {{ leg.departure|format_date(pattern='EEE d MMM') }}
                {%- endif -%}
            </span>
            {% endif %}
            {% if _nights > 0 %}<span class="c-home-visit__nights"><i class="fas fa-moon" aria-hidden="true"></i> {{ 'contact.trip.nights'|trans({ count: _nights }) }}</span>{% endif %}
        </p>
        <p class="c-home-visit__text"><span class="c-home-visit__trip">{{ _title }}{% if _excerpt %} :{% endif %}</span>{% if _excerpt %} {{ _excerpt }}{% endif %}</p>
    </div>
</article>
