{#
  One trip coming to the member's area, as a slide of the trips card on the home page. Top: the
  traveller's face and name (open their preview, search/preview.js), how many travel and what they
  look for, and on the right Message and Invite (the side panel; on phones Invite is a round icon). Then how soon in an orange pill,
  the dates and the nights, the trip's title and the start of its text, and See trip details, which
  opens the trip in the side panel.
#}
{% set traveller = leg.trip.creator %}
{% set invited = leg.invitationBy(app.user) %}
{% set _lookingForHost = constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
{% set _arrival = leg.arrival|date('Y-m-d') %}
{% set _nights = date(leg.departure|date('Y-m-d')).diff(date(_arrival)).days %}
{% set _travellers = leg.trip.countOfTravellers %}
{#- How soon, in words, as on the activities: Today, Tomorrow, In 3 days, In 2 weeks, In 2 months -#}
{% set _days = ((_arrival|date('U')) - ('today'|date('U'))) // 86400 %}
{% if _days <= 0 %}{% set _soon = 'landing.dash.when.today'|trans %}
{% elseif _days == 1 %}{% set _soon = 'landing.dash.when.tomorrow'|trans %}
{% elseif _days < 7 %}{% set _soon = 'landing.dash.when.days'|trans({ count: _days }) %}
{% elseif _days < 30 %}{% set _soon = 'landing.dash.when.weeks'|trans({ count: _days // 7 }) %}
{% else %}{% set _soon = 'landing.dash.when.months'|trans({ count: _days // 30 }) %}
{% endif %}
{% set _title = leg.trip.summary ?: leg.location.name %}
<article class="c-home-trip js-contact-row">
    {% set _preview = path('search_member_preview', { username: traveller.username }) %}
    <div class="c-home-trip__top">
        <a class="c-home-trip__face js-search-preview-open" href="{{ path('members_profile', { username: traveller.username }) }}" data-preview="{{ _preview }}" tabindex="-1" aria-hidden="true">
            <img class="c-home-trip__avatar" src="{{ path('avatar', { username: traveller.username, size: 192 }) }}" alt="" loading="lazy">
        </a>
        <div class="c-home-trip__who">
            <a class="c-home-trip__name js-search-preview-open" href="{{ path('members_profile', { username: traveller.username }) }}" data-preview="{{ _preview }}">{{ traveller.shortNameOrUsername }}</a>
            <span class="c-home-trip__people">
                {{ 'trip.count.of.travellers'|trans({ countOfTravellers: max(_travellers, 1) }) }}
                {% if invited %}
                    <span class="c-home-trip__look c-home-trip__look--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
                {% elseif _lookingForHost %}
                    <span class="c-home-trip__look">{{ 'landing.dash.needs.host'|trans }}</span>
                {% elseif constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
                    <span class="c-home-trip__look c-home-trip__look--plain">{{ 'trip.option.meet.locals'|trans }}</span>
                {% endif %}
            </span>
        </div>
        <div class="c-home-trip__acts">
            <a class="c-home-trip__msg js-contact-open" href="{{ path('message_new', { username: traveller.username }) }}" data-title="{{ traveller.username }}" aria-label="{{ 'trip.leg.message'|trans }}"><i class="far fa-envelope" aria-hidden="true"></i></a>
            {% if _lookingForHost and not invited %}
                <a class="c-home-trip__invite js-contact-open" href="{{ path('hosting_invitation', { leg: leg.id }) }}" data-title="{{ _title }}" aria-label="{{ 'contact.trip.invite'|trans }}"><i class="fas fa-house-user" aria-hidden="true"></i> <span class="c-home-trip__invite-label">{{ 'contact.trip.invite'|trans }}</span></a>
            {% endif %}
        </div>
    </div>
    <p class="c-home-trip__when">
        <span class="c-home-trip__soon">{{ _soon }}</span>
        <span class="c-home-trip__dates">
            {{- leg.arrival|format_date(pattern='MMM d') -}}
            {%- if leg.departure|date('Y-m-d') != _arrival %} → {{ leg.departure|date('Y-m') == leg.arrival|date('Y-m') ? leg.departure|format_date(pattern='d') : leg.departure|format_date(pattern='MMM d') }}{% endif -%}
        </span>
        {% if _nights > 0 %}<span class="c-home-trip__nights"><i class="fas fa-moon" aria-hidden="true"></i> {{ 'contact.trip.nights'|trans({ count: _nights }) }}</span>{% endif %}
    </p>
    {% set _excerpt = leg.trip.description|striptags|trim %}
    <p class="c-home-trip__summary">{{ _title }}</p>
    {% if _excerpt %}<p class="c-home-trip__text">{{ _excerpt }}</p>{% endif %}
    <a class="c-home-trip__see js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ _title }}">{{ 'landing.dash.see.trip.details'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
</article>
