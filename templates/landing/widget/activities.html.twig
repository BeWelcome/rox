{#
  The upcoming activities near the member, on the home page (loaded into the Activities tab).
#}
<div id="activitiesdisplay" class="c-home-list">
    {% for activity in activities %}
        <a class="c-home-item" href="/activities/{{ activity.id }}">
            <span class="c-home-item__date" aria-hidden="true">
                <span class="c-home-item__date-day">{{ activity.starts|format_date(pattern='d') }}</span>
                <span class="c-home-item__date-month">{{ activity.starts|format_date(pattern='MMM') }}</span>
            </span>
            <span class="c-home-item__body">
                <span class="c-home-item__title">{{ activity.title }}</span>
                <span class="c-home-item__meta">
                    {% if activity.online %}
                        <i class="fas fa-globe" aria-hidden="true"></i> {{ 'activityonline'|trans }}
                    {% else %}
                        <i class="fa fa-map-marker-alt" aria-hidden="true"></i> {{ activity.location.name }}, {{ activity.location.country.name }}
                    {% endif %}
                </span>
                <span class="c-home-item__meta">
                    <i class="far fa-calendar" aria-hidden="true"></i> {{ activity.starts|format_datetime('medium', 'short') }}
                    {% if activity.attendeesYes.count != 0 %}
                        · <i class="fa fa-user" aria-hidden="true"></i> {{ activity.attendeesYes.count }}&nbsp;{{ 'activitiesnumbattendeesyes'|trans }}
                    {% endif %}
                    {% if activity.attendeesMaybe.count != 0 %}
                        · {{ activity.attendeesMaybe.count }}&nbsp;{{ 'activitiesnumbattendeesmaybe'|trans }}
                    {% endif %}
                </span>
            </span>
        </a>
    {% else %}
        <p class="c-home-list__empty">{{ 'dashboard.activities.none'|trans }}</p>
    {% endfor %}
</div>
