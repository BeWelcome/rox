{#
  The upcoming activities near the member, in the Upcoming activities card of the home page: the date,
  the title, where and when, and how many come.
#}
<div id="activitiesdisplay" class="c-home-list"{% if activities is empty %} data-empty{% endif %}>
    {% for activity in activities %}
        {% set _coming = activity.attendeesYes.count %}
        <a class="c-home-item c-home-activity" href="{{ path('activities_show', { id: activity.id }) }}">
            <span class="c-home-item__date" aria-hidden="true">
                <span class="c-home-item__date-day">{{ activity.starts|format_date(pattern='d') }}</span>
                <span class="c-home-item__date-month">{{ activity.starts|format_date(pattern='MMM') }}</span>
            </span>
            <span class="c-home-item__body">
                <span class="c-home-activity__title">{{ activity.title }}</span>
                <span class="c-home-activity__meta">
                    {{- activity.online ? 'activityonline'|trans : activity.location.name }} · {{ activity.starts|format_datetime(pattern='EEE d MMM, ') }}{{ activity.starts|format_time('short') -}}
                </span>
            </span>
            {% if _coming %}
                <span class="c-home-activity__coming" aria-label="{{ _coming }} {{ 'activitiesnumbattendeesyes'|trans }}"><i class="fas fa-user-check" aria-hidden="true"></i> {{ _coming }}</span>
            {% endif %}
        </a>
    {% else %}
        <p class="c-home-dash__empty">{{ 'landing.dash.activities.none'|trans }} · <a href="{{ path('activities_create') }}">{{ 'landing.dash.activities.create'|trans }}</a></p>
    {% endfor %}
</div>
