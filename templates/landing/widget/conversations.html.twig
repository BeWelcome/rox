{#
  The latest messages received, in the Messages card of the home page: who wrote and when, then
  one line, the start of the message, or for a hosting request or invitation its kind and dates
  and then the start of the message.
  Where a request stands shows as an icon on the avatar, like in the inbox
  (conversations/_request_state.html.twig).
#}
<div id="conversationsdisplay" class="c-home-list"{% if messages is empty %} data-empty{% endif %}>
    {% for message in messages %}
        {% set unread = (message.firstRead is null) or (message.firstRead == '0000-00-00 00:00.00') %}
        {% set request = message.request %}
        {% set closed = request and request.status in [1, 2] %}
        {#
          A request or invitation from someone else, still open and not over, whose last message is
          not from the member: waiting for their answer, even once read
        #}
        {% set toAnswer = request and request.status == 0 and message.initiator.id != app.user.id
            and (request.departure ?? request.arrival) is not null and (request.departure ?? request.arrival)|date('Y-m-d') >= 'now'|date('Y-m-d') %}
        {% if toAnswer %}
            {% set _last = request.messages|reduce((last, one) => last is null or one.id > last.id ? one : last) %}
            {% set toAnswer = _last is null or _last.sender.id != app.user.id %}
        {% endif %}
        {# Opens in the side panel of the home page, like Send on a profile (contact/drawer.js) #}
        <a class="c-home-item c-home-msg js-contact-open js-home-message{% if unread %} is-unread{% endif %}{% if closed %} is-closed{% endif %}" href="{{ path('conversation_view', { id: message.id }) }}"
           data-title="{{ message.sender ? (message.sender.shortNameOrUsername ?? message.sender.username) : 'BeWelcome' }}">
            {% if message.sender %}
                <span class="c-home-item__avatar-wrap">
                    <img class="c-home-item__avatar" src="{{ path('avatar', { username: message.sender.username, size: 48 }) }}" alt="" loading="lazy">
                    {% if request %}{% include 'conversations/_request_state.html.twig' with { request: request, unread: unread, part: 'kind' } only %}{% endif %}
                </span>
            {% else %}
                <span class="c-home-item__avatar c-home-item__avatar--icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
            {% endif %}
            <span class="c-home-item__body">
                <span class="c-home-item__top">
                    <span class="c-home-item__name">{{ message.sender ? message.sender.username : 'BeWelcome' }}</span>
                    {% if toAnswer %}<span class="c-home-msg__waiting"><i class="fas fa-hourglass-half" aria-hidden="true"></i> {{ 'landing.dash.waiting.you'|trans }}</span>{% endif %}
                    <span class="c-home-item__time">{{ message.created.diffForHumans }}{% if unread %}<span class="c-home-item__dot" aria-hidden="true"></span>{% endif %}</span>
                </span>
                <span class="c-home-msg__line">
                    {%- if request -%}
                        {%- set _from = request.arrival -%}
                        {%- set _to = request.departure -%}
                        {{ (request.inviteForLeg ? 'conversations.invitation' : 'conversations.request')|trans }} ·
                        {% if _to is null -%}
                            {{ _from|format_date(pattern='MMM d') }}
                        {%- elseif _from|date('Y-m') == _to|date('Y-m') -%}
                            {{ _from|format_date(pattern='MMM d') }}–{{ _to|format_date(pattern='d') }}
                        {%- else -%}
                            {{ _from|format_date(pattern='MMM d') }} – {{ _to|format_date(pattern='MMM d') }}
                        {%- endif -%}
                    {%- else -%}
                        {{ message.message|striptags|truncate(90) }}
                    {%- endif -%}
                </span>
                {# A request: the start of its message too #}
                {% if request %}<span class="c-home-msg__line c-home-msg__line--text">{{ message.message|striptags|truncate(90) }}</span>{% endif %}
            </span>
        </a>
    {% else %}
        <p class="c-home-list__empty">{{ 'dashboard.messages.none'|trans }}</p>
    {% endfor %}
</div>
