{#
  The latest messages received, on the home page (loaded into the Messages tab).
  A hosting request or invitation shows its dates in a pill next to the subject and where it
  stands as an icon on the avatar, like in the inbox (conversations/_request_state.html.twig).
#}
<div id="conversationsdisplay" class="c-home-list"{% if messages is empty %} data-empty{% endif %}>
    {% for message in messages %}
        {% set unread = (message.firstRead is null) or (message.firstRead == '0000-00-00 00:00.00') %}
        {% set request = message.request %}
        {% set closed = request and request.status in [1, 2] %}
        <a class="c-home-item{% if unread %} is-unread{% endif %}{% if closed %} is-closed{% endif %}" href="{{ path('conversation_view', { id: message.id }) }}">
            {% if message.sender %}
                <span class="c-home-item__avatar-wrap">
                    <img class="c-home-item__avatar" src="{{ path('avatar', { username: message.sender.username, size: 48 }) }}" alt="" loading="lazy">
                    {% if request %}{% include 'conversations/_request_state.html.twig' with { request: request, unread: unread, part: 'kind' } only %}{% endif %}
                </span>
            {% else %}
                <span class="c-home-item__avatar c-home-item__avatar--icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
            {% endif %}
            <span class="c-home-item__body">
                <span class="c-home-item__top">
                    <span class="c-home-item__name">{{ message.sender ? message.sender.username : 'BeWelcome' }}</span>
                    <span class="c-home-item__time">{{ message.created.diffForHumans }}</span>
                </span>
                {% if request %}
                    {# The subject, and the dates on the right coloured by where the request stands #}
                    <span class="c-home-item__middle">
                        <span class="c-home-item__title">{{ message.subject ? message.subject.subject|striptags }}</span>
                        {% include 'conversations/_request_state.html.twig' with { request: request, unread: unread, part: 'pill' } only %}
                    </span>
                {% elseif message.subject %}
                    <span class="c-home-item__title">{{ message.subject.subject|striptags }}</span>
                {% endif %}
                {# The message, and for a request its state in words on the right #}
                <span class="c-home-item__bottom">
                    {# Received (this list only has those): the small orange arrow, as in the inbox list #}
                    <span class="c-home-item__text"><svg class="c-inbox-item__dir c-inbox-item__dir--received" viewBox="0 0 10 10" aria-hidden="true"><path d="M8 2 2 8M6.5 8H2V3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ message.message|striptags|truncate(90) }}</span>
                    {% if request %}{% include 'conversations/_request_state.html.twig' with { request: request, unread: unread, part: 'status' } only %}{% endif %}
                </span>
            </span>
        </a>
    {% else %}
        <p class="c-home-list__empty">{{ 'dashboard.messages.none'|trans }}</p>
    {% endfor %}
</div>
