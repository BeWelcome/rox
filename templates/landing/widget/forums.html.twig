{% import 'macros.twig' as macros %}
{#
  The latest threads in the member's groups on the home page (My groups tab), the BeWelcome
  group's agora included.
  The title opens the thread, the time of the last post jumps to that post.
#}
<div id="groupsdisplay" class="c-home-list">
    {% for thread in threads %}
        {% set page = 1 %}
        {% set lastpost = '' %}
        {% if ascending %}
            {% set lastpost = 'post' ~ thread.lastpost.id %}
            {% set page = thread.replies // constant('App\\Controller\\ForumPagesController::POSTS_PER_PAGE') + 1 %}
        {% endif %}
        {% if not thread.agora %}
            {% set threadUrl = url('group_forum_thread', { thread: thread.id, group_id: thread.group.id }) %}
            {% set lastUrl = page == 1
                ? url('group_forum_thread', { thread: thread.id, group_id: thread.group.id, _fragment: lastpost })
                : url('group_forum_thread_pages', { thread: thread.id, group_id: thread.group.id, page_id: page, _fragment: lastpost }) %}
        {% else %}
            {% set threadUrl = url('forum_thread', { threadId: thread.id }) %}
            {% set lastUrl = page == 1
                ? url('forum_thread', { threadId: thread.id, _fragment: lastpost })
                : url('forum_thread_pages', { threadId: thread.id, pageId: page, _fragment: lastpost }) %}
        {% endif %}
        <div class="c-home-item">
            <img class="c-home-item__avatar" src="{{ path('avatar', { username: thread.firstPost.author.username, size: 48 }) }}" alt="" loading="lazy">
            <div class="c-home-item__body">
                <a class="c-home-item__title c-home-item__title--link" href="{{ threadUrl }}">{{ thread.title|striptags }}</a>
                {# the group's name; nothing for the agora #}
                {% if not thread.agora %}
                    <p class="c-home-item__meta">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <a href="{{ url('group_start', { group_id: thread.group.id }) }}">{{ thread.group.name }}</a>
                    </p>
                {% endif %}
                <p class="c-home-item__meta">
                    {{ 'thread.lastpostby'|trans }}
                    <a class="c-home-item__author" href="{{ url('members_profile', { username: thread.lastpost.author.username }) }}">{{ thread.lastpost.author.username }}</a>
                    · <a class="c-home-item__when" href="{{ lastUrl }}" title="{{ thread.lastpost.updated.toDateTimeString }}">{{ thread.lastpost.updated.diffForHumans }}</a>
                </p>
            </div>
            {% set replies = thread.replies|default(0) %}
            <a class="c-home-item__replies{% if replies > 0 %} has-replies{% endif %}" href="{{ lastUrl }}" title="{{ 'landing.thread.replies'|trans({ count: replies }) }}">
                <i class="far fa-comment" aria-hidden="true"></i>
                <span>{{ replies }}</span>
            </a>
        </div>
    {% else %}
        <p class="c-home-list__empty">{{ 'landing.groups.empty'|trans }}</p>
    {% endfor %}
</div>
