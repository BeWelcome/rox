{#
  The latest threads in the member's groups on the home page (My groups tab), the BeWelcome
  group's agora included.
#}
<div id="groupsdisplay" class="c-home-list">
    {% for thread in threads %}
        {% include 'forum/_thread_item.html.twig' with { thread: thread, ascending: ascending } %}
    {% else %}
        <p class="c-home-list__empty">{{ 'landing.groups.empty'|trans }}</p>
    {% endfor %}
</div>
