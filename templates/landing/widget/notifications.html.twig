{#
  The member's notifications, on the home page (loaded into the Notifications tab).
  The cross marks one as seen.
#}
<div id="notificationsdisplay" class="c-home-list">
    {% for notification in notifications %}
        {% if notification.Type == "message" %}
            {% set notificationText %}{{ notification.translationcode|lower|trans|raw|format(notification.TranslationParameters)|raw }}{% endset %}
        {% else %}
            {% set notificationText %}{{ notification.translationcode|lower|trans|raw|format(notification.relMember.Username)|raw }}{% endset %}
        {% endif %}
        <div class="c-home-item">
            <img class="c-home-item__avatar" src="{{ path('avatar', { username: notification.relMember.username, size: 48 }) }}" alt="" loading="lazy">
            <div class="c-home-item__body">
                <a class="c-home-item__text c-home-item__text--strong" href="{{ notification.link }}" title="{{ notificationText|striptags }}">{{ notificationText }}</a>
                <p class="c-home-item__meta" title="{{ notification.created|format_date('medium') }}">{{ notification.created.diffForHumans }}</p>
            </div>
            <a class="c-home-item__dismiss notify" id="notify-{{ notification.id }}" href="#" aria-label="{{ 'close'|trans }}"><i class="fas fa-times" aria-hidden="true"></i></a>
        </div>
    {% else %}
        <p class="c-home-list__empty">{{ 'dashboard.notifications.none'|trans }}</p>
    {% endfor %}
</div>
