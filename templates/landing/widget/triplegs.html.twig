{#
  Members coming to the member's area, in the trips card of the home page: one trip at a time,
  sorted by arrival, with previous and next under it (landing.js).
#}
<div id="legsdisplay" class="c-home-list c-home-trips" data-count="{{ legs|length }}">
    {% if legs is empty %}
        <p class="c-home-list__empty">{{ 'landing.bevisited.none'|trans }}</p>
    {% else %}
        <div class="c-home-trips__track js-home-trips-track" tabindex="-1">
            {% for leg in legs %}
                {% include 'landing/widget/_leg_slide.html.twig' with { leg: leg } %}
            {% endfor %}
        </div>
        {#- Under the trip: previous, the travellers' faces and next, All visitors on the right -#}
        <div class="c-home-trips__nav{{ legs|length > 1 ? '' : ' c-home-trips__nav--single' }}">
            {% if legs|length > 1 %}
                <button type="button" class="c-home-trips__btn js-home-trips-prev" aria-label="{{ 'landing.beinformed.previous'|trans }}" disabled><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                {#- The travellers' faces instead of dots: the current one ringed in orange, a click shows that trip (landing.js) -#}
                <span class="c-home-trips__faces">
                    {% for leg in legs %}<button type="button" class="c-home-trips__face-dot js-home-trips-goto{% if loop.first %} is-active{% endif %}" data-index="{{ loop.index0 }}" aria-label="{{ leg.trip.creator.username }}"><img src="{{ path('avatar', { username: leg.trip.creator.username, size: 72 }) }}" alt="" loading="lazy"></button>{% endfor %}
                </span>
                <button type="button" class="c-home-trips__btn js-home-trips-next" aria-label="{{ 'landing.beinformed.next'|trans }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
            {% endif %}
            <a class="c-home-trips__all" href="{{ url('visitors') }}">{{ 'landing.dash.visitors.all'|trans }} <i class="fas fa-chevron-right" aria-hidden="true"></i></a>
        </div>
    {% endif %}
</div>
