{#
  Members coming to the member's area, in the trips card of the home page: one row per trip, sorted
  by arrival (landing/widget/_leg_row). The count, the distance and See all are in the card's head.
#}
<div id="legsdisplay" class="c-home-list c-home-trips c-home-visits" data-count="{{ legs|length }}">
    {% for leg in legs %}
        {% include 'landing/widget/_leg_row.html.twig' with { leg: leg } %}
    {% else %}
        <p class="c-home-list__empty">{{ 'landing.bevisited.none'|trans }}</p>
    {% endfor %}
</div>
