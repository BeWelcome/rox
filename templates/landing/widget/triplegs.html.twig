{#
  Members coming to the member's area, in the trips card of the home page: one trip at a time,
  sorted by arrival, with previous and next under it (landing.js).
#}
<div id="legsdisplay" class="c-home-list c-home-trips" data-count="{{ legs|length }}">
    {% if legs is empty %}
        <p class="c-home-list__empty">{{ 'landing.bevisited.none'|trans }}</p>
    {% else %}
        <div class="c-home-trips__track js-home-trips-track" tabindex="-1">
            {% for leg in legs %}
                {% include 'landing/widget/_leg_slide.html.twig' with { leg: leg } %}
            {% endfor %}
        </div>
        {% if legs|length > 1 %}
            <div class="c-home-trips__nav">
                <button type="button" class="c-home-trips__btn js-home-trips-prev" aria-label="{{ 'landing.beinformed.previous'|trans }}" disabled><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                <span class="c-home-trips__dots" aria-hidden="true">
                    {% for leg in legs %}<span class="c-home-slider__dot{% if loop.first %} is-active{% endif %}"></span>{% endfor %}
                </span>
                <button type="button" class="c-home-trips__btn js-home-trips-next" aria-label="{{ 'landing.beinformed.next'|trans }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
            </div>
        {% endif %}
    {% endif %}
</div>
