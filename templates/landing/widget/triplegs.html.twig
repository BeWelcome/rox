{#
  Members travelling near the member, on the home page (loaded into the Visitors tab).
#}
<div id="legsdisplay" class="c-home-list" data-hidden="{{ 'landing.visitors.hidden'|trans }}" data-undo="{{ 'landing.visitors.undo'|trans }}">
    {% for leg in legs %}
        {% include 'trip/landing.html.twig' with { leg: leg } %}
    {% else %}
        <p class="c-home-list__empty">{{ 'landing.bevisited.none'|trans }}</p>
    {% endfor %}
</div>
