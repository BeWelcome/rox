{# Primary site navigation. Expects: loggedInMember, teams (Twig globals). #}
<nav id="main_menu" class="navbar sticky-top navbar-dark navbar-expand bg-primary justify-content-between">
    <div class="container-lg bw-topbar__container">
        <ul id="collapsing_menu" class="navbar navbar-nav">
            <li class="nav-item">
                <a id="brand_image" class="navbar-brand" href="{{ url('homepage') }}">
                    {% include 'logo.html.twig' %}
                </a>
            </li>
            {% if not loggedInMember %}
                {% include 'login_form_navbar.html.twig' %}
            {% endif %}
        </ul>
        <ul id="static_menu" class="navbar navbar-nav align-items-center">
            {% if loggedInMember %}
            {% if teams|length != 0 %}
            <li class="nav-item dropdown">
                <a id="volunteer_menu_toggle" href="#volunteer_menu" class="nav-link dropdown-toggle topbar-icon-dropdown"
                   data-target="volunteer_menu" data-bs-toggle="dropdown" data-dropdown-click-only aria-haspopup="true" aria-expanded="false"
                   aria-label="{{ 'volunteer' | trans }}">
                    <span class="topbar-icon-dropdown__icon" aria-hidden="true"><i class="fas fa-handshake"></i></span>
                    {% if app.session.get('translation_mode') == 'on' and is_granted('ROLE_ADMIN_WORDS') %}
                        <span class="topbar-icon-dropdown__dot" title="{{ 'translation.mode.state.on'|trans }}"></span>
                        <span class="visually-hidden">{{ 'translation.mode.state.on'|trans }}</span>
                    {% endif %}
                </a>
                <ul id="volunteer_menu" class="dropdown-menu dropdown-menu-right nav-top-dropdown" role="menu">
                    <li class="member-menu__toolbar d-flex d-xl-none">
                        <button type="button" class="member-menu__close" aria-label="{{ 'close' | trans }}">
                            <span class="member-menu__close-icon" aria-hidden="true">&times;</span>
                        </button>
                    </li>
                    <li class="nav-top-dropdown__title d-xl-none">
                        <h6 class="dropdown-header text-left mb-0">{{ 'volunteer' | trans }}</h6>
                    </li>
                    {% for team in teams %}
                        <li>
                            {% if team.route starts with '/' %}
                                <a href="{{ team.route }}" class="dropdown-item text-left">{{ team.trans | trans }}</a>
                            {% else %}
                                <a href="{{ path(team.route) }}" class="dropdown-item text-left">{{ team.trans | trans }}</a>
                            {% endif %}
                        </li>
                        {# translators turn translation mode on and off right below the translation tool (the footer, which
                           phones don't show, had it) #}
                        {% if team.route == 'translations' %}
                            {% set _mode %}{% include 'layout/_translation_mode.html.twig' with {class: 'dropdown-item text-left'} %}{% endset %}
                            {% if _mode|trim is not empty %}<li>{{ _mode }}</li>{% endif %}
                        {% endif %}
                    {% endfor %}
                    <li>
                        <a href="{{ url('getactive') }}" class="dropdown-item text-left">{{ 'about_getactive' | trans }}</a>
                    </li>
                </ul>
            </li>
            {% endif %}
            {# Account to-dos (new email to confirm): a bell, only when there is one #}
            {% include 'layout/_notices_nav.html.twig' %}
            {# Search: straight to the search page #}
            <li class="nav-item">
                <a id="search_menu_toggle" href="{{ url('search_locations') }}" class="nav-link topbar-icon-dropdown"
                   aria-label="{{ 'findmembers' | trans }}">
                    <span class="topbar-icon-dropdown__icon" aria-hidden="true"><i class="fas fa-search"></i></span>
                </a>
            </li>
            <li class="nav-item dropdown">
                <a id="community_menu_toggle" href="#community_menu" class="nav-link dropdown-toggle topbar-icon-dropdown"
                   data-target="community_menu" data-bs-toggle="dropdown" data-dropdown-click-only aria-haspopup="true" aria-expanded="false"
                   aria-label="{{ 'communitymenu' | trans }}">
                    <span class="topbar-icon-dropdown__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                </a>
                <ul id="community_menu" class="dropdown-menu dropdown-menu-right nav-top-dropdown" role="menu">
                    <li class="member-menu__toolbar member-menu__toolbar--with-title d-flex d-xl-none">
                        <h6 class="member-menu__toolbar-title mb-0">{{ 'communitymenu' | trans }}</h6>
                        <button type="button" class="member-menu__close" aria-label="{{ 'close' | trans }}">
                            <span class="member-menu__close-icon" aria-hidden="true">&times;</span>
                        </button>
                    </li>
                    {% include 'layout/_community_nav_links.html.twig' with { item_link_class: 'text-left' } only %}
                </ul>
            </li>
            {# conversations #}
            <li class="nav-item topbar-messages">
                <div id="conversationCount" class="nav-link topbar-counter px-0" data-count="-1" data-member-id="{{ loggedInMember.id }}">
                    <a href="{{ path('conversations', {'conversationsType': 'conversations'}) }}" aria-label="{{ 'conversations' | trans }}" class="topbar-counter__link text-white">
                        <span class="topbar-counter__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                        <span class="badge topbar-counter__badge"><i class="fa fa-fw fa-spinner"></i></span>
                    </a>
                </div>
            </li>

            <li class="nav-item dropdown">
                <a id="member_menu_toggle" href="#member_menu" class="nav-link dropdown-toggle topbar-member-toggle"
                   data-target="member_menu" data-bs-toggle="dropdown" data-dropdown-click-only aria-haspopup="true" aria-expanded="false" aria-label="{{ 'profile' | trans }}">
                    <img class="profileimg px-0 js-profile-picture" src="{{ url('avatar', { username: loggedInMember.username, size: 36 })}}" width="32" height="32" alt="{{ 'profile.picture' }}">
                    <span class="d-none d-md-inline topbar-member__name">{{ loggedInMember.Username }}</span>
                </a>
                {#
                  The member's menu: who they are (photo, profile address) with View profile and Copy link
                  (member-menu-dropdown.js), their things, their account, Log out.
                  A compact card under the avatar on large screens, a full-screen sheet below xl.
                #}
                {% set _menuHosting = loggedInMember.Accommodation in ['yes', 'no'] ? loggedInMember.Accommodation : null %}
                {% set _menuUrl = url('members_profile', { username: loggedInMember.username }) %}
                <ul id="member_menu" class="dropdown-menu dropdown-menu-right member-menu" role="menu">
                    <li class="member-menu__card">
                        <div class="member-menu__who">
                            <img class="member-menu__avatar{{ _menuHosting ? ' member-menu__avatar--' ~ _menuHosting }}" src="{{ url('avatar', { username: loggedInMember.username, size: 96 }) }}" width="48" height="48" alt="">
                            <div class="member-menu__id">
                                <strong class="member-menu__name">{{ loggedInMember.Username }}</strong>
                                <span class="member-menu__url">{{ _menuUrl|replace({ 'https://': '', 'http://': '', 'www.': '' }) }}</span>
                            </div>
                            <button type="button" class="member-menu__close" aria-label="{{ 'close' | trans }}">
                                <i class="fas fa-times" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="member-menu__actions">
                            <a class="member-menu__btn" href="{{ path('members_profile', { username: loggedInMember.username }) }}">
                                <i class="far fa-user" aria-hidden="true"></i> {{ 'member.menu.view.profile'|trans }}
                            </a>
                            <button type="button" class="member-menu__btn member-menu__btn--primary js-member-share" data-url="{{ _menuUrl }}" data-title="{{ loggedInMember.Username }}">
                                <i class="fas fa-link" aria-hidden="true"></i> <span class="js-member-share-label" data-done="{{ 'member.menu.copied'|trans }}" aria-live="polite">{{ 'member.menu.copy.link'|trans }}</span>
                            </button>
                        </div>
                    </li>
                    <li class="member-menu__heading">{{ 'member.menu.mine'|trans }}</li>
                    <li><a class="member-menu__item" href="{{ path('profile_edit', {username: loggedInMember.username}) }}">
                        <span class="member-menu__icon member-menu__icon--warm" aria-hidden="true"><i class="fas fa-pen"></i></span>
                        <span class="member-menu__label">{{ 'profile.menu.edit.profile' | trans }}</span>
                        <i class="fas fa-chevron-right member-menu__chevron" aria-hidden="true"></i>
                    </a></li>
                    <li><a class="member-menu__item" href="{{ url('trips') }}">
                        <span class="member-menu__icon member-menu__icon--warm" aria-hidden="true"><i class="fas fa-route"></i></span>
                        <span class="member-menu__label">{{ 'trips.mytrips' | trans }}</span>
                        <i class="fas fa-chevron-right member-menu__chevron" aria-hidden="true"></i>
                    </a></li>
                    <li class="member-menu__sep" role="separator"></li>
                    <li class="member-menu__heading">{{ 'member.menu.account'|trans }}</li>
                    <li><a class="member-menu__item" href="{{ path('preferences', {'username': loggedInMember.username}) }}">
                        <span class="member-menu__icon" aria-hidden="true"><i class="fas fa-sliders"></i></span>
                        <span class="member-menu__label">{{ 'profile.menu.preferences' | trans }}</span>
                        <i class="fas fa-chevron-right member-menu__chevron" aria-hidden="true"></i>
                    </a></li>
                    <li><a class="member-menu__item" href="{{ path('change_password', {'username': loggedInMember.username}) }}">
                        <span class="member-menu__icon" aria-hidden="true"><i class="fas fa-key"></i></span>
                        <span class="member-menu__label">{{ 'profile.change.password.menu' | trans }}</span>
                        <i class="fas fa-chevron-right member-menu__chevron" aria-hidden="true"></i>
                    </a></li>
                    <li class="member-menu__sep" role="separator"></li>
                    <li class="member-menu__logout-item">
                        <a href="{{ url('_logout_main') }}" class="member-menu__logout"
                           data-browser-push-session
                           data-browser-push-configured="{{ browser_push_enabled ? '1' : '0' }}"
                           data-browser-push-preference-value="{{ browser_push_preference }}"
                           data-member-id="{{ loggedInMember.id }}"
                           data-public-key="{{ browser_push_public_key }}"
                           data-subscribe-url="{{ path('browser_push_subscription_upsert') }}"
                           data-unsubscribe-url="{{ path('browser_push_subscription_delete') }}"
                           data-csrf-token="{{ csrf_token('browser_push_subscription') }}">
                            <span class="member-menu__logout-icon" aria-hidden="true"><i class="fas fa-arrow-right-from-bracket"></i></span>
                            <span class="member-menu__logout-text">{{ 'logout' | trans }}</span>
                        </a>
                    </li>
                </ul>
            </li>
            {% endif %}
            {% if not loggedInMember %}
                {% include 'login_form_dropdown.html.twig' %}
            {% endif %}
        </ul>
    </div>
</nav>
