{% extends 'security/_layout.html.twig' %}

{% block title %}{{ 'reset.password' | trans }}{% endblock %}

{% block eyebrow %}{{ 'reset.password' | trans }}{% endblock %}
{% block heading %}{{ 'password.reset.headline' | trans }}{% endblock %}
{% block subtitle %}{{ 'password.reset.subtitle' | trans }}{% endblock %}

{% block messages %}
    {% if not form.vars.valid and form.vars.errors|length > 0 %}
        <div class="p-login__error" role="alert">
            {% for error in form.vars.errors %}
                <p class="p-login__error-title">{{ error.message }}</p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block form %}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'c-login-form', 'id': 'reset-password-form'}}) }}
        {% for field in [form.password.first, form.password.second] %}
            <div class="c-login-form__field">
                <label class="c-login-form__label" for="{{ field.vars.id }}">{{ (loop.first ? 'password' : 'password.repeat') | trans }}</label>
                <div class="c-login-form__password">
                    {{ form_widget(field, {'attr': {'class': 'c-login-form__input js-password-input', 'autocomplete': 'new-password', 'required': 'required'}|merge(loop.first ? {'autofocus': 'autofocus'} : {})}) }}
                    {% include 'partials/_password_toggle.html.twig' %}
                </div>
                {% for error in field.vars.errors %}
                    <p class="c-login-form__error">{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endfor %}

        <button type="submit" class="c-login-form__submit">
            {{ 'password.reset.submit' | trans }}
        </button>
    {# The buttons are written by hand, so the rest is left out; the CSRF token must not be #}
    {{ form_widget(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
{% endblock %}

{% block switch %}{{ 'menu.already.a.member' | trans }} <a href="{{ url('security_login') }}">{{ 'password.request.back.login' | trans }}</a>{% endblock %}
