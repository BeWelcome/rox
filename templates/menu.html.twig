{% set loggedInMember = app.user %}
{% include loggedInMember ? 'layout/main_navigation.html.twig' : 'layout/visitor_navigation.html.twig' %}
{% if loggedInMember %}
{% if is_granted('ROLE_ADMIN_CHECKER') or is_granted('ROLE_ADMIN_COMMENTS') or is_granted('ROLE_ADMIN_SAFETYTEAM')
    or is_granted('ROLE_ADMIN_GROUP')%}
    {# Admins: what waits for them, as small pills; the ones with something to do in orange #}
    <div class="p-admin-bar u:z-10 u:relative">
        <div class="container-lg p-admin-bar__inner">
            <span class="p-admin-bar__title"><i class="fas fa-user-shield" aria-hidden="true"></i> Admin</span>
            {% if groupsInApprovalQueue %}
                <a class="p-admin-bar__item is-todo" href="{{ path('admin_groups_approval') }}">
                    <i class="fas fa-users" aria-hidden="true"></i> {{ 'label.admin.groups.awaiting.approval'|trans({'groups': groupsInApprovalQueue}) }}
                </a>
            {% endif %}
            {# the Safety Team sees the comments handed to them, the Comments right the comments to check #}
            {% if not safetyTeamCommentsCount is null %}
                <a class="p-admin-bar__item{{ safetyTeamCommentsCount > 0 ? ' is-todo' }}" href="{{ path('admin_abuser_overview') }}">
                    <i class="fas fa-shield-halved" aria-hidden="true"></i> {{ 'label.admin.comments.safetyteam'|trans({'comments': safetyTeamCommentsCount}) }}
                </a>
            {% elseif not reportedCommentsCount is null %}
                <a class="p-admin-bar__item{{ reportedCommentsCount > 0 ? ' is-todo' }}" href="{{ path('admin_comment_reported_overview') }}">
                    <i class="fas fa-comment" aria-hidden="true"></i> {{ 'label.admin.comments.reported'|trans({'comments': reportedCommentsCount}) }}
                </a>
            {% endif %}
            {% if not reportedMessagesCount is null %}
                <a class="p-admin-bar__item{{ reportedMessagesCount > 0 ? ' is-todo' }}" href="{{ path('admin_spam_messages') }}">
                    <i class="fas fa-envelope" aria-hidden="true"></i> {{ 'label.admin.messages.reported'|trans({'messages': reportedMessagesCount}) }}
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}
{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}{% include 'layout/_login_messages.html.twig' %}{% endif %}
<noscript><div class="container-lg"><div class="alert alert-danger"><p class="h5">You need to activate Javascript for bewelcome.org</p><small>Without it some function won't work.</small></div></div></noscript>
    {% if loggedInMember.username == 'SafetyTeam' %}
        <div class="container-lg">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                Be careful, you're using the SafetyTeam profile.
                <button class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>
    {% endif %}
{% endif %}
