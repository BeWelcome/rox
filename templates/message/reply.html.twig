{% extends 'conversations/reply_layout.html.twig' %}

{% block javascripts %}
    {{ encore_entry_script_tags('message') }}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind')  }}
    {{ encore_entry_link_tags('requests')  }}
{% endblock stylesheets %}

{% block reply_form %}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_errors(form) }}
        {% if form.message.vars.errors|length > 0 %}
            <div class="c-inbox-compose__error">{{ form_errors(form.message) }}</div>
        {% endif %}
        <div class="c-inbox-compose__editor">
            {{ form_widget(form.message) }}
        </div>
        {% do form.subject.setRendered %}
        {% do form.message.setRendered %}
        {{ form_rest(form) }}
        <div class="c-inbox-compose__actions">
            <a class="c-inbox-compose__cancel" href="{{ backUrl }}">{{ 'cancel'|trans }}</a>
            <button type="submit" class="c-inbox-reply__btn c-inbox-compose__send">
                <i class="fas fa-reply" aria-hidden="true"></i>
                <span>{{ 'message.button.reply'|trans }}</span>
            </button>
        </div>
    {{ form_end(form) }}
{% endblock reply_form %}
