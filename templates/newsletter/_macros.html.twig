{# The language pills of a newsletter, each linking to it in that language; the active one is marked. #}
{% macro languages(id, languages, active) %}
  <ul class="c-newsletter-langs">
    {% for language in languages %}
      <li>
        <a class="c-newsletter-lang{{ language == active ? ' is-active' }}" href="{{ path('newsletter_single', {id: id, language: language}) }}" hreflang="{{ language }}"{% if language == active %} aria-current="true"{% endif %}>{{ ('lang_' ~ language)|lower|trans }}</a>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{#
  A newsletter of the archive list: its date, its title opening `newsletter.link`, and its languages with `active`
  marked. A draft (drafts are listed for the volunteers only) is dated by when it was written.
#}
{% macro card(newsletter, active, draft = false) %}
  {% set count = newsletter.languages|length %}
  <li class="c-cnews-card c-newsletter-card{{ draft ? ' c-newsletter-card--draft' }}">
    <div class="c-newsletter-card__date" aria-hidden="true">
      <span class="c-newsletter-card__day">{{ newsletter.created|format_date(pattern='d') }}</span>
      <span class="c-newsletter-card__month">{{ newsletter.created|format_date(pattern='MMM') }}</span>
    </div>
    <div class="c-newsletter-card__main">
      <h3 class="c-newsletter-card__title">
        <a href="{{ path('newsletter_single', {id: newsletter.id, language: newsletter.link}) }}">{{ ('broadcast_title_' ~ newsletter.name)|lower|trans }}</a>
      </h3>
      <p class="c-newsletter-card__meta">
        {{ newsletter.created|format_date(pattern='d MMMM y') }} · {{ newsletter.created.diffForHumans }} · {{ 'newsletters.languages'|trans({count: count}) }}
      </p>
      {% if count > 0 %}
        {{ _self.languages(newsletter.id, newsletter.languages, active) }}
      {% endif %}
    </div>
  </li>
{% endmacro %}
