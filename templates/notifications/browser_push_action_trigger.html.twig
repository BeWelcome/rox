{% if browser_push_enabled|default(false) and browser_push_preference|default('No') == 'Always' %}
  <div hidden
       data-browser-push-trigger-config
       data-browser-push-configured="1"
       data-browser-push-preference-value="{{ browser_push_preference }}"
       data-public-key="{{ browser_push_public_key }}"
       data-subscribe-url="{{ path('browser_push_subscription_upsert') }}"
       data-csrf-token="{{ csrf_token('browser_push_subscription') }}"></div>
{% endif %}
