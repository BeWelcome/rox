{# Shows or hides the password of the field next to it (password/showhide.js switches the icon and the label) #}
<button type="button" class="c-login-form__toggle js-password-show-hide"
        aria-label="{{ 'password.show' | trans }}"
        data-label-show="{{ 'password.show' | trans }}" data-label-hide="{{ 'password.hide' | trans }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
        <circle cx="12" cy="12" r="3"></circle>
    </svg>
</button>
