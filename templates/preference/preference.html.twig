{% extends 'profile/profile.html.twig' %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('profile/preference') }}
{% endblock javascripts %}

{% block page_content %}
    <h1>{{ 'profile.preferences'|trans }}</h1>
    {{ form_start(form) }}
    <input type="hidden" id="member" value="{{ member.username }}"
           data-update-url="{{ path('profile_update_preference') }}"
           data-csrf-token="{{ csrf_token('preference_update') }}">
    {% for name, child in form.children %}
        {% if not (name starts with '_') %}
            <div class="u:mb-16">
                <legend class="o-label" aria-label="{{ child.vars.label|trans }}">{{ child.vars.label|trans }}</legend>
              {% set is_browser_push_preference = browser_push_enabled and name == constant('App\\Entity\\Preference::BROWSER_NOTIFICATIONS') %}
              {% if child.vars.choices|length == 2 %}
                <label class="u:inline-flex u:items-center u:cursor-pointer" style="display: inline-flex;">
                  <span class="u:select-none u:font-medium u:text-heading switch">{{ child.vars.choices|keys|first|trans }}</span>
                  <input id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" type="checkbox" class="u:sr-only u:peer preference" value="{{ child.vars.choices|last }}" {% if child.vars.data == child.vars.choices|last %}checked="checked"{% endif %}{% if is_browser_push_preference %} data-browser-push-preference data-browser-push-configured="1" data-browser-push-preference-value="{{ browser_push_preference }}" data-member-id="{{ member.id }}" data-public-key="{{ browser_push_public_key }}" data-subscribe-url="{{ path('browser_push_subscription_upsert') }}" data-unsubscribe-url="{{ path('browser_push_subscription_delete') }}" data-csrf-token="{{ csrf_token('browser_push_subscription') }}"{% endif %}>
                  <div class="u:relative u:mx-9 u:w-24 u:h-12 u:bg-bewelcome u:peer-focus:outline-none u:peer-focus:ring-1 u:peer-focus:ring-bewelcome-light
                              u:rounded-6 u:peer u:peer-checked:after:translate-x-12 u:rtl:peer-checked:after:-translate-x-full u:peer-checked:after:border-buffer
                              u:after:content-[''] u:after:absolute after:top-[2px] u:after:bg-white u:after:rounded-6 u:after:h-12
                              u:after:w-12 u:after:transition-all u:peer-checked:bg-bewelcome"></div>
                  <span class="u:select-none u:text-sm u:font-medium u:text-heading">{{ child.vars.choices|keys|last|trans }}</span>
                </label>
                {% do child.setRendered %}
              {% else %}
                <div class="u:grid u:grid-cols-1">
                  {{ form_widget(child, is_browser_push_preference ? {'attr': child.vars.attr|merge({
                    'data-browser-push-preference': '1',
                    'data-browser-push-configured': '1',
                    'data-browser-push-preference-value': browser_push_preference,
                    'data-member-id': member.id,
                    'data-public-key': browser_push_public_key,
                    'data-subscribe-url': path('browser_push_subscription_upsert'),
                    'data-unsubscribe-url': path('browser_push_subscription_delete'),
                    'data-csrf-token': csrf_token('browser_push_subscription')
                  })} : {}) }}
                </div>
                  {% endif %}
              {% if is_browser_push_preference %}
                <div class="u:mt-4">
                  {{ form_help(child) }}
                </div>
                <div class="u:mt-4" data-browser-push-device-controls
                     data-status-active="{{ 'browser.notifications.device.active'|trans }}"
                     data-status-inactive="{{ 'browser.notifications.device.inactive'|trans }}"
                     data-status-open-only="{{ 'browser.notifications.device.open_only'|trans }}"
                     data-status-off="{{ 'browser.notifications.device.off'|trans }}"
                     data-status-denied="{{ 'browser.notifications.device.denied'|trans }}"
                     data-status-unsupported="{{ 'browser.notifications.device.unsupported'|trans }}"
                     data-status-error="{{ 'browser.notifications.device.error'|trans }}">
                  <button type="button" class="o-button" data-browser-push-enable>
                    {{ 'browser.notifications.device.enable'|trans }}
                  </button>
                  <span class="u:ml-4" role="status" aria-live="polite" data-browser-push-status></span>
                </div>
              {% else %}
                {{ form_help(child) }}
              {% endif %}
            </div>
        {% endif %}
    {% endfor %}
    {{ form_rest(form) }}
    <div class="u:flex u:justify-end">
        <a href="{{ url('members_profile', {username: member.username}) }}" class="o-button">{{ 'profile.back'|trans }}</a>
    </div>
    {{ form_end(form) }}
{% endblock %}
