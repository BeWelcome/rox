{% extends 'profile/edit_subpage.html.twig' %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('profile/preference') }}
{% endblock javascripts %}

{% block drawer_eyebrow %}<i class="fas fa-cog" aria-hidden="true"></i> {{ 'profile.edit.settings'|trans }}{% endblock %}

{% block subpage_title -%}
  {{ 'profile.preferences'|trans }}
{%- endblock %}

{% block subpage_body %}
  {{ form_start(form, {attr: {class: 'p-preferences-form'}}) }}
  <input type="hidden" id="member" value="{{ member.username }}"
         data-update-url="{{ path('profile_update_preference') }}"
         data-csrf-token="{{ csrf_token('preference_update') }}">

  <div class="p-preferences-list">
    {% for name, child in form.children %}
      {% if not (name starts with '_') %}
        {% set is_browser_push_preference = browser_push_enabled and name == constant('App\\Entity\\Preference::BROWSER_NOTIFICATIONS') %}
        <section class="p-preference-card">
          <div class="p-preference-card__copy">
            <h2 class="p-preference-card__title">{{ child.vars.label|trans }}</h2>
            {{ form_help(child, {help_attr: {class: 'p-preference-card__help'}}) }}
          </div>

          <div class="p-preference-card__control">
            {% if child.vars.choices|length == 2 %}
              <label class="p-preference-toggle" for="{{ child.vars.id }}">
                <span class="p-preference-toggle__label">{{ child.vars.choices|keys|first|trans }}</span>
                <input id="{{ child.vars.id }}"
                       name="{{ child.vars.full_name }}"
                       type="checkbox"
                       class="p-preference-toggle__input preference"
                       value="{{ child.vars.choices|last }}"
                       {% if child.vars.data == child.vars.choices|last %}checked="checked"{% endif %}
                       {% if is_browser_push_preference %}data-browser-push-preference data-browser-push-configured="1" data-browser-push-preference-value="{{ browser_push_preference }}" data-member-id="{{ member.id }}" data-public-key="{{ browser_push_public_key }}" data-subscribe-url="{{ path('browser_push_subscription_upsert') }}" data-unsubscribe-url="{{ path('browser_push_subscription_delete') }}" data-csrf-token="{{ csrf_token('browser_push_subscription') }}"{% endif %}>
                <span class="p-preference-toggle__track" aria-hidden="true">
                  <span class="p-preference-toggle__thumb"></span>
                </span>
                <span class="p-preference-toggle__label p-preference-toggle__label--active">{{ child.vars.choices|keys|last|trans }}</span>
              </label>
              {% do child.setRendered %}
            {% else %}
              {% set control_class = (child.vars.attr.class|default('') ~ ' p-preference-select')|trim %}
              {% set control_attr = child.vars.attr|merge({class: control_class}) %}
              {% if is_browser_push_preference %}
                {% set control_attr = control_attr|merge({
                  'data-browser-push-preference': '1',
                  'data-browser-push-configured': '1',
                  'data-browser-push-preference-value': browser_push_preference,
                  'data-member-id': member.id,
                  'data-public-key': browser_push_public_key,
                  'data-subscribe-url': path('browser_push_subscription_upsert'),
                  'data-unsubscribe-url': path('browser_push_subscription_delete'),
                  'data-csrf-token': csrf_token('browser_push_subscription')
                }) %}
              {% endif %}
              {{ form_widget(child, {attr: control_attr}) }}
            {% endif %}
            {{ form_errors(child) }}
            {% if is_browser_push_preference %}
              <div class="u:mt-4" data-browser-push-device-controls
                   data-status-active="{{ 'browser.notifications.device.active'|trans }}"
                   data-status-inactive="{{ 'browser.notifications.device.inactive'|trans }}"
                   data-status-open-only="{{ 'browser.notifications.device.open_only'|trans }}"
                   data-status-off="{{ 'browser.notifications.device.off'|trans }}"
                   data-status-denied="{{ 'browser.notifications.device.denied'|trans }}"
                   data-status-unsupported="{{ 'browser.notifications.device.unsupported'|trans }}"
                   data-status-error="{{ 'browser.notifications.device.error'|trans }}">
                <button type="button" class="o-button" data-browser-push-enable>
                  {{ 'browser.notifications.device.enable'|trans }}
                </button>
                <span class="u:ml-4" role="status" aria-live="polite" data-browser-push-status></span>
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>

  {{ form_rest(form) }}
  {{ form_end(form) }}
{% endblock subpage_body %}
