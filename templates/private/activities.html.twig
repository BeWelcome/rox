{% extends 'private/mydata.html.twig' %}
{# The activities the member signed up for (ActivitiesExtractor), each with its page in activities/. Expects activities. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'activities' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.activities.headline'|trans, abstract: 'mydata.activities.abstract'|trans}) }}
    {% if activities|length == 0 %}
        {{ my.empty('fa-calendar-days', 'mydata.activities.no.activity'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for key, activity in activities %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ activity.title }}</h2>
                    <div class="c-mydata-card__text">{{ activity.description|purify|striptags|truncate(200) }}</div>
                    <div class="c-mydata-card__foot"><span></span><a class="c-mydata-more" href="activities/activity-{{ key }}.html">{{ 'showdetails'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
