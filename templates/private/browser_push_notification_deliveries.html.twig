{% extends 'private/mydata.html.twig' %}
{# The deliveries of the member's browser notifications (BrowserPushNotificationDeliveriesExtractor). Expects browser_push_notification_deliveries. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'browser_push_notification_deliveries' %}
{% set k = 'mydata.browser.push.deliveries.' %}

{% block content %}
    {{ my.head({group: 'account', title: (k ~ 'headline')|trans, abstract: (k ~ 'abstract')|trans}) }}
    {% if browser_push_notification_deliveries|length == 0 %}
        {{ my.empty('fa-paper-plane', (k ~ 'no.deliveries')|trans) }}
    {% else %}
        <div class="c-mydata-card c-mydata-table-card">
            <table class="c-mydata-table">
                <thead><tr>
                    {% for column in ['notification', 'subscription', 'status', 'attempts', 'created', 'updated', 'last.error'] %}<th>{{ (k ~ column)|trans }}</th>{% endfor %}
                </tr></thead>
                <tbody>
                    {% for delivery in browser_push_notification_deliveries %}
                        <tr>
                            <td>{{ delivery.notification.id }}</td>
                            <td class="is-long">{% if delivery.subscription %}{{ delivery.subscription.endpointHash }}{% endif %}</td>
                            <td><span class="c-mydata-tag">{{ delivery.status }}</span></td>
                            <td>{{ delivery.attempts }}</td>
                            <td>{{ delivery.created|format_datetime('medium', 'short') }}</td>
                            <td>{% if delivery.updated %}{{ delivery.updated|format_datetime('medium', 'short') }}{% endif %}</td>
                            <td class="is-long">{{ delivery.lastError }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock content %}
