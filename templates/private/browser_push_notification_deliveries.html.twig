{% extends 'private/mydata.html.twig' %}

{% block content %}
    <h1>{{ 'mydata.browser.push.deliveries.headline'|trans }}</h1>
    <p>{{ 'mydata.browser.push.deliveries.abstract'|trans }}</p>
    {% if browser_push_notification_deliveries|length == 0 %}
        <p><strong>{{ 'mydata.browser.push.deliveries.no.deliveries'|trans }}</strong></p>
    {% else %}
        <div class="row">
            <div class="col-12 table-responsive">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>{{ 'mydata.browser.push.deliveries.notification'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.subscription'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.status'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.attempts'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.created'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.updated'|trans }}</th>
                        <th>{{ 'mydata.browser.push.deliveries.last.error'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for delivery in browser_push_notification_deliveries %}
                        <tr>
                            <td class="align-middle">{{ delivery.notification.id }}</td>
                            <td class="align-middle">{% if delivery.subscription %}{{ delivery.subscription.endpointHash }}{% endif %}</td>
                            <td class="align-middle">{{ delivery.status }}</td>
                            <td class="align-middle">{{ delivery.attempts }}</td>
                            <td class="align-middle">{{ delivery.created|format_datetime('medium', 'short') }}</td>
                            <td class="align-middle">{% if delivery.updated %}{{ delivery.updated|format_datetime('medium', 'short') }}{% endif %}</td>
                            <td class="align-middle">{{ delivery.lastError }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
