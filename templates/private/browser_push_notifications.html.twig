{% extends 'private/mydata.html.twig' %}
{# The browser notifications queued for the member (DoctrineExtractor). Expects browser_push_notifications. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'browser_push_notifications' %}
{% set k = 'mydata.browser.push.notifications.' %}

{% block content %}
    {{ my.head({group: 'account', title: (k ~ 'headline')|trans, abstract: (k ~ 'abstract')|trans}) }}
    {% if browser_push_notifications|length == 0 %}
        {{ my.empty('fa-message', (k ~ 'no.notifications')|trans) }}
    {% else %}
        <div class="c-mydata-card c-mydata-table-card">
            <table class="c-mydata-table">
                <thead><tr>
                    {% for column in ['type', 'sender', 'url', 'status', 'created', 'updated', 'last.error'] %}<th>{{ (k ~ column)|trans }}</th>{% endfor %}
                </tr></thead>
                <tbody>
                    {% for notification in browser_push_notifications %}
                        <tr>
                            <td><span class="c-mydata-tag">{{ notification.type }}</span></td>
                            <td>{{ notification.senderUsername }}</td>
                            <td class="is-long">{{ notification.url }}</td>
                            <td><span class="c-mydata-tag">{{ notification.status }}</span></td>
                            <td>{{ notification.created|format_datetime('medium', 'short') }}</td>
                            <td>{% if notification.updated %}{{ notification.updated|format_datetime('medium', 'short') }}{% endif %}</td>
                            <td class="is-long">{{ notification.lastError }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock content %}
