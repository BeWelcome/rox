{% extends 'private/mydata.html.twig' %}

{% block content %}
    <h1>{{ 'mydata.browser.push.subscriptions.headline'|trans }}</h1>
    <p>{{ 'mydata.browser.push.subscriptions.abstract'|trans }}</p>
    {% if browser_push_subscriptions|length == 0 %}
        <p><strong>{{ 'mydata.browser.push.subscriptions.no.subscriptions'|trans }}</strong></p>
    {% else %}
        <div class="row">
            <div class="col-12 table-responsive">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>{{ 'mydata.browser.push.subscriptions.endpoint.hash'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.endpoint.host'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.user.agent'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.content.encoding'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.created'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.last.seen'|trans }}</th>
                        <th>{{ 'mydata.browser.push.subscriptions.last.error'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for subscription in browser_push_subscriptions %}
                        <tr>
                            <td class="align-middle">{{ subscription.endpointHash }}</td>
                            <td class="align-middle">{{ subscription.endpointHost }}</td>
                            <td class="align-middle">{{ subscription.userAgent }}</td>
                            <td class="align-middle">{{ subscription.contentEncoding }}</td>
                            <td class="align-middle">{{ subscription.created|format_datetime('medium', 'short') }}</td>
                            <td class="align-middle">{% if subscription.lastSeen %}{{ subscription.lastSeen|format_datetime('medium', 'short') }}{% endif %}</td>
                            <td class="align-middle">{{ subscription.lastError }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
