{% extends 'private/mydata.html.twig' %}
{# The member's browsers that get notifications (DoctrineExtractor). Expects browser_push_subscriptions. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'browser_push_subscriptions' %}
{% set k = 'mydata.browser.push.subscriptions.' %}

{% block content %}
    {{ my.head({group: 'account', title: (k ~ 'headline')|trans, abstract: (k ~ 'abstract')|trans}) }}
    {% if browser_push_subscriptions|length == 0 %}
        {{ my.empty('fa-bell', (k ~ 'no.subscriptions')|trans) }}
    {% else %}
        <div class="c-mydata-card c-mydata-table-card">
            <table class="c-mydata-table">
                <thead><tr>
                    {% for column in ['endpoint.hash', 'endpoint.host', 'endpoint', 'public.key', 'auth.token', 'user.agent', 'content.encoding', 'created', 'last.seen', 'last.error'] %}<th>{{ (k ~ column)|trans }}</th>{% endfor %}
                </tr></thead>
                <tbody>
                    {% for subscription in browser_push_subscriptions %}
                        <tr>
                            <td class="is-long">{{ subscription.endpointHash }}</td>
                            <td>{{ subscription.endpointHost }}</td>
                            <td class="is-long">{{ subscription.endpoint }}</td>
                            <td class="is-long">{{ subscription.publicKey }}</td>
                            <td class="is-long">{{ subscription.authToken }}</td>
                            <td class="is-long">{{ subscription.userAgent }}</td>
                            <td>{{ subscription.contentEncoding }}</td>
                            <td>{{ subscription.created|format_datetime('medium', 'short') }}</td>
                            <td>{% if subscription.lastSeen %}{{ subscription.lastSeen|format_datetime('medium', 'short') }}{% endif %}</td>
                            <td class="is-long">{{ subscription.lastError }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock content %}
