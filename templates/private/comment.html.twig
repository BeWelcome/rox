{#
  A reference: from whom to whom, when, its quality, the text and how they know each other. The one the member wrote
  is muted (mute). Expects comment and mute.
#}
{% import 'private/_macros.html.twig' as my %}
{% set _quality = comment.quality|lower %}
<article class="c-mydata-card{{ mute ? ' is-muted' }}">
    <div class="c-mydata-ref__people">
        {{ my.person(comment.fromMember.username) }}
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
        {{ my.person(comment.toMember.username) }}
    </div>
    <p class="c-mydata-card__meta">
        {% if not mute %}<span class="c-mydata-tag{{ _quality == 'good' or _quality == 'positive' ? ' c-mydata-tag--green' : (_quality == 'bad' or _quality == 'negative' ? ' c-mydata-tag--red' : '') }}">{{ ('comment.quality.' ~ _quality)|trans }}</span>{% endif %}
        {{ comment.created|format_date('medium') }}
    </p>
    <blockquote class="c-mydata-ref__quote">“{{ comment.comment|purify|nl2br }}”</blockquote>
    {% set _relations = comment.relations|split(',')|filter(r => r|trim) %}
    {% if _relations is not empty %}
        <p class="c-mydata-ref__relations">{% for relation in _relations %}{{ ('Comment_' ~ relation)|lower|trans }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
    {% endif %}
</article>
