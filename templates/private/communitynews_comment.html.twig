{# A community news with the member's comments on it (communitynews_comments.html.twig). Expects commentsAndNews. #}
{% import 'private/_macros.html.twig' as my %}
<article class="c-mydata-card">
    <h2 class="c-mydata-card__title">{{ commentsAndNews.news.title }}</h2>
    {% for comment in commentsAndNews.comments %}
        <div class="c-mydata-box">
            <p class="c-mydata-card__meta">{{ comment.created|format_datetime('medium', 'short') }}</p>
            <div class="c-mydata-card__text">{{ comment.text|purify|nl2br }}</div>
        </div>
    {% endfor %}
    <div class="c-mydata-card__foot"><span></span>{{ my.site(url('communitynews_show', {id: commentsAndNews.news.id})) }}</div>
</article>
