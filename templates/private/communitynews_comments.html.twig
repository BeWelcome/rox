{% extends 'private/mydata.html.twig' %}
{# The member's comments on community news (CommunityNewsCommentsExtractor), by news. Expects newsAndComments. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'communitynews_comments' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.communitynewscomments.headline'|trans, abstract: 'mydata.communitynewscomments.abstract'|trans}) }}
    {% if newsAndComments|length == 0 %}
        {{ my.empty('fa-comment', 'mydata.communitynews.no.comments'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for commentsAndNews in newsAndComments %}
                {% include 'private/communitynews_comment.html.twig' with {commentsAndNews: commentsAndNews} %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
