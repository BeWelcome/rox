{# A community news as a card (communitynews.html.twig). Expects news. #}
{% import 'private/_macros.html.twig' as my %}
<article class="c-mydata-card">
    <h2 class="c-mydata-card__title">{{ news.title }}</h2>
    <p class="c-mydata-card__meta">{{ news.createdAt|format_date('medium') }}</p>
    <div class="c-mydata-card__text">{{ news.text|purify }}</div>
    <div class="c-mydata-card__foot"><span></span>{{ my.site(url('communitynews_show', {id: news.id})) }}</div>
</article>
