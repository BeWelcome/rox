{% extends 'private/mydata.html.twig' %}
{# The member's donations (DoctrineExtractor). Expects donations. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'donations' %}

{% block content %}
    {{ my.head({group: 'account', title: 'mydata.donations.headline'|trans, abstract: 'mydata.donations.abstract'|trans}) }}
    {% if donations|length == 0 %}
        {{ my.empty('fa-hand-holding-heart', 'mydata.donations.no.donations'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for donation in donations %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ donation.money }}{{ donation.amount }}</h2>
                    {% if donation.namegiven %}<p>{{ donation.namegiven }}</p>{% endif %}
                    {% if donation.referencepaypal %}<span class="c-mydata-label">{{ 'mydata.donations.paypal'|trans }}</span><div>{{ donation.referencepaypal }}</div>{% endif %}
                    {% if donation.systemcomment %}<p>{{ donation.systemcomment }}</p>{% endif %}
                    {% if donation.membercomment %}<p>{{ donation.membercomment }}</p>{% endif %}
                    <div class="c-mydata-card__foot"><span class="c-mydata-tag">{{ (donation.statusprivate == 'showamountonly' ? 'mydata.donations.amount.only' : 'mydata.donations.full.details')|trans }}</span></div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
