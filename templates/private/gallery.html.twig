{% extends 'private/mydata.html.twig' %}
{# The member's gallery (GalleryItemsExtractor): the pictures as copied into gallery/. Expects hrefs. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'gallery' %}

{% block content %}
    {{ my.head({group: 'you', title: 'mydata.gallery.headline'|trans, abstract: 'mydata.gallery.abstract'|trans}) }}
    {% if hrefs|length == 0 %}
        {{ my.empty('fa-images', 'mydata.gallery.no.images'|trans) }}
    {% else %}
        <div class="c-mydata-gallery">
            {% for href in hrefs %}
                <figure>
                    <a href="{{ href }}"><img src="{{ href }}" alt="" loading="lazy"></a>
                    <figcaption>{{ href|split('/')|last }}</figcaption>
                </figure>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
