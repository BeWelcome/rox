{# A poll's description, groups and choices, in every language (polls_created, polls_contributed, polls_voted). Expects poll. #}
<span class="c-mydata-label">{{ 'mydata.polls.description'|trans }}</span>
{% for locale, description in poll.descriptions %}
    <div lang="{{ locale }}"><span class="c-mydata-tag">{{ locale }}</span> {{ description|purify }}</div>
{% else %}
    <div>{{ 'mydata.polls.no.description'|trans }}</div>
{% endfor %}
{% if poll.groups|length %}
    <span class="c-mydata-label">{{ 'mydata.polls.groups'|trans }}</span>
    <div class="c-mydata-tags">{% for group in poll.groups %}<span class="c-mydata-tag">{{ group.name }}</span>{% endfor %}</div>
{% endif %}
<span class="c-mydata-label">{{ 'mydata.polls.choices'|trans }}</span>
{% for choice in poll.choices %}
    <div>{{ 'mydata.polls.choice'|trans({'choice': loop.index}) }}: {% for locale, text in choice.texts %}{{ text|purify }} <span class="c-mydata-tag">{{ locale }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</div>
{% else %}
    <div>{{ 'mydata.polls.no.choices'|trans }}</div>
{% endfor %}
