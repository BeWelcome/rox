{% extends 'private/mydata.html.twig' %}
{# The polls the member contributed (PollsExtractor), in polls/. Expects contributions. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'polls' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.polls.contributed.headline'|trans, abstract: 'mydata.polls.contributed.abstract'|trans, prefix: '../', back: {url: '../polls.html', label: 'mydata.polls.headline'|trans}}) }}
    {% if contributions|length == 0 %}
        {{ my.empty('fa-square-poll-vertical', 'mydata.polls.contributed.no.polls'|trans, '../') }}
    {% else %}
        <div class="c-mydata-grid">
            {% for contribution in contributions %}
                {% set _poll = contribution.poll %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ _poll.titles|length ? _poll.titles|first : 'mydata.polls.no.title'|trans }}</h2>
                    {% include 'private/poll.html.twig' with {poll: _poll} %}
                    {% if contribution.comment|length %}
                        <div class="c-mydata-box"><span class="c-mydata-label">{{ 'mydata.polls.comment'|trans }}</span>{{ contribution.comment|purify }}</div>
                    {% endif %}
                    <div class="c-mydata-card__foot"><span></span>{{ my.site(url('polls_view_results', {pollId: _poll.id})) }}</div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
