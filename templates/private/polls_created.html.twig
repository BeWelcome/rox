{% extends 'private/mydata.html.twig' %}
{# The polls the member created (PollsExtractor), in polls/. Expects polls. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'polls' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.polls.created.headline'|trans, abstract: 'mydata.polls.created.abstract'|trans, prefix: '../', back: {url: '../polls.html', label: 'mydata.polls.headline'|trans}}) }}
    {% if polls|length == 0 %}
        {{ my.empty('fa-square-poll-vertical', 'mydata.polls.created.no.polls'|trans, '../') }}
    {% else %}
        <div class="c-mydata-grid">
            {% for poll in polls %}
                {% set _poll = poll %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ _poll.titles|length ? _poll.titles|first : 'mydata.polls.no.title'|trans }}</h2>
                    {% include 'private/poll.html.twig' with {poll: _poll} %}
                    <div class="c-mydata-card__foot"><span></span>{{ my.site(url('polls_view_results', {pollId: _poll.id})) }}</div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
