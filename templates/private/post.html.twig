{% extends 'private/mydata.html.twig' %}
{# A single post with its translations (the mockups' post (thread), post (group)). Expects post, thread, group. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'posts' %}

{% block content %}
    {{ my.head({group: 'community', title: thread ? thread.title|striptags : 'mydata.posts.headline'|trans}) }}
    <article class="c-mydata-card">
        {% set posted_in %}{% if group %}<a href="{{ url('group_start', {group_id: group.id}) }}">{{ group.name }}</a>{% else %}{{ 'forum'|trans }}{% endif %}{% endset %}
        <p class="c-mydata-card__meta">
            {{ 'mydata.forums.posted'|trans({'in': posted_in})|raw }} · {{ 'mydata.forums.created'|trans({'posted': post.created}) }}
            {% if post.deleted == 'Deleted' %}<span class="c-mydata-tag">{{ 'mydata.post.deleted'|trans }}</span>{% endif %}
        </p>
        <small class="c-mydata-label">{{ ('lang_' ~ post.language.shortCode)|lower|trans }} ({{ post.language.shortCode }})</small>
        <div class="c-mydata-card__text">{{ post.message|purify }}</div>
        {% for locale, translation in post.messageTranslations %}
            {% if post.message != translation.message %}
                <div class="c-mydata-post__translation">
                    <small>{{ ('lang_' ~ translation.language.shortCode)|lower|trans }} ({{ translation.language.shortCode }})</small>
                    <div class="c-mydata-card__text">{{ translation.message|purify }}</div>
                </div>
            {% endif %}
        {% endfor %}
        {% if thread %}
            <div class="c-mydata-card__foot"><span></span>{{ my.site(url('forum_thread', {threadId: thread.id, _fragment: 'post' ~ post.id})) }}</div>
        {% endif %}
    </article>
{% endblock content %}
