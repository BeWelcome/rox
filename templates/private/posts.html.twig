{% extends 'private/mydata.html.twig' %}
{#
  The member's forum and group posts (ForumPostsExtractor), newest first: a card each with where and when, the text
  and its translations. Expects posts.
#}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'posts' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.posts.headline'|trans, abstract: 'mydata.posts.abstract'|trans}) }}
    {% if posts|length == 0 %}
        {{ my.empty('fa-comments', 'mydata.posts.no.posts'|trans) }}
    {% else %}
        {% for post in posts %}
            {% set threadLink -%}
                {%- if post.thread is not null -%}
                    {{- post.thread.agora ? url('forum_thread', {threadId: post.thread.id}) : url('group_forum_thread', {group_id: post.thread.group.id, thread: post.thread.id}) -}}
                {%- endif -%}
            {%- endset %}
            <article class="c-mydata-card" id="post{{ post.id }}">
                <div class="c-mydata-card__foot" style="margin: 0 0 0.75rem; padding: 0; border: 0;">
                    {% set _address = post.author.activeAddress %}
                    <span class="c-mydata-person"><img class="c-mydata-avatar" src="images/empty_avatar.png" alt="" width="32" height="32"><strong>{{ post.author.username }}</strong>{% if _address %} · {{ _address.location.name }}{% endif %}</span>
                    <span>
                        <i class="far fa-comment" aria-hidden="true"></i> {{ post.created|format_datetime('medium', 'short') }}
                        · <i class="far fa-eye" aria-hidden="true"></i> {{ ('forum_edit_vis_' ~ post.PostVisibility)|lower|trans }}
                        {% if threadLink is not empty %} · <a href="{{ threadLink }}#post{{ post.id }}"><i class="fas fa-link" aria-hidden="true"></i> {{ 'mydata.permalink'|trans }}</a>{% endif %}
                    </span>
                </div>
                {% set translations = post.messageTranslations %}
                {% for locale, translation in translations %}
                    <div class="{{ not loop.first ? 'c-mydata-post__translation' }}" lang="{{ translation.language.shortCode }}">
                        {% if translations|length > 1 %}<small class="c-mydata-label">{{ ('lang_' ~ translation.language.shortCode)|lower|trans }} ({{ translation.language.shortCode }})</small>{% endif %}
                        <div class="c-mydata-card__text">{{ translation.message|purify|nl2br }}</div>
                    </div>
                {% endfor %}
                {% if post.thread is not null %}
                    <div class="c-mydata-card__foot">
                        <span>
                            {% if not post.thread.agora %}{{ 'group'|trans }} <a href="{{ url('group_start', {group_id: post.thread.group.id}) }}">{{ post.thread.group.name|striptags }}</a> · {% endif %}
                            {{ 'search_topic_text'|trans }} <a href="{{ threadLink }}">{{ post.thread.title|striptags }}</a>
                        </span>
                    </div>
                {% endif %}
            </article>
        {% endfor %}
    {% endif %}
{% endblock content %}
