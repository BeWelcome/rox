{% extends 'private/mydata.html.twig' %}
{# The member's privileges (PrivilegesExtractor). Expects privileges. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'privileges' %}

{% block content %}
    {{ my.head({group: 'account', title: 'mydata.privileges.headline'|trans, abstract: 'mydata.privileges.abstract'|trans}) }}
    {% if privileges|length == 0 %}
        {{ my.empty('fa-key', 'mydata.privileges.no.privileges'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for privilege in privileges %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ privilege.privilege }}</h2>
                    <span class="c-mydata-label">{{ 'mydata.privileges.scope'|trans }}</span><div>{{ privilege.scope }}</div>
                    <span class="c-mydata-label">{{ 'mydata.privileges.role'|trans }}</span><div>{{ privilege.role }}</div>
                    <div class="c-mydata-card__foot"><span>{{ 'mydata.privileges.assigned'|trans }} {{ privilege.assigned|format_date('medium') }}</span></div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
