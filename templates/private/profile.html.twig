{% extends 'private/mydata.html.twig' %}
{#
  The member's profile (MemberDataExtractor): the header with the picture (full size in a viewer, :target), then the
  translated fields by language in tabs that work without JavaScript (radio buttons, _mydata.css). Expects member and
  picture (ProfilePicture::files, null without one).
#}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'profile' %}

{% block content %}
    {% set fields = member.translations %}
    {{ my.head({group: 'you', title: 'mydata.profile.headline'|trans, abstract: 'mydata.profile.abstract'|trans}) }}

    <section class="c-mydata-card c-mydata-profile">
        <div class="c-mydata-profile__picture">
            {% if picture %}
                <a href="#picture" aria-label="{{ 'mydata.picture.open'|trans }}">
                    <img src="{{ picture.thumbnail }}" alt="{{ 'mydata.profile.picture'|trans }}">
                    <span class="c-mydata-profile__expand" aria-hidden="true"><i class="fas fa-expand"></i></span>
                </a>
            {% else %}
                <img src="images/empty_avatar.png" alt="">
            {% endif %}
        </div>
        <div class="c-mydata-profile__who">
            <h2>{{ member.username }}</h2>
            <div class="c-mydata-tags">
                <span class="c-mydata-tag{{ member.accommodation != 'neverask' ? ' c-mydata-tag--green' }}">{{ member.accommodation|trans }}</span>
            </div>
            {% if member.name %}<p>{{ member.name }}</p>{% endif %}
            {% set address = member.activeAddress %}
            {% if address %}
                {% set location = address.location %}
                {% set regionName = location.admin1 is null ? '*' : location.admin1.name %}
                {% set regionCode = location.admin1 is null ? '*' : location.admin1.geonameId %}
                <p>
                    <i class="fas fa-location-dot" aria-hidden="true"></i>
                    <a href="{{ url('places_city', {countryname: location.country.name, countrycode: location.countryId, regionname: regionName, regioncode: regionCode, cityname: location.name, citycode: location.geonameId}) }}">{{ location.name }}</a>,
                    {% if location.admin1 is not null %}<a href="{{ url('places_region', {countryname: location.country.name, countrycode: location.countryId, regionname: regionName, regioncode: regionCode}) }}">{{ regionName }}</a>,{% endif %}
                    <a href="{{ url('places_country', {countryname: location.country.name, countrycode: location.countryId}) }}">{{ location.country.name }}</a>
                </p>
            {% endif %}
        </div>
        <dl class="c-mydata-profile__facts">
            <dt>{{ 'age'|trans }}</dt><dd>{{ member.age }}</dd>
            <dt>{{ 'gender'|trans }}</dt><dd>{{ member.gender|trans }}</dd>
            <dt>{{ 'membersince'|trans }}</dt><dd>{{ member.created|format_date('medium') }}</dd>
            <dt>{{ 'mydata.profile.status'|trans }}</dt><dd>{{ member.status|trans }}</dd>
        </dl>
    </section>

    {% if fields is not empty %}
        <div class="c-mydata-tabs">
            {% for locale in fields|keys %}
                <input type="radio" name="c-mydata-language" id="c-mydata-language-{{ locale }}"{% if loop.first %} checked{% endif %}>
            {% endfor %}
            <nav class="c-mydata-tabs__list" aria-label="{{ 'profile.languages'|trans }}">
                {% for locale in fields|keys %}
                    <label for="c-mydata-language-{{ locale }}">{{ ('lang_' ~ locale)|lower|trans }}</label>
                {% endfor %}
            </nav>
            {% for locale in fields|keys %}
                {% set f = fields[locale] %}
                <section class="c-mydata-tabs__panel" lang="{{ locale }}">
                    <div class="c-mydata-columns">
                        <div class="c-mydata-card">
                            <h3 class="c-mydata-card__title">{{ 'profile.about.me'|trans({}, 'messages', locale) }}</h3>
                            <div class="c-mydata-card__text">{{ f['ProfileSummary']|default('')|purify }}</div>
                            <span class="c-mydata-label">{{ 'occupation'|trans({}, 'messages', locale) }}</span>
                            <div>{{ f['Occupation']|default('') }}</div>
                            <span class="c-mydata-label">{{ 'profile.languages'|trans({}, 'messages', locale) }}</span>
                            <div class="c-mydata-tags">
                                {% for ll in member.languageLevels %}
                                    <span class="c-mydata-tag">{{ ('lang_' ~ ll.language.shortCode)|lower|trans({}, 'messages', locale) }} · {{ ('LanguageLevel_' ~ ll.level)|lower|trans({}, 'messages', locale) }}</span>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="c-mydata-card">
                            <h3 class="c-mydata-card__title">{{ 'profile.interests'|trans({}, 'messages', locale) }}</h3>
                            {% for key, label in {Hobbies: 'profile.hobbies', Books: 'profile.books', Music: 'profile.music', Movies: 'profile.movies', Organizations: 'profile.organizations'} %}
                                <span class="c-mydata-label">{{ label|trans({}, 'messages', locale) }}</span>
                                <div>{{ f[key]|default('')|purify }}</div>
                            {% endfor %}
                        </div>

                        <div class="c-mydata-card">
                            <h3 class="c-mydata-card__title">{{ 'profile.accommodation'|trans({}, 'messages', locale) }}</h3>
                            <span class="c-mydata-label">{{ 'profilenumberofguest'|trans({}, 'messages', locale) }}</span>
                            <div>{{ member.maxGuests }}</div>
                            {% for key, label in {MaxLenghtOfStay: 'profile.max.length.of.stay', ILiveWith: 'profile.i.live.with', PleaseBring: 'profile.please.bring', OfferHosts: 'profile.offer.hosts', PublicTransport: 'profile.getting.there'} %}
                                {% if f[key]|default('') %}
                                    <span class="c-mydata-label">{{ label|trans({}, 'messages', locale) }}</span>
                                    <div>{{ f[key]|purify }}</div>
                                {% endif %}
                            {% endfor %}
                            {% if member.standardOffers is not empty %}
                                <span class="c-mydata-label">{{ 'profile.offer.guests'|trans({}, 'messages', locale) }}</span>
                                <div class="c-mydata-tags">
                                    {% for offer in member.standardOffers %}<span class="c-mydata-tag">{{ ('ProfileTypicOffer_' ~ offer)|lower|trans({}, 'messages', locale) }}</span>{% endfor %}
                                </div>
                            {% endif %}
                            {% if f['AdditionalAccomodationInfo']|default('') or f['InformationToGuest']|default('') %}
                                <span class="c-mydata-label">{{ 'profile.additional.information.for.guests'|trans({}, 'messages', locale) }}</span>
                                <div>{{ f['AdditionalAccomodationInfo']|default('')|purify }} {{ f['InformationToGuest']|default('')|purify }}</div>
                            {% endif %}
                            {% if member.restrictions is not empty %}
                                <span class="c-mydata-label">{{ 'profile.house.rules'|trans({}, 'messages', locale) }}</span>
                                <div class="c-mydata-tags">
                                    {% for restriction in member.restrictions %}<span class="c-mydata-tag">{{ ('restriction_' ~ restriction)|lower|trans({}, 'messages', locale) }}</span>{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="c-mydata-card">
                            <h3 class="c-mydata-card__title">{{ 'profile.travel.experience'|trans({}, 'messages', locale) }}</h3>
                            <span class="c-mydata-label">{{ 'profile.past.trips'|trans({}, 'messages', locale) }}</span>
                            <div>{{ f['PastTrips']|default('')|purify }}</div>
                            <span class="c-mydata-label">{{ 'profile.planned.trips'|trans({}, 'messages', locale) }}</span>
                            <div>{{ f['PlannedTrips']|default('')|purify }}</div>
                        </div>

                        <div class="c-mydata-card">
                            <h3 class="c-mydata-card__title">{{ 'contactinfo'|trans({}, 'messages', locale) }}</h3>
                            <span class="c-mydata-label">{{ 'name'|trans({}, 'messages', locale) }}</span>
                            <div>{{ member.name }}</div>
                            {% if address %}
                                <span class="c-mydata-label">{{ 'address'|trans({}, 'messages', locale) }}</span>
                                <div>
                                    {{ address.streetName }} {{ address.houseNumber }}<br>
                                    {{ address.zip }} {{ address.location.name }}<br>
                                    {{ address.location.country.name }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}

    {% if picture %}
        <div class="c-mydata-viewer" id="picture" role="dialog" aria-label="{{ 'mydata.profile.picture'|trans }}">
            <a class="c-mydata-viewer__scrim" href="#" aria-label="{{ 'mydata.picture.close'|trans }}"></a>
            <div class="c-mydata-viewer__box">
                <img src="{{ picture.original }}" alt="{{ 'mydata.profile.picture'|trans }}">
                <a class="c-mydata-viewer__close" href="#" aria-label="{{ 'mydata.picture.close'|trans }}"><i class="fas fa-xmark" aria-hidden="true"></i></a>
                <a class="c-mydata-viewer__open" href="{{ picture.original }}">{{ 'mydata.picture.open.file'|trans }} <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
            </div>
        </div>
    {% endif %}
{% endblock content %}
