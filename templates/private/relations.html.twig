{% extends 'private/mydata.html.twig' %}

{% block content %}
    <h1>{{ 'mydata.friends.headline'|trans }}</h1>
    <p>{{ 'mydata.friends.abstract'|trans }}</p>
    {% if relations|length == 0 %}
        <p>{{ 'mydata.friends.none'|trans }}</p>
    {% else %}
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>{{ 'mydata.friends.member'|trans }}</th>
                    <th>{{ 'mydata.friends.requester'|trans }}</th>
                    <th>{{ 'mydata.friends.created'|trans }}</th>
                    <th>{{ 'mydata.friends.confirmed'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for relation in relations %}
                    <tr>
                        <td>{{ relation.other.username }}</td>
                        <td>{{ relation.requester.username }}</td>
                        <td>{{ relation.created|format_datetime('short', 'short') }}</td>
                        <td>{{ relation.confirmed ? relation.confirmed|format_datetime('short', 'short') : 'mydata.friends.pending'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock content %}
