{% extends 'private/mydata.html.twig' %}
{# The member's friends (FriendsExtractor): who asked, when, confirmed or not. Expects relations. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'relations' %}

{% block content %}
    {{ my.head({group: 'you', title: 'mydata.friends.headline'|trans, abstract: 'mydata.friends.abstract'|trans}) }}
    {% if relations|length == 0 %}
        {{ my.empty('fa-user-group', 'mydata.friends.none'|trans) }}
    {% else %}
        <div class="c-mydata-card c-mydata-table-card">
            <table class="c-mydata-table">
                <thead><tr>
                    <th>{{ 'mydata.friends.member'|trans }}</th>
                    <th>{{ 'mydata.friends.requester'|trans }}</th>
                    <th>{{ 'mydata.friends.created'|trans }}</th>
                    <th>{{ 'mydata.friends.confirmed'|trans }}</th>
                </tr></thead>
                <tbody>
                    {% for relation in relations %}
                        <tr>
                            <td>{{ my.person(relation.other.username, '', 24) }}</td>
                            <td>{{ relation.requester.username }}</td>
                            <td>{{ relation.created|format_datetime('short', 'short') }}</td>
                            <td>{% if relation.confirmed %}{{ relation.confirmed|format_datetime('short', 'short') }}{% else %}<span class="c-mydata-tag c-mydata-tag--orange">{{ 'mydata.friends.pending'|trans }}</span>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock content %}
