{% extends 'private/mydata.html.twig' %}
{# The member's volunteer rights (RightsExtractor). Expects volunteerrights. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'rights' %}

{% block content %}
    {{ my.head({group: 'account', title: 'mydata.rights.headline'|trans, abstract: 'mydata.rights.abstract'|trans}) }}
    {% if volunteerrights|length == 0 %}
        {{ my.empty('fa-shield-halved', 'mydata.rights.no.rights'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for volunteerright in volunteerrights %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ volunteerright.right.name }}</h2>
                    <span class="c-mydata-label">{{ 'mydata.rights.scope'|trans }}</span><div>{{ volunteerright.scope }}</div>
                    <span class="c-mydata-label">{{ 'mydata.rights.level'|trans }}</span><div>{{ volunteerright.level }}</div>
                    <div class="c-mydata-card__foot"><span>{{ 'mydata.rights.assigned'|trans }} {{ volunteerright.created|format_datetime('medium', 'short') }}</span></div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
