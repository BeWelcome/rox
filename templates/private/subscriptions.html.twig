{% extends 'private/mydata.html.twig' %}
{# The forum threads the member follows (DoctrineExtractor), with their notifications on or off. Expects subscriptions. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'subscriptions' %}

{% block content %}
    {{ my.head({group: 'community', title: 'mydata.subscriptions.threads.headline'|trans, abstract: 'mydata.subscriptions.threads.abstract'|trans}) }}
    {% if subscriptions|length == 0 %}
        {{ my.empty('fa-bell', 'mydata.subscriptions.threads.no.subscriptions'|trans) }}
    {% else %}
        <div class="c-mydata-card c-mydata-table-card">
            <table class="c-mydata-table">
                <thead><tr><th>{{ 'mydata.subscriptions.thread.name'|trans }}</th><th>{{ 'created'|trans }}</th><th>{{ 'mydata.subscriptions.subscription'|trans }}</th></tr></thead>
                <tbody>
                    {% for subscription in subscriptions %}
                        <tr>
                            <td class="is-long"><a href="{{ url('forum_thread', {threadId: subscription.thread.id}) }}">{{ subscription.thread.title|striptags }}</a></td>
                            <td>{{ subscription.subscribed|format_datetime('medium', 'short') }}</td>
                            <td><span class="c-mydata-tag{{ subscription.notificationsEnabled ? ' c-mydata-tag--green' }}">{{ (subscription.notificationsEnabled ? 'on' : 'off')|trans }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock content %}
