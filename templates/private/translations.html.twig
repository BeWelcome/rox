{% extends 'private/mydata.html.twig' %}
{# The texts the member translated (DoctrineExtractor). Expects translations. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'translations' %}

{% block content %}
    {{ my.head({group: 'account', title: 'mydata.translations.headline'|trans, abstract: 'mydata.translations.abstract'|trans}) }}
    {% if translations|length == 0 %}
        {{ my.empty('fa-language', 'mydata.translations.no.translations'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for translation in translations %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ translation.code }}</h2>
                    <div class="c-mydata-card__text">{{ translation.sentence|purify|truncate(500) }}</div>
                    <div class="c-mydata-card__foot">
                        <span class="c-mydata-tag">{{ ('lang_' ~ translation.language.shortCode)|lower|trans }}</span>
                        <span>{{ translation.created|format_date('medium') }}</span>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
