{% extends 'private/mydata.html.twig' %}
{# The member's trips (DoctrineExtractor): a card each with its travellers and legs. Expects trips. #}
{% import 'private/_macros.html.twig' as my %}
{% set section = 'trips' %}
{% set O = 'App\\Doctrine\\LegOptionsType::' %}

{% block content %}
    {{ my.head({group: 'you', title: 'mydata.trips.headline'|trans, abstract: 'mydata.trips.abstract'|trans}) }}
    {% if trips|length == 0 %}
        {{ my.empty('fa-route', 'mydata.trips.no.trips'|trans) }}
    {% else %}
        <div class="c-mydata-grid">
            {% for trip in trips %}
                <article class="c-mydata-card">
                    <h2 class="c-mydata-card__title">{{ trip.summary }}</h2>
                    <div class="c-mydata-tags">
                        <span class="c-mydata-tag">{{ 'trip.count.of.travellers'|trans({'countOfTravellers': trip.countOfTravellers}) }}</span>
                        {% if trip.additionalInfo %}<span class="c-mydata-tag">{{ ('trip.additional.info.' ~ trip.additionalInfo)|lower|trans }}</span>{% endif %}
                    </div>
                    {% if trip.description %}<p>{{ trip.description }}</p>{% endif %}
                    <ul class="c-mydata-legs">
                        {% for leg in trip.legs %}
                            <li>
                                <span class="c-mydata-tile" aria-hidden="true"><i class="fas fa-location-dot"></i></span>
                                <strong>{{ leg.location ? leg.location.name ~ ', ' ~ leg.location.country.name : 'trip.location.none'|trans }}</strong>
                                {% if leg.arrival is defined and leg.arrival %}<span>{{ leg.arrival|format_date('medium') }}{% if leg.departure ?? null %} – {{ leg.departure|format_date('medium') }}{% endif %}</span>{% endif %}
                                {% for option, label in {PRIVATE: 'trip.option.private', MEET_LOCALS: 'trip.option.meet.locals', LOOKING_FOR_HOST: 'trip.option.looking.for.host'} %}
                                    {% if constant(O ~ option) in leg.options %}<span class="c-mydata-tag c-mydata-tag--orange">{{ label|trans }}</span>{% endif %}
                                {% endfor %}
                            </li>
                        {% endfor %}
                    </ul>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock content %}
