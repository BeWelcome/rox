{#
  Volunteers with admin rights: their tools for this member (ProfileSubmenu::addVolunteerEntries),
  in a dark block of the right column. Each link shows only with the matching right.
  The Flags right gets the switch that blocks forum posting (Admin\FlagsController) instead of a link: on, it asks
  for the reason; off, it asks before removing the flag.
#}
{% set _adminItems = submenu.items ?? [] %}
{% set _adminTools = [
  {key: 'adminedit', icon: 'pen'},
  {key: 'personaldate', icon: 'database'},
  {key: 'adminrights', icon: 'user-shield'},
  {key: 'adminlogs', icon: 'list'},
]|filter(tool => _adminItems[tool.key] is defined) %}
{% set _flag = _adminItems.adminflags is defined ? forum_posting_block(member) : null %}
{% if _adminTools|length > 0 or _flag %}
  <section class="p-pro-admin-tools" aria-labelledby="admin-tools-{{ where }}-title" id="admin-tools-{{ where }}">
    <h2 class="p-pro-admin-tools__title" id="admin-tools-{{ where }}-title">
      <i class="fas fa-user-shield" aria-hidden="true"></i> Admin
    </h2>
    <ul class="p-pro-admin-tools__list">
      {% for tool in _adminTools %}
        {% set _item = _adminItems[tool.key] %}
        {% set _url = _item.url starts with '/' or _item.url starts with 'http' ? _item.url : '/' ~ _item.url %}
        <li>
          <a class="p-pro-admin-tools__link" href="{{ _url }}">
            <span class="p-pro-admin-tools__icon" aria-hidden="true"><i class="fas fa-{{ tool.icon }}"></i></span>
            <span class="p-pro-admin-tools__label">{{ _item.key|trans }}</span>
            <i class="fas fa-chevron-right p-pro-admin-tools__go" aria-hidden="true"></i>
          </a>
        </li>
      {% endfor %}
    </ul>

    {% if _flag %}
      {% set _blocked = _flag.block is not null %}
      {% set _dialog = 'p-pro-flag-' ~ (profile_language ?? 'x') %}
      <div class="p-pro-flag{{ _blocked ? ' is-blocked' }}">
        <div class="p-pro-flag__head">
          <span class="p-pro-flag__icon" aria-hidden="true"><i class="fas fa-comment-slash"></i></span>
          <span class="p-pro-flag__text">
            <span class="p-pro-flag__label">{{ 'admin.flags.block.label'|trans }}</span>
            <span class="p-pro-flag__status">
              {{- _blocked ? 'admin.flags.blocked.since'|trans({date: _flag.block.created|format_date('medium')}) : 'admin.flags.not.blocked'|trans -}}
            </span>
          </span>
          <button type="button" class="p-pro-flag__switch c-home-switch{{ _blocked ? ' is-on' }}" role="switch" aria-checked="{{ _blocked ? 'true' : 'false' }}"
                  aria-label="{{ 'admin.flags.block.label'|trans }}" data-micromodal-trigger="{{ _dialog }}"><span class="c-home-switch__track" aria-hidden="true"></span></button>
        </div>
        {% if _blocked and _flag.block.comment %}
          <p class="p-pro-flag__comment">“{{ _flag.block.comment }}”</p>
        {% endif %}
        <a class="p-pro-flag__history" href="{{ _flag.earlier > 0 ? path('admin_flags', {member: member.username}) : path('admin_flags') }}">
          {{- _flag.earlier > 0 ? 'admin.flags.history.link'|trans({count: _flag.earlier}) : 'admin.flags.all'|trans -}}
          <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      {# on: the reason; off: are you sure #}
      <div class="micromodal-slide p-pe-confirm" id="{{ _dialog }}" aria-hidden="true">
        <div class="modal__overlay p-pe-confirm__overlay" tabindex="-1" data-micromodal-close>
          <div class="modal__container p-pe-confirm__box" role="dialog" aria-modal="true" aria-labelledby="{{ _dialog }}-title">
            <span class="p-pe-confirm__icon" aria-hidden="true"><i class="fas fa-{{ _blocked ? 'xmark' : 'comment-slash' }}"></i></span>
            <h2 class="p-pe-confirm__title" id="{{ _dialog }}-title">{{ (_blocked ? 'admin.flags.remove.title' : 'admin.flags.block.title')|trans }}</h2>
            <form method="post" action="{{ path(_blocked ? 'admin_flags_unblock' : 'admin_flags_block', {username: member.username}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\Admin\\FlagsController::TOKEN')) }}">
              <input type="hidden" name="return" value="{{ path('members_profile', {username: member.username}) }}">
              {% if _blocked %}
                <p class="p-pe-confirm__text">{{ 'admin.flags.remove.question'|trans({flag: 'NotAllowedToPostInForum', username: member.username}) }}</p>
              {% else %}
                <p class="p-pe-confirm__text">{{ 'admin.flags.block.text'|trans({username: member.username}) }}</p>
                <div class="p-pro-flag__field">
                  <label class="form-label" for="{{ _dialog }}-comment">{{ 'admin.rights.comment'|trans }}</label>
                  <textarea class="o-input" id="{{ _dialog }}-comment" name="comment" rows="3" required></textarea>
                  <small class="form-text">{{ 'admin.flags.block.help'|trans }}</small>
                </div>
              {% endif %}
              <div class="p-pe-confirm__actions">
                <button type="button" class="p-pe-confirm__cancel" data-micromodal-close>{{ 'cancel'|trans }}</button>
                <button type="submit" class="p-pe-confirm__delete">{{ (_blocked ? 'admin.flags.remove.button' : 'admin.flags.block.button')|trans }}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
      {{ encore_entry_script_tags('micromodal') }}
    {% endif %}
  </section>
{% endif %}
