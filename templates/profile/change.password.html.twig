{% extends 'profile/edit_subpage.html.twig' %}
{#
  Change password (from the member menu): the current password, the new one with its strength meter,
  each with an eye to show it; saving signs the member out to sign in again with the new password.
#}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('password/showhide') }}
    {{ encore_entry_script_tags('password/check') }}
{% endblock %}

{% block subpage_back %}{{ url('members_profile', { username: member.username }) }}{% endblock %}
{% block subpage_eyebrow %}{{ 'profile.edit.settings'|trans }}{% endblock %}
{% block drawer_eyebrow %}<i class="fas fa-lock" aria-hidden="true"></i> {{ 'profile.edit.settings'|trans }}{% endblock %}

{% block subpage_title -%}
    {{ 'profile.change.password'|trans }}
{%- endblock %}

{% block subpage_body %}
    {{ form_start(form, { attr: { class: 'p-pw-form', novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <div class="p-pw-intro">
        <span class="p-pw-intro__icon" aria-hidden="true"><i class="fas fa-shield-halved"></i></span>
        <p>{{ 'profile.password.change.intro'|trans }}</p>
    </div>

    <section class="p-account-section">
        <label class="p-account-section__label" for="{{ form.current.vars.id }}">{{ form.current.vars.label|trans }}</label>
        <div class="c-login-form__password">
            {{ form_widget(form.current, { attr: { class: 'c-login-form__input', autocomplete: 'current-password' } }) }}
            {% include 'partials/_password_toggle.html.twig' %}
        </div>
        {{ form_errors(form.current) }}
    </section>

    <section class="p-account-section">
        <label class="p-account-section__label" for="{{ form.password.vars.id }}">{{ form.password.vars.label|trans }}</label>
        <div class="c-login-form__password">
            {{ form_widget(form.password, { attr: { class: 'c-login-form__input js-password-input', autocomplete: 'new-password' } }) }}
            {% include 'partials/_password_toggle.html.twig' %}
        </div>
        {#- Five bars, coloured by password/check.js from red (weak) to green (strong) -#}
        <div class="p-pw-meter js-password-strength" aria-hidden="true">
            {% for i in 1..5 %}<div class="u:grow u:bg-gray-300 u:rounded-4 u:h-4"></div>{% endfor %}
        </div>
        {{ form_errors(form.password) }}
        <p class="p-account-section__help">{{ 'profile.password.change.help'|trans }}</p>
        <input type="hidden" class="js-username" value="{{ app.user.username }}">
        <input type="hidden" class="js-email-address" value="{{ app.user.email }}">
    </section>

    <div class="p-edit-subpage__actions">
        <button type="submit" class="o-button"><i class="fas fa-lock" aria-hidden="true"></i>&nbsp; {{ 'profile.change.password.label'|trans }}</button>
    </div>
    {{ form_end(form) }}
{% endblock %}
