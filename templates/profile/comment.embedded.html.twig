{% import 'macros.twig' as macros %}

{#
  One entry of the comment list: the comment received by the profile member
  ('from') and, nested below it, the comment they wrote back ('to'). When only
  one of the two is visible, it is shown alone.
#}
{% set loggedInMember = app.user %}
{% set fromVisible = comment['from'] is defined and comment['from'].showCondition(loggedInMember) > 0 %}
{% set toVisible = comment['to'] is defined and comment['to'].showCondition(loggedInMember) > 0 %}
{% set main = fromVisible ? comment['from'] : (toVisible ? comment['to'] : null) %}
{% set answer = (fromVisible and toVisible) ? comment['to'] : null %}

{% if main %}
    {# Only offer to write the answer when it is the logged-in member's turn. #}
    {% set otherComment = fromVisible ? (comment['to'] ?? null) : (comment['from'] ?? null) %}
    {% set canAnswer = answer is null and otherComment is null and main.toMember == loggedInMember %}
    {% set answerHtml = answer ? _self.comment(member, loggedInMember, answer, language, true, null, false) : null %}
    {{ _self.comment(member, loggedInMember, main, language, false, answerHtml, canAnswer) }}
{% endif %}

{% macro comment(member, loggedInMember, comment, language, isAnswer, answerHtml, canAnswer) %}
    {% import 'macros.twig' as macros %}
    {% set show = comment.showCondition(loggedInMember) %}
    {% set edit = comment.editCondition(loggedInMember) %}
    {% set isAdmin = is_granted(constant('\\App\\Entity\\Member::ROLE_ADMIN_COMMENTS')) %}
    {% set quality = comment.quality|lower %}
    {% set author = comment.fromMember %}
    {% set linked = author.status in ['Active', 'OutOfRemind'] %}
    {% set qualityIcons = { positive: 'thumbs-up', neutral: 'minus', negative: 'thumbs-down' } %}
    {% set commentDate = (comment.updated is not null and comment.created != comment.updated) ? comment.updated : comment.created %}
    {% set wasGuestOrHost = 'hewasmyguest' in comment.relations or 'hehostedme' in comment.relations %}

    <article class="p-comment{{ isAnswer ? ' p-comment--answer' : '' }}{{ answerHtml ? ' p-comment--thread' : '' }}">
        <div class="p-comment__avatar">
            <div class="o-avatar {{ isAnswer ? 'o-avatar--s' : 'o-avatar--m' }}">
                {{ macros.roundedavatarstack(author.Username, isAnswer ? 48 : 72, false, linked) }}
            </div>
        </div>

        <div class="p-comment__head">
            <div class="p-comment__who">
                <div class="p-comment__name">
                    {% if linked %}
                        {{ macros.profilelink(author.Username, author.Username, 'p-comment__link') }}
                    {% else %}
                        <span class="p-comment__link">{{ author.Username }}</span>
                    {% endif %}
                    {% if author == loggedInMember %}
                        <span class="p-comment__you">{{ 'profile.comment.you'|trans({}, "messages", language) }}</span>
                    {% endif %}
                </div>
                <div class="p-comment__meta">
                    <span title="{{ commentDate|format_datetime() }}">{{ commentDate.diffForHumans }}</span>
                    {% if wasGuestOrHost %}
                        <i class="fas fa-home" aria-hidden="true"></i>
                    {% endif %}
                    {% if isAdmin %}
                        <a class="p-comment__action" href="{{ url('admin_comment', { to_member: comment.toMember.Username, from_member: comment.fromMember.Username }) }}">
                            <i class="fas fa-edit" aria-hidden="true"></i> {{ 'editcomment'|trans({}, "messages", language) }}
                        </a>
                    {% endif %}
                </div>
            </div>
            {% if member.Status != constant('\\App\\Doctrine\\MemberStatusType::PASSED_AWAY') %}
                <span class="p-comment__badge p-comment__badge--{{ quality }}" title="{{ ('comment.quality.' ~ quality)|trans({}, "messages", language) }}">
                    <i class="fas fa-{{ qualityIcons[quality] ?? 'minus' }}" aria-hidden="true"></i>
                    <span class="p-comment__badge-label">{{ ('comment.quality.' ~ quality)|trans({}, "messages", language) }}</span>
                </span>
            {% endif %}
            {% if comment.toMember == loggedInMember %}
                <a class="p-comment__report" href="{{ url('report_comment', { to_member: comment.toMember.Username, from_member: comment.fromMember.Username }) }}"
                   title="{{ 'reportcommentproblem'|trans({}, "messages", language) }}">
                    <i class="far fa-flag" aria-hidden="true"></i><span class="visually-hidden">{{ 'reportcommentproblem'|trans({}, "messages", language) }}</span>
                </a>
            {% endif %}
        </div>

        <div class="p-comment__body">
            {% if show > 1 %}
                <div class="p-comment__hidden">{{ 'commenthiddenedit'|trans({}, "messages", language) }}</div>
            {% endif %}

            <div class="p-comment__text js-read-more-comment"
                 data-config='{
                     {% if isAnswer %}"limit": 160, "after": 40,{% else %}"limit": 280, "after": 60,{% endif %}
                     "more": "{{ 'comment.read.more'|trans({}, "messages", language) }}",
                     "less": "{{ 'comment.show.less'|trans({}, "messages", language) }}" }'>{{ comment.comment|nl2br|purify }}</div>

            {% if edit %}
                <div class="p-comment__actions">
                    <a class="p-comment__edit" href="{{ url('edit_comment', { username: comment.toMember.Username }) }}">
                        <i class="fas fa-pen" aria-hidden="true"></i> {{ 'profile.comment.edit.mine'|trans({}, "messages", language) }}
                    </a>
                </div>
            {% endif %}

            {% if canAnswer %}
                <div class="p-comment__actions">
                    <a class="p-comment__action" href="{{ url('add_comment', { username: comment.fromMember.Username }) }}">
                        <i class="fas fa-reply" aria-hidden="true"></i>
                        {{ 'profile.add.comment'|trans({'username': comment.fromMember.Username, 'gender': comment.fromMember.Gender}, "messages", language) }}
                    </a>
                </div>
            {% endif %}

            {% if answerHtml %}
                <div class="p-comment__answer">{{ answerHtml }}</div>
            {% endif %}
        </div>
    </article>
{% endmacro %}
