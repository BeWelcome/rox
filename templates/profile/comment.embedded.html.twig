{% import 'macros.twig' as macros %}

{#
  One entry of the comment list: the comment received by the profile member
  ('from') and, nested below it, the comment they wrote back ('to'). A comment
  they wrote with no visible comment received from that member is not shown. With hide_answer (the profile page's
  latest comments) the answer is left out; the comments page shows it. Each one is a row: the face with the quality
  on it, the name, how they know the member and the date, the text below.
#}
{% set loggedInMember = app.user %}
{% set fromVisible = comment['from'] is defined and comment['from'].showCondition(loggedInMember) > 0 %}
{% set toVisible = comment['to'] is defined and comment['to'].showCondition(loggedInMember) > 0 %}
{# Only comments the profile member received; one they wrote is shown only as an answer. #}
{% set main = fromVisible ? comment['from'] : null %}
{% set answer = (fromVisible and toVisible) ? comment['to'] : null %}

{% if main %}
    {# Only offer to write the answer when it is the logged-in member's turn. #}
    {% set canAnswer = answer is null and (comment['to'] ?? null) is null and main.toMember == loggedInMember %}
    {% set answerHtml = answer and not (hide_answer ?? false) ? _self.comment(member, loggedInMember, answer, language, true, null, false) : null %}
    {{ _self.comment(member, loggedInMember, main, language, false, answerHtml, canAnswer) }}
{% endif %}

{% macro comment(member, loggedInMember, comment, language, isAnswer, answerHtml, canAnswer) %}
    {% import 'macros.twig' as macros %}
    {% set show = comment.showCondition(loggedInMember) %}
    {% set edit = comment.editCondition(loggedInMember) %}
    {% set isAdmin = is_granted(constant('\\App\\Entity\\Member::ROLE_ADMIN_COMMENTS')) %}
    {% set quality = comment.quality|lower %}
    {% set author = comment.fromMember %}
    {% set linked = author.status in ['Active', 'OutOfRemind'] %}
    {% set qualityIcons = { positive: 'thumbs-up', neutral: 'minus', negative: 'thumbs-down' } %}
    {% set commentDate = (comment.updated is not null and comment.created != comment.updated) ? comment.updated : comment.created %}
    {# How the author knows the member (ticked on the comment form), as small chips with the form's icons #}
    {% set relationIcons = {
        was_my_guest: 'fa-home', hosted_me: 'fa-house-user', only_once: 'fa-handshake', family: 'fa-users',
        close_friend: 'fa-heart', travelled_together: 'fa-route', friends: 'fa-user-friends', chatted: 'fa-comments'
    } %}
    {% set relations = comment.relations|split(',')|map(r => r|trim|lower)|filter(r => r is not empty) %}

    {#- One row: the face with the quality as a small round badge on it, the name, how they know the member
        (grey, with its icon) and the date on the right, the text below -#}
    <article class="p-cmt{{ isAnswer ? ' p-cmt--answer' : '' }}">
        <div class="p-cmt__avatar">
            {% if linked %}<a href="{{ path('members_profile', { username: author.Username }) }}" tabindex="-1" aria-hidden="true">{% endif %}
            <img class="p-cmt__face" src="{{ path('avatar', { username: author.Username, size: isAnswer ? 48 : 96 }) }}" alt="" loading="lazy">
            {% if linked %}</a>{% endif %}
            {% if member.Status != constant('\\App\\Doctrine\\MemberStatusType::PASSED_AWAY') %}
                <span class="p-cmt__quality p-cmt__quality--{{ quality }}">
                    <i class="fas fa-{{ qualityIcons[quality] ?? 'minus' }}" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ ('comment.quality.' ~ quality)|trans({}, "messages", language) }}</span>
                </span>
            {% endif %}
        </div>

        <div class="p-cmt__main">
            {#- The name and the relations wrap on the left; the date stays on the first line, on the right -#}
            <div class="p-cmt__head">
                <span class="p-cmt__who">
                <span class="p-cmt__name">
                    {% if linked %}
                        {{ macros.profilelink(author.Username, author.Username, 'p-cmt__link') }}
                    {% else %}
                        <span class="p-cmt__link">{{ author.Username }}</span>
                    {% endif %}
                    {% if author == loggedInMember %}
                        <span class="p-comment__you">{{ 'profile.comment.you'|trans({}, "messages", language) }}</span>
                    {% endif %}
                </span>
                {% for relation in relations %}
                    <span class="p-cmt__relation">
                        <i class="fas {{ relationIcons[relation] ?? 'fa-user-friends' }}" aria-hidden="true"></i>
                        {#- hosting is said from the reader's side: who hosted whom -#}
                        {{ ((relation in ['was_my_guest', 'hosted_me'] ? 'comment.relation.shown.' : 'profile.comment.relation.') ~ relation)|trans({username: comment.toMember.Username}, "messages", language) }}
                    </span>
                {% endfor %}
                </span>
                <span class="p-cmt__end">
                    <span class="p-cmt__date">{{ commentDate.diffForHumans }}</span>
                    {% if edit %}
                        {# Editing one's own comment: a small round pencil #}
                        <a class="p-comment__edit-icon js-contact-open" href="{{ url('edit_comment', { username: comment.toMember.Username }) }}"
                           data-title="{{ 'profile.comment.edit.mine'|trans|striptags }}">
                            <i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">{{ 'profile.comment.edit.mine'|trans({}, "messages", language) }}</span>
                        </a>
                    {% endif %}
                    {% if comment.toMember == loggedInMember %}
                        <a class="p-comment__report" href="{{ url('report_comment', { to_member: comment.toMember.Username, from_member: comment.fromMember.Username }) }}">
                            <i class="far fa-flag" aria-hidden="true"></i><span class="visually-hidden">{{ 'reportcommentproblem'|trans({}, "messages", language) }}</span>
                        </a>
                    {% endif %}
                </span>
            </div>

            {% if isAdmin %}
                <a class="p-comment__action p-cmt__admin" href="{{ url('admin_comment', { to_member: comment.toMember.Username, from_member: comment.fromMember.Username }) }}">
                    <i class="fas fa-edit" aria-hidden="true"></i> {{ 'editcomment'|trans({}, "messages", language) }}
                </a>
            {% endif %}

            {% if show > 1 %}
                <div class="p-comment__hidden">{{ 'commenthiddenedit'|trans({}, "messages", language) }}</div>
            {% endif %}

            <div class="p-cmt__text js-read-more-comment"
                 data-config='{
                     {% if isAnswer %}"limit": 160, "after": 40,{% else %}"limit": 280, "after": 60,{% endif %}
                     "more": "{{ 'comment.read.more'|trans({}, "messages", language) }}",
                     "less": "{{ 'comment.show.less'|trans({}, "messages", language) }}" }'>{{ comment.comment|nl2br|purify }}</div>


            {# no comment back to a former member (retired) #}
            {% if canAnswer and comment.fromMember is not former_member %}
                <div class="p-comment__actions">
                    <a class="p-comment__action" href="{{ url('add_comment', { username: comment.fromMember.Username }) }}">
                        <i class="fas fa-reply" aria-hidden="true"></i>
                        {{ 'profile.add.comment'|trans({'username': comment.fromMember.Username, 'gender': comment.fromMember.Gender}, "messages", language) }}
                    </a>
                </div>
            {% endif %}

            {% if answerHtml %}
                {# The answer stays folded: a small link opens it #}
                <details class="p-comment__fold">
                    <summary class="p-comment__fold-toggle">
                        <i class="fas fa-reply" aria-hidden="true"></i>
                        <span>{{ 'profile.comment.answer.toggle'|trans({ username: comment.toMember.Username }, "messages", language) }}</span>
                        <i class="fas fa-chevron-down p-comment__fold-chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="p-comment__answer">{{ answerHtml }}</div>
                </details>
            {% endif %}
        </div>
    </article>
{% endmacro %}
