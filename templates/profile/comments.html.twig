{% extends 'profile/profile.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('readmore') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('readmore') }}
{% endblock javascripts %}

{% block page_content %}
  {% set language = app.request.locale %}
  {% set filters = [
    {type: 'all', icon: null, label: 'landing.button.all'|trans, count: comments_count.total},
    {type: 'positive', icon: 'thumbs-up', label: 'comment.quality.positive'|trans, count: comments_count.positive},
    {type: 'neutral', icon: 'minus', label: 'comment.quality.neutral'|trans, count: comments_count.neutral},
    {type: 'negative', icon: 'thumbs-down', label: 'comment.quality.negative'|trans, count: comments_count.negative},
  ] %}
  <div class="p-comments-page p-profile-main">
    <div class="card">
      {# The same filter as the comments of the profile: all, positive, neutral, negative (greyed when empty) #}
      <div class="p-pro-card__head p-comments-page__head">
        <h2 class="p-pro-card__title p-comments-page__title">
          {{ 'profile.comments'|trans }}
          {% if comments_count.total %}<span class="p-pro-card__count">{{ comments_count.total }}</span>{% endif %}
        </h2>
        {# The filter only when the comments are of more than one kind; kinds without comments are left out #}
        {% set _kinds = filters|filter(f => f.type != 'all' and f.count > 0)|length %}
        {% if _kinds > 1 %}
          {# The filter as a small dropdown: the picked one on the button, all four in the menu (greyed when empty) #}
          {% set current = (filters|filter(f => f.type == type)|first) ?: filters|first %}
          <div class="dropdown p-comments-filter">
            <button type="button" class="p-comments-filter__toggle p-comments-filter__toggle--{{ current.type }}" data-bs-toggle="dropdown" aria-expanded="false">
              {% if current.icon %}<i class="fas fa-{{ current.icon }} p-comments-filter__icon--{{ current.type }}" aria-hidden="true"></i>{% endif %}
              <span>{{ current.label|striptags }}</span>
              <span class="p-comments-filter__count">{{ current.count }}</span>
              <i class="fas fa-chevron-down p-comments-filter__chevron" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end p-comments-filter__menu">
              {% for filter in filters|filter(f => f.count > 0) %}
                {% set active = filter.type == current.type %}
                {% set filterUrl = filter.type == 'all' ? url('profile_comments', {username: member.username}) : url('profile_comments', {username: member.username, type: filter.type}) %}
                <li>
                  {% if filter.count > 0 %}
                    <a class="dropdown-item p-comments-filter__item p-comments-filter__item--{{ filter.type }}{{ active ? ' is-active' : '' }}" href="{{ filterUrl }}"{% if active %} aria-current="page"{% endif %}>
                  {% else %}
                    <span class="dropdown-item p-comments-filter__item p-comments-filter__item--{{ filter.type }} is-empty">
                  {% endif %}
                    <i class="fas fa-fw fa-{{ filter.icon ?: 'comments' }} p-comments-filter__icon--{{ filter.type }}" aria-hidden="true"></i>
                    <span>{{ filter.label|striptags }}</span>
                    <span class="p-comments-filter__count">{{ filter.count }}</span>
                  {% if filter.count > 0 %}</a>{% else %}</span>{% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
      <div class="card-body">
        <div class="p-comments-page__list">
          {% set shown = 0 %}
          {% for comment in comments %}
            {% set commentFromVisible = (comment['from'] is defined) ? (comment['from'].showCondition(app.user) > 0) : false %}
            {% if commentFromVisible %}
              {% set shown = shown + 1 %}
              {% include 'profile/comment.embedded.html.twig' with { comment: comment, language: language } %}
            {% endif %}
          {% endfor %}
          {% if shown == 0 %}
            <div class="p-no-comments">
              <i class="fas fa-comment-slash" aria-hidden="true"></i>
              <p>{{ 'profile.no.comments'|trans }}</p>
            </div>
          {% endif %}
        </div>

        {# Only "add a comment": an own comment already has its small edit button. #}
        {% if submenu.items is defined and submenu.items.comment is defined and submenu.items.comment.key != 'EditComments' %}
          <div class="p-comments-cta">
            <a href="{{ submenu.items.comment.url }}" class="p-hero__btn p-hero__btn--secondary js-contact-open" data-title="{{ submenu.items.comment.key|lower|trans|striptags }}">
              <i class="fas fa-comment p-comments-cta__icon" aria-hidden="true"></i><i class="fas fa-pen p-comments-cta__icon p-comments-cta__icon--phone" aria-hidden="true"></i> {{ submenu.items.comment.key|lower|trans }}
            </a>
          </div>
        {% endif %}

        {% if member.Status != constant('\\App\\Doctrine\\MemberStatusType::PASSED_AWAY') %}
          <p class="p-comments-page__guidelines"><i class="fas fa-info-circle" aria-hidden="true"></i> <span>{{ 'commentguidlineslink'|trans|raw }}</span></p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock page_content %}
