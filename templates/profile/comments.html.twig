{% extends 'profile/profile.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('readmore') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('readmore') }}
{% endblock javascripts %}

{% block page_content %}
  {% set language = app.request.locale %}
  {% set filters = [
    {type: 'all', icon: 'list-ul', label: 'landing.button.all'|trans, count: comments_count.total},
    {type: 'positive', icon: 'thumbs-up', label: 'comment.quality.positive'|trans, count: comments_count.positive},
    {type: 'neutral', icon: 'minus', label: 'comment.quality.neutral'|trans, count: comments_count.neutral},
    {type: 'negative', icon: 'thumbs-down', label: 'comment.quality.negative'|trans, count: comments_count.negative},
  ] %}
  <div class="p-comments-page p-profile-main">
    <div class="card">
      <div class="card-header u:flex u:flex-row u:justify-between">
        <span>
          {{ 'profile.comments'|trans }}
          {% if comments_count.total > 0 %}
            <span class="p-gallery-footer__count">{{ comments_count.total }}</span>
          {% endif %}
        </span>
        {% if submenu.items is defined and submenu.items.comment is defined %}
          {% set add_text = submenu.items.comment.key|lower|trans %}
          <div><a href="{{ submenu.items.comment.url }}"><i class="fas fa-comment" title="{{ add_text }}" aria-hidden="true"></i><span class="visually-hidden">{{ add_text }}</span></a></div>
        {% endif %}
      </div>
      <div class="card-body">
        {% if comments_count.total > 0 %}
          <nav class="p-comments-tabs" aria-label="{{ 'profile.comments'|trans }}">
            {% for filter in filters %}
              {% set active = type == filter.type %}
              <a href="{{ filter.type == 'all' ? url('profile_comments', {username: member.username}) : url('profile_comments', {username: member.username, type: filter.type}) }}"
                 class="p-comments-tabs__tab p-comments-tabs__tab--{{ filter.type }}{% if active %} p-comments-tabs__tab--active{% endif %}"
                 {% if active %}aria-current="page"{% endif %}>
                <i class="fas fa-{{ filter.icon }}" aria-hidden="true"></i>
                {{ filter.label }}
                <span class="p-comments-tabs__count">{{ filter.count }}</span>
              </a>
            {% endfor %}
          </nav>
        {% endif %}

        <div class="p-comments-page__list">
          {% set shown = 0 %}
          {% for comment in comments %}
            {% set commentToVisible = (comment['to'] is defined) ? (comment['to'].showCondition(app.user) > 0) : false %}
            {% set commentFromVisible = (comment['from'] is defined) ? (comment['from'].showCondition(app.user) > 0) : false %}
            {% if commentToVisible or commentFromVisible %}
              {% set shown = shown + 1 %}
              {% include 'profile/comment.embedded.html.twig' with { comment: comment, language: language } %}
            {% endif %}
          {% endfor %}
          {% if shown == 0 %}
            <div class="p-no-comments">
              <i class="fas fa-comment-slash" aria-hidden="true"></i>
              <p>{{ 'profile.no.comments'|trans }}</p>
            </div>
          {% endif %}
        </div>

        {% if member.Status != constant('\\App\\Doctrine\\MemberStatusType::PASSED_AWAY') %}
          <p class="p-comments-page__guidelines">{{ 'commentguidlineslink'|trans|raw }}</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock page_content %}
