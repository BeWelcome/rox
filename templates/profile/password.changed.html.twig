{% extends 'base.html.twig' %}

{% block redirect %}
  <meta http-equiv="refresh" content="0; URL='{{ path('_logout_main') }}'">
  <script>window.location.replace({{ path('_logout_main')|json_encode|raw }});</script>
{% endblock %}

{% block content %}
  <h1>{{ 'logout'|trans }}</h1>
  <p><a href="{{ path('_logout_main') }}">{{ 'logout'|trans }}</a></p>
{% endblock %}
