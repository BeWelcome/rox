{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans({username:member.Username}) }}{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('profile/profile') }}
  {{ encore_entry_script_tags('lightbox') }}
{% endblock javascripts %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('lightbox') }}
  {{ encore_entry_link_tags('leaflet') }}
  {# Between the profile's pages (its tabs) the browser keeps the head and the tabs in place and fades the content,
     instead of showing a new page (browsers with cross-document view transitions; the others load the page as before) #}
  <style>
    @view-transition { navigation: auto; }
    .p-pro { view-transition-name: profile-head; }
    .p-pro__tabs-wrap { view-transition-name: profile-tabs; }
  </style>
{% endblock %}

{% block main %}
<main role="main">
  {% include 'profile/header.html.twig' %}
  <div class="container-lg pt-0">
    {% block above_body %}{% endblock %}
    {% block page_content %}{% endblock %}
    {% block below_body %}{% endblock %}
  </div>
  {% block modals %}{% endblock modals %}
</main>
{% endblock main %}
