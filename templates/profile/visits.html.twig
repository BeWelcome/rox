{% extends 'profile/profile.html.twig' %}

{# The member's visitors, latest first: a tile per visitor (avatar, name, when), like the friends page. #}
{% block page_content %}
  <div class="p-friends-page p-visitors-page p-profile-main">
    <div class="card">
      <div class="card-header u:flex u:flex-row u:justify-between">
        <span>
          {{ 'myvisitors'|trans }}
          {% if visits.nbResults > 0 %}
            <span class="p-gallery-footer__count">{{ visits.nbResults }}</span>
          {% endif %}
        </span>
      </div>
      <div class="card-body">
        {% if visits.nbResults == 0 %}
          <div class="p-no-comments">
            <i class="fas fa-eye" aria-hidden="true"></i>
            <p>{{ 'profile.visitors.none.visible'|trans }}</p>
          </div>
        {% else %}
          <ul class="p-friends-page__grid" id="visitors">
            {% for visit in visits %}
              {% set visitor = visit.visitor %}
              <li>
                <a class="p-friends-page__item" href="{{ url('members_profile', {username: visitor.username}) }}">
                  <span class="o-avatar o-avatar--m">
                    <span class="o-avatar__img-wrapper o-avatar--shadow-s">
                      <img class="o-avatar__img" src="{{ path('avatar', {username: visitor.username, size: 72}) }}" alt="" loading="lazy">
                    </span>
                  </span>
                  <span class="p-friends-page__name">{{ visitor.username }}</span>
                  <span class="p-visitors-page__when">{{ visit.updated.diffForHumans }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
          {% if visits.haveToPaginate %}
            <div class="p-friends-page__pager">
              {{ pagerfanta(visits, 'rounded_pagination_end') }}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock page_content %}
