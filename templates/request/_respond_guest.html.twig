{#
  The guest's answer in a hosting request, under the messages: a message to the host,
  and on demand other dates or the number of travellers. "Cancel request" cancels it.
  Expects respond (HostingRequestGuest form view) and current (the newest message).
#}
{% import 'request/_request.macros.twig' as stay %}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set fields = respond.request %}
{% set showStay = fields.duration.vars.errors|length > 0 or fields.numberOfTravellers.vars.errors|length > 0 %}

{{ form_start(respond, { action: path('conversation_reply', { id: current.id }), attr: { class: 'c-inbox-respond c-inbox-respond--guest js-respond', novalidate: 'novalidate', autocomplete: 'off' } }) }}
    {{ form_errors(respond) }}

    <div class="c-inbox-respond__stay c-inbox-respond__stay--grid js-respond-stay"{% if not showStay %} hidden{% endif %}>
        {{ stay.dates(fields) }}
        {{ stay.travellers(fields.numberOfTravellers) }}
        <div class="c-request-line">
            {{ stay.nights(fields) }}
            {% if fields.flexible is defined %}{{ stay.flexible(fields.flexible) }}{% endif %}
        </div>
    </div>
    {% do fields.setRendered %}

    {% if respond.message.vars.errors|length > 0 %}
        <div class="c-inbox-compose__error">{{ form_errors(respond.message) }}</div>
    {% endif %}
    <div class="c-inbox-respond__compose c-inbox-respond__compose--actions">
        {# A plain text field (turned into paragraphs on send) instead of the rich editor: it takes less room. #}
        <div class="c-inbox-respond__editor c-inbox-respond__editor--plain">
            <textarea class="c-inbox-respond__text js-respond-text" id="{{ respond.message.vars.id }}" name="{{ respond.message.vars.full_name }}" rows="3"
                      placeholder="{{ respond.message.vars.attr.placeholder|default('')|trans }}" aria-label="{{ respond.message.vars.label|trans }}">
                {{- respond.message.vars.value|replace({'</p>': '\n\n', '<br>': '\n', '<br />': '\n'})|striptags|trim -}}
            </textarea>
        </div>
        {% do respond.message.setRendered %}
        <div class="c-inbox-respond__more">
            {% if current.request.status != constant(S ~ 'REQUEST_CANCELLED') %}
                <button type="submit" id="{{ respond.cancel.vars.id }}" name="{{ respond.cancel.vars.full_name }}" class="c-inbox-respond__secondary c-inbox-respond__secondary--danger"
                        onclick="return confirm('{{ 'request.confirm.cancel'|trans|e('js') }}');">
                    <i class="fa fa-times" aria-hidden="true"></i> {{ respond.cancel.vars.label|trans }}
                </button>
            {% endif %}
        </div>
        <div class="c-inbox-respond__actions">
            {% include 'conversations/_reply_templates.html.twig' with { editor_id: respond.message.vars.id, menu_up: true } only %}
            <button type="button" class="c-inbox-respond__secondary js-respond-stay-toggle" aria-expanded="{{ showStay ? 'true' : 'false' }}">
                <i class="fa fa-calendar" aria-hidden="true"></i> {{ 'request.respond.change'|trans }}
            </button>
            <button type="submit" id="{{ respond.update.vars.id }}" name="{{ respond.update.vars.full_name }}" class="c-inbox-reply__btn c-inbox-respond__send">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                <span class="c-inbox-respond__send-label">{{ 'label.message.button.send'|trans }}</span>
            </button>
        </div>
    </div>
    {% do respond.cancel.setRendered %}
    {% do respond.update.setRendered %}
    {{ form_rest(respond) }}
{{ form_end(respond) }}
