{#
  The host's answer to a hosting request, under the messages (on the conversation page
  and on the reply page when the form comes back with an error).
  By default Send posts a plain message (the "update" button: the answer stays as it is).
  "Reply" opens the options: the dates (when the guest is flexible) and Accept, Maybe
  or Decline; the send button then submits as the picked button. The options start
  open while the request waits for an answer and folded once the host has answered;
  "Reply" opens or folds them (its arrow shows which way).
  Expects respond (HostingRequestHost form view) and current (the newest message).
#}
{% import 'request/_request.macros.twig' as stay %}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set request = current.request %}
{% set fields = respond.request %}
{% set flexible = fields.flexible is defined %}

{% set choices = [] %}
{% if request.status != constant(S ~ 'REQUEST_ACCEPTED') %}
    {% set choices = choices|merge([{ key: 'accept', button: respond.accept, icon: 'fa fa-check' }]) %}
{% endif %}
{% if request.status != constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED') %}
    {% set choices = choices|merge([{ key: 'maybe', button: respond.tentatively, icon: 'fa fa-question' }]) %}
{% endif %}
{% if request.status != constant(S ~ 'REQUEST_DECLINED') %}
    {% set choices = choices|merge([{ key: 'decline', button: respond.decline, icon: 'fa fa-times' }]) %}
{% endif %}

{% set awaitingAnswer = request.status == constant(S ~ 'REQUEST_OPEN') %}
{# Open while the request waits for an answer (or the form came back with an error), folded once answered. #}
{% set optionsOpen = awaitingAnswer or not respond.vars.valid %}

{{ form_start(respond, { action: path('conversation_reply', { id: current.id }), attr: { class: 'c-inbox-respond js-respond', novalidate: 'novalidate', autocomplete: 'off' } }) }}
    {{ form_errors(respond) }}

    <div class="c-inbox-respond__options js-respond-options" id="{{ respond.vars.id }}_options"{{ optionsOpen ? '' : ' hidden' }}>
    <div class="c-inbox-respond__head">
        <h2 class="c-inbox-respond__title">{{ 'request.respond.title'|trans }}</h2>
        {% if not flexible %}
            <p class="c-inbox-respond__note"><i class="fas fa-lock" aria-hidden="true"></i> {{ 'request.host.fixed.dates'|trans }}</p>
        {% endif %}
    </div>

    {% if flexible %}
        {# The guest is flexible: the host may suggest other dates. #}
        <div class="c-inbox-respond__stay">
            {{ stay.dates(fields) }}
            <div class="c-request-line">
                {{ stay.nights(fields) }}
                {{ stay.flexible(fields.flexible) }}
            </div>
            <p class="c-inbox-compose__hint">{{ 'request.host.suggest.dates'|trans }}</p>
        </div>
    {% else %}
        {{ form_widget(fields.arrival) }}
        {{ form_widget(fields.departure) }}
        {% do fields.duration.setRendered %}
    {% endif %}
    {{ form_widget(fields.numberOfTravellers) }}
    {% do fields.setRendered %}

    {% if choices|length %}
        <div class="c-inbox-respond__choices c-inbox-respond__choices--{{ choices|length }}" role="radiogroup" aria-label="{{ 'request.respond.title'|trans }}">
            {% for choice in choices %}
                <label class="c-inbox-respond__choice c-inbox-respond__choice--{{ choice.key }}">
                    <input type="radio" name="respond_choice" value="{{ choice.key }}" class="js-respond-choice"
                           data-button="{{ choice.button.vars.full_name }}">
                    <span><i class="{{ choice.icon }}" aria-hidden="true"></i> {{ choice.button.vars.label|trans }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}
    </div>
    {% do respond.accept.setRendered %}
    {% do respond.tentatively.setRendered %}
    {% do respond.decline.setRendered %}

    {% if respond.message.vars.errors|length > 0 %}
        <div class="c-inbox-compose__error">{{ form_errors(respond.message) }}</div>
    {% endif %}
    <div class="c-inbox-respond__compose c-inbox-respond__compose--actions">
        {# A plain text field (turned into paragraphs on send) instead of the rich editor: it takes less room. #}
        <div class="c-inbox-respond__editor c-inbox-respond__editor--plain">
            <textarea class="c-inbox-respond__text js-respond-text" id="{{ respond.message.vars.id }}" name="{{ respond.message.vars.full_name }}" rows="3"
                      placeholder="{{ 'request.respond.placeholder'|trans }}" aria-label="{{ respond.message.vars.label|trans }}">
                {{- respond.message.vars.value|replace({'</p>': '\n\n', '<br>': '\n', '<br />': '\n'})|striptags|trim -}}
            </textarea>
        </div>
        {% do respond.message.setRendered %}
        <div class="c-inbox-respond__more">
            {% if request.status != constant(S ~ 'REQUEST_DECLINED') %}
                <a class="c-inbox-respond__link c-inbox-respond__link--danger js-respond-decline-link" href="{{ path('conversation_decline', { id: current.id }) }}" hidden>
                    {{ 'label.decline.no.message'|trans }}
                </a>
            {% endif %}
        </div>
        <div class="c-inbox-respond__actions">
            {% include 'conversations/_reply_templates.html.twig' with { editor_id: respond.message.vars.id, menu_up: true } only %}
            <button type="button" class="c-inbox-respond__secondary{{ awaitingAnswer ? ' c-inbox-respond__secondary--awaiting' : '' }} js-respond-options-toggle"
                    aria-controls="{{ respond.vars.id }}_options" aria-expanded="{{ optionsOpen ? 'true' : 'false' }}">
                <i class="fa fa-calendar" aria-hidden="true"></i> {{ 'request.respond.toggle'|trans }}
                {% if awaitingAnswer %}<span class="c-inbox-respond__dot" title="{{ 'request.status.open'|trans }}"></span>{% endif %}
                <i class="fas fa-chevron-down c-inbox-respond__chevron" aria-hidden="true"></i>
            </button>
            <button type="submit" id="{{ respond.update.vars.id }}" name="{{ respond.update.vars.full_name }}"
                    class="c-inbox-reply__btn c-inbox-respond__send js-respond-send" data-button="{{ respond.update.vars.full_name }}">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                <span class="c-inbox-respond__send-label">{{ 'label.message.button.send'|trans }}</span>
            </button>
        </div>
    </div>
    {% do respond.update.setRendered %}
    {{ form_rest(respond) }}
{{ form_end(respond) }}
