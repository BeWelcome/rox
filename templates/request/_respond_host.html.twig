{#
  The host's answer to a hosting request, under the messages (on the conversation page
  and on the reply page when the form comes back with an error): the message and Send.
  Accept, Maybe and Decline are in the stay card (request/_stay_answer.html.twig): a pick
  shows the picked answer and "Change" above the message, the dates when the guest is
  flexible (accept or maybe), and Send submits as the picked button (requests.js).
  Without a pick, Send posts a plain message.
  Expects respond (HostingRequestHost form view) and current (the newest message).
  The invited member answers an invitation with the same form (InvitationGuest form
  view): then "guest" below is the member who invited, and Accept and Maybe are missing
  once the invitation was accepted.
#}
{% import 'request/_request.macros.twig' as stay %}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set request = current.request %}
{% set fields = respond.request %}
{% set flexible = fields.flexible is defined %}
{% set guest = current.initiator %}
{% set isInvitation = request.inviteForLeg is not null %}
{% set guestName = guest.shortNameOrUsername ?? guest.username %}

{% set awaitingAnswer = request.status == constant(S ~ 'REQUEST_OPEN') %}

{{ form_start(respond, { action: path('conversation_reply', { id: current.id }|merge(app.request.query.getBoolean('embed') ? { embed: 1 } : {})), attr: { class: 'c-inbox-respond c-decide js-respond' ~ (awaitingAnswer ? '' : ' c-decide--answered'), novalidate: 'novalidate', autocomplete: 'off' } }) }}
    {{ form_errors(respond) }}

    {% if respond.accept is defined %}{% do respond.accept.setRendered %}{% endif %}
    {% if respond.tentatively is defined %}{% do respond.tentatively.setRendered %}{% endif %}
    {% do respond.decline.setRendered %}

    {# The message, with the answer picked in the stay card (request/_stay_answer.html.twig) on top #}
    <div class="c-decide__step c-decide__write js-decide-step" data-step="write" data-choice="reply">
        {# The picked answer and "Change" (hidden while no answer is picked: then Send posts a plain message) #}
        <div class="c-decide__top">
            {% for key, icon in { accept: 'fa fa-check', maybe: 'fa fa-question', decline: 'fa fa-times' } %}
                <span class="c-decide__picked c-decide__picked--{{ key }} js-decide-picked" data-choice="{{ key }}" hidden>
                    <i class="{{ icon }}" aria-hidden="true"></i> {{ ('request.decide.' ~ key)|trans }}
                </span>
            {% endfor %}
            <button type="button" class="c-decide__change js-decide-change">{{ 'request.decide.change'|trans }}</button>
        </div>

        {% if flexible %}
            {# The guest is flexible: when accepting (or maybe), the host may suggest other dates. #}
            <div class="c-inbox-respond__stay c-decide__stay js-decide-stay" hidden>
                {{ stay.dates(fields) }}
                <div class="c-request-line">
                    {{ stay.nights(fields) }}
                    {{ stay.flexible(fields.flexible) }}
                </div>
                <p class="c-inbox-compose__hint">{{ 'request.host.suggest.dates'|trans }}</p>
            </div>
        {% else %}
            {{ form_widget(fields.arrival) }}
            {{ form_widget(fields.departure) }}
            {% if fields.duration is defined %}{% do fields.duration.setRendered %}{% endif %}
        {% endif %}
        {{ form_widget(fields.numberOfTravellers) }}
        {% if fields.inviteForLeg is defined %}{{ form_widget(fields.inviteForLeg) }}{% endif %}
        {% do fields.setRendered %}

        {% if respond.message.vars.errors|length > 0 %}
            <div class="c-inbox-compose__error">{{ form_errors(respond.message) }}</div>
        {% endif %}
        {# One line: the camera, the message, Send (templates: the "⋯" menu of the stay card, request/_card_menu.html.twig) #}
        {% include 'conversations/_photo_attach.html.twig' with { part: 'tray', name: guestName } only %}
        <div class="c-decide__foot c-decide__foot--inline">
            {% include 'conversations/_photo_attach.html.twig' with { part: 'button' } only %}
            {# A plain text field (turned into paragraphs on send) instead of the rich editor: it takes less room. #}
            <textarea class="c-decide__text js-respond-text" id="{{ respond.message.vars.id }}" name="{{ respond.message.vars.full_name }}" rows="1"
                      aria-label="{{ respond.message.vars.label|trans }}"
                      placeholder="{{ 'conversation.write.to'|trans({ username: guestName }) }}"
                      data-placeholder-accept="{{ 'conversation.answer.placeholder'|trans }}"
                      data-placeholder-maybe="{{ 'conversation.answer.placeholder'|trans }}"
                      data-placeholder-decline="{{ 'conversation.answer.placeholder'|trans }}"
                      data-placeholder-reply="{{ 'conversation.write.to'|trans({ username: guestName }) }}">
                {{- respond.message.vars.value|replace({'</p>': '\n\n', '<br>': '\n', '<br />': '\n'})|striptags|trim -}}
            </textarea>
            <button type="submit" id="{{ respond.update.vars.id }}" name="{{ respond.update.vars.full_name }}"
                    class="c-decide__send js-respond-send" data-button="{{ respond.update.vars.full_name }}">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                {% for key in ['accept', 'maybe', 'decline', 'reply'] %}
                    <span class="js-decide-send" data-choice="{{ key }}"{{ key == 'reply' ? '' : ' hidden' }}>{{ (key == 'reply' ? 'label.message.button.send' : 'request.decide.send.' ~ key)|trans }}</span>
                {% endfor %}
            </button>
        </div>
        {% do respond.message.setRendered %}

        {% if request.status != constant(S ~ 'REQUEST_DECLINED') %}
            <button type="submit" form="conversation-decline-{{ current.id }}" class="o-post-link__button c-decide__decline-link js-respond-decline-link" hidden>
                {{ 'label.decline.no.message'|trans }}
            </button>
        {% endif %}
    </div>
    {% do respond.update.setRendered %}
    {{ form_rest(respond) }}
{{ form_end(respond) }}
{# declining without a message posts its own form (the button above is in the reply form) #}
<form id="conversation-decline-{{ current.id }}" method="post" action="{{ path('conversation_decline', { id: current.id }|merge(app.request.query.getBoolean('embed') ? { embed: 1 } : {})) }}" hidden>
    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\ConversationController::TOKEN')) }}">
</form>
