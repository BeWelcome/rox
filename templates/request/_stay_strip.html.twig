{#
  The stay card as one line on phones (hidden on a computer): the dates and nights, the kind
  and the people, where it stands, and a chevron that hides or shows the answer buttons under
  it (requests.js); the card's "⋯" menu sits at its right end. Expects stay, status and nights (request/header.html.twig,
  invitation/header.html.twig), kind_icon, kind_title and decider (the member who answers).
#}
{% set _label = status.key == 'open' ? (decider ? 'request.strip.your.answer' : 'conversations.state.waiting') : (status.key ? 'request.status.' ~ status.key : null) %}
<button type="button" class="c-stay-strip js-stay-strip" aria-expanded="{{ status.key == 'open' and decider ? 'true' : 'false' }}">
    <span class="c-stay-strip__icon"><i class="{{ kind_icon }}" aria-hidden="true"></i></span>
    <span class="c-stay-strip__text">
        <strong>{{ stay.arrival|date('Y-m') == stay.departure|date('Y-m') ? stay.arrival|format_date(pattern='d') : stay.arrival|format_date(pattern='d MMM') }}–{{ stay.departure|format_date(pattern='d MMM') }} · {{ 'contact.trip.nights'|trans({ count: nights }) }}</strong>
        <span>{{ kind_title|trans }} · {{ 'request.card.persons'|trans({ count: stay.numberOfTravellers }) }}</span>
    </span>
    {% if _label %}<span class="c-stay-strip__state">{{ _label|trans }}</span>{% endif %}
    <i class="fas fa-chevron-down c-stay-strip__chevron" aria-hidden="true"></i>
</button>
