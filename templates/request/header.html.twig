{#
  What the hosting request is about, above the messages: the dates and where the
  request stands, then the nights, the people and whether the dates are flexible.
  The guest and the host read a different status text. Expects request, original
  (first message of the thread) and myself.
#}
{% set S = 'App\\Entity\\HostingRequest::' %}
{% set side = original.Initiator.Username == myself.Username ? 'guest' : 'host' %}
{% set statuses = {
    (constant(S ~ 'REQUEST_OPEN')): { key: 'open', tone: 'pending', icon: 'fas fa-exclamation-circle' },
    (constant(S ~ 'REQUEST_TENTATIVELY_ACCEPTED')): { key: 'tentatively', tone: 'pending', icon: 'fa fa-question' },
    (constant(S ~ 'REQUEST_ACCEPTED')): { key: 'accepted', tone: 'success', icon: 'far fa-handshake' },
    (constant(S ~ 'REQUEST_DECLINED')): { key: 'declined', tone: 'danger', icon: 'fa fa-times' },
    (constant(S ~ 'REQUEST_CANCELLED')): { key: 'cancelled', tone: 'danger', icon: 'fa fa-times' },
} %}
{% set status = statuses[request.status] ?? { key: null, tone: 'pending', icon: '' } %}
{% set nights = date(request.departure).diff(date(request.arrival)).days %}
{% set sameYear = request.arrival|date('Y') == request.departure|date('Y') %}

<section class="c-inbox-trip c-inbox-trip--{{ status.tone }}">
    <span class="c-inbox-trip__icon" aria-hidden="true"><i class="fas fa-bed"></i></span>
    <div class="c-inbox-trip__body">
        <div class="c-inbox-trip__top">
            <p class="c-inbox-trip__dates">
                <span class="c-inbox-trip__day">{{ request.arrival|format_date(pattern='EEE') }}</span>
                {{ request.arrival|format_date(pattern=sameYear ? 'd MMM' : 'd MMM y') }}
                <span class="c-inbox-trip__sep" aria-hidden="true">→</span>
                <span class="c-inbox-trip__day">{{ request.departure|format_date(pattern='EEE') }}</span>
                {{ request.departure|format_date(pattern='d MMM y') }}
            </p>
        </div>
        <ul class="c-inbox-trip__facts">
            <li><i class="fa fa-moon" aria-hidden="true"></i> {{ 'request.night.stay'|trans({ numbernights: nights }) }}</li>
            <li><i class="fa fa-users" aria-hidden="true"></i> {{ 'request.number.persons'|trans({ numberpersons: request.numberOfTravellers }) }}</li>
            {% if request.flexible %}
                <li><i class="fas fa-sync" aria-hidden="true"></i> {{ 'label.flexible'|trans }}</li>
            {% else %}
                <li><i class="fas fa-lock" aria-hidden="true"></i> {{ 'request.not.flexible.with.arrival.departure'|trans }}</li>
            {% endif %}
        </ul>
    </div>
    {% if status.key %}
        {# Short status on the right. #}
        <span class="c-inbox-trip__status">
            <i class="{{ status.icon }}" aria-hidden="true"></i>
            {{ ('request.status.' ~ status.key)|trans }}
        </span>
    {% endif %}
</section>
