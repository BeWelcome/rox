{% extends 'conversations/reply_layout.html.twig' %}

{% set compose_class = ' c-inbox-compose--respond' %}

{% block javascripts %}
    {{ encore_entry_script_tags('requests') }}
{% endblock javascripts %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('requests') }}
{% endblock stylesheets %}

{% block reply_extra %}
    {% set original = thread | last %}
    {% set request = (thread | first).request %}
    {% set myself = app.user %}
    {% include 'request/header.html.twig' %}
{% endblock reply_extra %}

{% block reply_form %}
    {% include 'request/_respond_guest.html.twig' with { respond: form, current: thread | first } %}
{% endblock reply_form %}
