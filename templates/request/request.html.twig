{% extends 'base.html.twig' %}
{% set inbox_page = true %}

{% set hide_sidebar = true %}

{% block javascripts %}
    {{ encore_entry_script_tags('requests') }}
{% endblock javascripts %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('requests') }}
{% endblock stylesheets %}

{% block title %}
    {{ 'request.write_to'|trans|format(host.shortNameOrUsername) }}
{% endblock title %}

{% block content %}
    {# imported in the block: the translators' preview renders only this block #}
    {% import 'conversations/_inbox.macros.twig' as inbox %}
    {% import 'request/_request.macros.twig' as stay %}
    {% set address = host.activeAddress %}
    {% set languages %}
        {%- for level in host.languageLevels -%}
            {{ ('lang_' ~ level.language.shortCode)|lower|trans }}
            {%- if level.level == constant('App\\Doctrine\\LanguageLevelType::MOTHER_TONGUE') %} ({{ ('language.level.' ~ level.level)|lower|trans }}){% endif -%}
            {%- if not loop.last %}, {% endif -%}
        {%- endfor -%}
    {% endset %}
    {% set meta = [] %}
    {% if address is not same as(false) and address is not null and address.location %}
        {% set meta = meta|merge([address.location.name ~ (address.location.country ? ', ' ~ address.location.country.name : '')]) %}
    {% endif %}
    {% if languages|trim %}
        {% set meta = meta|merge(['speaks'|trans ~ ' ' ~ languages|trim]) %}
    {% endif %}
    {% set profileUrl = path('members_profile', { username: host.username }) %}
    {% set fields = form.request %}

    {% set embedded = app.request.query.getBoolean('embed') %}
    {% if embedded %}
        {# The "contact a member" side panel (search preview, profile) #}
        {% include 'request/_embed_form.html.twig' %}
    {% else %}
    <div class="c-inbox c-inbox--thread{% if embedded %} c-inbox--embedded{% endif %}">
        {% if not embedded %}
        {{ inbox.nav(folder, 'column') }}

        <section class="c-inbox__list">
            <div class="c-inbox-list">
                {{ inbox.list(conversations, folder, { initiator: initiator, unreadOnly: unreadOnly }) }}
            </div>
        </section>
        {% endif %}

        <section class="c-inbox__pane">
            {% if not embedded %}
            {% include 'conversations/_pane_head.html.twig' with {
                current: null,
                correspondent: host,
                subject: 'request.write_to'|trans|format(host.shortNameOrUsername),
                meta: meta|join(' · '),
                linked: true,
                back_url: profileUrl,
                show_actions: false,
                is_spam: false,
                show_deleted: false,
            } %}
            {% endif %}

            {{ form_start(form, { attr: { novalidate: 'novalidate', autocomplete: 'off', class: 'c-inbox-new c-request-new' } }) }}
                <div class="c-inbox-new__body">
                    {{ form_errors(form) }}

                    <div class="c-request-new__stay">
                        {{ stay.dates(fields) }}
                        {{ stay.travellers(fields.numberOfTravellers) }}
                        <div class="c-request-line">
                            {{ stay.nights(fields) }}
                            {{ stay.flexible(fields.flexible) }}
                        </div>
                    </div>
                    {% do fields.setRendered %}

                    <div class="p-message-form__field">
                        <label class="o-label" for="{{ form.subject.subject.vars.id }}">{{ form.subject.subject.vars.label|trans }}</label>
                        {{ form_widget(form.subject.subject, { attr: form.subject.subject.vars.attr|merge({ class: 'o-input' }) }) }}
                        {{ form_errors(form.subject.subject) }}
                    </div>

                    {# A plain text box: the text is sent as paragraphs (contact/plain_text.js) #}
                    <div class="p-message-form__field c-plain-message-field">
                        <label class="o-label" for="{{ form.message.vars.id }}">{{ form.message.vars.label|trans }}</label>
                        <textarea class="o-input c-plain-message js-plain-message" id="{{ form.message.vars.id }}" name="{{ form.message.vars.full_name }}" rows="7"
                                  placeholder="{{ (form.message.vars.attr.placeholder ?? '')|trans }}" data-html="{{ form.message.vars.value }}"></textarea>
                        {% do form.message.setRendered %}
                        {{ form_errors(form.message) }}
                    </div>
                    {% do form.send.setRendered %}

                    {{ form_rest(form) }}
                </div>

                <div class="c-inbox-new__actions">
                    <button type="submit" name="{{ form.send.vars.full_name }}" class="c-inbox-reply__btn c-inbox-compose__send">
                        <i class="fas fa-paper-plane" aria-hidden="true"></i> {{ 'label.message.button.send'|trans }}
                    </button>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
    {% endif %}
{% endblock content %}
