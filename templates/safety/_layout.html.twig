{% extends 'base.html.twig' %}
{#
  The safety pages (SafetyController): the eyebrow, the pages as pill tabs and the button to report a problem with a
  member, then the page in the same two columns everywhere: the cards in the main column (safety_content), the
  Safety Team's contact card on the side (safety_side adds to it). A page sets active (the route of its tab).
#}
{% set _tabs = {
    safety: 'safetymain',
    safety_basics: 'safetybasics',
    safety_what_to_do: 'safetywhattodo',
    safety_tips: 'safetytips',
    safety_faq: 'safetyfaq',
    safety_team: 'safetyteam',
} %}

{% block title %}{{ 'safety'|trans }}{% endblock %}

{% block main %}
    <main role="main" class="p-safety">
        <div class="container-lg">
            <header class="p-safety__head">
                <p class="c-page-head__eyebrow">{{ 'safety'|trans }}</p>
                <div class="p-safety__bar">
                    <nav class="p-safety__tabs" aria-label="{{ 'safety'|trans }}">
                        {% for route, key in _tabs %}
                            <a class="p-safety__tab{{ route == active ? ' is-active' }}" href="{{ path(route) }}"{% if route == active %} aria-current="page"{% endif %}>{{ key|trans }}</a>
                        {% endfor %}
                    </nav>
                    <a class="c-cadmin-btn c-cadmin-btn--primary p-safety__report" href="{{ path('feedback', {IdCategory: 2}) }}"><i class="fas fa-shield-halved" aria-hidden="true"></i>{{ 'safetycontact'|trans }}</a>
                </div>
            </header>

            <div class="p-safety__columns">
                <div class="p-safety__main">
                    {% block safety_content %}{% endblock %}
                </div>
                <aside class="p-safety__side">
                    {% include 'safety/_contact.html.twig' %}
                    {% block safety_side %}{% endblock %}
                </aside>
            </div>
        </div>
    </main>
{% endblock main %}
