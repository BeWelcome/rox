{% extends 'safety/_layout.html.twig' %}
{# How to assess whether a member is trustworthy, then on to the safety FAQ #}
{% set active = 'safety_basics' %}

{% block safety_content %}
    <article class="p-safety__card p-safety__article">
        <section id="trustworthy">
            <h1>{{ 'safety_trustworthy'|trans|striptags }}</h1>
            <div class="p-safety__text">{{ 'safety_trustworthytext'|trans|purify }}</div>
        </section>
        <a class="p-safety__more" href="{{ path('safety_faq') }}">{{ 'safety_learnaboutfaq'|trans }}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </article>
{% endblock safety_content %}
