{% extends 'safety/_layout.html.twig' %}
{#
  The safety FAQ by category (#general, #comments, #spam): a question (its text comes with a paragraph, shown as a
  heading) and its answer. The answers are HTML themselves, so they sit in a block, not in a paragraph.
#}
{% set active = 'safety_faq' %}

{% block safety_content %}
    {% set _contact = path('feedback', {IdCategory: 2}) %}
    {% macro qa(question, answer) %}
        <div class="p-safety__qa">
            <h3>{{ question|trans|striptags|trim }}</h3>
            <div class="p-safety__text">{{ answer|purify }}</div>
        </div>
    {% endmacro %}
    {% import _self as faq %}

        <section class="p-safety__card p-safety__article" id="general">
            <h2>{{ 'safetyfaqcategorygeneral'|trans|striptags }}</h2>
            {{ faq.qa('faqq_isitsafe', 'faqa_isitsafe'|trans({'faqa_isitsafe.contact.us': '<a href="' ~ _contact ~ '">' ~ 'faqa_isitsafe.contact.us'|trans ~ '</a>'})) }}
            <a class="p-safety__more" href="{{ path('safety') }}">{{ 'safety_learnaboutsafety'|trans }}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </section>

        <section class="p-safety__card p-safety__article" id="comments">
            <h2>{{ 'safetyfaqcategorycomments'|trans|striptags }}</h2>
            {{ faq.qa('faqq_purposeofcomment', 'faqa_purposeofcomment'|trans({'faqa_purposeofcomment.contact.us': '<a href="' ~ _contact ~ '">' ~ 'faqa_purposeofcomment.contact.us'|trans ~ '</a>'})) }}
            {{ faq.qa('faqq_commentguidelines', 'faqa_commentguidelines'|trans({'faqa_commentguidelines.link': '<a href="' ~ path('profilecomments') ~ '">' ~ 'faqa_commentguidelines.link'|trans ~ '</a>'})) }}
            {{ faq.qa('faqq_canieditcomment', 'faqa_canieditcomment'|trans({'faqa_canieditcomment.contact.us': '<a href="' ~ _contact ~ '">' ~ 'faqa_canieditcomment.contact.us'|trans ~ '</a>'})) }}
            <a class="p-safety__more" href="{{ path('faqs_overview', {categoryId: '1', _fragment: 'question3'}) }}">{{ 'safety_learnaboutfaq'|trans }}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </section>

        <section class="p-safety__card p-safety__article" id="spam">
            <h2>{{ 'safetyfaqcategoryspam'|trans|striptags }}</h2>
            {{ faq.qa('faqq_ifoundapronlink', 'faqa_ifoundapronlink'|trans({'faqa_ifoundapronlink.contact.us': '<a href="' ~ _contact ~ '">' ~ 'faqa_ifoundapronlink.contact.us'|trans ~ '</a>'})) }}
            {{ faq.qa('faqq_dontwanttoreceiveinmyemail', 'faqa_dontwanttoreceiveinmyemail'|trans({
                'faqa_dontwanttoreceiveinmyemail.mypreference': '<a href="' ~ path('mypreferences_redirect') ~ '">' ~ 'faqa_dontwanttoreceiveinmyemail.mypreferences'|trans ~ '</a>',
                'faqa_dontwanttoreceiveinmyemail.subscriptions': '<a href="' ~ path('subscriptions') ~ '">' ~ 'faqa_dontwanttoreceiveinmyemail.subscriptions'|trans ~ '</a>',
            })) }}
        </section>
{% endblock safety_content %}
