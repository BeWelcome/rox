{% extends 'safety/_layout.html.twig' %}
{# The general safety tips (#general) and the ones for female travellers (#female) #}
{% set active = 'safety_tips' %}

{% block safety_content %}
    {% set _contact = path('feedback', {IdCategory: 2}) %}
    <section class="p-safety__card p-safety__article" id="general">
        <span class="p-safety__icon" aria-hidden="true"><i class="fas fa-lightbulb"></i></span>
        <h1>{{ 'safety_tipsgeneral'|trans|striptags }}</h1>
        <div class="p-safety__text">{{ 'safety_tipsgeneraltext'|trans|purify }}</div>
        <div class="p-safety__text">{{ 'safety_tipsgeneraltext_cont'|trans({'safety.tipsgeneraltext_cont.contact.us': '<a href="' ~ _contact ~ '">' ~ 'safety.tipsgeneraltext_cont.contact.us'|trans ~ '</a>'})|purify }}</div>
    </section>
    <section class="p-safety__card p-safety__article" id="female">
        <span class="p-safety__icon" aria-hidden="true"><i class="fas fa-person-dress"></i></span>
        <h2>{{ 'safety_tipsfemale'|trans|striptags }}</h2>
        <div class="p-safety__text">{{ 'safety_tipsfemaletext'|trans|purify }}</div>
        <div class="p-safety__text">{{ 'safety_tipsfemaletext_cont'|trans({'safety.tipsfemaletext_cont.contact.us': '<a href="' ~ _contact ~ '">' ~ 'safety.tipsfemaletext_cont.contact.us'|trans ~ '</a>'})|purify }}</div>
        <a class="p-safety__more" href="{{ path('safety') }}">{{ 'safety_learnaboutsafety'|trans }}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </section>
{% endblock safety_content %}
