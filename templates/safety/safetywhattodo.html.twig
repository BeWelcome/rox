{% extends 'safety/_layout.html.twig' %}
{# What to do in an emergency (first, highlighted) and in an uncomfortable situation #}
{% set active = 'safety_what_to_do' %}

{% block safety_content %}
    {% set _contact = path('feedback', {IdCategory: 2}) %}
    <section class="p-safety__card p-safety__article p-safety__situation--emergency" id="emergency">
        <span class="p-safety__icon" aria-hidden="true"><i class="fas fa-kit-medical"></i></span>
        <h1>{{ 'safety_emergency'|trans|striptags }}</h1>
        <div class="p-safety__text">{{ 'safety_emergencytext'|trans({'safety.emergency.contact.us': '<a href="' ~ _contact ~ '">' ~ 'safety.emergency.contact.us'|trans ~ '</a>'})|purify }}</div>
    </section>
    <section class="p-safety__card p-safety__article" id="uncomfortable">
        <span class="p-safety__icon" aria-hidden="true"><i class="fas fa-circle-question"></i></span>
        <h2>{{ 'safety_uncomfortablesituation'|trans|striptags }}</h2>
        <div class="p-safety__text">{{ 'safety_uncomfortablesituationtext'|trans|purify }}</div>
    </section>
{% endblock safety_content %}
