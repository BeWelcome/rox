{#
  A short view of a member, loaded into the preview panel of the search results
  (see search/locations.js): their pictures, who they are, hosting, comments,
  languages and the start of "about me", the main actions and the full profile.
#}
{% set displayName = member.name is empty ? member.username : member.name %}
{% set translations = member.translations %}
{# "About me" in the reader's language, else in the first language the member wrote it in
   (the list of languages always starts with an empty "en"). #}
{% set aboutMe = translations[app.request.locale]['AboutMe'] ?? '' %}
{% if aboutMe is empty %}
    {% for texts in translations %}{% if aboutMe is empty and texts['AboutMe'] is defined %}{% set aboutMe = texts['AboutMe'] %}{% endif %}{% endfor %}
{% endif %}
{% set aboutMe = aboutMe|replace({'<br />': '\n', '<br>': '\n', '</p>': '\n'})|striptags|trim %}
{% set profileUrl = path('members_profile', { username: member.username }) %}
{% set gender = member.isGenderVisible and member.gender in ['female', 'male', 'other'] ? member.gender : null %}
{% set age = member.isAgeVisible and member.age ? member.age : null %}
{% set occupation = translations[app.request.locale]['Occupation'] ?? '' %}
{% if occupation is empty %}
    {% for texts in translations %}{% if occupation is empty and texts['Occupation'] is defined %}{% set occupation = texts['Occupation'] %}{% endif %}{% endfor %}
{% endif %}
{% set occupation = occupation|striptags|trim %}
{% set hosting = member.accommodation in ['yes', 'no'] ? member.accommodation : null %}
{% set languages = [] %}
{% for level, levelLanguages in member.levelLanguages %}
    {% for language in levelLanguages %}{% set languages = languages|merge([('lang_' ~ language.ShortCode)|lower|trans]) %}{% endfor %}
{% endfor %}
{# The privacy filter hides logins of the last 7 days; show nothing then. #}
{% set lastActive = member.lastActive and member.lastActive.diffInDays() > 7 ? member.lastActive|privacy : null %}

{# The member's own pictures fill the top of the panel (swipe or arrows); the profile picture overlaps them.
   Nothing here links to the profile except the button at the bottom. #}
{% if pictures|length %}
    {% set shown = pictures|slice(0, 8) %}
    <div class="p-search-preview__photos js-preview-photos">
        <div class="p-search-preview__track js-preview-photos-track">
            {% for picture in shown %}
                <div class="p-search-preview__slide">
                    <img src="{{ url('gallery_image', { id: picture.id }) }}" alt="{{ picture.title|e('html_attr') }}"{% if not loop.first %} loading="lazy"{% endif %}>
                </div>
            {% endfor %}
        </div>
        {% if shown|length > 1 %}
            <span class="p-search-preview__counter"><i class="fas fa-images" aria-hidden="true"></i> <span class="js-preview-photos-counter" data-total="{{ shown|length }}">1 / {{ shown|length }}</span></span>
            <span class="p-search-preview__navs">
                <button type="button" class="p-search-preview__nav p-search-preview__nav--prev js-preview-photos-prev" aria-label="{{ 'landing.beinformed.previous'|trans }}" disabled><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="p-search-preview__nav p-search-preview__nav--next js-preview-photos-next" aria-label="{{ 'landing.beinformed.next'|trans }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
            </span>
        {% endif %}
    </div>
{% endif %}

<div class="p-search-preview__content">
    <div class="p-search-preview__who">
        <span class="p-search-preview__picture">
            <img class="p-search-preview__avatar" src="{{ path('avatar', { username: member.username, size: 192 }) }}" alt="">
            {% if hosting %}
                <span class="p-search-preview__host p-search-preview__host--{{ hosting }}" aria-hidden="true">
                    <i class="fas {{ hosting == 'yes' ? 'fa-house-circle-check' : 'fa-house-circle-xmark' }}"></i>
                </span>
            {% endif %}
        </span>
        <div class="p-search-preview__names">
            <p class="p-search-preview__title">
                <span class="p-search-preview__name" id="search-preview-title">{{ displayName }}</span>
                {% if gender or age %}
                    <span class="p-search-card__who p-search-card__who--{{ gender ?: 'none' }}">
                        {%- if gender -%}
                            <i class="fas {{ { female: 'fa-venus', male: 'fa-mars', other: 'fa-genderless' }[gender] }}" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ gender|trans }}</span>
                        {%- endif -%}
                        {%- if age %}<span>{{ age }}</span><span class="visually-hidden"> {{ 'searchyearsold'|trans|format('')|striptags|trim }}</span>{% endif -%}
                    </span>
                {% endif %}
            </p>
            {% if displayName != member.username %}<p class="p-search-preview__username">{{ member.username }}</p>{% endif %}
        </div>
    </div>

    {% if occupation %}<p class="p-search-preview__occupation">{{ occupation }}</p>{% endif %}

    <p class="p-search-preview__activity">
        {%- if lastActive -%}
            <span class="p-search-card__online{{ member.lastActive.diffInDays() <= 30 ? ' is-recent' : '' }}" aria-hidden="true"></span>
            <span>{{ 'search.last.login'|trans|trim(': ') }} {{ lastActive }}</span>
            <span class="p-search-card__dot" aria-hidden="true">·</span>
        {%- endif -%}
        <span>{{ 'search.member.duration'|trans({ duration: member.created.diffForHumans({ syntax: 1 }) }) }}</span>
    </p>

    {# Hosting, then the comments with their split #}
    {% set commentsTotal = comments_count.total ?? 0 %}
    <div class="p-search-preview__tiles">
        {% if hosting %}
            <div class="p-search-preview__tile p-search-preview__tile--host-{{ hosting }}">
                <i class="fas {{ hosting == 'yes' ? 'fa-house-circle-check' : 'fa-house-circle-xmark' }}" aria-hidden="true"></i>
                <span>{{ ('search.accommodation.' ~ hosting)|trans|trim('.') }}</span>
            </div>
        {% endif %}
        {% if commentsTotal %}
            <a class="p-search-preview__comments has-comments" href="{{ path('profile_comments', { username: member.username }) }}" target="_blank" rel="noopener">
                <span class="p-search-preview__comments-icon"><i class="fas fa-comment" aria-hidden="true"></i></span>
                <span class="p-search-preview__comments-text">{{ commentsTotal }} {{ 'search.preview.comments'|trans({ count: commentsTotal }) }}</span>
                <span class="p-search-preview__comments-split">
                    {% if comments_count.positive %}<span class="is-positive"><i class="fas fa-thumbs-up" aria-hidden="true"></i> {{ comments_count.positive }}<span class="visually-hidden"> {{ 'comment.quality.positive'|trans|striptags }}</span></span>{% endif %}
                    {% if comments_count.neutral %}<span class="is-neutral"><i class="fas fa-minus" aria-hidden="true"></i> {{ comments_count.neutral }}<span class="visually-hidden"> {{ 'comment.quality.neutral'|trans|striptags }}</span></span>{% endif %}
                    {% if comments_count.negative %}<span class="is-negative"><i class="fas fa-thumbs-down" aria-hidden="true"></i> {{ comments_count.negative }}<span class="visually-hidden"> {{ 'comment.quality.negative'|trans|striptags }}</span></span>{% endif %}
                </span>
                <i class="fas fa-chevron-right p-search-preview__comments-go" aria-hidden="true"></i>
            </a>
        {% else %}
            <div class="p-search-preview__comments">
                <span class="p-search-preview__comments-icon"><i class="fas fa-comment" aria-hidden="true"></i></span>
                <span class="p-search-preview__comments-text">{{ 'profile.no.comments'|trans|striptags }}</span>
            </div>
        {% endif %}
    </div>

    {% if app.user != member and member.status != 'PassedAway' %}
        <div class="p-search-preview__actions">
            {% if member.accommodation == constant('App\\Doctrine\\AccommodationType::YES') %}
                <a class="p-search-preview__btn p-search-preview__btn--primary" href="{{ url('hosting_request', { username: member.username }) }}">
                    <i class="fas fa-bed" aria-hidden="true"></i> {{ 'profile.request.hosting'|trans }}
                </a>
            {% endif %}
            <a class="p-search-preview__btn" href="{{ url('message_new', { username: member.username }) }}">
                <i class="fas fa-envelope" aria-hidden="true"></i> {{ 'message.send'|trans }}
            </a>
        </div>
    {% endif %}

    {% if aboutMe %}
        <section class="p-search-preview__section">
            <h3>{{ 'profile.about.me'|trans }}</h3>
            <p class="p-search-preview__about">{{ aboutMe|truncate(900)|nl2br }}</p>
        </section>
    {% endif %}

    {% if languages|length %}
        <section class="p-search-preview__section">
            <h3>{{ 'languages.spoken'|trans|striptags }}</h3>
            <ul class="p-search-preview__languages">
                {% for language in languages %}<li>{{ language }}</li>{% endfor %}
            </ul>
        </section>
    {% endif %}

</div>

<div class="p-search-preview__foot">
    <a class="p-search-preview__full" href="{{ profileUrl }}" target="_blank" rel="noopener">
        {{ 'search.preview.full'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
</div>
