{# Member preview (search/preview.js), on the search and on a country page: opened from a result, drawer on large screens, sheet from the bottom on phones #}
<div class="p-search-preview__backdrop js-search-preview-backdrop" hidden></div>
<aside class="p-search-preview js-search-preview" aria-labelledby="search-preview-title" aria-hidden="true"
       data-error="{{ 'search.preview.error'|trans }}">
    <div class="p-search-preview__bar">
        <span class="p-search-preview__grip" aria-hidden="true"></span>
        <button type="button" class="p-search-preview__close js-search-preview-close" aria-label="{{ 'close'|trans }}">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </div>
    <div class="p-search-preview__body js-search-preview-body"></div>
    {# Message or stay request written without leaving the search: slides over the preview #}
    <div class="p-search-contact js-search-contact" hidden>
        <div class="p-search-contact__head">
            <button type="button" class="p-search-contact__back js-search-contact-back" aria-label="{{ 'back'|trans }}">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </button>
            <h2 class="p-search-contact__title js-search-contact-title"></h2>
        </div>
        <iframe class="p-search-contact__frame js-search-contact-frame" title="" src="about:blank"></iframe>
    </div>
</aside>
