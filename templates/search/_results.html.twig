{#
  Search results: one card per member. On large screens everything sits in one block,
  below 768px the badge, beds and comments become chips under the name (see the CSS).
#}
{% import 'search/_search.macros.twig' as search %}

<div class="p-search-results__cards">
    {% for result in members.currentPageResults %}
        {% set member = result.member %}
        {% set displayName = member.name is empty ? member.username : member.name %}
        {% set address = member.activeAddress %}
        {% set translations = member.translations %}
        {% set texts = translations[app.request.locale] ?? (translations|length > 0 ? translations|first : {}) %}
        {% set aboutMe = (texts['AboutMe'] ?? '')|replace({'<br />': ' ', '</p>': ' '})|striptags|trim %}
        {% set occupation = (texts['Occupation'] ?? '')|striptags|trim %}
        {% set profileUrl = path('members_profile', { username: member.username }) %}

        <article class="p-search-card">
            <a class="p-search-card__avatar" href="{{ profileUrl }}" tabindex="-1" aria-hidden="true">
                <img src="{{ path('avatar', { username: member.username, size: 96 }) }}" alt="" loading="lazy">
            </a>

            <div class="p-search-card__top">
                <a class="p-search-card__name" href="{{ profileUrl }}">{{ displayName }}</a>
                {% if displayName != member.username %}<span class="p-search-card__username">{{ member.username }}</span>{% endif %}
                {% if result.messageCount %}
                    <a class="p-search-card__messages" href="{{ path('conversations_with', { username: member.username }) }}"
                       title="{{ 'messages_allmessageswith'|trans|format(member.username)|striptags }}">
                        <i class="fas fa-mail-bulk" aria-hidden="true"></i>
                    </a>
                {% endif %}
                {{ search.accommodation(member, 'p-search-card__badge') }}
            </div>

            <div class="p-search-card__meta">
                {%- set facts = [] -%}
                {%- if member.isAgeVisible %}{% set facts = facts|merge(['searchyearsold'|trans|format(member.age)|striptags]) %}{% endif -%}
                {%- if member.isGenderVisible %}{% set facts = facts|merge([member.gender|trans]) %}{% endif -%}
                {%- if facts|length %}<span>{{ facts|join(', ') }}</span>{% endif -%}
                {%- if address and address.location -%}
                    {%- if facts|length %}<span class="p-search-card__dot" aria-hidden="true">·</span>{% endif -%}
                    <span class="p-search-card__place"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        {{- address.location.name }}{% if address.location.country %}, {{ address.location.country.name }}{% endif %}</span>
                {%- endif -%}
            </div>

            <div class="p-search-card__stats">
                {{ search.accommodation(member, 'p-search-card__chip p-search-card__chip-badge') }}
                <span class="p-search-card__chip" title="{{ 'searchcanhostatleast'|trans }}">
                    <i class="fas fa-bed" aria-hidden="true"></i> {{ member.maxGuests }}
                </span>
                <a class="p-search-card__chip p-search-card__comments" href="{{ path('profile_comments', { username: member.username }) }}">
                    <i class="fas fa-comments" aria-hidden="true"></i> {{ 'searchcommentsinfo'|trans|format(result.commentCount ?? 0)|striptags }}
                </a>
            </div>

            {% if aboutMe %}
                <p class="p-search-card__about">{{ aboutMe|truncate(300) }}</p>
            {% endif %}
            {% if occupation %}
                <p class="p-search-card__occupation"><strong>{{ 'occupation'|trans|capitalize }}:</strong> {{ occupation }}</p>
            {% endif %}

            {# The last activity is hidden when it is unknown or kept private (active in the last 7 days). #}
            {% set lastActive = member.lastActive|privacy %}
            <div class="p-search-card__dates">
                {% if lastActive and lastActive != 'lastloginprivacy'|trans %}
                    <span>{{ 'search.last.login'|trans }} <strong>{{ lastActive }}</strong></span>
                    <span class="p-search-card__dot" aria-hidden="true">·</span>
                {% endif %}
                <span>{{ 'search.member.since'|trans }} <strong>{{ member.created|privacy }}</strong></span>
            </div>
        </article>
    {% endfor %}
</div>
