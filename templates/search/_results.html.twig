{#
  Search results: one row per member (photo, name, facts, hosting, beds,
  comments and membership length); the whole row opens the profile.
  Beds and comments sit in a small pill on the right.
#}
<div class="p-search-results__cards">
    {% for result in members.currentPageResults %}
        {% set member = result.member %}
        {% set displayName = member.name is empty ? member.username : member.name %}
        {% set address = member.activeAddress %}
        {% set profileUrl = path('members_profile', { username: member.username }) %}

        <article class="p-search-card">
            <a class="p-search-card__avatar" href="{{ profileUrl }}" tabindex="-1" aria-hidden="true">
                <img src="{{ path('avatar', { username: member.username, size: 192 }) }}" alt="" loading="lazy">
            </a>

            <div class="p-search-card__body">
                <a class="p-search-card__name" href="{{ profileUrl }}">{{ displayName }}</a>

                <div class="p-search-card__meta">
                    {%- set facts = [] -%}
                    {%- if member.isAgeVisible %}{% set facts = facts|merge(['searchyearsold'|trans|format(member.age)|striptags]) %}{% endif -%}
                    {%- if member.isGenderVisible %}{% set facts = facts|merge([member.gender|trans]) %}{% endif -%}
                    {#- The place is left out when it is the place searched for: only nearby places are shown. -#}
                    {%- set searchedPlaceId = searchParams.location_geoname_id ?? null -%}
                    {%- if address and address.location and (searchedPlaceId is empty or address.location.geonameId != searchedPlaceId) -%}
                        {%- set facts = facts|merge([address.location.name ~ (address.location.country ? ', ' ~ address.location.country.name : '')]) -%}
                    {%- endif -%}
                    {{- facts|join(' · ') -}}
                </div>

                {% if member.accommodation in ['yes', 'no'] or result.messageCount %}
                    <div class="p-search-card__stats">
                        {% if member.accommodation in ['yes', 'no'] %}
                            <span class="p-search-card__host p-search-card__host--{{ member.accommodation }}">{{ ('search.accommodation.' ~ member.accommodation)|trans|trim('.') }}</span>
                        {% endif %}
                        {% if result.messageCount %}
                            <a class="p-search-card__messages" href="{{ path('conversations_with', { username: member.username }) }}"
                               title="{{ 'messages_allmessageswith'|trans|format(member.username)|striptags }}">
                                <i class="fas fa-mail-bulk" aria-hidden="true"></i>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                {# The last activity is left out when it is unknown or kept private (active in the last 7 days). #}
                {% set lastActive = member.lastActive|privacy %}
                {% set showLastActive = lastActive and lastActive != 'lastloginprivacy'|trans %}
                {% if member.created or showLastActive %}
                    <p class="p-search-card__since">
                        {%- if member.created %}<span>{{ 'search.member.for'|trans({ duration: member.created.diffForHumans({ syntax: 1 }) }) }}</span>{% endif -%}
                        {%- if member.created and showLastActive %}<span aria-hidden="true"> · </span>{% endif -%}
                        {%- if showLastActive %}<span>{{ 'search.last.login'|trans }} {{ lastActive }}</span>{% endif -%}
                    </p>
                {% endif %}
            </div>

            {% set commentCount = result.commentCount ?? 0 %}
            <div class="p-search-card__counts">
                <span class="p-search-card__count" title="{{ 'searchcanhostatleast'|trans }}">
                    <i class="fas fa-bed" aria-hidden="true"></i> {{ member.maxGuests }}
                </span>
                <span class="p-search-card__count p-search-card__count--comments{% if commentCount %} has-comments{% endif %}" title="{{ 'searchcommentsinfo'|trans|format(commentCount)|striptags }}">
                    <i class="fas fa-comment" aria-hidden="true"></i> {{ commentCount }}
                </span>
            </div>
        </article>
    {% endfor %}
</div>
