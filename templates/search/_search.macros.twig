{# Building blocks of the search page (/search/locations). #}

{# A checkbox of the search form, drawn by hand so it looks the same everywhere. #}
{% macro check(field) %}
    <label class="p-search-check" for="{{ field.vars.id }}">
        <input type="checkbox" id="{{ field.vars.id }}" name="{{ field.vars.full_name }}" value="1"
               data-default="{{ field.vars.checked ? 1 : 0 }}"{% if field.vars.checked %} checked{% endif %}>
        <span>{{ field.vars.label|trans }}</span>
    </label>
    {% do field.setRendered %}
{% endmacro %}

{# A single choice field as a plain select (no autocomplete box needed for a short list). #}
{% macro select(field, class = '', any = false) %}
    {% set noTranslation = field.vars.choice_translation_domain is same as(false) %}
    <select id="{{ field.vars.id }}" name="{{ field.vars.full_name }}" class="form-select p-search-select {{ class }}">
        {% if any %}<option value="">{{ 'any'|trans|capitalize }}</option>{% endif %}
        {% for choice in field.vars.choices %}
            <option value="{{ choice.value }}"{% if choice is selectedchoice(field.vars.value) %} selected{% endif %}>
                {{- noTranslation ? choice.label : choice.label|trans({}, field.vars.choice_translation_domain ?: 'messages') -}}
            </option>
        {% endfor %}
    </select>
    {% do field.setRendered %}
{% endmacro %}

{#
  A multiple choice field as a group of checkboxes (gender, languages): clearer than a
  search box for a handful of choices. Nothing is drawn when there is nothing to choose.
#}
{% macro checks(field) %}
    {% set noTranslation = field.vars.choice_translation_domain is same as(false) %}
    {% if field.vars.choices|length > 0 %}
        <fieldset class="p-search-options__field">
            <legend class="p-search-options__label">{{ field.vars.label|trans }}</legend>
            <div class="p-search-options__choices">
                {% for choice in field.vars.choices %}
                    <label class="p-search-check p-search-check--pill">
                        <input type="checkbox" name="{{ field.vars.full_name }}" value="{{ choice.value }}"
                               data-default="0"{% if choice is selectedchoice(field.vars.value) %} checked{% endif %}>
                        <span>{{ (noTranslation ? choice.label : choice.label|trans({}, field.vars.choice_translation_domain ?: 'messages'))|capitalize }}</span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>
    {% endif %}
    {% do field.setRendered %}
{% endmacro %}

{# A labelled field in the Search options panel. widget is HTML drawn by form_widget() or select() above. #}
{% macro field(field, widget) %}
    <div class="p-search-options__field">
        <label class="p-search-options__label" for="{{ field.vars.id }}">{{ field.vars.label|trans }}</label>
        {{ widget|raw }}
    </div>
{% endmacro %}

{# The accommodation badge of a member (nothing when they didn't say). #}
{% macro accommodation(member, class = '') %}
    {% if member.accommodation in ['yes', 'no'] %}
        <span class="p-search-badge p-search-badge--{{ member.accommodation }} {{ class }}">
            <i class="fas fa-house-user" aria-hidden="true"></i>
            {{ ('search.accommodation.' ~ member.accommodation)|trans }}
        </span>
    {% endif %}
{% endmacro %}

{# What the map shows when a member's marker is clicked. #}
{% macro map_popup(result) %}
    {% import _self as search %}
    {% set member = result.member %}
    {% set displayName = member.name is empty ? member.username : member.name %}
    {% set address = member.activeAddress %}
    {% set facts = [] %}
    {% if member.isAgeVisible %}{% set facts = facts|merge(['searchyearsold'|trans|format(member.age)|striptags]) %}{% endif %}
    {% if address and address.location %}{% set facts = facts|merge([address.location.name]) %}{% endif %}
    <div class="p-search-map-popup">
        <a class="p-search-map-popup__head" href="{{ path('members_profile', { username: member.username }) }}">
            <img src="{{ path('avatar', { username: member.username, size: 96 }) }}" alt="">
            <span class="p-search-map-popup__who">
                <strong>{{ displayName }}</strong>
                {% if displayName != member.username %}<span class="p-search-map-popup__username">{{ member.username }}</span>{% endif %}
                {% if facts|length %}<span class="p-search-map-popup__facts">{{ facts|join(' · ') }}</span>{% endif %}
            </span>
        </a>
        <div class="p-search-map-popup__chips">
            {{ search.accommodation(member) }}
            <span class="p-search-map-popup__chip" title="{{ 'searchcanhostatleast'|trans }}"><i class="fas fa-bed" aria-hidden="true"></i> {{ member.maxGuests }}</span>
            <a class="p-search-map-popup__chip" href="{{ path('profile_comments', { username: member.username }) }}"><i class="fas fa-comments" aria-hidden="true"></i> {{ result.commentCount ?? 0 }}</a>
        </div>
    </div>
{% endmacro %}
