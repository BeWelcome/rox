{% extends 'base.html.twig' %}
{% import 'search/_search.macros.twig' as search %}

{% set hide_sidebar = true %}

{% block title %}{{ 'search.locations'|trans }}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('search/locations') }}
{% endblock javascripts %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('search/locations') }}
{% endblock stylesheets %}

{% block content %}
    {% set hasResults = pager is not null and pager.nbResults > 0 %}
    {% set showMap = form.show_map.vars.checked %}
    {% set locationName = form.location_name.vars.value %}
    {% set locationFull = form.location_fullname.vars.value %}
    {% set locationRest = locationFull starts with (locationName ~ ', ') ? locationFull|slice(locationName|length + 2) : '' %}

    {# The members of this page, for the markers of the map. #}
    {% set mapMembers = [] %}
    {% if hasResults %}
        {% for result in pager.currentPageResults %}
            {% set address = result.member.activeAddress %}
            {% if address and address.location and address.location.latitude is not null %}
                {% set mapMembers = mapMembers|merge([{
                    Username: result.member.username,
                    latitude: address.location.latitude,
                    longitude: address.location.longitude,
                    popup: search.map_popup(result),
                }]) %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {{ form_start(form, { attr: { class: 'p-search search_form js-search-form' ~ (showMap ? '' : ' is-map-off'), novalidate: 'novalidate', onkeypress: 'return event.keyCode != 13;' } }) }}

    {# Where, radius and the search button #}
    <div class="p-search__top">
        <div class="p-search__bar">
            <div class="p-search-where js-search-where">
                <button type="button" class="p-search-where__back js-search-where-back" aria-label="{{ 'back'|trans }}">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                </button>
                <i class="fas fa-map-marker-alt p-search-where__pin" aria-hidden="true"></i>
                <div class="p-search-where__field">
                    <label class="p-search-where__label" for="{{ form.location.vars.id }}">{{ 'landing.whereyougo'|trans }}</label>
                    <div class="auto-search-wrapper max-height p-search-where__input">
                        <input type="text" id="{{ form.location.vars.id }}" name="{{ form.location.vars.full_name }}"
                               class="js-location-picker" autocomplete="off"
                               placeholder="{{ 'trip.leg.location'|trans }}"
                               {% if form.location.vars.value %}value="{{ form.location.vars.value }}"{% endif %}>
                        <span class="p-search-where__display js-search-where-display" aria-hidden="true">
                            <strong class="js-search-where-name">{{ locationName }}</strong>
                            <span class="js-search-where-rest">{{ locationRest }}</span>
                            <span class="p-search-where__radius js-search-where-radius"></span>
                        </span>
                    </div>
                    {% do form.location.setRendered %}
                </div>
                <span class="p-search-where__help" title="{{ 'search.locations.help'|trans|striptags }}">
                    <i class="far fa-question-circle" aria-hidden="true"></i>
                </span>
                <p class="p-search-where__hint"><i class="far fa-question-circle" aria-hidden="true"></i> {{ 'search.locations.help'|trans|striptags }}</p>
            </div>

            <div class="p-search__radius js-search-radius">
                <label class="u:sr-only" for="{{ form.distance.vars.id }}">{{ form.distance.vars.label|trans }}</label>
                {{ search.select(form.distance, 'p-search-select--radius') }}
            </div>

            <button type="submit" class="p-search__find js-search-find" name="{{ form.updateMap.vars.full_name }}">
                <i class="fas fa-search" aria-hidden="true"></i>
                <span>{{ 'search.find.members'|trans }}</span>
            </button>

            <button type="button" class="p-search__options-btn js-search-options-open" aria-label="{{ 'search.show.advanced'|trans }}"
                    title="{{ 'search.show.advanced'|trans }}">
                <i class="fas fa-filter" aria-hidden="true"></i>
            </button>
        </div>

        {% if form.vars.errors|length > 0 %}
            <ul class="p-search__errors" role="alert">
                {% for error in form.vars.errors %}
                    <li><i class="fas fa-exclamation-circle" aria-hidden="true"></i> {{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {# Quick filters: they tick the same boxes as the panel and search right away. #}
        <div class="p-search__quick">
            <button type="button" class="p-search__options-pill js-search-options-open">
                <i class="fas fa-filter" aria-hidden="true"></i>
                <span>{{ 'search.show.advanced'|trans }}</span>
            </button>
            <span class="p-search__divider" aria-hidden="true"></span>
            <div class="p-search__pills">
                {% for item in [
                    { field: form.accommodation_yes, icon: 'fas fa-house-user' },
                    { field: form.accommodation_no, icon: 'fas fa-house-user' },
                    { field: form.offers_dinner, icon: null },
                    { field: form.offers_tour, icon: 'fas fa-map-signs' },
                ] %}
                    <button type="button" class="p-search-pill js-search-pill{{ item.field.vars.checked ? ' is-active' : '' }}"
                            data-target="{{ item.field.vars.id }}" aria-pressed="{{ item.field.vars.checked ? 'true' : 'false' }}">
                        {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
                        {{ item.field.vars.label|trans }}
                    </button>
                {% endfor %}
            </div>
            <label class="p-search__map-switch" for="{{ form.show_map.vars.id }}">
                <span>{{ form.show_map.vars.label|trans }}</span>
                <input type="checkbox" role="switch" class="show_map js-search-map-switch" id="{{ form.show_map.vars.id }}"
                       name="{{ form.show_map.vars.full_name }}" value="1"{% if showMap %} checked{% endif %}>
                <span class="p-search__switch" aria-hidden="true"></span>
            </label>
            {% do form.show_map.setRendered %}
            {# The old "show options" switch: kept so the preference is not lost. #}
            {% if form.show_options.vars.checked %}<input type="hidden" name="{{ form.show_options.vars.full_name }}" value="1">{% endif %}
            {% do form.show_options.setRendered %}
        </div>
    </div>

    {# Results and map #}
    <div class="p-search__body">
        <section class="p-search-results">
            {% if hasResults %}
                <div class="p-search-results__head">
                    <h1 class="p-search-results__count">
                        {%- if pager.haveToPaginate -%}
                            {{ 'search.members.found.range'|trans({ first: pager.currentPageOffsetStart, last: pager.currentPageOffsetEnd, count: pager.nbResults }) }}
                        {%- else -%}
                            {{ 'search.members.found'|trans({ count: pager.nbResults }) }}
                        {%- endif -%}
                    </h1>
                    <div class="p-search-results__view" role="group">
                        <button type="button" class="p-search-results__view-btn is-active js-search-view" data-view="list">
                            <i class="fas fa-list-ul" aria-hidden="true"></i> {{ 'search.view.list'|trans }}
                        </button>
                        <button type="button" class="p-search-results__view-btn js-search-view" data-view="map">
                            <i class="fas fa-map" aria-hidden="true"></i> {{ 'map'|trans }}
                        </button>
                    </div>
                    <div class="p-search-results__order">
                        <label for="{{ form.order.vars.id }}">{{ form.order.vars.label|trans }}</label>
                        {{ search.select(form.order, 'p-search-select--small js-search-autosubmit') }}
                        {% set descending = form.direction.vars.value == constant('App\\Repository\\MemberRepository::DIRECTION_DESCENDING') %}
                        <input type="hidden" class="js-search-direction" name="{{ form.direction.vars.full_name }}" value="{{ form.direction.vars.value }}"
                               data-ascending="{{ constant('App\\Repository\\MemberRepository::DIRECTION_ASCENDING') }}"
                               data-descending="{{ constant('App\\Repository\\MemberRepository::DIRECTION_DESCENDING') }}">
                        {% do form.direction.setRendered %}
                        <button type="button" class="p-search-results__direction js-search-direction-toggle"
                                title="{{ (descending ? 'search.direction.descending' : 'search.direction.ascending')|trans }}"
                                aria-label="{{ form.direction.vars.label|trans }}: {{ (descending ? 'search.direction.descending' : 'search.direction.ascending')|trans }}">
                            <i class="fas {{ descending ? 'fa-arrow-down' : 'fa-arrow-up' }}" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                {% include 'search/_results.html.twig' with { members: pager } %}

                <div class="p-search-results__foot">
                    {% if pager.haveToPaginate %}
                        {{ pagerfanta(pager, 'rounded_pagination', { routeName: routeName, routeParams: routeParams }) }}
                    {% endif %}
                    <div class="p-search-results__items">
                        <label for="{{ form.items.vars.id }}">{{ form.items.vars.label|trans }}</label>
                        {{ search.select(form.items, 'p-search-select--small js-search-autosubmit') }}
                    </div>
                </div>
            {% else %}
                {% do form.order.setRendered %}
                {% do form.items.setRendered %}
                <input type="hidden" name="{{ form.order.vars.full_name }}" value="{{ form.order.vars.value }}">
                <input type="hidden" name="{{ form.direction.vars.full_name }}" value="{{ form.direction.vars.value }}">
                <input type="hidden" name="{{ form.items.vars.full_name }}" value="{{ form.items.vars.value }}">
                {% do form.direction.setRendered %}
                <div class="p-search-results__empty">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <p>{{ pager is not null ? 'search.no.members'|trans : 'search.locations.help'|trans|striptags }}</p>
                </div>
            {% endif %}
        </section>

        <div class="p-search__map">
            <div id="map-box" class="p-search__map-box"></div>
        </div>
    </div>

    {# Search options: side panel on large screens, sheet from the bottom on phones #}
    <div class="p-search-options__backdrop js-search-options-close" hidden></div>
    <aside class="p-search-options js-search-options" aria-labelledby="search-options-title" aria-hidden="true">
        <div class="p-search-options__head">
            <h2 id="search-options-title">{{ 'search.show.advanced'|trans }}</h2>
            <button type="button" class="p-search-options__close js-search-options-close" aria-label="{{ 'close'|trans }}">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <div class="p-search-options__body js-search-options-body">
            {# Below 768px the radius moves here from the search bar (see search/locations.js). #}
            <div class="p-search-options__radius js-search-options-radius"></div>

            <section class="p-search-options__section">
                <h3>{{ 'accommodation'|trans }}</h3>
                {{ search.check(form.accommodation_yes) }}
                {{ search.check(form.accommodation_no) }}
                {{ search.check(form.accessible) }}
                {{ search.field(form.can_host, search.select(form.can_host)) }}
            </section>

            <section class="p-search-options__section">
                <h3>{{ 'offers'|trans }}</h3>
                {{ search.check(form.offers_dinner) }}
                {{ search.check(form.offers_tour) }}
            </section>

            <section class="p-search-options__section">
                <h3>{{ 'member'|trans }}</h3>
                <div class="p-search-options__row">
                    {{ search.field(form.min_age, search.select(form.min_age, '', true)) }}
                    {{ search.field(form.max_age, search.select(form.max_age, '', true)) }}
                </div>
                {{ search.checks(form.gender) }}
                {# Only the languages the member speaks can be chosen (see SearchController). #}
                {{ search.checks(form.languages) }}
                {{ search.field(form.last_active, search.select(form.last_active)) }}
                {% if form.groups.vars.choices|length > 0 %}
                    {{ search.field(form.groups, form_widget(form.groups)) }}
                {% else %}
                    {% do form.groups.setRendered %}
                {% endif %}
                {{ search.field(form.keywords, form_widget(form.keywords, { attr: { class: 'p-search-input' } })) }}
            </section>

            <section class="p-search-options__section">
                <h3>{{ 'profile.information'|trans }}</h3>
                {{ search.check(form.has_profile_picture) }}
                {{ search.check(form.has_about_me) }}
                {{ search.check(form.has_comments) }}
            </section>

            <section class="p-search-options__section">
                <h3>{{ 'restrictions'|trans }}</h3>
                {{ search.check(form.no_smoking) }}
                {{ search.check(form.no_alcohol) }}
                {{ search.check(form.no_drugs) }}
            </section>
        </div>

        <div class="p-search-options__foot">
            <button type="button" class="p-search-options__reset js-search-options-reset">{{ 'search.options.reset'|trans }}</button>
            <button type="submit" class="p-search__find p-search-options__find" name="{{ form.updateMap.vars.full_name }}">
                {{ 'search.find.members'|trans }}{% if hasResults %} · {{ pager.nbResults }}{% endif %}
            </button>
        </div>
    </aside>

    {% do form.updateMap.setRendered %}
    {% if form.resetOptions is defined %}{% do form.resetOptions.setRendered %}{% endif %}
    {{ form_rest(form) }}
    {{ form_end(form) }}

    <input type="hidden" id="min_latitude" value="{{ searchParams.min_latitude }}">
    <input type="hidden" id="max_latitude" value="{{ searchParams.max_latitude }}">
    <input type="hidden" id="min_longitude" value="{{ searchParams.min_longitude }}">
    <input type="hidden" id="max_longitude" value="{{ searchParams.max_longitude }}">

    <script>
        var mapMembers = {{ (mapMembers|length ? mapMembers : null)|json_encode|raw }};
    </script>
{% endblock content %}
