{% extends 'base.html.twig' %}
{% import 'macros.twig' as macros %}

{% block javascripts %}
  {{ encore_entry_script_tags('jquery_ui') }}
  {{ encore_entry_script_tags('member/autocomplete') }}
{% endblock javascripts %}

{% block stylesheets %}
  {{ encore_entry_link_tags('jquery_ui') }}
{% endblock stylesheets %}

{% block content %}
  <h1 class="u:text-24">{{ 'search.members'|trans }}</h1>
  <p class="u:mb-8">{{ 'search.member.abstract'|trans }}</p>
  {# A GET form with the field the controller reads (username), as on the landing page #}
  <form action="{{ path('search_members') }}" method="get">
    <label for="search_members_username">{{ 'label.username'|trans }}</label>
    <input type="text"
           id="search_members_username" name="username"
           value="{{ username }}"
           required="required"
           placeholder="{{ 'search.member.placeholder'|trans }}"
           class="member-autocomplete-start o-input"
           aria-describedby="search_members_username_help"
    >
    <p id="search_members_username_help" class="u:text-14">{{ 'help.username.auto.complete'|trans }}</p>
    <button type="submit" class="o-button">{{ 'label.search.username'|trans }}</button>
  </form>
  {% if not members is null %}
    <div class="u:w-full u:grid u:grid-cols-1 {% if members|length > 0 %}u:sm:grid-cols-2 u:md:grid-cols-3{% endif %} u:gap-12">
      {% for member in members %}
        {% set translations = member.translations %}
          <div class="d-flex">
            {{ macros.avatar(member.username, 72, true) }}
            <div class="ms-3 flex-grow-1">
              <h5 class="mt-0">{{ member.username }}</h5>
              {% set address = member.activeAddress %}
              {% if not address is same as(false) %}
              <p>{{ address.location.name }}, {{ address.location.country.name }}
                {% if translations[app.request.locale] is defined %}
                  <p>{{ (translations[app.request.locale]['AboutMe']??'')|purify|striptags|truncate(100) }}</p>
                {% else %}
                  <p>{{ ((translations|first)['AboutMe']??'')|purify|striptags|truncate(100) }}</p>
              {% endif %}
              {% endif %}
            </div>
          </div>
      {% else %}
        {{ 'members.search.no.results'|trans }}
      {% endfor %}
      </div>
    </div>
  {% endif %}
{% endblock content %}
