{% extends 'security/_layout.html.twig' %}

{% block title %}{{ 'login' | trans }}{% endblock %}

{% block eyebrow %}{{ 'landing.welcomeback' | trans }}{% endblock %}
{% block heading %}{{ 'login.title' | trans }}{% endblock %}
{% block subtitle %}{{ 'login.subtitle' | trans }}{% endblock %}

{% block messages %}
    {% if error %}
        <div class="p-login__error" role="alert">
            <p class="p-login__error-title">
                {%- if retry_minutes -%}
                    {{ 'login.too.many.attempts'|trans({'minutes': retry_minutes}) }}
                {%- else -%}
                    {{ error.messageKey|trans(error.messageData, 'messages')|raw }}
                {%- endif -%}
            </p>
            {% if error.messageKey == 'Invalid credentials.' %}
                <p>{{ 'login.forgot.password' | trans }}
                    <a href="{{ url('member_request_reset_password') }}">{{ 'login.password.getnew' | trans }}</a></p>
                <p>{{ 'login.forgot.username' | trans }}</p>
            {% endif %}
            {% if error.messageKey == 'login.mail.not_confirmed' %}
                <p><a href="{{ url('resend_confirmation_email', {'username': last_username}) }}">{{ 'login.resend.confirmation' | trans }}</a></p>
            {% endif %}
            {% if error.messageKey == 'member_banned' %}
                <p>{{ 'login.account.banned' | trans }}</p>
            {% endif %}
            {% if error.messageKey == 'member_expired' %}
                <p>{{ 'login.account.expired' | trans }}</p>
            {% endif %}
            {% if error.messageKey == 'member_not_allowed_to_login' %}
                <p>{{ 'login.account.no_login' | trans }}</p>
            {% endif %}
            <p><a href="{{ url('feedback', {'IdCategory': 3}) }}">{{ 'login.contact.support' | trans }}</a></p>
        </div>
    {% endif %}
{% endblock %}

{% block form %}
    {% include 'partials/home_login_form.html.twig' with {
        form_id: 'main-login-form',
        prefix: 'login_',
        last_username: last_username,
        autofocus: true,
    } only %}
{% endblock %}

{% block switch %}{{ 'menu.not.a.member.yet' | trans }} <a href="{{ url('signup') }}">{{ 'navbar.button.signup' | trans }}</a>{% endblock %}
