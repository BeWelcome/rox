{#
  The mail with the confirmation link got lost: a box with a button that sends it again
  (SignupController::resendConfirmationEmail). Outside the page's own form: its button is that form's only submit
  button. Expects member.
#}
<div class="signup-resend" role="note">
    <span class="signup-resend__icon" aria-hidden="true"><i class="fas fa-envelope-open-text"></i></span>
    <div class="signup-resend__body">
        <p class="signup-resend__title">{{ 'members.confirm.email.resend.title'|trans }}</p>
        <p class="signup-resend__text">{{ 'members.confirm.email.resend.blurb'|trans({email: member.email}) }}</p>
        <form method="post" action="{{ path('resend_confirmation_email', {username: member.username}) }}" id="resend-confirmation">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\SignupController::RESEND_TOKEN')) }}">
            <button type="submit" class="o-button signup-resend__button">
                <i class="fas fa-paper-plane" aria-hidden="true"></i> {{ 'members.confirm.email.resend'|trans }}
            </button>
        </form>
    </div>
</div>
