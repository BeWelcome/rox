{% extends 'trips.html.twig' %}
{% import 'macros.twig' as macros %}

{% set trips_redesign = true %}

{% block title %}
  {{ 'trip.in.area' | trans }}
{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('tailwind') }}
{% endblock stylesheets %}

{% block javascripts %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const radius = document.getElementById('trips_radius');
      if (radius) {
        radius.addEventListener('change', function () {
          document.getElementById('trips').requestSubmit();
        });
      }
    });

    document.addEventListener('submit', function (event) {
      const form = event.target.closest('.js-hide-leg');
      if (!form) {
        return;
      }

      event.preventDefault();

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: {'X-Requested-With': 'XMLHttpRequest'},
      }).then(function (response) {
        if (response.ok) {
          form.closest('.p-trips-leg').remove();
        }
      });
    });
  </script>
{% endblock javascripts %}

{% block content %}
<section class="p-trips__body">
  <div class="p-trips__toolbar">
    {{ form_start(radiusForm, { attr: { id: 'trips', class: 'p-trips__radius' } }) }}
      <i class="fa fa-bullseye" aria-hidden="true"></i>
      {{ form_label(radiusForm.radius, null, { label_attr: { class: 'p-trips__radius-label' } }) }}
      {{ form_widget(radiusForm.radius, { attr: { class: 'p-trips__radius-select' } }) }}
      {{ form_rest(radiusForm) }}
    {{ form_end(radiusForm) }}
    {% if legs.nbResults != 0 %}
      <p class="p-trips__count"><i class="fa fa-users" aria-hidden="true"></i> {{ legs.nbResults }}</p>
    {% endif %}
  </div>

  {% if legs.nbResults != 0 %}
    <div class="p-trips__list">
      {% for leg in legs %}
        {% include 'trip/leg.html.twig' with { leg: leg } %}
      {% endfor %}
    </div>

    {% if legs.haveToPaginate %}
      <div class="p-trips__pager">
        {{ pagerfanta(legs, 'rounded_pagination', { routeName: 'visitors' }) }}
      </div>
    {% endif %}
  {% else %}
    <div class="p-trips__empty">
      <i class="far fa-map" aria-hidden="true"></i>
      <p>{{ 'trip.in.area.no'|trans }}</p>
    </div>
  {% endif %}
</section>
{% endblock content %}
