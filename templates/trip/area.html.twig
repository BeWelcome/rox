{% extends 'trips.html.twig' %}
{% import 'macros.twig' as macros %}

{% set trips_redesign = true %}

{% block title %}
  {{ 'trip.in.area' | trans }}
{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('tailwind') }}
  {{ encore_entry_link_tags('trips') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ encore_entry_script_tags('trips') }}
{% endblock javascripts %}

{% block content %}
{#
  Visitors: how far to look (20, 50, 100 km of the member's city, buttons that send the
  form), how many are coming, then the trips as on the Visitors tab of the home page
  (trip/landing.html.twig) in one white card, under This week / Later.
#}
{% set _radius = radiusForm.radius.vars.value|default('') %}
{% set _address = app.user.activeAddress %}
{% set _city = _address is not same as(false) and _address is not null and _address.location ? _address.location.name : null %}
<section class="p-trips__body">
  <div class="p-trips__toolbar">
    {{ form_start(radiusForm, { attr: { id: 'trips', class: 'p-trips__radius' } }) }}
      <span class="p-trips__radius-label">{{ 'landing.visitors.within'|trans }}</span>
      <span class="p-trips__radius-options" role="group" aria-label="{{ 'trips.radius'|trans }}">
        {% for choice in radiusForm.radius.vars.choices %}
          {% if choice.value in ['20', '50', '100'] or choice.value == _radius ~ '' %}
            <button type="submit" class="p-trips__radius-option{% if choice.value == _radius ~ '' %} is-active{% endif %}" name="{{ radiusForm.radius.vars.full_name }}" value="{{ choice.value }}" aria-pressed="{{ choice.value == _radius ~ '' ? 'true' : 'false' }}">{{ choice.label|trans }}</button>
          {% endif %}
        {% endfor %}
      </span>
      {% if _city %}<span class="p-trips__radius-city">{{ 'trips.visitors.of'|trans }} <strong>{{ _city }}</strong></span>{% endif %}
      {% do radiusForm.radius.setRendered %}
      {{ form_rest(radiusForm) }}
    {{ form_end(radiusForm) }}
    {% if legs.nbResults != 0 %}
      <p class="p-trips__count"><strong>{{ legs.nbResults }}</strong> {{ 'trips.visitors.coming'|trans({ count: legs.nbResults }) }}</p>
    {% endif %}
  </div>

  {% if legs.nbResults != 0 %}
    {% set _weekEnd = date('+7 days')|date('Y-m-d') %}
    {% set _group = null %}
    <div class="p-trips-visitors c-home-list c-home-list--legs">
      {% for leg in legs %}
        {% set _legGroup = leg.arrival|date('Y-m-d') < _weekEnd ? 'this.week' : 'later' %}
        {% if _legGroup != _group %}
          {% set _group = _legGroup %}
          <p class="c-home-list__group">{{ ('landing.visitors.' ~ _group)|trans }}</p>
        {% endif %}
        {% include 'trip/landing.html.twig' with { leg: leg } %}
      {% endfor %}
    </div>

    {% if legs.haveToPaginate %}
      <div class="p-trips__pager">
        {{ pagerfanta(legs, 'rounded_pagination', { routeName: 'visitors' }) }}
      </div>
    {% endif %}
  {% else %}
    <div class="p-trips__empty">
      <i class="far fa-map" aria-hidden="true"></i>
      <p>{{ 'trip.in.area.no'|trans }}</p>
    </div>
  {% endif %}
</section>

{# A trip, the invitation or the message open in a side panel #}
{% include 'conversations/_contact_drawer.html.twig' with { from: 'visitors' } %}
{% endblock content %}
