{% extends 'trips.html.twig' %}

{% set trips_redesign = true %}

{% block title %}
    {% if create %}{{ 'trip.create' | trans }}{% else %}{{ 'trip.edit' | trans }}{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('jquery_ui') }}
    {{ encore_entry_link_tags('trips') }}
{% endblock stylesheets %}

{% block javascripts %}
    {{ encore_entry_script_tags('trips') }}
{% endblock javascripts %}

{#
  One stop of the trip: place, dates and options. trips.js relies on the
  js-* classes, the data-content/data-related pair and the field ids.
#}
{% macro widget_prototype(widget) %}
    {% if widget.vars.prototype is defined %}
        {% set form = widget.vars.prototype %}
        {% set name = widget.vars.name %}
    {% else %}
        {% set form = widget %}
        {% set name = widget.vars.full_name %}
    {% endif %}
    {# The place's errors (no place, or a typed name not picked from the suggestions) come from the
       field, its hidden geoname id and the transformer: shown once, under the field #}
    {% set location_errors = [] %}
    {% for field in [form.location, form.location.fullname, form.location.geoname_id] %}
        {% for error in field.vars.errors %}{% set location_errors = location_errors|merge([error.message]) %}{% endfor %}
    {% endfor %}
    <div data-content="{{ name }}" class="p-trips-stop">
        <div class="p-trips-stop__fields">
            <div class="p-trips-field p-trips-field--icon{{ location_errors is not empty ? ' has-error' }}">
                <i class="fas fa-location-dot" aria-hidden="true"></i>
                <div class="auto-search-wrapper max-height">
                    <input type="text" id="{{ form.location.fullname.vars.id }}" name="{{ form.location.fullname.vars.full_name }}"
                           class="p-trips-input js-location-picker" autocomplete="off"
                           placeholder="{{ 'trip.leg.location'|trans }}"
                           aria-label="{{ 'trip.leg.location'|trans }}"
                           {% if form.location.fullname.vars.disabled %}disabled{% endif %}
                           {% if form.location.fullname.vars.value %}value="{{ form.location.fullname.vars.value }}"{% endif %}
                    >
                </div>
            </div>
            <div class="p-trips-field p-trips-field--icon p-trips-field--dates">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                {{ form_widget(form.duration, { attr: {
                    class: 'p-trips-input duration js-duration',
                    placeholder: 'trip.leg.duration'|trans,
                    'aria-label': 'trip.leg.duration'|trans,
                } }) }}
            </div>
            <button type="button" class="p-trips-stop__remove js-btn-remove" data-related="{{ name }}" aria-label="{{ 'delete'|trans }}" title="{{ 'delete'|trans }}">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </div>
        {% if location_errors is not empty %}
            <p class="p-trips-stop__error js-location-error">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                {{ form.location.fullname.vars.value ? 'trip.leg.location.pick'|trans : location_errors|first }}
            </p>
        {% endif %}
        <div class="p-trips-stop__errors">
            {{ form_errors(form.duration) }}
            {{ form_errors(form.options) }}
        </div>
        {# What the traveller looks for at this stop: two pills that light up when picked; below, the
           private switch (the stop is then hidden from other members) #}
        {% set option_icons = { LookingForHosts: 'fa-house-user', MeetLocals: 'fa-users', Private: 'fa-lock' } %}
        <div class="p-trips-stop__options" role="group" aria-label="{{ 'trip.leg.options'|trans }}">
            {% for option in form.options|filter(option => option.vars.value != 'Private') %}
                <label class="p-trips-option" for="{{ option.vars.id }}">
                    <input type="checkbox" class="p-trips-option__input" id="{{ option.vars.id }}" name="{{ option.vars.full_name }}" value="{{ option.vars.value }}"{% if option.vars.checked %} checked{% endif %}{% if option.vars.disabled %} disabled{% endif %}>
                    <i class="fas {{ option_icons[option.vars.value] ?? 'fa-check' }} p-trips-option__icon" aria-hidden="true"></i>
                    <span>{{ option.vars.label|trans }}</span>
                </label>
                {% do option.setRendered %}
            {% endfor %}
        </div>
        {% for option in form.options|filter(option => option.vars.value == 'Private') %}
            <label class="p-trips-private" for="{{ option.vars.id }}">
                <i class="fas fa-lock p-trips-private__icon" aria-hidden="true"></i>
                <span class="p-trips-private__text">{{ option.vars.label|trans }}</span>
                <input type="checkbox" role="switch" class="p-trips-private__input" id="{{ option.vars.id }}" name="{{ option.vars.full_name }}" value="{{ option.vars.value }}"{% if option.vars.checked %} checked{% endif %}{% if option.vars.disabled %} disabled{% endif %}>
                <span class="p-trips-private__switch" aria-hidden="true"></span>
            </label>
            {% do option.setRendered %}
        {% endfor %}
        {{ form_widget(form.location.name) }} {{ form_widget(form.location.geoname_id) }}
        {{ form_widget(form.location.latitude) }} {{ form_widget(form.location.longitude) }}
        {{ form_widget(form.arrival) }}
        {{ form_widget(form.departure) }}
        {% do form.location.setRendered() %}
    </div>
{% endmacro %}

{% block content %}
    {%- set button_text -%}
        {% if create %}{{ 'trip.create' | trans }}{% else %}{{ 'trip.update' | trans }}{% endif %}
    {%- endset -%}

    {% set embedded = app.request.query.getBoolean('embed') %}
    {% if embedded %}
    {#
      In the side panel of the home page (?embed=1): the head of the panels (back, title,
      close) and Cancel / Create at the bottom, as in the edit page's panels.
    #}
    <div class="p-ped p-trips-embed">
      <header class="p-ped-head">
        <button type="button" class="p-ped-head__btn js-ped-close" aria-label="{{ 'back'|trans }}">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
        </button>
        <div class="p-ped-head__text">
          <p class="p-ped-head__eyebrow"><i class="fas fa-suitcase" aria-hidden="true"></i> {{ 'trip'|trans }}</p>
          <h1 class="p-ped-head__title">{{ 'landing.stats.trip'|trans }}</h1>
        </div>
        <button type="button" class="p-ped-head__close js-ped-close" aria-label="{{ 'close'|trans }}">
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </header>
    {% endif %}
    {{ form_start(form, { attr: { autocomplete: 'off', class: 'p-trips-form' } }) }}
        <section class="p-trips-card">
            <div class="p-trips-card__head">
                <span class="p-trips-card__icon" aria-hidden="true"><i class="fas fa-suitcase"></i></span>
                <div>
                    <h2 class="p-trips-card__title">{{ 'trip.details'|trans }}</h2>
                    <p class="p-trips-card__hint">{{ 'trip.details.hint'|trans }}</p>
                </div>
            </div>
            <div class="p-trips-field">
                <label class="p-trips-label" for="{{ form.summary.vars.id }}">{{ form.summary.vars.label|trans }}</label>
                {{ form_widget(form.summary, { attr: form.summary.vars.attr|merge({ class: 'p-trips-input p-trips-input--box' }) }) }}
                {{ form_errors(form.summary) }}
            </div>
            <div class="p-trips-field">
                <label class="p-trips-label" for="{{ form.description.vars.id }}">{{ form.description.vars.label|trans }}</label>
                {{ form_widget(form.description, { attr: form.description.vars.attr|merge({ class: 'p-trips-input p-trips-input--box', rows: 4 }) }) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="p-trips-form__row">
                {% for field in [form.countOfTravellers, form.additionalInfo, form.invitationRadius] %}
                    <div class="p-trips-field">
                        {% if field.vars.name == 'countOfTravellers' %}
                            {# The number of travellers with - and + (trips.js): 1 to 5, then "5+" (the form's 6) #}
                            {% set count = field.vars.value ?: 1 %}
                            <span class="p-trips-label" id="{{ field.vars.id }}_label">{{ field.vars.label|trans }}</span>
                            <div class="p-trips-stepper js-stepper" role="group" aria-labelledby="{{ field.vars.id }}_label" data-min="1" data-max="6">
                                <button type="button" class="p-trips-stepper__btn js-stepper-step" data-step="-1" aria-label="-"{{ count <= 1 ? ' disabled' }}>
                                    <i class="fas fa-minus" aria-hidden="true"></i>
                                </button>
                                <output class="p-trips-stepper__value js-stepper-value" for="{{ field.vars.id }}" aria-live="polite">{{ count >= 6 ? '5+' : count }}</output>
                                <input type="hidden" id="{{ field.vars.id }}" name="{{ field.vars.full_name }}" value="{{ count }}" class="js-stepper-input">
                                <button type="button" class="p-trips-stepper__btn js-stepper-step" data-step="1" aria-label="+"{{ count >= 6 ? ' disabled' }}>
                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                </button>
                            </div>
                            {% do field.setRendered %}
                        {% else %}
                            <label class="p-trips-label" for="{{ field.vars.id }}">{{ field.vars.label|trans }}</label>
                            {{ form_widget(field, { attr: { class: 'p-trips-select' } }) }}
                        {% endif %}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="p-trips-card">
            <div class="p-trips-card__head">
                <span class="p-trips-card__icon" aria-hidden="true"><i class="fas fa-route"></i></span>
                <div>
                    <h2 class="p-trips-card__title">{{ 'trip.legs.title'|trans }}</h2>
                    <p class="p-trips-card__hint">{{ 'trip.legs.hint'|trans }}</p>
                </div>
            </div>
            {# The texts of the calendar of each stop (trips.js, contact/stay_dates.js) #}
            <div class="js-trip-dates-texts" hidden
                 data-arrival="{{ 'contact.dates.arrival'|trans }}" data-departure="{{ 'contact.dates.departure'|trans }}"
                 data-select="{{ 'contact.dates.select'|trans }}" data-change="{{ 'contact.dates.change'|trans }}"
                 data-tap-arrival="{{ 'contact.dates.tap.arrival'|trans }}" data-tap-departure="{{ 'contact.dates.tap.departure'|trans }}"
                 data-week="{{ 'contact.dates.week'|trans }}"
                 data-previous="{{ 'contact.dates.previous'|trans }}" data-next="{{ 'contact.dates.next'|trans }}"
                 data-one="{{ 'request.night.stay'|trans({ numbernights: 1 }) }}"
                 data-other="{{ 'request.night.stay'|trans({ numbernights: 99 })|replace({ '99': '{n}' }) }}"></div>
            <div id="legs-list" class="p-trips-stops"
                 data-prototype="{{ _self.widget_prototype(form.legs.vars.prototype)|escape('html_attr') }}">
                {% for leg in form.legs %}
                    {{ _self.widget_prototype(leg) }}
                {% endfor %}
            </div>
            <button type="button" class="p-trips-btn js-btn-add" data-target="legs-list">
                <i class="fa fa-plus" aria-hidden="true"></i> {{ 'trip.leg.add'|trans }}
            </button>
        </section>

        {{ form_errors(form) }}
        {% if embedded %}
        <div class="p-ped-foot">
            <button type="button" class="p-ped-foot__cancel js-ped-close">{{ 'cancel'|trans }}</button>
            <button class="p-ped-foot__save" type="submit"><i class="fas fa-check" aria-hidden="true"></i> {{ button_text|trans|capitalize }}</button>
        </div>
        {% else %}
        <div class="p-trips-form__actions">
            <button class="p-trips-btn p-trips-btn--primary p-trips-btn--l" type="submit">{{ button_text|trans|capitalize }}</button>
        </div>
        {% endif %}
    {{ form_end(form) }}
    {% if embedded %}
    </div>
    <script>
      (function () {
        var parentWindow = window.parent !== window ? window.parent : null;
        // The panel's own head is hidden: this page has its own
        if (parentWindow) {
          parentWindow.postMessage({ type: 'bw-contact-ready' }, window.location.origin);
        }
        document.body.classList.add('has-ped-foot');
        document.addEventListener('click', function (event) {
          if (event.target.closest('.js-ped-close')) {
            event.preventDefault();
            if (parentWindow) {
              parentWindow.postMessage({ type: 'bw-contact-back' }, window.location.origin);
            } else {
              window.location.href = '{{ path('landingpage') }}';
            }
          }
        });
      })();
    </script>
    {% endif %}
{% endblock content %}
