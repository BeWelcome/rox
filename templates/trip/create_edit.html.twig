{% extends 'trips.html.twig' %}

{% set trips_redesign = true %}

{% block title %}
    {% if create %}{{ 'trip.create' | trans }}{% else %}{{ 'trip.edit' | trans }}{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('jquery_ui') }}
    {{ encore_entry_link_tags('trips') }}
{% endblock stylesheets %}

{% block javascripts %}
    {{ encore_entry_script_tags('trips') }}
{% endblock javascripts %}

{#
  One stop of the trip: place, dates and options. trips.js relies on the
  js-* classes, the data-content/data-related pair and the field ids.
#}
{% macro widget_prototype(widget) %}
    {% if widget.vars.prototype is defined %}
        {% set form = widget.vars.prototype %}
        {% set name = widget.vars.name %}
    {% else %}
        {% set form = widget %}
        {% set name = widget.vars.full_name %}
    {% endif %}
    <div data-content="{{ name }}" class="p-trips-stop">
        <div class="p-trips-stop__fields">
            <div class="p-trips-field p-trips-field--icon">
                <i class="fas fa-location-dot" aria-hidden="true"></i>
                <div class="auto-search-wrapper max-height">
                    <input type="text" id="{{ form.location.fullname.vars.id }}" name="{{ form.location.fullname.vars.full_name }}"
                           class="p-trips-input js-location-picker" autocomplete="off"
                           placeholder="{{ 'trip.leg.location'|trans }}"
                           aria-label="{{ 'trip.leg.location'|trans }}"
                           {% if form.location.fullname.vars.disabled %}disabled{% endif %}
                           {% if form.location.fullname.vars.value %}value="{{ form.location.fullname.vars.value }}"{% endif %}
                    >
                </div>
            </div>
            <div class="p-trips-field p-trips-field--icon p-trips-field--dates">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                {{ form_widget(form.duration, { attr: {
                    class: 'p-trips-input duration js-duration',
                    placeholder: 'trip.leg.duration'|trans,
                    'aria-label': 'trip.leg.duration'|trans,
                } }) }}
            </div>
            <button type="button" class="p-trips-stop__remove js-btn-remove" data-related="{{ name }}" aria-label="{{ 'delete'|trans }}" title="{{ 'delete'|trans }}">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="p-trips-stop__errors">
            {{ form_errors(form.location) }}{{ form_errors(form.location.fullname) }}{{ form_errors(form.location.geoname_id) }}
            {{ form_errors(form.duration) }}
            {{ form_errors(form.options) }}
        </div>
        <div class="p-trips-stop__options" role="group" aria-label="{{ 'trip.leg.options'|trans }}">
            {% for option in form.options %}
                <label class="p-trips-option" for="{{ option.vars.id }}">
                    <input type="checkbox" id="{{ option.vars.id }}" name="{{ option.vars.full_name }}" value="{{ option.vars.value }}"{% if option.vars.checked %} checked{% endif %}{% if option.vars.disabled %} disabled{% endif %}>
                    <span>{{ option.vars.label|trans }}</span>
                </label>
                {% do option.setRendered %}
            {% endfor %}
        </div>
        {{ form_widget(form.location.name) }} {{ form_widget(form.location.geoname_id) }}
        {{ form_widget(form.location.latitude) }} {{ form_widget(form.location.longitude) }}
        {{ form_widget(form.arrival) }}
        {{ form_widget(form.departure) }}
        {% do form.location.setRendered() %}
    </div>
{% endmacro %}

{% block content %}
    {%- set button_text -%}
        {% if create %}{{ 'trip.create' | trans }}{% else %}{{ 'trip.update' | trans }}{% endif %}
    {%- endset -%}

    {{ form_start(form, { attr: { autocomplete: 'off', class: 'p-trips-form' } }) }}
        <section class="p-trips-card">
            <h2 class="p-trips-card__title">{{ 'trip.details'|trans }}</h2>
            <div class="p-trips-field">
                {{ form_label(form.summary, null, { label_attr: { class: 'p-trips-label' } }) }}
                {{ form_widget(form.summary, { attr: form.summary.vars.attr|merge({ class: 'p-trips-input p-trips-input--box' }) }) }}
                {{ form_errors(form.summary) }}
            </div>
            <div class="p-trips-field">
                {{ form_label(form.description, null, { label_attr: { class: 'p-trips-label' } }) }}
                {{ form_widget(form.description, { attr: form.description.vars.attr|merge({ class: 'p-trips-input p-trips-input--box', rows: 4 }) }) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="p-trips-form__row">
                {% for field in [form.countOfTravellers, form.additionalInfo, form.invitationRadius] %}
                    <div class="p-trips-field">
                        {{ form_label(field, null, { label_attr: { class: 'p-trips-label' } }) }}
                        {{ form_widget(field, { attr: { class: 'p-trips-select' } }) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="p-trips-card">
            <h2 class="p-trips-card__title">{{ 'trip.legs.title'|trans }}</h2>
            <div id="legs-list" class="p-trips-stops"
                 data-prototype="{{ _self.widget_prototype(form.legs.vars.prototype)|escape('html_attr') }}">
                {% for leg in form.legs %}
                    {{ _self.widget_prototype(leg) }}
                {% endfor %}
            </div>
            <button type="button" class="p-trips-btn js-btn-add" data-target="legs-list">
                <i class="fa fa-plus" aria-hidden="true"></i> {{ 'trip.leg.add'|trans }}
            </button>
        </section>

        {{ form_errors(form) }}
        <div class="p-trips-form__actions">
            <button class="p-trips-btn p-trips-btn--primary p-trips-btn--l" type="submit">{{ button_text|trans|capitalize }}</button>
        </div>
    {{ form_end(form) }}
{% endblock content %}
