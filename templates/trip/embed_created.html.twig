{% extends 'base.html.twig' %}
{#
  Shown in the side panel of the home page once a trip is created (?embed=1): the same
  animated confirmation as a sent request (conversations/embed_sent.html.twig), the trip
  (title, dates, stops) and two ways on: back to the home page, or the trip's page.
#}
{% block title %}{{ 'trip.created.title'|trans }}{% endblock title %}

{% block content %}
    <div class="c-embed-sent c-embed-sent--trip" role="status">
        <button type="button" class="c-embed-sent__close js-embed-sent-close" aria-label="{{ 'close'|trans }}">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <div class="c-embed-sent__scene" aria-hidden="true">
            <span class="c-embed-sent__ring"></span>
            <span class="c-embed-sent__ring c-embed-sent__ring--late"></span>
            <span class="c-embed-sent__plane"><i class="fas fa-suitcase"></i></span>
            <svg class="c-embed-sent__check" viewBox="0 0 64 64">
                <circle class="c-embed-sent__disc" cx="32" cy="32" r="30"></circle>
                <path class="c-embed-sent__tick" d="M19 33.5l9 9 17-19"></path>
            </svg>
            {% for i in 1..10 %}<span class="c-embed-sent__spark c-embed-sent__spark--{{ i }}"></span>{% endfor %}
        </div>

        <h1 class="c-embed-sent__title">{{ 'trip.created.title'|trans }}</h1>
        <p class="c-embed-sent__text">{{ 'trip.created.text'|trans }}</p>

        {# The trip as hosts see it: plane tile, title, travellers and how far hosts can be; the stops in
           order (number, town, dates, nights, what the traveller looks for there); View trip at the bottom #}
        {% set first_place = (trip.legs|first) ? (trip.legs|first).location : null %}
        <div class="c-embed-sent__trip">
            <div class="c-embed-sent__trip-head">
                <span class="c-embed-sent__avatar c-embed-sent__avatar--icon" aria-hidden="true"><i class="fas fa-plane"></i></span>
                <div class="c-embed-sent__card-text">
                    <strong class="c-embed-sent__subject">{{ trip.summary }}</strong>
                    <span class="c-embed-sent__stay">
                        <i class="fas fa-user-group" aria-hidden="true"></i> {{ 'trip.review.travellers'|trans({ count: trip.countOfTravellers }) }}
                        · <i class="fas fa-bullseye" aria-hidden="true"></i> {{ trip.invitationRadius }} km
                    </span>
                </div>
            </div>
            <ol class="c-embed-sent__stops">
                {% for leg in trip.legs %}
                    {% set _nights = leg.arrival and leg.departure ? date(leg.departure|date('Y-m-d')).diff(date(leg.arrival|date('Y-m-d'))).days : 0 %}
                    <li class="c-embed-sent__stop">
                        <span class="c-embed-sent__stop-num">{{ loop.index }}</span>
                        <span class="c-embed-sent__stop-text">
                            <strong>{{ leg.location ? leg.location.name : '' }}</strong>
                            <span>
                                {%- if leg.arrival -%}
                                    {{ leg.arrival|format_date(pattern='d MMM') }}{% if leg.departure %} – {{ leg.departure|format_date(pattern='d MMM') }}{% endif %}
                                {%- endif -%}
                                {%- if _nights > 0 %} · {{ 'contact.trip.nights'|trans({ count: _nights }) }}{% endif -%}
                            </span>
                        </span>
                        {% if constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
                            <span class="c-embed-sent__stop-tag"><i class="fas fa-house" aria-hidden="true"></i> {{ 'landing.dash.needs.host'|trans }}</span>
                        {% elseif constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
                            <span class="c-embed-sent__stop-tag c-embed-sent__stop-tag--plain"><i class="fas fa-users" aria-hidden="true"></i> {{ 'trip.option.meet.locals'|trans }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
            <a class="c-embed-sent__trip-link" href="{{ path('trip_show', { id: trip.id }) }}" target="_top">{{ 'trip.created.view'|trans }} <i class="fas fa-chevron-right" aria-hidden="true"></i></a>
        </div>

        <div class="c-embed-sent__actions">
            {% if first_place %}
                {# Posted like the home page's place search (the search form checks its token, a plain link is refused) #}
                <form class="c-embed-sent__search-form" method="post" action="{{ path('search_locations') }}" target="_top">
                    {% for _name, _value in {
                        location: first_place.name,
                        location_fullname: first_place.fullname,
                        location_name: first_place.name,
                        location_geoname_id: first_place.geonameId,
                        location_latitude: first_place.latitude,
                        location_longitude: first_place.longitude,
                        location_admin_unit: 0,
                        _token: csrf_token('submit'),
                    } %}
                        <input type="hidden" name="tiny[{{ _name }}]" value="{{ _value }}">
                    {% endfor %}
                    <button type="submit" class="c-embed-sent__btn c-embed-sent__btn--primary">
                        <i class="fas fa-magnifying-glass-location" aria-hidden="true"></i> {{ 'trip.created.search'|trans({ place: first_place.name }) }}
                    </button>
                </form>
            {% endif %}
            <button type="button" class="c-embed-sent__btn{{ first_place ? '' : ' c-embed-sent__btn--primary' }} js-embed-sent-close">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> {{ 'contact.sent.back.home'|trans }}
            </button>
        </div>
    </div>
    <script>
        (function () {
            var parentWindow = window.parent !== window ? window.parent : null;
            if (parentWindow) {
                parentWindow.postMessage({ type: 'bw-contact-sent', kind: 'trip' }, window.location.origin);
            }
            document.querySelectorAll('.js-embed-sent-close').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (parentWindow) {
                        parentWindow.postMessage({ type: 'bw-contact-close' }, window.location.origin);
                    } else {
                        window.location.href = '{{ path('trip_show', { id: trip.id }) }}';
                    }
                });
            });
        })();
    </script>
{% endblock content %}
