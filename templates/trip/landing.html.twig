{#
  One trip leg near the member, in the Visitors tab of the home page: where and when,
  who travels, and the actions (hide, write, invite).
#}
{% import 'macros.twig' as macros %}
{% set creator = leg.trip.creator.username %}
<div class="c-home-item c-dashboard__item">
    <img class="c-home-item__avatar" src="{{ path('avatar', { username: creator, size: 48 }) }}" alt="" loading="lazy">
    <div class="c-home-item__body">
        <span class="c-home-item__top">
            <a class="c-home-item__title c-home-item__title--link" href="{{ url('trip_show', { id: leg.trip.id, _fragment: 'leg' ~ leg.id }) }}">{{ leg.location.name }}</a>
        </span>
        <p class="c-home-item__meta">
            <i class="far fa-calendar" aria-hidden="true"></i>
            {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} - {{ leg.departure|format_date('medium') }}{% endif %}
            · <i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: leg.trip.countOfTravellers }) }}
            {%- if constant('App\\Doctrine\\TripAdditionalInfoType::NONE') != leg.trip.additionalInfo %}
                · {{ ('trip.additional.info.' ~ leg.trip.additionalInfo)|lower|trans }}
            {%- endif %}
        </p>
        <p class="c-home-item__meta">{{ 'trip.posted.by'|trans({ username: macros.profilelink(creator, false, 'c-home-item__author') })|raw }}</p>
    </div>
    <div class="c-home-item__actions">
        <form method="post" action="{{ path('trip_hide', { id: leg.id }) }}" class="js-hide-leg">
            <input type="hidden" name="_token" value="{{ csrf_token('hide_leg') }}">
            <input type="hidden" name="redirectTo" value="homepage">
            <button type="submit" class="c-home-item__action" aria-label="{{ 'trip.hide'|trans }}" title="{{ 'trip.hide'|trans }}">
                <i class="fa fa-fw fa-eye-slash" aria-hidden="true"></i>
            </button>
        </form>
        {% if constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
            <a class="c-home-item__action" href="{{ path('message_new', { username: creator }) }}" aria-label="{{ 'message.write_to'|trans|format(creator) }}" title="{{ 'message.write_to'|trans|format(creator) }}">
                <i class="fa fa-fw fa-envelope" aria-hidden="true"></i>
            </a>
        {% endif %}
        {% if constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
            {% if leg.invitationBy(app.user) %}
                {% set invitation = leg.invitationBy(app.user) %}
                <a class="c-home-item__action{% if leg.invitedBy == app.user %} is-done{% endif %}" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" aria-label="{{ 'invitation.reply'|trans|format(creator) }}" title="{{ 'invitation.reply'|trans|format(creator) }}">
                    <i class="fa fa-fw fa-house-user" aria-hidden="true"></i>
                </a>
            {% else %}
                <a class="c-home-item__action c-home-item__action--primary" href="{{ path('hosting_invitation', { leg: leg.id }) }}">
                    <i class="fa fa-fw fa-house-user" aria-hidden="true"></i>
                </a>
            {% endif %}
        {% endif %}
    </div>
</div>
