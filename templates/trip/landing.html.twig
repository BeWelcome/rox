{#
  One trip leg near the member, in the Visitors tab of the home page and on the Visitors page: the traveller and the
  trip's title, the start of its text, then tags (Invited, the nights, the other stops, the travellers when more than one); on
  the right the arrival as plain text (Today / Tomorrow in orange, else the date). The row opens the trip in
  the side panel, where the member can invite or write.
#}
{% set traveller = leg.trip.creator %}
{% set invited = leg.invitationBy(app.user) %}
{% set otherStops = leg.trip.legs|filter(stop => stop.id != leg.id and constant('App\\Doctrine\\LegOptionsType::PRIVATE') not in stop.options)|length %}
{% set _arrival = leg.arrival|date('Y-m-d') %}
{% set _soon = _arrival == 'today'|date('Y-m-d') ? 'today' : (_arrival == 'tomorrow'|date('Y-m-d') ? 'tomorrow' : null) %}
{% set _nights = date(leg.departure|date('Y-m-d')).diff(date(_arrival)).days %}
<div class="c-home-item c-dashboard__item c-home-item--leg js-contact-row">
    {# The whole row opens the trip in the side panel (trip/leg_panel.html.twig) #}
    <a class="c-home-item__cover js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ leg.trip.summary ?: leg.location.name }}">
        <span class="visually-hidden">{{ leg.trip.summary ?: leg.location.name }}</span>
    </a>
    <img class="c-home-item__avatar" src="{{ path('avatar', { username: traveller.username, size: 96 }) }}" alt="" loading="lazy">
    <div class="c-home-item__body">
        <span class="c-home-item__top">
            <span class="c-home-item__name">{{ traveller.shortNameOrUsername }}</span>
            {% if leg.trip.summary %}<span class="c-home-item__title">{{ leg.trip.summary }}</span>{% endif %}
        </span>
        {% set _excerpt = leg.trip.description|striptags|trim %}
        {% if _excerpt %}
            <p class="c-home-item__excerpt">{{ _excerpt }}</p>
        {% endif %}
        {% set _travellers = leg.trip.countOfTravellers %}
        {% if invited or _nights > 0 or otherStops > 0 or _travellers > 1 %}
            <p class="c-home-item__tags">
                {% if invited %}
                    <span class="c-home-item__tag c-home-item__tag--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
                {% endif %}
                {% if _nights > 0 %}
                    <span class="c-home-item__tag c-home-item__tag--nights"><i class="fas fa-moon" aria-hidden="true"></i> {{ 'contact.trip.nights'|trans({ count: _nights }) }}</span>
                {% endif %}
                {% if otherStops > 0 %}
                    <span class="c-home-item__tag c-home-item__tag--plain"><i class="fas fa-route" aria-hidden="true"></i> {{ 'landing.visitors.more.stops'|trans({ count: otherStops }) }}</span>
                {% endif %}
                {% if _travellers > 1 %}
                    <span class="c-home-item__tag c-home-item__tag--plain"><i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: _travellers }) }}</span>
                {% endif %}
            </p>
        {% endif %}
    </div>
    {# Arrival, then the chevron #}
    <div class="c-home-item__side">
        <span class="c-home-item__arrival{{ _soon ? ' is-soon' }}">
            {{- _soon ? ('landing.visitors.' ~ _soon)|trans : leg.arrival|format_date(pattern='MMM d') -}}
        </span>
    </div>
    <span class="c-home-item__chevron" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
</div>
