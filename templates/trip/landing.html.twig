{#
  One trip leg near the member, in the Visitors tab of the home page: where and when,
  who travels and the start of the trip's text. The row opens the trip in the side panel,
  where the member can invite or write; the eye hides the trip.
#}
{% import 'macros.twig' as macros %}
{% set creator = leg.trip.creator.username %}
{% set invited = leg.invitationBy(app.user) %}
<div class="c-home-item c-dashboard__item c-home-item--leg">
    {# The whole row opens the trip in the side panel (trip/leg_panel.html.twig) #}
    <a class="c-home-item__cover js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ leg.location.name }}">
        <span class="visually-hidden">{{ leg.location.name }}</span>
    </a>
    <img class="c-home-item__avatar" src="{{ path('avatar', { username: creator, size: 48 }) }}" alt="" loading="lazy">
    <div class="c-home-item__body">
        <span class="c-home-item__top">
            <span class="c-home-item__title">{{ leg.location.name }}</span>
            {% if invited %}
                <span class="c-home-item__tag c-home-item__tag--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
            {% elseif constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
                <span class="c-home-item__tag"><i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.option.looking.for.host'|trans }}</span>
            {% endif %}
        </span>
        <p class="c-home-item__meta">
            <i class="far fa-calendar" aria-hidden="true"></i>
            {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} - {{ leg.departure|format_date('medium') }}{% endif %}
            · <i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: leg.trip.countOfTravellers }) }}
        </p>
        {% set _excerpt = [leg.trip.summary|striptags|trim, leg.trip.description|striptags|trim]|filter(t => t)|join(' · ') %}
        {% if _excerpt %}
            <p class="c-home-item__excerpt">{{ _excerpt }}</p>
        {% endif %}
        <p class="c-home-item__meta">{{ 'trip.posted.by'|trans({ username: macros.profilelink(creator, false, 'c-home-item__author') })|raw }}</p>
    </div>
    <div class="c-home-item__actions">
        <form method="post" action="{{ path('trip_hide', { id: leg.id }) }}" class="js-hide-leg">
            <input type="hidden" name="_token" value="{{ csrf_token('hide_leg') }}">
            <input type="hidden" name="redirectTo" value="homepage">
            <button type="submit" class="c-home-item__action" aria-label="{{ 'trip.hide'|trans }}" title="{{ 'trip.hide'|trans }}">
                <i class="fa fa-fw fa-eye-slash" aria-hidden="true"></i>
            </button>
        </form>
        <span class="c-home-item__chevron" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
    </div>
</div>
