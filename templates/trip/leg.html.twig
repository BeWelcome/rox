{% import 'macros.twig' as macros %}
{#
  One trip leg in the visitors list: who is coming, where and when, and whether
  they look for a host or were already invited. The whole card opens the trip in
  the side panel, where Invite and Send a message are.
#}
{% set creator = leg.trip.creator %}
{% set invitation = leg.invitationBy(app.user) %}
<article class="p-trips-leg p-trips-leg--panel js-contact-row{% if leg.invitedBy == app.user %} p-trips-leg--invited{% endif %}">
  {# The whole card opens the trip in the side panel (trip/leg_panel.html.twig) #}
  <a class="p-trips-leg__cover js-contact-open" href="{{ path('trip_leg_panel', { id: leg.id }) }}" data-title="{{ leg.trip.summary ?: leg.location.name }}">
    <span class="visually-hidden">{{ leg.trip.summary ?: leg.location.name }}</span>
  </a>
  <a class="p-trips-leg__avatar" href="{{ path('members_profile', { username: creator.username }) }}">
    <img src="{{ path('avatar', { username: creator.username, size: 96 }) }}" alt="" width="56" height="56" loading="lazy">
  </a>

  <div class="p-trips-leg__body">
    <p class="p-trips-leg__who">{{ macros.profilelink(creator.username, false, 'p-trips-leg__name') }}</p>
    <p class="p-trips-leg__title">{{ leg.trip.summary }}</p>
    <p class="p-trips-leg__where">
      <span><i class="fas fa-location-dot" aria-hidden="true"></i> {{ leg.location.name }}</span>
      <span><i class="far fa-calendar-alt" aria-hidden="true"></i> {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} – {{ leg.departure|format_date('medium') }}{% endif %}</span>
    </p>
    {% if leg.trip.description %}
      <p class="p-trips-leg__text">{{ leg.trip.description|purify|striptags|truncate(240) }}</p>
    {% endif %}
    <p class="p-trips-leg__meta">
      <span class="p-trips-leg__chip">
        <i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: leg.trip.countOfTravellers }) }}
        {% if leg.trip.countOfTravellers > app.user.maxGuests %}
          <i class="fas fa-exclamation-triangle p-trips-leg__warn" title="{{ 'trip.leg.warning.too.many.travellers'|trans }}"></i>
        {% endif %}
      </span>
      {% if constant('App\\Doctrine\\TripAdditionalInfoType::NONE') != leg.trip.additionalInfo %}
        <span class="p-trips-leg__chip"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ ('trip.additional.info.' ~ leg.trip.additionalInfo)|lower|trans }}</span>
      {% endif %}
    </p>
  </div>

  {# Right side: where things stand, and a chevron; the actions are in the side panel #}
  <div class="p-trips-leg__side">
    {% if invitation %}
      <span class="c-home-item__tag c-home-item__tag--done"><i class="fa fa-check" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}</span>
    {% elseif constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
      <span class="c-home-item__tag"><i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.option.looking.for.host'|trans }}</span>
    {% endif %}
    <span class="p-trips-leg__chevron" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
  </div>
</article>
