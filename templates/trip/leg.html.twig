{% import 'macros.twig' as macros %}
{#
  One trip leg in the visitors list: who is coming, where and when, then the
  actions (invite, message, hide).
#}
{% set creator = leg.trip.creator %}
{% set invitation = leg.invitationBy(app.user) %}
<article class="p-trips-leg{% if leg.invitedBy == app.user %} p-trips-leg--invited{% endif %}">
  <a class="p-trips-leg__avatar" href="{{ path('members_profile', { username: creator.username }) }}">
    <img src="{{ path('avatar', { username: creator.username, size: 96 }) }}" alt="" width="56" height="56" loading="lazy">
  </a>

  <div class="p-trips-leg__body">
    <p class="p-trips-leg__who">{{ macros.profilelink(creator.username, false, 'p-trips-leg__name') }}</p>
    <a class="p-trips-leg__title" href="{{ path('trip_show', { id: leg.trip.id, _fragment: 'leg' ~ leg.id }) }}">{{ leg.trip.summary }}</a>
    <p class="p-trips-leg__where">
      <span><i class="fas fa-location-dot" aria-hidden="true"></i> {{ leg.location.name }}</span>
      <span><i class="far fa-calendar-alt" aria-hidden="true"></i> {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} – {{ leg.departure|format_date('medium') }}{% endif %}</span>
    </p>
    {% if leg.trip.description %}
      <p class="p-trips-leg__text">{{ leg.trip.description|purify|striptags|truncate(240) }}</p>
    {% endif %}
    <p class="p-trips-leg__meta">
      <span class="p-trips-leg__chip">
        <i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: leg.trip.countOfTravellers }) }}
        {% if leg.trip.countOfTravellers > app.user.maxGuests %}
          <i class="fas fa-exclamation-triangle p-trips-leg__warn" title="{{ 'trip.leg.warning.too.many.travellers'|trans }}"></i>
        {% endif %}
      </span>
      {% if constant('App\\Doctrine\\TripAdditionalInfoType::NONE') != leg.trip.additionalInfo %}
        <span class="p-trips-leg__chip"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ ('trip.additional.info.' ~ leg.trip.additionalInfo)|lower|trans }}</span>
      {% endif %}
    </p>
  </div>

  <div class="p-trips-leg__actions">
    {% if constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
      {% if invitation %}
        <a class="p-trips-btn p-trips-btn--done" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" title="{{ 'invitation.reply'|trans|format(creator.username) }}">
          <i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}
        </a>
      {% else %}
        <a class="p-trips-btn p-trips-btn--primary" href="{{ path('hosting_invitation', { leg: leg.id }) }}" title="{{ 'invite.username'|trans|format(creator.username) }}">
          <i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invite'|trans }}
        </a>
      {% endif %}
    {% endif %}
    {% if constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
      <a class="p-trips-btn" href="{{ path('message_new', { username: creator.username }) }}" title="{{ 'message.write_to'|trans|format(creator.username) }}">
        <i class="fa fa-envelope" aria-hidden="true"></i> {{ 'trip.leg.message'|trans }}
      </a>
    {% endif %}
    <form method="post" action="{{ path('trip_hide', { id: leg.id }) }}" class="js-hide-leg">
      <input type="hidden" name="_token" value="{{ csrf_token('hide_leg') }}">
      <input type="hidden" name="redirectTo" value="visitors">
      <button type="submit" class="p-trips-btn p-trips-btn--icon" aria-label="{{ 'trip.hide'|trans }}" title="{{ 'trip.hide'|trans }}">
        <i class="fa fa-eye-slash" aria-hidden="true"></i>
      </button>
    </form>
  </div>
</article>
