{% extends 'base.html.twig' %}
{#
  One leg of a trip in the side panel of the home page (Visitors, ?embed=1): the trip as
  the traveller wrote it, then the ways to answer. Invite and Send a message open their
  form in the same panel; its back arrow comes back here (?back=).
#}
{% set traveller = leg.trip.creator %}
{% set myself = app.user %}
{% set lookingForHost = constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
{% set meetLocals = constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
{% set invitation = lookingForHost ? leg.invitationBy(myself) : null %}
{% set back = app.request.requestUri %}

{% block title %}{{ leg.location.name }}{% endblock title %}

{% block content %}
    <div class="c-contact">
        {% include 'conversations/_contact_head.html.twig' with { member: traveller, kind: 'trip' } %}

        <div class="c-contact__body">
            <section class="c-contact-trip c-contact-trip--full">
                <p class="c-contact-trip__where">
                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{ leg.location.name }}
                    <span>· {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} - {{ leg.departure|format_date('medium') }}{% endif %}</span>
                    <span>· <i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: leg.trip.countOfTravellers }) }}</span>
                </p>
                {% if leg.trip.summary %}
                    <h2 class="c-contact-trip__title">{{ leg.trip.summary }}</h2>
                {% endif %}
                {% if leg.trip.description %}
                    <div class="c-contact-trip__text">{{ leg.trip.description|purify }}</div>
                {% endif %}
                {% if lookingForHost or meetLocals or constant('App\\Doctrine\\TripAdditionalInfoType::NONE') != leg.trip.additionalInfo %}
                    <p class="c-contact-trip__chips">
                        {% if lookingForHost %}<span class="c-contact-trip__chip"><i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.option.looking.for.host'|trans }}</span>{% endif %}
                        {% if meetLocals %}<span class="c-contact-trip__chip"><i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.option.meet.locals'|trans }}</span>{% endif %}
                        {% if constant('App\\Doctrine\\TripAdditionalInfoType::NONE') != leg.trip.additionalInfo %}<span class="c-contact-trip__chip">{{ ('trip.additional.info.' ~ leg.trip.additionalInfo)|lower|trans }}</span>{% endif %}
                    </p>
                {% endif %}
                <p class="c-contact-trip__links">
                    <a class="c-contact-trip__link" href="{{ path('trip_show', { id: leg.trip.id, _fragment: 'leg' ~ leg.id }) }}" target="_top">{{ 'contact.trip.see'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    <a class="c-contact-trip__link" href="{{ path('members_profile', { username: traveller.username }) }}" target="_top">{{ 'contact.trip.profile'|trans({ username: traveller.shortNameOrUsername }) }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </p>
            </section>
        </div>

        {% if lookingForHost or meetLocals %}
            <div class="c-contact__foot c-contact__foot--actions">
                {% if lookingForHost %}
                    {% if invitation %}
                        <a class="c-contact__send c-contact__send--done" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" target="_top">
                            <i class="fas fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}
                        </a>
                    {% else %}
                        <a class="c-contact__send" href="{{ path('hosting_invitation', { leg: leg.id, embed: 1, from: 'home', back: back }) }}">
                            <i class="fas fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invite'|trans }}
                        </a>
                    {% endif %}
                {% endif %}
                {% if meetLocals %}
                    <a class="c-contact__send{% if lookingForHost %} c-contact__send--secondary{% endif %}" href="{{ path('message_new', { username: traveller.username, embed: 1, from: 'home', back: back }) }}">
                        <i class="fas fa-envelope" aria-hidden="true"></i> {{ 'trip.leg.message'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock content %}
