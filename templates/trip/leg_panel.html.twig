{% extends 'base.html.twig' %}
{#
  One leg of a trip in the side panel (home page and visitors page, ?embed=1): the traveller
  at the top (opens their preview in the panel) and the cross, the title with when, the text
  (cut after 10 lines, with Read more), the itinerary as a timeline with this leg's number dark and its dates
  in orange (Today / Tomorrow before them). At the bottom Hide this trip, centred, over a round Message
  and Invite to stay: they open their form in the same panel, and its back arrow comes back here (?back=).
#}
{% set traveller = trip.creator %}
{% set myself = app.user %}
{% set lookingForHost = constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
{% set invitation = lookingForHost ? leg.invitationBy(myself) : null %}
{% set back = app.request.requestUri %}
{% set from = app.request.query.get('from') ?: 'home' %}

{% block title %}{{ trip.summary }}{% endblock title %}

{% block content %}
    {% set stops = trip.legs|filter(stop => constant('App\\Doctrine\\LegOptionsType::PRIVATE') not in stop.options)|merge([]) %}
    {% set _first = stops|first %}
    {% set _last = stops|last %}
    {#- Who travels, under the traveller's name: what they said (as a couple, family...), else solo or the count -#}
    {% set _info = trip.additionalInfo %}
    {% if _info == constant('App\\Doctrine\\TripAdditionalInfoType::SINGLE') or (_info == constant('App\\Doctrine\\TripAdditionalInfoType::NONE') and trip.countOfTravellers <= 1) %}
        {% set _who = 'trip.panel.solo'|trans %}
    {% elseif _info != constant('App\\Doctrine\\TripAdditionalInfoType::NONE') %}
        {% set _who = ('trip.additional.info.' ~ _info)|lower|trans %}
    {% else %}
        {% set _who = 'trip.count.of.travellers'|trans({ countOfTravellers: trip.countOfTravellers }) %}
    {% endif %}
    <div class="c-contact c-contact--trip c-tripv">
        <div class="c-contact__body c-tripv__body">
            {# The traveller (face, name, who travels: opens their preview in the same panel, its back arrow comes back here) and the cross #}
            <div class="c-tripv__top">
                <a class="c-tripv__who" href="{{ path('search_member_preview', { username: traveller.username, embed: 1, leg: leg.id, from: from, back: back }) }}">
                    <img class="c-tripv__face" src="{{ path('avatar', { username: traveller.username, size: 96 }) }}" alt="">
                    <span class="c-tripv__who-text">
                        <strong>{{ traveller.shortNameOrUsername }} <i class="fas fa-chevron-right" aria-hidden="true"></i></strong>
                        <small>{{ _who }}</small>
                    </span>
                </a>
                <button type="button" class="c-tripv__close js-trip-close" aria-label="{{ 'close'|trans }}">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>

            {# The title, then where and when: the dates for one stop (the place is ours), the number of stops otherwise #}
            <header class="c-tripv__head">
                <h1 class="c-tripv__title">{{ trip.summary ?: (_first ? _first.location.name : '') }}</h1>
                {% if _first %}
                    <p class="c-tripv__sub">
                        {%- if stops|length == 1 -%}
                            {{ _first.arrival|format_date(pattern='EEE d') }}{% if _first.departure|date('Y-m-d') != _first.arrival|date('Y-m-d') %} – {{ _first.departure|format_date(pattern='EEE d MMM') }}{% else %} {{ _first.arrival|format_date(pattern='MMM') }}{% endif %}
                        {%- else -%}
                            {{ 'contact.trip.stops'|trans({ count: stops|length }) }} · {{ _first.arrival|format_date(pattern='d MMM') }} – {{ _last.departure|format_date(pattern='d MMM') }}
                        {%- endif %} · {{ 'trip.count.of.travellers'|trans({ countOfTravellers: trip.countOfTravellers }) -}}
                    </p>
                {% endif %}
            </header>

            {% if trip.description %}
                <section class="c-tripv__about">
                    <div class="c-tripv__text is-clamped js-trip-text">{{ trip.description|nl2br }}</div>
                    <button type="button" class="c-tripv__more js-trip-more" data-less="{{ 'contact.trip.read.less'|trans }}" hidden>{{ 'contact.trip.read.more'|trans }}</button>
                </section>
            {% endif %}

            {# The stops as a timeline: this leg's number dark and its dates in orange #}
            <section class="c-tripv__stops">
                <h2 class="c-tripv__h2">{{ 'trip.panel.itinerary'|trans }}</h2>
                <ol class="c-tripv__list">
                    {% for stop in stops %}
                        {% set isThis = stop.id == leg.id %}
                        {% set _from = stop.arrival|date('Y-m-d') %}
                        {% set nights = date(stop.departure|date('Y-m-d')).diff(date(_from)).days %}
                        <li class="c-tripv__stop{{ isThis ? ' is-current' }}">
                            <span class="c-tripv__num">{{ loop.index }}</span>
                            <div class="c-tripv__stop-body">
                                <p class="c-tripv__place">
                                    {% if stop.location.country %}<span class="o-flag o-flag--{{ stop.location.countryId|upper }} c-tripv__flag" aria-hidden="true"></span>{% endif %}
                                    <strong>{{ stop.location.name }}</strong>
                                    {% if stop.location.country %}<span class="c-tripv__country">{{ stop.location.country.name }}</span>{% endif %}
                                </p>
                                <p class="c-tripv__dates">
                                    {#- Today or Tomorrow (this leg) says it all: no dates then, the nights still -#}
                                    {% set _days = date(_from).diff(date('today')).days %}
                                    {% if isThis and _from >= 'now'|date('Y-m-d') and _days <= 1 %}
                                        <span class="c-tripv__soon">{{ (_days == 0 ? 'landing.visitors.today' : 'landing.visitors.tomorrow')|trans }}</span>
                                    {% else %}
                                    <span class="c-tripv__when">
                                        {%- if stop.departure|date('Y-m-d') == _from -%}
                                            {{ stop.arrival|format_date(pattern='EEE d MMM') }}
                                        {%- elseif stop.departure|date('Y-m') == stop.arrival|date('Y-m') -%}
                                            {{ stop.arrival|format_date(pattern='EEE d') }} – {{ stop.departure|format_date(pattern='EEE d MMM') }}
                                        {%- else -%}
                                            {{ stop.arrival|format_date(pattern='EEE d MMM') }} – {{ stop.departure|format_date(pattern='EEE d MMM') }}
                                        {%- endif -%}
                                    </span>
                                    {% endif %}
                                    {% if nights > 0 %}<span class="c-tripv__nights"><i class="fas fa-moon" aria-hidden="true"></i> {{ 'contact.trip.nights'|trans({ count: nights }) }}</span>{% endif %}
                                </p>
                                {% if constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in stop.options %}
                                    <p class="c-tripv__tags"><span class="c-tripv__tag">{{ 'trip.option.meet.locals'|trans }}</span></p>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            </section>
        </div>

        {% if trip.creator != app.user %}
            {# Not for me (centred above the buttons): hides this trip from my visitors list; the page around the panel reloads without it #}
            <form class="c-tripv__hide-form" method="post" action="{{ path('trip_hide', { id: leg.id }) }}" target="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('hide_leg') }}">
                <input type="hidden" name="redirectTo" value="{{ from == 'visitors' ? 'visitors' : 'homepage' }}">
                <button type="submit" class="c-tripv__hide"><i class="fa fa-eye-slash" aria-hidden="true"></i> {{ 'trip.hide'|trans }}</button>
            </form>
        {% endif %}

        {# Message (round) is always there, also to agree on the dates before inviting #}
        <div class="c-contact__foot c-contact__foot--row">
            <a class="c-contact__send{% if lookingForHost %} c-contact__send--secondary c-contact__send--side c-tripv__msg{% endif %}" href="{{ path('message_new', { username: traveller.username, embed: 1, from: from, back: back }) }}" aria-label="{{ 'trip.leg.message'|trans }}">
                <i class="fas fa-envelope" aria-hidden="true"></i>{% if not lookingForHost %} <span class="c-contact__send-label">{{ 'trip.leg.message'|trans }}</span>{% endif %}
            </a>
            {% if lookingForHost %}
                {% if invitation %}
                    <a class="c-contact__send c-contact__send--done" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" target="_top">
                        <i class="fas fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}
                    </a>
                {% else %}
                    <a class="c-contact__send" href="{{ path('hosting_invitation', { leg: leg.id, embed: 1, from: from, back: back }) }}">
                        <i class="fas fa-house-user" aria-hidden="true"></i> {{ 'contact.trip.invite'|trans }}
                    </a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <script>
        (function () {
            var parentWindow = window.parent !== window ? window.parent : null;
            // The panel's own head is hidden: this page has its own (the cross at the top)
            if (parentWindow) {
                parentWindow.postMessage({ type: 'bw-contact-ready' }, window.location.origin);
            }
            document.querySelector('.js-trip-close').addEventListener('click', function () {
                if (parentWindow) {
                    parentWindow.postMessage({ type: 'bw-contact-close' }, window.location.origin);
                } else {
                    window.location.href = '{{ path('trip_show', { id: trip.id }) }}';
                }
            });

            // The trip's text is cut after a few lines; Read more shows the rest
            var text = document.querySelector('.js-trip-text');
            var more = document.querySelector('.js-trip-more');
            if (!text || !more) {
                return;
            }
            if (text.scrollHeight > text.clientHeight + 2) {
                more.hidden = false;
            }
            var label = more.textContent;
            more.addEventListener('click', function () {
                var open = text.classList.toggle('is-clamped') === false;
                more.textContent = open ? more.dataset.less : label;
            });
        })();
    </script>
{% endblock content %}
