{% extends 'trips.html.twig' %}

{% set trips_redesign = true %}

{#
  My trips, in the same layout as Visitors (trips.html.twig, trips_redesign): one card per
  trip with its title, dates, the places of its legs, the travellers, then edit (while the
  trip is not over) and remove, which asks first.
#}

{% block title %}
  {{ 'trips.mytrips' | trans }}
{% endblock %}

{% block stylesheets %}
  {{ encore_entry_link_tags('tailwind') }}
  {{ encore_entry_link_tags('trips') }}
{% endblock %}

{% block javascripts %}
  {{ encore_entry_script_tags('micromodal') }}
{% endblock %}

{% block content %}
<section class="p-trips__body">
  {% if trips.nbResults != 0 %}
    <div class="p-trips__toolbar">
      <p class="p-trips__count"><i class="fa fa-route" aria-hidden="true"></i> {{ trips.nbResults }}</p>
    </div>

    <div class="p-trips__list">
      {% for trip in trips %}
        {% set first = trip.legs|first %}
        {% set last = trip.legs|last %}
        <article class="p-trips-trip{% if trip.isExpired %} is-over{% endif %}">
          <span class="p-trips-trip__icon" aria-hidden="true"><i class="fa fa-route"></i></span>
          <div class="p-trips-trip__body">
            <p class="p-trips-trip__head">
              <a class="p-trips-trip__title" href="{{ path('trip_show', { id: trip.id }) }}">{{ trip.summary }}</a>
              {% if trip.isExpired %}<span class="p-trips-trip__over">{{ 'trip.over'|trans }}</span>{% endif %}
            </p>
            {% if first and last %}
              <p class="p-trips-trip__dates">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                {{ first.arrival|format_date('medium') }}{% if last.departure and last.departure != first.arrival %} – {{ last.departure|format_date('medium') }}{% endif %}
              </p>
            {% endif %}
            {% if trip.legs|length > 0 %}
              <p class="p-trips-trip__legs">
                {% for leg in trip.legs %}
                  {% if leg.location %}
                    <span class="p-trips-trip__leg">
                      <i class="fas fa-location-dot" aria-hidden="true"></i> {{ leg.location.name }}
                    </span>
                    {% if not loop.last %}<i class="fas fa-chevron-right p-trips-trip__arrow" aria-hidden="true"></i>{% endif %}
                  {% endif %}
                {% endfor %}
              </p>
            {% endif %}
            {% if trip.description %}
              <p class="p-trips-leg__text">{{ trip.description|purify|striptags|truncate(240) }}</p>
            {% endif %}
            <p class="p-trips-leg__meta">
              <span class="p-trips-leg__chip"><i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: trip.countOfTravellers }) }}</span>
              {% if trip.additionalInfo != constant('App\\Doctrine\\TripAdditionalInfoType::NONE') %}
                <span class="p-trips-leg__chip"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ ('trip.additional.info.' ~ trip.additionalInfo)|lower|trans }}</span>
              {% endif %}
            </p>
          </div>
          <div class="p-trips-trip__actions">
            {% if not trip.isExpired %}
              <a class="p-notes-card__action" href="{{ path('trip_edit', { id: trip.id }) }}" aria-label="{{ 'trip.edit'|trans }}" title="{{ 'trip.edit'|trans }}">
                <i class="fas fa-pen" aria-hidden="true"></i>
              </a>
            {% endif %}
            <button type="button" class="p-notes-card__action" data-micromodal-trigger="removeTrip-{{ trip.id }}" aria-label="{{ 'trip.remove'|trans }}" title="{{ 'trip.remove'|trans }}">
              <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </button>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if trips.haveToPaginate %}
      <div class="p-trips__pager">
        {{ pagerfanta(trips, 'rounded_pagination', { routeName: 'trips' }) }}
      </div>
    {% endif %}
  {% else %}
    <div class="p-trips__empty">
      <i class="far fa-map" aria-hidden="true"></i>
      <p>{{ 'trip.no.trips'|trans }}</p>
    </div>
  {% endif %}
</section>
{% endblock content %}

{% block modals %}
  {% for trip in trips %}
    <div class="micromodal-slide p-pe-confirm" id="removeTrip-{{ trip.id }}" aria-hidden="true">
      <div class="modal__overlay p-pe-confirm__overlay" tabindex="-1" data-micromodal-close>
        <div class="modal__container p-pe-confirm__box" role="dialog" aria-modal="true" aria-labelledby="removeTrip-{{ trip.id }}-title">
          <span class="p-pe-confirm__icon" aria-hidden="true"><i class="fas fa-trash-alt"></i></span>
          <h2 class="p-pe-confirm__title" id="removeTrip-{{ trip.id }}-title">{{ trip.summary|truncate(60) }}</h2>
          <div class="p-pe-confirm__text">{{ 'trip.remove.body'|trans|raw }}</div>
          <div class="p-pe-confirm__actions">
            <button type="button" class="p-pe-confirm__cancel" data-micromodal-close>{{ 'trip.remove.close'|trans }}</button>
            <a class="p-pe-confirm__delete" href="{{ path('trip_remove', { id: trip.id }) }}">
              <i class="fas fa-trash-alt" aria-hidden="true"></i> {{ 'trip.remove.label'|trans }}
            </a>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
{% endblock modals %}
