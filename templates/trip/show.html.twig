{% extends 'trips.html.twig' %}
{% import 'macros.twig' as macros %}

{% set trips_redesign = true %}

{% block title %}
    {{ trip.summary }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('trips') }}
{% endblock javascripts %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('tailwind') }}
    {{ encore_entry_link_tags('trips') }}
{% endblock %}

{#
  One trip: who travels and how (top card), the stops as a timeline next to the
  map. trips.js draws the map from the hidden .js-data inputs and the two JS
  objects at the bottom.
#}
{% block content %}
    {% set member = app.user %}
    {% set address = member.activeAddress %}
    {% set own = member is same as(trip.creator) %}

    <section class="p-trips-card p-trip-hero">
        <a class="p-trip-hero__avatar" href="{{ path('members_profile', { username: trip.creator.username }) }}">
            <img src="{{ path('avatar', { username: trip.creator.username, size: 96 }) }}" alt="" width="64" height="64">
        </a>
        <div class="p-trip-hero__body">
            <p class="p-trip-hero__who">{{ macros.profilelink(trip.creator.username, false, 'p-trips-leg__name') }}</p>
            <p class="p-trips-leg__meta p-trip-hero__meta">
                <span class="p-trips-leg__chip"><i class="fa fa-users" aria-hidden="true"></i> {{ 'trip.count.of.travellers'|trans({ countOfTravellers: trip.countOfTravellers }) }}</span>
                {% if trip.additionalInfo != constant('App\\Doctrine\\TripAdditionalInfoType::NONE') %}
                    <span class="p-trips-leg__chip"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ ('trip.additional.info.' ~ trip.additionalInfo)|lower|trans }}</span>
                {% endif %}
                <span class="p-trips-leg__chip" title="{{ 'trip.invitation.radius'|trans }}"><i class="fa fa-bullseye" aria-hidden="true"></i> {{ trip.invitationRadius|trans }}</span>
            </p>
            {% if trip.description %}
                <div class="p-trip-hero__text">{{ trip.description|nl2br }}</div>
            {% endif %}
        </div>
        {% if own %}
            <div class="p-trip-hero__actions">
                {% if expired == false %}
                    <a class="p-trips-btn" href="{{ path('trip_edit', { id: trip.id }) }}"><i class="fa fa-edit" aria-hidden="true"></i> {{ 'trip.edit'|trans }}</a>
                {% endif %}
                <a class="p-trips-btn" href="{{ path('trip_copy', { id: trip.id }) }}"><i class="fa fa-copy" aria-hidden="true"></i> {{ 'trip.copy'|trans }}</a>
            </div>
        {% endif %}
    </section>

    <div class="p-trip-layout">
        <section class="p-trips-card p-trip-stops">
            <h2 class="p-trips-card__title">{{ 'trip.legs.title'|trans }}</h2>
            <ol class="p-trip-timeline">
                {% set current = 1 %}
                {% set lastLongitude = ((trip.legs)|first).location.longitude %}
                {% for leg in trip.legs %}
                    {% if not(constant('App\\Doctrine\\LegOptionsType::PRIVATE') in leg.options) or own %}
                        <li class="p-trip-timeline__item" id="leg{{ leg.id }}">
                            <span class="p-trip-timeline__num">{{ current }}</span>
                            <div class="p-trip-timeline__body">
                                <p class="p-trip-timeline__place">
                                    {{ leg.location.fullname }}
                                    {% if leg.location.country %}<i class="o-flag o-flag--{{ leg.location.country.countryId }}" title="{{ leg.location.country.name }}"></i>{% endif %}
                                </p>
                                <p class="p-trip-timeline__dates"><i class="far fa-calendar-alt" aria-hidden="true"></i> {{ leg.arrival|format_date('medium') }}{% if leg.arrival != leg.departure %} – {{ leg.departure|format_date('medium') }}{% endif %}</p>

                                {% if own %}
                                    <p class="p-trips-leg__meta">
                                        {% for option, key in {
                                            (constant('App\\Doctrine\\LegOptionsType::PRIVATE')): 'trip.option.private',
                                            (constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST')): 'trip.option.looking.for.host',
                                            (constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS')): 'trip.option.meet.locals',
                                        } %}
                                            {% if option in leg.options %}
                                                <span class="p-trips-leg__chip"><i class="fa fa-check" aria-hidden="true"></i> {{ key|trans }}</span>
                                            {% endif %}
                                        {% endfor %}
                                    </p>
                                    {% if leg.acceptedInvitation %}
                                        {% set invitation = leg.acceptedInvitation %}
                                        {% set username = invitation.messages[0].initiator.Username %}
                                        <div class="p-trip-hosts">
                                            <a class="p-trip-hosts__avatar is-accepted" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" title="{{ username }}">
                                                <img src="{{ path('avatar', { username: username, size: 48 }) }}" alt="{{ 'profile'|trans }}: {{ username }}">
                                            </a>
                                        </div>
                                    {% elseif leg.openInvitations|length > 0 %}
                                        {% set invitations = leg.openInvitations %}
                                        <div class="p-trip-hosts">
                                            {% for invitation in invitations|slice(0, 4) %}
                                                {% set username = invitation.messages[0].initiator.Username %}
                                                <a class="p-trip-hosts__avatar" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" title="{{ username }}">
                                                    <img src="{{ path('avatar', { username: username, size: 48 }) }}" alt="{{ 'profile'|trans }}: {{ username }}">
                                                </a>
                                            {% endfor %}
                                            {% if invitations|length > 4 %}
                                                <a class="p-trip-hosts__more" href="{{ url('conversations', { conversationsType: 'invitations' }) }}">+{{ invitations|length - 4 }}</a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% elseif distance(leg.location.latitude, leg.location.longitude, address.latitude, address.longitude) <= trip.invitationRadius or leg.location.geonameId == address.location.geonameId %}
                                    <div class="p-trip-timeline__actions">
                                        {% if constant('App\\Doctrine\\LegOptionsType::LOOKING_FOR_HOST') in leg.options %}
                                            {% set invitation = leg.invitationBy(member) %}
                                            {% if invitation %}
                                                <a class="p-trips-btn p-trips-btn--done" href="{{ path('conversation_reply', { id: invitation.messages[0].id }) }}" title="{{ 'invitation.reply'|trans|format(trip.creator.username) }}">
                                                    <i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invited'|trans }}
                                                </a>
                                            {% else %}
                                                <a class="p-trips-btn p-trips-btn--primary" href="{{ path('hosting_invitation', { leg: leg.id }) }}" title="{{ 'invite.username'|trans|format(trip.creator.username) }}">
                                                    <i class="fa fa-house-user" aria-hidden="true"></i> {{ 'trip.leg.invite'|trans }}
                                                </a>
                                            {% endif %}
                                        {% endif %}
                                        {% if constant('App\\Doctrine\\LegOptionsType::MEET_LOCALS') in leg.options %}
                                            <a class="p-trips-btn" href="{{ path('message_new', { username: trip.creator.username }) }}" title="{{ 'message.write_to'|trans|format(trip.creator.username) }}">
                                                <i class="fa fa-envelope" aria-hidden="true"></i> {{ 'trip.leg.message'|trans }}
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>

                            {% set calculatedLongitude = leg.location.longitude %}
                            {% if lastLongitude != leg.location.longitude %}
                                {% if sgn(lastLongitude) != sgn(leg.location.longitude) %}
                                    {% if lastLongitude|abs > 170 or leg.location.longitude|abs > 170 %}
                                        {% set calculatedLongitude = leg.location.longitude + 360.0 %}
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                            <input type="hidden" class="js-data"
                                   value="{{ leg.location.name }},{{ leg.location.latitude }},{{ calculatedLongitude }},{{ leg.location.country.name }},{{ leg.arrival|format_date('short') }}{% if leg.arrival != leg.departure %} - {{ leg.departure|format_date('short') }}{% endif %}">
                        </li>
                        {% set current = current + 1 %}
                    {% endif %}
                {% endfor %}
            </ol>
        </section>

        <section class="p-trips-card p-trip-map">
            <div id="map" class="o-map p-trip-map__map"></div>
        </section>
    </div>

    <script type="text/javascript">
        let trip = {
            own: {% if own %}true{% else %}false{% endif %},
            radius: {{ trip.invitationRadius * 1000 }},
        }
        let memberInfo = {
            latitude: {{ address.latitude }},
            longitude: {{ address.longitude }},
            searchRadius: {{ searchRadius }},
        }
    </script>
{% endblock content %}
